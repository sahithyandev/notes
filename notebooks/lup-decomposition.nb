    RowBox[{"{",
     RowBox[{"2", ",", "9", ",", "0"}], "}"}], ",",
    RowBox[{"{",
     RowBox[{"6", ",", "8", ",", "8"}], "}"}]}], "}"}]}]], "Input",ExpressionU\
UID->"3d447492-f45e-48e2-924c-2ec9edc348a5"],

