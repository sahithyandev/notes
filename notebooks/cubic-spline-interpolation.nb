Notebook[{

Cell[CellGroupData[{
Cell["\<\
ClearAll[\"Global`*\"];

pts = {{0, 2}, {2, 4}, {3, 6}, {5,-2}}

method = \"Natural\"
(* method is either \"Natural\" or \"Clamped\"; *)

mLeft = 0;
mRight = 0;\
\>", "Input",
 CellChangeTimes->{{3.995416169615698*^9, 3.9954161761179037`*^9}, {
  3.99541652340326*^9, 3.995416544505467*^9}, {3.995419563195424*^9, 
  3.9954195764473667`*^9}},
