     RowBox[{"a", "[", "2", "]"}], "\[Rule]", "4"}], ",", 
    RowBox[{
     RowBox[{"b", "[", "2", "]"}], "\[Rule]", 
     FractionBox["83", "35"]}], ",", 
    RowBox[{
     RowBox[{"c", "[", "2", "]"}], "\[Rule]", 
     FractionBox["36", "35"]}], ",", 
    RowBox[{
     RowBox[{"d", "[", "2", "]"}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["7", "5"]}]}], ",", 
    RowBox[{
     RowBox[{"a", "[", "3", "]"}], "\[Rule]", "6"}], ",", 
    RowBox[{
     RowBox[{"b", "[", "3", "]"}], "\[Rule]", 
     FractionBox["8", "35"]}], ",", 
    RowBox[{
     RowBox[{"c", "[", "3", "]"}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["111", "35"]}]}], ",", 
    RowBox[{
     RowBox[{"d", "[", "3", "]"}], "\[Rule]", 
     FractionBox["37", "70"]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9954161490928698`*^9, 3.9954161797637863`*^9, 3.995416433060663*^9, {
   3.995416528795446*^9, 3.995416548941113*^9}, 3.995419580402959*^9},
 CellLabel->
  "Out[230]=",ExpressionUUID->"84a799cc-5d88-46f6-9c16-2d8920ad993d"]
