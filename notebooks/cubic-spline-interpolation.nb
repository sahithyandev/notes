Cell[BoxData["\<\"Natural\"\>"], "Output",
 CellChangeTimes->{
  3.9954161490488377`*^9, 3.99541617971894*^9, 3.9954164330164337`*^9, {
   3.9954165287499323`*^9, 3.995416548896481*^9}, {3.99541957720298*^9, 
   3.995419580361577*^9}},
 CellLabel->
  "Out[216]=",ExpressionUUID->"df9adc6f-3f28-4793-aab1-2f7be4f98b6d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["x = pts[[All, 1]]", "Input",
 CellLabel->
  "In[221]:=",ExpressionUUID->"40836dff-dcd7-4f94-aaea-e3679fa64908"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "2", ",", "3", ",", "5"}], "}"}]], "Output",
 CellChangeTimes->{
  3.99541614906444*^9, 3.995416179735189*^9, 3.995416433041666*^9, {
   3.9954165287717667`*^9, 3.995416548911401*^9}, 3.995419580375194*^9},
 CellLabel->
  "Out[221]=",ExpressionUUID->"2b85487e-2451-44dd-88ad-6174af6fd8ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["y = pts[[All, 2]]", "Input",
 CellLabel->
  "In[222]:=",ExpressionUUID->"7272c154-decd-4695-b00f-6916af8a0afa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "4", ",", "6", ",", 
   RowBox[{"-", "2"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.995416149072959*^9, 3.9954161797448473`*^9, 3.995416433043453*^9, {
   3.9954165287739897`*^9, 3.995416548913232*^9}, 3.995419580376933*^9},
 CellLabel->
  "Out[222]=",ExpressionUUID->"043daeb1-7b50-4094-b3dd-3d45890a0ad8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["n = Length[pts] - 1", "Input",
 CellLabel->
  "In[223]:=",ExpressionUUID->"a2d856b1-c125-4094-b07e-008567a02a1e"],

Cell[BoxData["3"], "Output",
 CellChangeTimes->{
  3.995416149074932*^9, 3.995416179746648*^9, 3.995416433044989*^9, {
   3.995416528775968*^9, 3.9954165489173117`*^9}, 3.995419580378587*^9},
 CellLabel->
  "Out[223]=",ExpressionUUID->"5444e99d-b431-4efb-b374-282c9ae62cec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
s = Table[
   a[i] + b[i] (t - x[[i]]) +
    c[i] (t - x[[i]])^2 +
    d[i] (t - x[[i]])^3,
   {i, n}
   ]\
\>", "Input",
 CellLabel->
  "In[224]:=",ExpressionUUID->"896df739-cd52-494f-8528-cd41831fe64a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "[", "1", "]"}], "+", 
    RowBox[{"t", " ", 
     RowBox[{"b", "[", "1", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["t", "2"], " ", 
     RowBox[{"c", "[", "1", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["t", "3"], " ", 
     RowBox[{"d", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"a", "[", "2", "]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "t"}], ")"}], " ", 
     RowBox[{"b", "[", "2", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "t"}], ")"}], "2"], " ", 
     RowBox[{"c", "[", "2", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "t"}], ")"}], "3"], " ", 
     RowBox[{"d", "[", "2", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{"a", "[", "3", "]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "3"}], "+", "t"}], ")"}], " ", 
     RowBox[{"b", "[", "3", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "t"}], ")"}], "2"], " ", 
     RowBox[{"c", "[", "3", "]"}]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "3"}], "+", "t"}], ")"}], "3"], " ", 
     RowBox[{"d", "[", "3", "]"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.995416149076737*^9, 3.995416179748423*^9, 3.9954164330466423`*^9, {
   3.9954165287776213`*^9, 3.995416548923945*^9}, 3.995419580386849*^9},
 CellLabel->
  "Out[224]=",ExpressionUUID->"58db13c3-645e-4e1a-a9bf-cf1f33e5ace6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
eq1 = Flatten@Table[
    {
     (s[[i]] /. t -> x[[i]]) == y[[i]],
     (s[[i]] /. t -> x[[i + 1]]) == y[[i + 1]]
     },
    {i, n}
    ]\
\>", "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"00289af9-1226-4222-950f-dcc459acb535"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "[", "1", "]"}], "\[Equal]", "2"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "1", "]"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"b", "[", "1", "]"}]}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"c", "[", "1", "]"}]}], "+", 
     RowBox[{"8", " ", 
      RowBox[{"d", "[", "1", "]"}]}]}], "\[Equal]", "4"}], ",", 
   RowBox[{
    RowBox[{"a", "[", "2", "]"}], "\[Equal]", "4"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "2", "]"}], "+", 
     RowBox[{"b", "[", "2", "]"}], "+", 
     RowBox[{"c", "[", "2", "]"}], "+", 
     RowBox[{"d", "[", "2", "]"}]}], "\[Equal]", "6"}], ",", 
   RowBox[{
    RowBox[{"a", "[", "3", "]"}], "\[Equal]", "6"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "3", "]"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"b", "[", "3", "]"}]}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"c", "[", "3", "]"}]}], "+", 
     RowBox[{"8", " ", 
      RowBox[{"d", "[", "3", "]"}]}]}], "\[Equal]", 
    RowBox[{"-", "2"}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9954161490782757`*^9, 3.995416179751322*^9, 3.995416433048338*^9, {
   3.9954165287794943`*^9, 3.995416548926098*^9}, 3.995419580389038*^9},
 CellLabel->
  "Out[225]=",ExpressionUUID->"5ddac739-7036-4772-adca-008fbf4ea770"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
eq2 = Table[
   (D[s[[i]], t] /. t -> x[[i + 1]]) ==
    (D[s[[i + 1]], t] /. t -> x[[i + 1]]),
   {i, n - 1}
   ]\
\>", "Input",
 CellLabel->
  "In[226]:=",ExpressionUUID->"4e945048-9db0-45a5-bfac-eca7c66fc171"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", "1", "]"}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"c", "[", "1", "]"}]}], "+", 
     RowBox[{"12", " ", 
      RowBox[{"d", "[", "1", "]"}]}]}], "\[Equal]", 
    RowBox[{"b", "[", "2", "]"}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", "2", "]"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"c", "[", "2", "]"}]}], "+", 
     RowBox[{"3", " ", 
      RowBox[{"d", "[", "2", "]"}]}]}], "\[Equal]", 
    RowBox[{"b", "[", "3", "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.995416149079904*^9, 3.995416179757545*^9, 3.995416433054405*^9, {
   3.9954165287836*^9, 3.9954165489278183`*^9}, 3.995419580390758*^9},
 CellLabel->
  "Out[226]=",ExpressionUUID->"8a4385fb-dea2-45df-9129-aa8b862f7cfe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
eq3 = Table[
   (D[s[[i]], {t, 2}] /. t -> x[[i + 1]]) ==
    (D[s[[i + 1]], {t, 2}] /. t -> x[[i + 1]]),
   {i, n - 1}
   ]\
\>", "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"1c915743-87a6-4d25-889a-067adc6ca801"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"c", "[", "1", "]"}]}], "+", 
     RowBox[{"12", " ", 
      RowBox[{"d", "[", "1", "]"}]}]}], "\[Equal]", 
    RowBox[{"2", " ", 
     RowBox[{"c", "[", "2", "]"}]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"c", "[", "2", "]"}]}], "+", 
     RowBox[{"6", " ", 
      RowBox[{"d", "[", "2", "]"}]}]}], "\[Equal]", 
    RowBox[{"2", " ", 
     RowBox[{"c", "[", "3", "]"}]}]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.995416149081362*^9, 3.995416179759282*^9, 3.9954164330561123`*^9, {
   3.995416528790745*^9, 3.995416548929467*^9}, 3.995419580392398*^9},
 CellLabel->
  "Out[227]=",ExpressionUUID->"93a9644d-5ba3-483b-8109-05d8db5bc1fd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
eq4 = Switch[
   method,

   \"Natural\",
   {
    (D[s[[1]], {t, 2}] /. t -> x[[1]]) == 0,
    (D[s[[-1]], {t, 2}] /. t -> x[[-1]]) == 0
    },

   \"Clamped\",
   {
    (D[s[[1]], t] /. t -> x[[1]]) == mLeft,
    (D[s[[-1]], t] /. t -> x[[-1]]) == mRight
    },

   _,
   Print[\"Error: method must be \\\"Natural\\\" or \\\"Clamped\\\".\"]
   ]\
\>", "Input",
 CellLabel->
  "In[228]:=",ExpressionUUID->"13d385a1-444b-4645-8dbf-03ff7b39385e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"c", "[", "1", "]"}]}], "\[Equal]", "0"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"c", "[", "3", "]"}]}], "+", 
     RowBox[{"12", " ", 
      RowBox[{"d", "[", "3", "]"}]}]}], "\[Equal]", "0"}]}], "}"}]], "Output",\

 CellChangeTimes->{
  3.995416149089633*^9, 3.995416179761012*^9, 3.995416433057572*^9, {
   3.9954165287925587`*^9, 3.995416548937613*^9}, 3.9954195803939323`*^9},
 CellLabel->
  "Out[228]=",ExpressionUUID->"e0550955-bc03-4285-b40c-91f1dc70e449"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
unknowns = Flatten@Table[
    {a[i], b[i], c[i], d[i]},
    {i, n}
    ]\
\>", "Input",
 CellLabel->
  "In[229]:=",ExpressionUUID->"a26332f5-eddb-482f-83d6-470b0bea0f35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"a", "[", "1", "]"}], ",", 
   RowBox[{"b", "[", "1", "]"}], ",", 
   RowBox[{"c", "[", "1", "]"}], ",", 
   RowBox[{"d", "[", "1", "]"}], ",", 
   RowBox[{"a", "[", "2", "]"}], ",", 
   RowBox[{"b", "[", "2", "]"}], ",", 
   RowBox[{"c", "[", "2", "]"}], ",", 
   RowBox[{"d", "[", "2", "]"}], ",", 
   RowBox[{"a", "[", "3", "]"}], ",", 
   RowBox[{"b", "[", "3", "]"}], ",", 
   RowBox[{"c", "[", "3", "]"}], ",", 
   RowBox[{"d", "[", "3", "]"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9954161490912848`*^9, 3.995416179762423*^9, 3.995416433059127*^9, {
   3.995416528793988*^9, 3.995416548939391*^9}, 3.99541958039542*^9},
 CellLabel->
  "Out[229]=",ExpressionUUID->"64f96978-c42e-4f56-b6f9-d851c4bf4258"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
sol = Solve[
   Join[eq1, eq2, eq3, eq4],
   unknowns
   ]\
\>", "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"3d12db47-025d-481c-8cee-ca4e1e122efb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "1", "]"}], "\[Rule]", "2"}], ",", 
    RowBox[{
     RowBox[{"b", "[", "1", "]"}], "\[Rule]", 
     FractionBox["11", "35"]}], ",", 
    RowBox[{
     RowBox[{"c", "[", "1", "]"}], "\[Rule]", "0"}], ",", 
    RowBox[{
     RowBox[{"d", "[", "1", "]"}], "\[Rule]", 
     FractionBox["6", "35"]}], ",", 
