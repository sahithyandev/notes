    RowBox[{"0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "6"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", 
     RowBox[{"-", "2"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9954161490488377`*^9, 3.99541617971894*^9, 3.9954164330164337`*^9, {
   3.9954165287499323`*^9, 3.995416548896481*^9}, {3.99541957720298*^9, 
   3.995419580361042*^9}},
 CellLabel->
