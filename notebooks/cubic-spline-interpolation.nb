Cell[CellGroupData[{

Cell["\<\
nodeSym = Table[Subscript[t, i], {i, n + 1}];
sSym = Table[
   a[i] + b[i] (t - nodeSym[[i]]) + c[i] (t - nodeSym[[i]])^2 +
    d[i] (t - nodeSym[[i]])^3,
   {i, n}
   ];
pwSym = Piecewise[
   Table[
    {sSym[[i]] /. First[sol], x[[i]] <= t <= x[[i + 1]]},
    {i, n}
    ]
   ]\
\>", "Input",
