Cell[CellGroupData[{

Cell["spline = Simplify[s /. First[sol]]", "Input",
 CellLabel->
  "In[231]:=",ExpressionUUID->"e81f29d7-1311-4142-9cd9-dd6f367940b6"],

Cell[BoxData[
 RowBox[{"{", 
