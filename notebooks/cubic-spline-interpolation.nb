}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
pw = Piecewise[
   Table[
    {
     spline[[i]],
     x[[i]] <= t <= x[[i + 1]]
     },
    {i, n}
    ]
   ]\
\>", "Input",
 CellLabel->
  "In[232]:=",ExpressionUUID->"501a9f86-c6b2-4abc-a485-c99320672926"],

