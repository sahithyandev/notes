{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST http://localhost:4321/__reload-lock/pause >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST http://localhost:4321/__reload-lock/resume >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
