---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Nav from "../components/layout/nav.astro";
import Footer from "../components/layout/footer.astro";
import { SITE_NAME, SITE_HOST_URL } from "../utils/values";
---

<Layout
  title={`You're offline | ${SITE_NAME}`}
  description="You're offline. Notes you opened before are still available on this device."
  image={`${SITE_HOST_URL}/og/default.jpg`}
  noindex
>
  <Nav />

  <main id="main-content" class="offline-page">
    <section class="offline-content">
      <p class="error-code">Offline</p>
      <h1>You're not connected.</h1>
      <p class="description">
        This page isn't saved on your device. Notes you opened before stay
        available offline for 30 days.
      </p>
      <nav class="links-grid" aria-label="Actions">
        <button
          type="button"
          id="offline-retry"
          class="link-card link-card--primary"
        >
          <span class="link-label">Try again</span>
          <span class="link-desc">
            Reload this page once you're back online
          </span>
        </button>
        <a href="/" class="link-card link-card--primary">
          <span class="link-label">Home</span>
          <span class="link-desc">All semesters and notes</span>
        </a>
      </nav>

      <div id="offline-saved" hidden>
        <h2 class="saved-heading">Saved on this device</h2>
        <div id="offline-groups"></div>
      </div>
      <p id="offline-empty" class="description" hidden>
        Nothing is saved yet. Notes become available offline after you open them
        once while connected.
      </p>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { titleize } from "../utils";
  import {
    PAGE_CACHE_PREFIX,
    isFresh,
    normalizePath,
  } from "../scripts/offline";

  document
    .getElementById("offline-retry")
    ?.addEventListener("click", () => location.reload());
  window.addEventListener("online", () => location.reload());

  type Saved = { path: string; title: string; cachedAt: number };

  async function loadSaved(): Promise<Saved[]> {
    const byPath = new Map<string, Saved>();
    for (const name of await caches.keys()) {
      if (!name.startsWith(PAGE_CACHE_PREFIX)) continue;
      const cache = await caches.open(name);
      for (const request of await cache.keys()) {
        const path = normalizePath(new URL(request.url).pathname);
        if (path === "/" || path === "/offline") continue;
        const response = await cache.match(request);
        if (!response || !isFresh(response)) continue;
        const html = await response.text();
        const heading = new DOMParser()
          .parseFromString(html, "text/html")
          .querySelector("h1")
          ?.textContent?.trim();
        byPath.set(path, {
          path,
          title: heading || titleize(path.split("/").pop() ?? path),
          cachedAt: Number(response.headers.get("sn-cached-at")),
        });
      }
    }
    return [...byPath.values()].sort((a, b) => b.cachedAt - a.cachedAt);
  }

  function render(saved: Saved[]) {
    const groups = new Map<string, Saved[]>();
    for (const item of saved) {
      const sem = item.path.split("/")[1] ?? "";
      if (!groups.has(sem)) groups.set(sem, []);
      groups.get(sem)!.push(item);
    }
    const container = document.getElementById("offline-groups")!;
    for (const sem of [...groups.keys()].sort()) {
      const match = sem.match(/^s(\d+)$/);
      const section = document.createElement("section");
      section.className = "offline-group";
      if (match) section.style.setProperty("--group", `var(--s${match[1]})`);
      const label = document.createElement("h3");
      label.textContent = match ? `Semester ${match[1]}` : titleize(sem);
      const list = document.createElement("div");
      list.className = "links-grid";
      for (const item of groups.get(sem)!) {
        const a = document.createElement("a");
        a.href = item.path;
        a.className = "link-card";
        const name = document.createElement("span");
        name.className = "link-label";
        name.textContent = item.title;
        const module = document.createElement("span");
        module.className = "link-desc";
        module.textContent = titleize(item.path.split("/")[2] ?? "");
        a.append(name, module);
        list.append(a);
      }
      section.append(label, list);
      container.append(section);
    }
  }

  loadSaved()
    .then((saved) => {
      if (saved.length === 0) {
        document.getElementById("offline-empty")!.hidden = false;
        return;
      }
      render(saved);
      document.getElementById("offline-saved")!.hidden = false;
    })
    .catch(() => {
      document.getElementById("offline-empty")!.hidden = false;
    });
</script>

<style>
  :root {
    --nav-h: 54px;
  }

  .offline-page {
    min-height: calc(100dvh - var(--nav-h) - 60px);
    width: var(--body-width);
    margin: 0 auto;
    padding: calc(8 * var(--spacing)) 0;
  }

  .offline-content {
    max-width: 640px;
    width: 100%;
  }

  .error-code {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
  }

  .offline-content h1 {
    font-family: var(--font-ui);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0 0 20px;
  }

  .description {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0 0 36px;
  }

  .saved-heading {
    font-family: var(--font-ui);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 48px 0 16px;
  }

  .links-grid,
  :global(#offline-groups .links-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .link-card,
  :global(#offline-groups .link-card) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .link-card:hover,
  :global(#offline-groups .link-card:hover) {
    border-color: var(--group, var(--accent));
  }

  .link-card--primary {
    grid-column: auto;
  }

  .link-label,
  :global(#offline-groups .link-label) {
    font-family: var(--font-ui);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .link-desc,
  :global(#offline-groups .link-desc) {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  :global(#offline-groups .offline-group) {
    margin-bottom: 28px;
  }

  :global(#offline-groups .offline-group h3) {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: var(--group, var(--text-muted));
  }
</style>
