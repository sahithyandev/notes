---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import { SITE_NAME, SITE_HOST_URL, isElective } from "../utils/values";
import { titleize } from "../utils";
import NoteCard from "../components/note-card.astro";
import TocRail from "../components/toc-rail.astro";
import ModulesList from "../components/modules-list.astro";
import RightSidebar from "../components/right-sidebar.astro";
import type { ModuleItem } from "../utils/types";

export const prerender = true;

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const sems = new Set<string>();
  notes.forEach((note) => {
    const parts = note.data.slug.split("/");
    if (parts[0]?.match(/^s\d$/)) sems.add(parts[0]);
  });
  return [...sems].map((sem) => ({ params: { sem } }));
}

const { sem } = Astro.params;
const semNum = sem.match(/^s(\d)$/)?.[1] || "1";

const allNotes = await getCollection("notes");

// Parse the numeric prefix of a topic-group directory from a note's filePath.
function moduleOrderFromFilePath(filePath: string | undefined): number {
  if (!filePath) return Infinity;
  const parts = filePath.split("/");
  const topicDir = parts[3];
  if (!topicDir) return Infinity;
  const m = topicDir.match(/^(\d+)-/);
  return m ? parseInt(m[1], 10) : Infinity;
}

type NoteItem = {
  slug: string;
  label: string;
  order: number;
  moduleOrder: number;
};

const grouped: Record<string, NoteItem[]> = {};
allNotes.forEach((note) => {
  const parts = note.data.slug.split("/");
  if (parts[0] !== sem) return;
  const subject = parts[1];
  if (!grouped[subject]) grouped[subject] = [];
  grouped[subject].push({
    slug: note.data.slug,
    label: note.data.sidebar?.label || note.data.title,
    order: note.data.sidebar?.order ?? 999,
    moduleOrder: moduleOrderFromFilePath(note.filePath),
  });
});

Object.keys(grouped).forEach((subj) => {
  grouped[subj].sort((a, b) => a.order - b.order);
});

const subjectTrees: Record<
  string,
  { direct: NoteItem[]; modules: Record<string, NoteItem[]> }
> = {};

Object.keys(grouped)
  .sort((a, b) => titleize(a).localeCompare(titleize(b)))
  .forEach((subject) => {
    const tree: { direct: NoteItem[]; modules: Record<string, NoteItem[]> } = {
      direct: [],
      modules: {},
    };
    grouped[subject].forEach((note) => {
      const parts = note.slug.split("/");
      if (parts.length === 3) {
        tree.direct.push(note);
      } else if (parts.length >= 4) {
        const mod = parts[2];
        if (!tree.modules[mod]) tree.modules[mod] = [];
        tree.modules[mod].push(note);
      }
    });
    const sortedMods: Record<string, NoteItem[]> = {};
    Object.keys(tree.modules)
      .sort((a, b) => {
        const orderA = tree.modules[a][0]?.moduleOrder ?? Infinity;
        const orderB = tree.modules[b][0]?.moduleOrder ?? Infinity;
        return orderA - orderB;
      })
      .forEach((k) => (sortedMods[k] = tree.modules[k]));
    tree.modules = sortedMods;
    subjectTrees[subject] = tree;
  });

const tocHeadings: { depth: 2 | 3; slug: string; html: string }[] = [];
Object.entries(subjectTrees).forEach(([subject, { modules }]) => {
  tocHeadings.push({ depth: 2, slug: subject, html: titleize(subject) });
  Object.keys(modules).forEach((mod) => {
    tocHeadings.push({
      depth: 3,
      slug: `${subject}-${mod}`,
      html: titleize(mod),
    });
  });
});

const semesterNums = new Set<number>();
allNotes.forEach((note) => {
  const match = note.data.slug.split("/")[0].match(/^s(\d)$/);
  if (match) semesterNums.add(parseInt(match[1]));
});
const semesters = [...semesterNums]
  .sort((a, b) => a - b)
  .map((number) => ({ number, label: `Semester ${number}` }));

const subjectTreesKeys = Object.keys(subjectTrees);
const description = `Semester ${semNum} notes covering ${subjectTreesKeys.map(titleize).join(", ")}.`;
const semStyle = `--sem: var(--s${semNum}); --sem-bg: var(--s${semNum}-bg); --sem-border: var(--s${semNum}-border); --sem-text: var(--s${semNum}); --sem-dim: var(--s${semNum}-bg); --link: var(--s${semNum});`;

const subjectsList: Array<ModuleItem> = subjectTreesKeys.map((subject) => {
  const { direct, modules } = subjectTrees[subject];
  const firstNote = direct[0] ?? Object.values(modules).flat()[0];
  const href = firstNote ? `/${firstNote.slug}` : `#${subject}`;
  return {
    module: subject,
    href,
    count: grouped[subject].length,
    elective: isElective(`${sem}/${subject}`),
  };
});
---

<Layout
  title={`Semester ${semNum} | ${SITE_NAME}`}
  description={description}
  canonical={`${SITE_HOST_URL}/${sem}`}
  image={`${SITE_HOST_URL}/og/sem-${sem.slice(1)}.jpg`}
  slug={sem}
>
  <Nav />

  <div class="mobile-bar">
    <button
      class="mobile-bar-btn"
      id="open-sidebar"
      type="button"
      aria-label="Open contents"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="3" y1="6" x2="21" y2="6"></line><line
          x1="3"
          y1="12"
          x2="15"
          y2="12"></line><line x1="3" y1="18" x2="18" y2="18"></line></svg
      >
      <span>Contents</span>
    </button>
    {
      tocHeadings.length > 0 && (
        <button
          class="mobile-bar-btn right"
          id="open-toc"
          type="button"
          aria-label="Open table of contents"
        >
          <span>On this page</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </>
          </svg>
        </button>
      )
    }
  </div>
  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>

  <main
    data-pagefind-body
    class="grid grid-cols-[auto_1fr_auto]"
    style={semStyle}
  >
    <aside class="sidebar">
      <div class="sb-sem-wrap">
        <button
          class="sb-sem"
          id="sem-switcher-btn"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <div class="sb-sem-pip"></div>
          <div class="sb-sem-info">
            <span class="sb-sem-name">Semester {semNum}</span>
          </div>
          <svg
            class="sb-sem-chev"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div class="sb-sem-menu" id="sem-switcher-menu" hidden role="listbox">
          {
            semesters.map((s) => (
              <a
                href={`/s${s.number}`}
                class={`sb-sem-opt ${s.number === parseInt(semNum) ? "active" : ""}`}
                style={`--opt-sem: var(--s${s.number}); --opt-sem-bg: var(--s${s.number}-bg); --opt-sem-border: var(--s${s.number}-border);`}
                role="option"
              >
                <span class="sb-sem-opt-pip" />
                <span>{s.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <ModulesList modules={subjectsList} />

      <div class="sb-rule"></div>
      <a href="/license" class="sb-item"> License </a>
    </aside>

    <section>
      <div class="sem-breadcrumb">
        <a href="/" class="sem-breadcrumb-link">Home</a>
        <span class="sem-breadcrumb-sep">/</span>
        <span class="sem-breadcrumb-current">Semester {semNum}</span>
      </div>

      <h1 class="sem-title">Semester {semNum}</h1>
      <p class="sem-subtitle">
        {Object.keys(subjectTrees).length} subject{
          Object.keys(subjectTrees).length !== 1 ? "s" : ""
        },
        {allNotes.filter((n) => n.data.slug.startsWith(`${sem}/`)).length} notes
      </p>

      <article data-pagefind-body>
        {
          Object.entries(subjectTrees).map(([subject, { direct, modules }]) => (
            <>
              <h2 id={subject}>
                {titleize(subject)}
                {isElective(`${sem}/${subject}`) && (
                  <span class="elective-badge">Elective</span>
                )}
              </h2>
              {direct.length > 0 && (
                <div class="note-grid">
                  {direct.map((note) => (
                    <NoteCard href={`/${note.slug}`} order={note.order}>
                      {note.label}
                    </NoteCard>
                  ))}
                </div>
              )}
              {Object.entries(modules).map(([mod, notes]) => (
                <>
                  <h3 id={`${subject}-${mod}`}>{titleize(mod)}</h3>
                  <div class="note-grid">
                    {notes.map((note) => (
                      <NoteCard href={`/${note.slug}`} order={note.order}>
                        {note.label}
                      </NoteCard>
                    ))}
                  </div>
                </>
              ))}
            </>
          ))
        }
      </article>
    </section>

    <RightSidebar>
      <TocRail headings={tocHeadings} />
    </RightSidebar>
  </main>

  <script>
    const semBtn = document.getElementById("sem-switcher-btn");
    const semMenu = document.getElementById("sem-switcher-menu");
    if (semBtn && semMenu) {
      const close = () => {
        semMenu.hidden = true;
        semBtn.setAttribute("aria-expanded", "false");
      };
      const open = () => {
        semMenu.hidden = false;
        semBtn.setAttribute("aria-expanded", "true");
      };
      semBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        semMenu.hidden ? open() : close();
      });
      document.addEventListener("click", (e) => {
        if (semMenu.hidden) return;
        const target = e.target as Node;
        if (!semMenu.contains(target) && !semBtn.contains(target)) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !semMenu.hidden) {
          close();
          semBtn.focus();
        }
      });
    }
  </script>

  <script>
    const openSidebarBtn = document.getElementById("open-sidebar");
    const openTocBtn = document.getElementById("open-toc");
    const backdrop = document.getElementById("drawer-backdrop");
    const sidebarEl = document.querySelector(".sidebar");
    const tocEl = document.querySelector(".toc-rail");
    const root = document.documentElement;

    const closeDrawers = () => {
      root.classList.remove("sidebar-open", "toc-open");
      document.body.style.overflow = "";
    };
    const openSidebar = () => {
      root.classList.add("sidebar-open");
      root.classList.remove("toc-open");
      document.body.style.overflow = "hidden";
    };
    const openToc = () => {
      root.classList.add("toc-open");
      root.classList.remove("sidebar-open");
      document.body.style.overflow = "hidden";
    };

    openSidebarBtn?.addEventListener("click", openSidebar);
    openTocBtn?.addEventListener("click", openToc);
    backdrop?.addEventListener("click", closeDrawers);

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        (root.classList.contains("sidebar-open") ||
          root.classList.contains("toc-open"))
      ) {
        closeDrawers();
      }
    });

    sidebarEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });
    tocEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });

    const mqDesktop = window.matchMedia("(min-width: 48rem)");
    mqDesktop.addEventListener("change", (e) => {
      if (e.matches) closeDrawers();
    });

    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.classList.add("drawers-ready"));
    });
  </script>
</Layout>

<style>
  :root {
    --sidebar-w: 280px;
    --toc-w: 280px;
    --nav-h: 54px;
    --pip-size: 16px;
  }

  main {
    height: calc(100dvh - var(--nav-h));
    overflow: hidden;
  }

  section {
    padding: 0 calc(5 * var(--spacing));
    overflow: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  /* ── BREADCRUMB ────────────────────────────────────────────────── */
  .sem-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .sem-breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.12s ease;
  }

  .sem-breadcrumb-link:hover {
    color: var(--text-secondary);
  }

  .sem-breadcrumb-sep {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .sem-breadcrumb-current {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* ── SEMESTER HEADING ──────────────────────────────────────────── */
  .sem-title {
    font-family: var(--font-ui);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.08;
    color: var(--text-primary);
    margin-bottom: 6px;
    text-wrap: pretty;
  }

  .sem-subtitle {
    font-family: var(--font-ui);
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 32px;
  }

  /* ── ARTICLE ───────────────────────────────────────────────────── */
  article {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);

    h2 {
      font-family: var(--font-ui);
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      line-height: 1;
      color: var(--text-primary);
      margin: 32px 0 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    h2:first-child {
      margin-top: 0;
    }

    .elective-badge {
      font-family: var(--font-ui);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.2px;
      color: var(--sem-text);
      background: var(--sem-bg);
      border: 1px solid var(--sem-border);
      border-radius: 5px;
      padding: 2px 7px;
    }

    h3 {
      font-family: var(--font-ui);
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: -0.1px;
      color: var(--text-primary);
      margin: 20px 0 8px;
    }
  }

  .note-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 10px;
    margin-bottom: 16px;
  }

  /* ── LEFT SIDEBAR ─────────────────────────────────────────────── */
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    overflow-y: auto;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 0;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .sidebar::-webkit-scrollbar {
    width: 3px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 2px;
  }

  .sb-sem-wrap {
    position: relative;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }

  .sb-sem {
    width: 100%;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--sem-bg);
    border: 0;
    border-bottom: 1px solid var(--sem-border);
    color: var(--sem);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: filter 0.1s;
  }

  .sb-sem:hover {
    filter: brightness(0.97);
  }

  [data-theme="dark"] .sb-sem:hover {
    filter: brightness(1.25);
  }

  .sb-sem .sb-sem-name {
    color: var(--sem);
  }

  .sb-sem .sb-sem-chev {
    color: var(--sem);
    opacity: 0.7;
  }

  .sb-sem-chev {
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  .sb-sem[aria-expanded="true"] .sb-sem-chev {
    transform: rotate(180deg);
  }

  .sb-sem-menu {
    position: absolute;
    top: 100%;
    left: 8px;
    right: 8px;
    z-index: 10;
    margin-top: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sb-sem-opt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 4px;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .sb-sem-opt:hover {
    background: var(--surface-2);
    color: var(--text-primary);
  }

  .sb-sem-opt.active {
    color: var(--opt-sem);
  }

  .sb-sem-opt-pip,
  .sb-sem-pip {
    width: var(--pip-size);
    height: var(--pip-size);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .sb-sem-opt-pip {
    background: var(--opt-sem);
  }

  .sb-sem-pip {
    background: var(--sem);
  }

  .sb-sem-name {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.2px;
  }

  .sb-item {
    display: flex;
    align-items: center;
    padding: 5px 16px;
    font-size: 0.78125rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition:
      background 0.1s,
      color 0.1s,
      border-color 0.1s;
    line-height: 1.35;
  }

  .sb-item:hover {
    background: var(--surface-2);
    color: var(--text-primary);
  }

  .sb-rule {
    height: 1px;
    background: var(--border);
    margin: 8px 0;
  }

  /* ── MOBILE ACTION BAR & DRAWER CONTROLS ──────────────────────── */
  .mobile-bar {
    display: none;
    position: sticky;
    top: var(--nav-h);
    z-index: 20;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 8px calc(4 * var(--spacing));
    gap: 8px;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    transition:
      background 0.12s,
      color 0.12s,
      border-color 0.12s;
  }

  .mobile-bar-btn:hover,
  .mobile-bar-btn:active {
    background: var(--sem-bg);
    border-color: var(--sem-border);
    color: var(--sem);
  }

  .drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
  }

  html.drawers-ready .drawer-backdrop {
    transition: opacity 0.2s ease;
  }

  [data-theme="dark"] .drawer-backdrop {
    background: rgba(0, 0, 0, 0.65);
  }

  html.sidebar-open .drawer-backdrop,
  html.toc-open .drawer-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 48rem) {
    main {
      display: block !important;
      height: auto;
      overflow: visible;
    }

    .mobile-bar {
      display: flex;
    }

    .drawer-backdrop {
      display: block;
    }

    section {
      padding: 0 calc(4 * var(--spacing));
      overflow: visible;
      height: auto;
    }

    .sidebar {
      position: fixed;
      top: var(--nav-h);
      left: 0;
      height: calc(100dvh - var(--nav-h));
      width: min(300px, 85vw);
      z-index: 50;
      transform: translateX(-100%);
      box-shadow: 2px 0 18px rgba(0, 0, 0, 0.18);
    }

    html.drawers-ready .sidebar {
      transition: transform 0.22s ease;
    }

    html.sidebar-open .sidebar {
      transform: translateX(0);
    }

    .sem-title {
      font-size: 1.625rem;
    }
  }
</style>
