---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { SITE_NAME, SITE_HOST_URL } from "../utils/values";
import { NoteGraph } from "../utils/note-graph";
import { buildSiteGraphData } from "../utils/site-graph-data";

// The whole graph is computed here, before anything is rendered
const notes = await getCollection("notes");
const graph = NoteGraph.build(
  notes.map((n) => ({
    id: n.id,
    title: n.data.title,
    filePath: n.filePath,
    prereqs: n.data.prereqs,
    content: n.body,
  })),
);
const graphData = buildSiteGraphData(graph);
const strongestModuleDependencies = graphData.moduleDependencies.slice(0, 5);
const moduleLabel = (module: string) => {
  const [semester, ...parts] = module.split("/");
  const name = parts
    .join(" ")
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
  return semester.startsWith("s")
    ? `S${semester.slice(1)} ${name}`
    : name || "General";
};
---

<Layout
  title={`Site Graph | ${SITE_NAME}`}
  description="All notes as a graph"
  canonical={`${SITE_HOST_URL}/sitegraph`}
  noindex
>
  <main id="graph-root">
    <canvas id="graph-canvas" aria-label="Graph of all notes"></canvas>
    <header class="hud">
      <a href="/" class="back">
        ← Home
      </a>
      <h1>Site Graph</h1>
      <p class="stats">
        {graphData.nodes.length} notes, {graphData.edges.length} links
      </p>
      {strongestModuleDependencies.length > 0 && (
        <section class="dependencies" aria-labelledby="dependency-heading">
          <h2 id="dependency-heading">Strongest Module Dependencies</h2>
          <ol>
            {strongestModuleDependencies.map((dependency) => (
              <li>
                <span class="dependency-count">
                  {dependency.links} {dependency.links === 1 ? "link" : "links"}
                </span>
                <span class="dependency-route">
                  {moduleLabel(dependency.from)}
                  <span aria-hidden="true"> → </span>
                  {moduleLabel(dependency.to)}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )}
      <div class="search">
        <input
          id="q"
          type="search"
          placeholder="Find a note"
          autocomplete="off"
          spellcheck="false"
          aria-label="Find a note"
        />
        <kbd>/</kbd>
      </div>
      <ul id="results" hidden></ul>
      <ul id="legend"></ul>
      <p class="hint">
        Drag to pan, scroll to zoom, and click a note to open it. Arrows show
        prerequisites, solid lines show note order and dashed lines show links
        written in note content.
      </p>
      <div class="actions">
        <button id="longest" type="button" aria-pressed="false">
          Longest path
        </button>
        <button id="reset" type="button">
          Reset view
        </button>
      </div>
      <div id="path-info" hidden>
        <p id="path-summary"></p>
      </div>
    </header>
    <div id="tip" role="tooltip" hidden></div>
    <script
      id="graph-data"
      type="application/json"
      set:html={JSON.stringify(graphData).replace(/</g, "\\u003c")}
    />
  </main>
</Layout>

<style is:global>
  html,
  body {
    overflow: hidden;
    height: 100%;
  }
</style>

<style>
  #graph-root {
    position: fixed;
    inset: 0;
    background: var(--bg);
  }

  #graph-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  #graph-canvas.dragging {
    cursor: grabbing;
  }

  .hud {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 280px;
    max-width: calc(100vw - 32px);
    padding: 14px 16px 16px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    color: var(--text-secondary);
    font-size: 12.5px;
    line-height: 1.5;
  }

  .hud h1 {
    margin: 6px 0 0;
    font-size: 20px;
    font-weight: 800;
    color: var(--text-primary);
  }

  .stats {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  .dependencies {
    margin: 0 0 12px;
    padding: 10px 0;
    border-block: 1px solid var(--border);
  }

  .dependencies h2 {
    margin: 0 0 6px;
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.01em;
  }

  .dependencies ol {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dependencies li {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 7px;
    align-items: baseline;
  }

  .dependency-count {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .dependency-route {
    overflow: hidden;
    color: var(--text-secondary);
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .back {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .search {
    position: relative;
  }

  .search input {
    width: 100%;
    padding: 7px 30px 7px 10px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text-primary);
    font: inherit;
    outline: none;
  }

  .search input:focus {
    border-color: var(--accent);
  }

  .search kbd {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    padding: 0 5px;
    border-radius: 4px;
    border: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
    pointer-events: none;
  }

  #results {
    margin: 6px 0 0;
    padding: 4px;
    list-style: none;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  #results :global(button) {
    display: block;
    width: 100%;
    padding: 5px 8px;
    border: 0;
    border-radius: 5px;
    background: none;
    color: var(--text-primary);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  #results :global(button:hover),
  #results :global(button.active) {
    background: var(--surface);
  }

  #results :global(small) {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
  }

  #legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  #legend :global(button) {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px 2px 6px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: none;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
  }

  #legend :global(button[aria-pressed="false"]) {
    opacity: 0.4;
  }

  #legend :global(i) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }

  .hint {
    margin: 12px 0 8px;
    font-size: 11.5px;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    gap: 6px;
  }

  #path-info {
    margin: 10px 0 0;
    font-size: 11.5px;
    color: var(--text-secondary);
  }

  #path-info p {
    margin: 0;
  }

  #path-info :global(b) {
    color: var(--text-primary);
  }

  #path-info details {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 11.5px;
  }

  #path-info summary {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
  }

  #path-info details p {
    margin-top: 6px;
  }

  #longest[aria-pressed="true"] {
    color: var(--text-primary);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  #longest:disabled {
    opacity: 0.4;
    cursor: default;
  }

  #reset,
  #longest {
    padding: 4px 10px;
    border-radius: 7px;
    border: 1px solid var(--border-strong);
    background: none;
    color: var(--text-secondary);
    font: inherit;
    font-size: 11.5px;
    cursor: pointer;
  }

  #reset:hover,
  #longest:not(:disabled):hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  #tip {
    position: fixed;
    pointer-events: none;
    max-width: 300px;
    padding: 8px 11px;
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--tone, var(--border-strong));
    color: var(--text-secondary);
    font-size: 12px;
    line-height: 1.4;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
  }

  #tip :global(strong) {
    display: block;
    color: var(--tone, var(--text-primary));
    font-size: 13px;
  }

  #tip :global(small) {
    display: block;
    margin-top: 2px;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
  }

  #tip :global(p) {
    margin: 6px 0 0;
  }

  #tip :global(b) {
    margin-right: 6px;
    font-weight: 700;
    color: var(--text-primary);
  }
</style>

<script>
  import type { SiteGraphData } from "../utils/site-graph-data";
  import { track } from "../scripts/analytics";

  // Kind 0 joins consecutive notes of a module, kind 1 is a prerequisite
  type Link = [GNode, GNode, number];

  interface GNode {
    id: string;
    title: string;
    sem: number;
    module: string;
    group: string;
    x: number;
    y: number;
    r: number;
    delay: number;
    ins: GNode[];
    outs: GNode[];
  }

  interface Blob {
    members: GNode[];
    sem: number;
    label: string;
    x: number;
    y: number;
    r: number;
  }

  // All deterministic graph and layout data arrives from Astro frontmatter.
  // The client only revives object references for interaction and simulates it.
  const graphData = JSON.parse(
    document.getElementById("graph-data")!.textContent ?? "{}",
  ) as SiteGraphData;

  const canvas = document.getElementById("graph-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const tip = document.getElementById("tip")!;
  const legend = document.getElementById("legend")!;
  const input = document.getElementById("q") as HTMLInputElement;
  const results = document.getElementById("results")!;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---------------------------------------------------------------- hydrate
  const nodes: GNode[] = graphData.nodes.map(
    ({ incoming: _incoming, outgoing: _outgoing, ...node }) => ({
      ...node,
      ins: [],
      outs: [],
    }),
  );
  const byId = new Map(nodes.map((n) => [n.id, n]));
  const existingNode = (id: string): GNode | undefined => byId.get(id);
  const isNode = (node: GNode | undefined): node is GNode => node !== undefined;
  for (const serialized of graphData.nodes) {
    const node = byId.get(serialized.id)!;
    node.ins = serialized.incoming.map(existingNode).filter(isNode);
    node.outs = serialized.outgoing.map(existingNode).filter(isNode);
  }
  const links: Link[] = [];
  for (const e of graphData.edges) {
    const s = byId.get(e.from);
    const t = byId.get(e.to);
    if (!s || !t) continue;
    links.push([s, t, e.kind === "prereq" ? 1 : e.kind === "content" ? 2 : 0]);
  }

  // The entrance follows the study structure, not source-file order. Nodes at
  // the same depth arrive together, with content links held back for the end.
  const structuralIns = new Map(nodes.map((node) => [node, 0]));
  const waveDepth = new Map(nodes.map((node) => [node, 0]));
  for (const [from, to, kind] of links) {
    if (kind !== 2) structuralIns.set(to, structuralIns.get(to)! + 1);
  }
  const ready = nodes.filter((node) => structuralIns.get(node) === 0);
  for (let cursor = 0; cursor < ready.length; cursor++) {
    const node = ready[cursor];
    for (const [from, to, kind] of links) {
      if (from !== node || kind === 2) continue;
      waveDepth.set(to, Math.max(waveDepth.get(to)!, waveDepth.get(node)! + 1));
      const remaining = structuralIns.get(to)! - 1;
      structuralIns.set(to, remaining);
      if (remaining === 0) ready.push(to);
    }
  }
  // Cycles have no natural starting point. Keep them in the final structural
  // wave rather than making the entrance wait for an impossible prerequisite.
  const maximumWave = Math.max(...waveDepth.values(), 0);
  for (const node of nodes) {
    if ((structuralIns.get(node) ?? 0) > 0)
      waveDepth.set(node, maximumWave + 1);
  }
  const finalWave = Math.max(...waveDepth.values(), 0);
  const nodeRevealAt = new Map(
    nodes.map((node) => [
      node,
      300 +
        (waveDepth.get(node)! / Math.max(finalWave, 1)) * 560 +
        node.delay * 0.22,
    ]),
  );

  // Blob membership and labels are also prepared in the frontmatter.
  const blobs = new Map<string, Blob>(
    graphData.blobs.map((blob) => [
      blob.group,
      {
        ...blob,
        members: blob.members.map(existingNode).filter(isNode),
        x: 0,
        y: 0,
        r: 0,
      },
    ]),
  );
  const labelOrder = [...blobs.values()].sort(
    (a, b) => b.members.length - a.members.length,
  );
  const semBlobs = new Map<number, { x: number; y: number; n: number }>(
    graphData.semList.map((s) => [s, { x: 0, y: 0, n: 0 }]),
  );

  function measure() {
    for (const s of semBlobs.values()) s.x = s.y = s.n = 0;
    for (const b of blobs.values()) {
      let x = 0;
      let y = 0;
      for (const n of b.members) {
        x += n.x!;
        y += n.y!;
      }
      b.x = x / b.members.length;
      b.y = y / b.members.length;
      b.r = 0;
      for (const n of b.members) {
        b.r = Math.max(b.r, Math.hypot(n.x! - b.x, n.y! - b.y));
      }
      const s = semBlobs.get(b.sem)!;
      s.x += x;
      s.y += y;
      s.n += b.members.length;
    }
    for (const s of semBlobs.values()) {
      s.x /= s.n;
      s.y /= s.n;
    }
  }

  // ---------------------------------------------------------------- state
  let scale = 1;
  let ox = 0;
  let oy = 0;
  let dpr = 1;
  let hover: GNode | null = null;
  let pinned: GNode | null = null;
  const hiddenSems = new Set<number>();
  // The longest path, as the notes on it and the edges between them
  let showPath = false;
  let pathNodes = new Set<GNode>();
  let pathPairs = new Set<string>();
  let dirty = true;
  const t0 = performance.now();
  let introComplete = reduceMotion;

  const progress = (now: number, start: number, duration: number) =>
    introComplete ? 1 : Math.min(1, Math.max(0, (now - t0 - start) / duration));
  const finishIntro = () => {
    if (!introComplete) {
      introComplete = true;
      dirty = true;
    }
  };

  type View = { scale: number; ox: number; oy: number };
  let fly: { from: View; to: View; start: number } | null = null;

  function fitView(list: GNode[] = nodes): View {
    let minX = Infinity,
      minY = Infinity,
      maxX = -Infinity,
      maxY = -Infinity;
    for (const n of list) {
      minX = Math.min(minX, n.x!);
      maxX = Math.max(maxX, n.x!);
      minY = Math.min(minY, n.y!);
      maxY = Math.max(maxY, n.y!);
    }
    // Leave room above the top row for the group names
    minY -= 80;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    const sc = Math.min(w / (maxX - minX + 300), h / (maxY - minY + 300));
    return {
      scale: sc,
      ox: w / 2 - ((minX + maxX) / 2) * sc,
      oy: h / 2 - ((minY + maxY) / 2) * sc,
    };
  }

  function flyTo(to: View) {
    if (reduceMotion) {
      ({ scale, ox, oy } = to);
      dirty = true;
      return;
    }
    fly = { from: { scale, ox, oy }, to, start: performance.now() };
  }

  function focusOn(n: GNode) {
    // Aim right of the panel on wide screens so the note isn't hidden by it
    const w = canvas.clientWidth;
    const cx = w > 900 ? (w + 320) / 2 : w / 2;
    const sc = Math.max(scale, 1.8);
    flyTo({
      scale: sc,
      ox: cx - n.x! * sc,
      oy: canvas.clientHeight / 2 - n.y! * sc,
    });
  }

  function resize() {
    dpr = window.devicePixelRatio || 1;
    canvas.width = canvas.clientWidth * dpr;
    canvas.height = canvas.clientHeight * dpr;
    dirty = true;
  }

  // ---------------------------------------------------------------- theme
  let semColors: string[] = [];
  let semRgb: number[][] = [];
  let textPrimary = "";
  let textSecondary = "";
  let accent = "";
  let bgColor = "";
  const toRgb = (c: string) => {
    const m = /^#([0-9a-f]{6})$/i.exec(c.trim());
    if (!m) return [136, 136, 136];
    const v = parseInt(m[1], 16);
    return [v >> 16, (v >> 8) & 255, v & 255];
  };
  function readTheme() {
    const css = getComputedStyle(document.documentElement);
    const get = (name: string, fallback: string) =>
      css.getPropertyValue(name).trim() || fallback;
    semColors = Array.from({ length: 9 }, (_, i) =>
      i === 0 ? get("--text-muted", "#888") : get(`--s${i}`, "#888"),
    );
    semRgb = semColors.map(toRgb);
    textPrimary = get("--text-primary", "#fff");
    textSecondary = get("--text-secondary", "#aaa");
    accent = get("--accent", "#8aa0ff");
    bgColor = get("--bg", "#111");
    legend
      .querySelectorAll<HTMLElement>("i")
      .forEach((el) => (el.style.background = semColors[+el.dataset.sem!]));
    dirty = true;
  }
  legend.innerHTML = graphData.semList
    .map(
      (s) =>
        `<li><button type="button" data-sem="${s}" aria-pressed="true"><i data-sem="${s}"></i>${s ? `S${s}` : "General"}</button></li>`,
    )
    .join("");
  readTheme();
  new MutationObserver(readTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // ----------------------------------------------------------------- draw
  // easeOutBack, notes pop in with a small overshoot
  const ease = (x: number) => {
    const c = x - 1;
    return 1 + 2.7 * c * c * c + 1.7 * c * c;
  };
  const visible = (n: GNode) => !hiddenSems.has(n.sem);

  // Cross-module prerequisites bow sideways so they don't pile on one line
  function controlPoint(s: GNode, t: GNode): [number, number] {
    const mx = (s.x! + t.x!) / 2;
    const my = (s.y! + t.y!) / 2;
    return [mx - (t.y! - s.y!) * 0.16, my + (t.x! - s.x!) * 0.16];
  }

  function draw(now: number) {
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.translate(ox, oy);
    ctx.scale(scale, scale);
    measure();

    const focus = hover ?? pinned;
    const near = focus
      ? new Set<GNode>([focus, ...focus.ins, ...focus.outs])
      : showPath
        ? pathNodes
        : null;
    const dark = document.documentElement.dataset.theme === "dark";
    const haloProgress = progress(now, 0, 260);
    const labelProgress = progress(now, 110, 220);
    const structuralProgress = progress(now, 150, 360);
    const contentProgress = progress(now, 1_060, 220);

    // Semester names, huge and faint behind everything
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.font = `800 260px "Sagittaire Display", serif`;
    ctx.globalAlpha = haloProgress;
    for (const [sem, s] of semBlobs) {
      if (hiddenSems.has(sem)) continue;
      const [r, g, b] = semRgb[sem];
      ctx.fillStyle = `rgba(${r},${g},${b},${dark ? 0.08 : 0.1})`;
      ctx.fillText(sem ? `S${sem}` : "General", s.x, s.y);
    }

    // Soft halo per group
    ctx.globalAlpha = haloProgress;
    for (const b of blobs.values()) {
      if (hiddenSems.has(b.sem)) continue;
      const rad = b.r + 40;
      const [r, g, bl] = semRgb[b.sem];
      const grad = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, rad);
      grad.addColorStop(0, `rgba(${r},${g},${bl},${dark ? 0.16 : 0.14})`);
      grad.addColorStop(1, `rgba(${r},${g},${bl},0)`);
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(b.x, b.y, rad, 0, Math.PI * 2);
      ctx.fill();
    }

    // Arrowheads sit on the target node's rim, at a constant on-screen size
    const arrow = (fx: number, fy: number, t: GNode, size: number) => {
      const a = Math.atan2(t.y! - fy, t.x! - fx);
      const tx = t.x! - Math.cos(a) * (t.r + 1);
      const ty = t.y! - Math.sin(a) * (t.r + 1);
      ctx.moveTo(tx, ty);
      ctx.lineTo(tx - Math.cos(a - 0.4) * size, ty - Math.sin(a - 0.4) * size);
      ctx.lineTo(tx - Math.cos(a + 0.4) * size, ty - Math.sin(a + 0.4) * size);
      ctx.closePath();
    };
    const drawEdges = (
      pick: (l: Link) => boolean,
      drawArrowheads: (l: Link) => boolean = () => true,
      trace = 1,
    ) => {
      const size = 8 / scale;
      ctx.beginPath();
      for (const l of links) {
        if (!pick(l)) continue;
        const [s, t, kind] = l;
        ctx.moveTo(s.x!, s.y!);
        if (kind) {
          const [cx, cy] = controlPoint(s, t);
          if (trace < 1) {
            // de Casteljau split: trace a real portion of the curve rather
            // than fading in the finished edge all at once.
            const p01x = s.x! + (cx - s.x!) * trace;
            const p01y = s.y! + (cy - s.y!) * trace;
            const p12x = cx + (t.x! - cx) * trace;
            const p12y = cy + (t.y! - cy) * trace;
            ctx.quadraticCurveTo(
              p01x,
              p01y,
              p01x + (p12x - p01x) * trace,
              p01y + (p12y - p01y) * trace,
            );
          } else {
            ctx.quadraticCurveTo(cx, cy, t.x!, t.y!);
          }
        } else {
          ctx.lineTo(
            s.x! + (t.x! - s.x!) * trace,
            s.y! + (t.y! - s.y!) * trace,
          );
        }
      }
      ctx.stroke();
      if (trace < 0.98) return;
      ctx.beginPath();
      for (const l of links) {
        if (!pick(l) || !drawArrowheads(l)) continue;
        const [s, t, kind] = l;
        const [cx, cy] = kind ? controlPoint(s, t) : [s.x!, s.y!];
        arrow(cx, cy, t, size);
      }
      ctx.fill();
    };

    const shown = (l: Link) => visible(l[0]) && visible(l[1]);
    const touches = (l: Link) => l[0] === focus || l[1] === focus;
    ctx.strokeStyle = textPrimary;
    ctx.fillStyle = textPrimary;
    for (const kind of [0, 1, 2]) {
      const reveal = kind === 2 ? contentProgress : structuralProgress;
      if (reveal === 0) continue;
      ctx.lineWidth = (kind === 1 ? 1.2 : kind === 2 ? 0.9 : 1.1) / scale;
      ctx.globalAlpha =
        (near ? 0.04 : kind === 1 ? 0.16 : kind === 2 ? 0.1 : 0.24) * reveal;
      if (kind === 2) ctx.setLineDash([3 / scale, 5 / scale]);
      drawEdges(
        (l) => l[2] === kind && shown(l) && !touches(l),
        (l) => l[2] === 1,
        reveal,
      );
      ctx.setLineDash([]);
    }

    // Edges of the focused note, or of the longest path, flow along their direction
    const onPath = (l: Link) => pathPairs.has(`${l[0].id}>${l[1].id}`);
    const highlight = focus ? touches : showPath ? onPath : null;
    if (highlight) {
      ctx.globalAlpha = 1;
      ctx.strokeStyle = focus ? semColors[focus.sem] : accent;
      ctx.fillStyle = ctx.strokeStyle;
      ctx.lineWidth = (focus ? 3 : 3.5) / scale;
      if (!reduceMotion) {
        ctx.setLineDash([10 / scale, 7 / scale]);
        ctx.lineDashOffset = -(now * 0.03) / scale;
      }
      drawEdges(
        (l) => shown(l) && highlight(l),
        (l) => l[2] === 1,
      );
      ctx.setLineDash([]);
    }

    // Notes
    for (const n of nodes) {
      const lit = visible(n) && (!near || near.has(n));
      const pop = reduceMotion ? 1 : progress(now, nodeRevealAt.get(n)!, 330);
      if (pop <= 0) continue;
      const rad = n.r * ease(pop) * (n === focus ? 1.5 : 1);
      const [r, g, b] = semRgb[n.sem];
      ctx.globalAlpha = lit ? 1 : visible(n) ? 0.12 : 0.05;
      if (lit) {
        ctx.fillStyle = `rgba(${r},${g},${b},0.12)`;
        ctx.beginPath();
        ctx.arc(n.x!, n.y!, rad * 1.75, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = semColors[n.sem];
      ctx.beginPath();
      ctx.arc(n.x!, n.y!, rad, 0, Math.PI * 2);
      ctx.fill();
    }
    if (focus) {
      ctx.globalAlpha = 1;
      ctx.strokeStyle = textPrimary;
      ctx.lineWidth = 2 / scale;
      ctx.beginPath();
      ctx.arc(focus.x!, focus.y!, focus.r * 2, 0, Math.PI * 2);
      ctx.stroke();
    }

    // Group names, kept at a constant on-screen size. Bigger groups claim
    // their spot first and a name that would overlap one already drawn is skipped.
    ctx.globalAlpha = labelProgress;
    ctx.font = `700 ${11.5 / scale}px "DM Sans", sans-serif`;
    ctx.lineJoin = "round";
    ctx.lineWidth = 4 / scale;
    const focusBlob = focus ? blobs.get(focus.group) : null;
    const taken: [number, number, number, number][] = [];
    for (const b of labelOrder) {
      if (hiddenSems.has(b.sem)) continue;
      const mine = b === focusBlob;
      const tw = ctx.measureText(b.label).width;
      const th = 14 / scale;
      const y = b.y - b.r - 14 / scale;
      const box: [number, number, number, number] = [
        b.x - tw / 2 - 3 / scale,
        y - th / 2,
        b.x + tw / 2 + 3 / scale,
        y + th / 2,
      ];
      const clash = taken.some(
        (t) => box[0] < t[2] && box[2] > t[0] && box[1] < t[3] && box[3] > t[1],
      );
      if (clash && !mine) continue;
      taken.push(box);
      ctx.globalAlpha = labelProgress * (!focus || mine ? 1 : 0.25);
      ctx.strokeStyle = bgColor;
      ctx.strokeText(b.label, b.x, y);
      ctx.fillStyle = mine ? textPrimary : textSecondary;
      ctx.fillText(b.label, b.x, y);
    }
    ctx.globalAlpha = 1;
  }

  function frame(now: number) {
    if (fly) {
      const k = Math.min(1, (now - fly.start) / 700);
      const e = 1 - Math.pow(1 - k, 3);
      scale = fly.from.scale + (fly.to.scale - fly.from.scale) * e;
      ox = fly.from.ox + (fly.to.ox - fly.from.ox) * e;
      oy = fly.from.oy + (fly.to.oy - fly.from.oy) * e;
      if (k >= 1) fly = null;
      dirty = true;
    }
    // Keep redrawing while the intro plays or flowing edges animate
    if (!reduceMotion && (!introComplete || hover || pinned || showPath))
      dirty = true;
    if (dirty) {
      draw(now);
      dirty = false;
    }
    requestAnimationFrame(frame);
  }

  // ---------------------------------------------------------- interaction
  function pick(px: number, py: number): GNode | null {
    const wx = (px - ox) / scale;
    const wy = (py - oy) / scale;
    let best: GNode | null = null;
    let bestD = Infinity;
    for (const n of nodes) {
      if (!visible(n)) continue;
      const d = Math.hypot(n.x! - wx, n.y! - wy);
      if (d < Math.max(n.r * 1.3, 7 / scale) && d < bestD) {
        best = n;
        bestD = d;
      }
    }
    return best;
  }

  function showTip(n: GNode, e: PointerEvent) {
    tip.hidden = false;
    tip.style.setProperty("--tone", semColors[n.sem]);
    tip.replaceChildren();
    const title = document.createElement("strong");
    title.textContent = n.title;
    const slug = document.createElement("small");
    slug.textContent = n.id;
    tip.append(title, slug);
    const list = (label: string, arr: GNode[]) => {
      if (!arr.length) return;
      const p = document.createElement("p");
      const b = document.createElement("b");
      b.textContent = label;
      const more = arr.length > 3 ? ` +${arr.length - 3} more` : "";
      p.append(
        b,
        arr
          .slice(0, 3)
          .map((x) => x.title)
          .join(", ") + more,
      );
      tip.append(p);
    };
    list("Builds on", n.ins);
    list("Leads to", n.outs);
    tip.style.left = `${Math.min(e.clientX + 16, window.innerWidth - 320)}px`;
    tip.style.top = `${Math.min(e.clientY + 16, window.innerHeight - 140)}px`;
  }

  canvas.addEventListener(
    "wheel",
    (e) => {
      e.preventDefault();
      finishIntro();
      fly = null;
      const next = Math.min(
        12,
        Math.max(0.05, scale * Math.exp(-e.deltaY * 0.0015)),
      );
      const k = next / scale;
      ox = e.offsetX - (e.offsetX - ox) * k;
      oy = e.offsetY - (e.offsetY - oy) * k;
      scale = next;
      dirty = true;
    },
    { passive: false },
  );

  // Dragging the canvas pans the precomputed, static layout.
  let drag: {
    x: number;
    y: number;
    moved: boolean;
  } | null = null;
  canvas.addEventListener("pointerdown", (e) => {
    finishIntro();
    fly = null;
    drag = {
      x: e.clientX,
      y: e.clientY,
      moved: false,
    };
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener("pointermove", (e) => {
    finishIntro();
    if (drag) {
      const dx = e.clientX - drag.x;
      const dy = e.clientY - drag.y;
      if (Math.abs(dx) + Math.abs(dy) > 3) drag.moved = true;
      if (drag.moved) {
        tip.hidden = true;
        canvas.classList.add("dragging");
        ox += dx;
        oy += dy;
        drag.x = e.clientX;
        drag.y = e.clientY;
        dirty = true;
      }
      return;
    }
    const n = pick(e.offsetX, e.offsetY);
    if (n !== hover) {
      hover = n;
      dirty = true;
    }
    if (n) {
      showTip(n, e);
      canvas.style.cursor = "pointer";
    } else {
      tip.hidden = true;
      canvas.style.cursor = "";
    }
  });
  canvas.addEventListener("pointerup", (e) => {
    const wasClick = drag && !drag.moved;
    drag = null;
    canvas.classList.remove("dragging");
    if (wasClick) {
      const n = pick(e.offsetX, e.offsetY);
      if (n) {
        track("sitegraph_node_open", `/${n.id}`);
        window.location.href = `/${n.id}`;
      } else if (pinned) {
        pinned = null;
        dirty = true;
      }
    }
  });
  canvas.addEventListener("pointerleave", () => {
    hover = null;
    tip.hidden = true;
    dirty = true;
  });

  // Legend chips hide and show a semester
  legend.addEventListener("click", (e) => {
    finishIntro();
    const btn = (e.target as HTMLElement).closest<HTMLElement>("button");
    if (!btn) return;
    const sem = +btn.dataset.sem!;
    const off = hiddenSems.delete(sem) ? false : true;
    if (off) hiddenSems.add(sem);
    btn.setAttribute("aria-pressed", String(!off));
    track("sitegraph_semester_filter", { semester: sem, on: !off });
    dirty = true;
  });

  // Longest path: computed on the graph, then only highlighted here
  const longestBtn = document.getElementById("longest") as HTMLButtonElement;
  const pathInfo = document.getElementById("path-info")!;
  const longest = graphData.longestPath;
  if (!longest) longestBtn.disabled = true;
  function setPath(on: boolean) {
    showPath = on && !!longest;
    longestBtn.setAttribute("aria-pressed", String(showPath));
    pathInfo.hidden = !showPath;
    pathNodes = new Set();
    pathPairs = new Set();
    if (showPath && longest) {
      pinned = null;
      for (const sem of hiddenSems) hiddenSems.delete(sem);
      legend
        .querySelectorAll("button")
        .forEach((b) => b.setAttribute("aria-pressed", "true"));
      longest.forEach((id, i) => {
        pathNodes.add(byId.get(id)!);
        if (i) pathPairs.add(`${longest[i - 1]}>${id}`);
      });
      const first = byId.get(longest[0])!;
      const last = byId.get(longest[longest.length - 1])!;
      const summary = document.getElementById("path-summary")!;
      summary.replaceChildren();
      const b = document.createElement("b");
      b.textContent = `${longest.length - 1} steps`;
      summary.append(b, ` from ${first.title} to ${last.title}`);
      flyTo(fitView([...pathNodes]));
    } else {
      flyTo(fitView());
    }
    dirty = true;
  }
  longestBtn.addEventListener("click", () => {
    finishIntro();
    track("sitegraph_longest_path", { on: !showPath });
    setPath(!showPath);
  });

  document.getElementById("reset")!.addEventListener("click", () => {
    finishIntro();
    track("sitegraph_reset");
    if (showPath) setPath(false);
    pinned = null;
    input.value = "";
    results.hidden = true;
    flyTo(fitView());
  });

  // Search: type to find a note, pick one to fly to it
  let matches: GNode[] = [];
  let active = 0;
  function renderResults() {
    results.replaceChildren();
    results.hidden = matches.length === 0;
    matches.forEach((n, i) => {
      const li = document.createElement("li");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = i === active ? "active" : "";
      btn.textContent = n.title;
      const small = document.createElement("small");
      small.textContent = n.id;
      btn.append(small);
      btn.addEventListener("click", () => choose(n));
      li.append(btn);
      results.append(li);
    });
  }
  function choose(n: GNode) {
    finishIntro();
    track("sitegraph_search", { query: input.value.trim(), note: n.id });
    pinned = n;
    hiddenSems.delete(n.sem);
    legend
      .querySelector(`button[data-sem="${n.sem}"]`)
      ?.setAttribute("aria-pressed", "true");
    input.value = n.title;
    matches = [];
    renderResults();
    focusOn(n);
    dirty = true;
  }
  input.addEventListener("input", () => {
    finishIntro();
    const q = input.value.trim().toLowerCase();
    active = 0;
    if (!q) {
      matches = [];
    } else {
      const starts: GNode[] = [];
      const rest: GNode[] = [];
      for (const n of nodes) {
        const t = n.title.toLowerCase();
        if (t.startsWith(q)) starts.push(n);
        else if (t.includes(q) || n.id.includes(q)) rest.push(n);
      }
      matches = [...starts, ...rest].slice(0, 6);
    }
    renderResults();
  });
  input.addEventListener("keydown", (e) => {
    finishIntro();
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      if (!matches.length) return;
      const step = e.key === "ArrowDown" ? 1 : -1;
      active = (active + step + matches.length) % matches.length;
      renderResults();
    } else if (e.key === "Enter" && matches[active]) {
      choose(matches[active]);
    } else if (e.key === "Escape") {
      input.value = "";
      matches = [];
      pinned = null;
      renderResults();
      input.blur();
      dirty = true;
    }
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== input) {
      e.preventDefault();
      input.focus();
    }
  });

  window.addEventListener("resize", resize);
  resize();
  ({ scale, ox, oy } = fitView());
  requestAnimationFrame(frame);
</script>
