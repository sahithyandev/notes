    semester: 4,
    module: "Artificial Intelligence",
    preview:
      "Explore the basics of neural networks, including perceptrons, activation functions, backpropagation, and how these models mimic human learning processes.",
    lastUpdated: "1 week ago",
  },
  {
    title: "Database Normalization",
    semester: 3,
    module: "Database Systems",
    preview:
      "Understanding database normalization forms (1NF, 2NF, 3NF, BCNF) to eliminate data redundancy and improve data integrity in relational databases.",
    lastUpdated: "3 days ago",
  },
];

const popularNotes = [
  {
    title: "Time Complexity Analysis",
    semester: 3,
    module: "Algorithms",
    preview:
      "Master Big O notation and analyze algorithm efficiency. Learn to identify time and space complexity for common algorithms and data structures.",
    isPopular: true,
  },
  {
