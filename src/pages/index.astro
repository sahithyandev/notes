---
import Hero from "../components/hero.astro";
import Footer from "../components/footer.astro";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/nav.astro";
import SemesterCard from "../components/semester-card.astro";
import { getCollection } from "astro:content";
import { SITE_NAME, SITE_HOST_URL, SITE_DESCRIPTION } from "../utils/values";

interface SemesterInfo {
  number: number;
  modules: Array<string>;
  notesCount: number;
}

async function getSemestersData(): Promise<SemesterInfo[]> {
  const notes = await getCollection("notes");
  const semestersMap = new Map<
    number,
    { modules: Set<string>; notesCount: number }
  >();

  for (const note of notes) {
    // Extract semester and module from the slug
    // slug format: "theory-of-electricity/introduction" or "dimensions-and-units"
    const slugParts = note.data.slug.split("/");

    let semesterNumber: number;
    let moduleName: string;

    if (slugParts[0].match(/s(\d)/g)) {
      semesterNumber = parseInt(slugParts[0][1]);
      moduleName = slugParts[1];
    } else {
      semesterNumber = 0;
      moduleName = "General";
    }

    // Format module name (capitalize each word, replace hyphens with spaces)
    const formattedModuleName = moduleName
      .split("-")
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");

    // Initialize semester entry if it doesn't exist
    if (!semestersMap.has(semesterNumber)) {
      semestersMap.set(semesterNumber, {
        modules: new Set<string>(),
        notesCount: 0,
      });
    }

    const semesterData = semestersMap.get(semesterNumber)!;
    semesterData.modules.add(formattedModuleName);
    semesterData.notesCount++;
  }

  // Convert Map to array and sort by semester number
  const semestersData: SemesterInfo[] = Array.from(semestersMap.entries())
    .map(([number, data]) => ({
      number,
      modules: Array.from(data.modules),
      notesCount: data.notesCount,
    }))
    .sort((a, b) => a.number - b.number);

  return semestersData;
}

const semestersData: SemesterInfo[] = await getSemestersData();

async function getRecentNotes(count: number = 4) {
  const notes = await getCollection("notes");

  // Filter notes that have lastUpdatedOn and sort by most recent
  const notesWithDates = notes
    .filter((note) => note.data.lastUpdatedOn)
    .sort(
      (a, b) =>
        new Date(b.data.lastUpdatedOn!).getTime() -
        new Date(a.data.lastUpdatedOn!).getTime(),
    )
    .slice(0, count);

  return notesWithDates.map((note) => {
    // Extract semester and module from slug
    const slugParts = note.data.slug.split("/");

    let semesterNumber: number;
    let moduleName: string;

    if (slugParts[0].match(/s(\d)/g)) {
      semesterNumber = parseInt(slugParts[0][1]);
      moduleName = slugParts[1];
    } else {
      semesterNumber = 0;
      moduleName = "General";
    }

    // Format module name (capitalize each word, replace hyphens with spaces)
    const formattedModuleName = moduleName
      .split("-")
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(" ");

    // Generate preview from first paragraph of content
    const content = note.body || "";
    const firstParagraph = content
      .split("\n\n")[0]
      .replace(/[#*`]/g, "")
      .trim();
    const preview =
      firstParagraph.length > 150
        ? firstParagraph.substring(0, 150) + "..."
        : firstParagraph;

    // Format last updated date
    const lastUpdated = new Date(note.data.lastUpdatedOn!);
    const now = new Date();
    const diffTime = Math.abs(now.getTime() - lastUpdated.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    let lastUpdatedText: string;
    if (diffDays === 0) {
      lastUpdatedText = "today";
    } else if (diffDays === 1) {
      lastUpdatedText = "yesterday";
    } else if (diffDays < 7) {
      lastUpdatedText = `${diffDays} days ago`;
    } else if (diffDays < 30) {
      const weeks = Math.floor(diffDays / 7);
      lastUpdatedText = `${weeks} week${weeks > 1 ? "s" : ""} ago`;
    } else {
      const months = Math.floor(diffDays / 30);
      lastUpdatedText = `${months} month${months > 1 ? "s" : ""} ago`;
    }

    return {
      title: note.data.title,
      semester: semesterNumber,
      module: formattedModuleName,
      preview,
      lastUpdated: lastUpdatedText,
      slug: note.data.slug,
    };
  });
}

const recentNotes = await getRecentNotes();
---

<Layout
  title={SITE_NAME}
  description={SITE_DESCRIPTION}
  image={`${SITE_HOST_URL}/og/default`}
  canonical={SITE_HOST_URL}
  slug=""
>
  <Nav />
  <Hero semestersCount={semestersData.length} />

  <section id="semesters">
    <h2 class="section-title">All Semesters</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      {
        semestersData.map((semester) => (
          <SemesterCard
            href={`/s${semester.number}`}
            number={semester.number}
            subjects={semester.modules}
            notesCount={semester.notesCount.toString()}
          />
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="section-title">Recent Notes</h2>
    <div id="recent">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
        {
          recentNotes.map((note) => (
            <a href={`/notes/${note.slug}`} class="note-card">
              <div
                class="note-card-bar"
                style={`background:var(--s${note.semester})`}
              />
              <div class="note-card-inner">
                <div class="note-card-sem">
                  SEMESTER {note.semester} / {note.module.toUpperCase()}
                </div>
                <div class="note-card-title">{note.title}</div>
                <div class="note-card-foot">
                  <span class="note-card-meta">{note.lastUpdated}</span>
                  <span class="note-card-cta">Read &rarr;</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  section {
    width: var(--body-width);
    padding: 40px 0 24px;
    margin: 0 auto;
  }

  /* ── SECTION WRAPPER ──────────────────────────────────────────── */
  .section-counter {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .section-rule {
    width: 32px;
    height: 1px;
    background: var(--border-strong);
  }

  .section-title {
    margin-bottom: calc(8 * var(--spacing));
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--text-primary);
  }

  .section-sub {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .section-link {
    font-size: 12.5px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.1px;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .note-card {
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    display: flex;
    overflow: hidden;
    transition:
      border-color 0.14s,
      box-shadow 0.14s,
      transform 0.14s;
  }

  .note-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
  }

  .note-card-bar {
    width: 3px;
    flex-shrink: 0;
  }

  .note-card-inner {
    padding: 15px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .note-card-sem {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 6px;
    letter-spacing: 0.3px;
  }

  .note-card-title {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 12px;
    flex: 1;
    text-wrap: pretty;
    letter-spacing: -0.1px;
  }

  .note-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .note-card-meta {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .note-card-cta {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--accent);
  }

  [data-theme="dark"] .sem-card[data-s="1"]:hover {
    box-shadow: 0 8px 28px rgba(123, 146, 248, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="2"]:hover {
    box-shadow: 0 8px 28px rgba(168, 112, 224, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="3"]:hover {
    box-shadow: 0 8px 28px rgba(66, 196, 120, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="4"]:hover {
    box-shadow: 0 8px 28px rgba(216, 144, 64, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="5"]:hover {
    box-shadow: 0 8px 28px rgba(142, 126, 240, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="6"]:hover {
    box-shadow: 0 8px 28px rgba(208, 88, 136, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="7"]:hover {
    box-shadow: 0 8px 28px rgba(40, 180, 212, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="8"]:hover {
    box-shadow: 0 8px 28px rgba(208, 112, 64, 0.18);
  }

  [data-theme="dark"] .note-card:hover {
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
  }

  [data-theme="dark"] .note-nav-btn:hover {
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.3);
  }
</style>
