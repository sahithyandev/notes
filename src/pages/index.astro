    justify-content: space-between;
    align-items: center;
  }

  .note-card-meta {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .note-card-cta {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--accent);
  }

