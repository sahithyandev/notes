---

<Layout>
  <Nav />
  <Hero />

  <section>
    <h2 class="section-title">All Semesters</h2>

    <div class="sem-grid">
      {
        semestersData.map((semester) => (
          <SemesterCard
            number={semester.number}
            subjects={semester.modules}
            notesCount={semester.notesCount.toString()}
          />
        ))
      }
    </div>
  </section>

  <!-- RECENT NOTES -->
  <section>
    <div id="recent">
      <div class="section-hd">
        <div class="section-hd-left">
          <span class="section-counter">02 /</span>
          <div class="section-rule"></div>
          <h2 class="section-title">Recent Notes</h2>
        </div>
        <a href="#" class="section-link">View all →</a>
      </div>
      <div class="notes-grid">
        <a href="Short Notes.html" class="note-card">
          <div class="note-card-bar" style="background:var(--s3)"></div>
          <div class="note-card-inner">
