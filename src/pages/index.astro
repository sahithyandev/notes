    border-color: var(--border-strong);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
  }

  .note-card-bar {
    width: 3px;
    flex-shrink: 0;
  }

  .note-card-inner {
    padding: 15px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .note-card-sem {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 6px;
    letter-spacing: 0.3px;
