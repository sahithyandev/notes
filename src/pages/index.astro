  <script>
    const nav = document.querySelector(".nav");
    window.addEventListener(
      "scroll",
      () => {
        nav.style.background =
          window.scrollY > 40 ? "rgba(9,10,18,0.94)" : "rgba(9,10,18,0.78)";
      },
      { passive: true },
    );

    // Theme toggle
    const html = document.documentElement;
    const toggle = document.getElementById("themeToggle");
    const iconSun = document.getElementById("iconSun");
    const iconMoon = document.getElementById("iconMoon");

    const saved = localStorage.getItem("sn-theme");
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)",
    ).matches;
    const isDark = saved ? saved === "dark" : prefersDark;

    function applyTheme(isDarkMode: boolean) {
      html.setAttribute("data-theme", isDarkMode ? "dark" : "light");
      iconSun.style.display = isDarkMode ? "block" : "none";
      iconMoon.style.display = isDarkMode ? "none" : "block";
      localStorage.setItem("sn-theme", isDarkMode ? "dark" : "light");
    }
    applyTheme(isDark);
    toggle.addEventListener("click", () =>
      applyTheme(html.dataset.theme !== "dark"),
    );
  </script>
</Layout>

<style>
  :root {
    --font-ui: "Manrope", sans-serif;
    --font-mono: "JetBrains Mono", monospace;

    --bg: #f4f3f0;
    --surface: #ffffff;
    --surface-2: #eeede9;
    --border: #e0deda;
    --border-strong: #bfbeba;

    --text-primary: #0e0f14;
    --text-secondary: #4c4c5e;
    --text-muted: #96969e;

    --accent: #3348c8;
    --accent-subtle: #ebedfa;
    --accent-hover: #2a3aad;

    /* Per-semester accents — desaturated, professional */
    --s1: #3348c8;
    --s1-bg: #ebedfa;
    --s1-border: #bdc5ef;
    --s2: #6b38a0;
    --s2-bg: #f1ebf8;
    --s2-border: #cdb8e4;
    --s3: #1a7a4a;
    --s3-bg: #e8f3ed;
    --s3-border: #a8cebc;
    --s4: #8a5a18;
    --s4-bg: #f5efe3;
    --s4-border: #d4b888;
    --s5: #4f3ac0;
    --s5-bg: #ededfa;
    --s5-border: #bab4ec;
    --s6: #a0245a;
    --s6-bg: #faebf2;
    --s6-border: #e4b0c8;
    --s7: #0e7a96;
    --s7-bg: #e4f2f6;
    --s7-border: #98ccd9;
    --s8: #944018;
    --s8-bg: #f6ede7;
    --s8-border: #d9aa90;
  }

  html {
    font-family: var(--font-ui);
    color: var(--text-primary);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }

