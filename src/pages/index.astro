            </div>
            <div class="note-card-foot">
              <span class="note-card-meta">8pp · 3d ago</span>
              <span class="note-card-cta">Read →</span>
            </div>
          </div>
        </a>

        <a href="#" class="note-card">
          <div class="note-card-bar" style="background:var(--s4)"></div>
          <div class="note-card-inner">
            <div class="note-card-sem">SEMESTER 4 / ALGORITHM ANALYSIS</div>
            <div class="note-card-title">
              Dynamic Programming — Memoization vs Tabulation
            </div>
            <div class="note-card-foot">
              <span class="note-card-meta">15pp · 5d ago</span>
              <span class="note-card-cta">Read →</span>
            </div>
          </div>
