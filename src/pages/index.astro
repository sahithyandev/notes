  .section-hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .section-hd-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .section-counter {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .section-rule {
    width: 32px;
    height: 1px;
    background: var(--border-strong);
  }

  .section-title {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--text-primary);
  }

  .section-sub {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .section-link {
    font-size: 12.5px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.1px;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .page-rule {
    height: 1px;
    background: var(--border);
    margin: 0 36px;
  }

  /* ── SEMESTER GRID ────────────────────────────────────────────── */
  .sem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  /* ── RECENT NOTES ─────────────────────────────────────────────── */
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .note-card {
    border-radius: 9px;
