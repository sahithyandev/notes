</Layout>

<style>
  section {
    padding: 64px 36px;
    max-width: 1272px;
    margin: 0 auto;
  }

  /* ── SECTION WRAPPER ──────────────────────────────────────────── */
  .section-counter {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.5px;
  }

  .section-rule {
    width: 32px;
    height: 1px;
    background: var(--border-strong);
  }

  .section-title {
    margin-bottom: calc(8 * var(--spacing));
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--text-primary);
  }

  .section-sub {
    font-size: 12.5px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .section-link {
    font-size: 12.5px;
    color: var(--accent);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.1px;
  }

  .section-link:hover {
    text-decoration: underline;
  }

  .page-rule {
    height: 1px;
    background: var(--border);
    margin: 0 36px;
  }

  /* ── SEMESTER GRID ────────────────────────────────────────────── */
  .sem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  /* ── RECENT NOTES ─────────────────────────────────────────────── */
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .note-card {
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    display: flex;
    overflow: hidden;
    transition:
      border-color 0.14s,
      box-shadow 0.14s,
      transform 0.14s;
  }

  .note-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
  }

  .note-card-bar {
    width: 3px;
    flex-shrink: 0;
  }

  .note-card-inner {
    padding: 15px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .note-card-sem {
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 6px;
    letter-spacing: 0.3px;
  }

  .note-card-title {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 12px;
    flex: 1;
    text-wrap: pretty;
    letter-spacing: -0.1px;
  }

  .note-card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .note-card-meta {
    font-size: 11px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .note-card-cta {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--accent);
  }

  [data-theme="dark"] .sem-card[data-s="1"]:hover {
    box-shadow: 0 8px 28px rgba(123, 146, 248, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="2"]:hover {
    box-shadow: 0 8px 28px rgba(168, 112, 224, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="3"]:hover {
    box-shadow: 0 8px 28px rgba(66, 196, 120, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="4"]:hover {
    box-shadow: 0 8px 28px rgba(216, 144, 64, 0.18);
  }

  [data-theme="dark"] .sem-card[data-s="5"]:hover {
    box-shadow: 0 8px 28px rgba(142, 126, 240, 0.18);
