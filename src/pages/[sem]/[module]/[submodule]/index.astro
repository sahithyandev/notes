---
import { ModuleRedirectsScanner } from "../../../../integrations/module-redirects/scan";
import { getModuleRedirectsScanner } from "../../../../integrations/module-redirects/scanner-cache";

// Keep this route limited to the paths returned by getStaticPaths in dev too.
// Otherwise SSR makes [submodule] outrank [...slug] for every three-segment URL.
export const prerender = true;

export function getStaticPaths() {
  const redirects = new ModuleRedirectsScanner().current;
  return Object.entries(redirects).flatMap(([from, to]) => {
    const parts = from.slice(1).split("/");
    if (parts.length !== 3) return [];
    const [sem, module, submodule] = parts;
    return [{ params: { sem, module, submodule }, props: { to } }];
  });
}

const from = `/${Astro.params.sem}/${Astro.params.module}/${Astro.params.submodule}`;
const to = import.meta.env.PROD
  ? Astro.props.to
  : getModuleRedirectsScanner().current[from];

if (!to) return new Response(null, { status: 404 });

return Astro.redirect(to);
---
