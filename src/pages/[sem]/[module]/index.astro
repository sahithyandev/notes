---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  const byModule = new Map<
    string,
    { sem: string; module: string; slug: string; order: number }[]
  >();

  for (const note of notes) {
    const parts = note.data.slug.split("/");
    if (parts.length < 3) continue;
    if (!/^s\d$/.test(parts[0])) continue;
    const sem = parts[0];
    const module = parts[1];
    const key = `${sem}/${module}`;
    if (!byModule.has(key)) byModule.set(key, []);
    byModule.get(key)!.push({
      sem,
      module,
      slug: note.data.slug,
      order: note.data.sidebar?.order ?? 999,
    });
  }

  return Array.from(byModule.values()).map((list) => {
    const first = [...list].sort((a, b) => a.order - b.order)[0];
    return {
      params: { sem: first.sem, module: first.module },
      props: { target: `/${first.slug}` },
    };
  });
}

const { target } = Astro.props;
return Astro.redirect(target);
---
