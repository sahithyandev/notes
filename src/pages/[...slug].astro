  /* Diagonal connector between levels — bridges the 10px horizontal
     gap between the h2 column (left:5) and the h3 column (left:15). */
  .toc-trail-segment[data-depth="2"] + .toc-trail-segment[data-depth="3"]::before,
  .toc-trail-segment[data-depth="3"] + .toc-trail-segment[data-depth="2"]::before {
    border-radius: 1px;
    content: "";
    position: absolute;
    width: 15.9px; /* sqrt(10² + 10²) */
    height: 2px;
    background: var(--border);
    transform-origin: left center;
  }

  /* h2 above → h3 below: ::before on h3, bridges from h2 bottom-center to h3 top-center */
  .toc-trail-segment[data-depth="2"] + .toc-trail-segment[data-depth="3"]::before {
    left: -9.6px;
