---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import Nav from "../components/Nav.astro";
import Breadcrumb from "../components/breadcrumb.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { slug } = Astro.params;
const notesEntry = await getEntry("notes", slug);
const slugParts = slug.split("/");

if (!notesEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const { Content, headings } = await render(notesEntry);

// Helper functions to generate sidebar data
function getSemesterInfo(slugParts: string[]) {
  if (slugParts[0] === "s1") {
    return {
      label: "Semester 1",
      color: "#1a7a4a",
    };
  } else if (slugParts[0] === "s2") {
    return {
      label: "Semester 2",
      color: "#1a7a4a",
    };
  }
  return {
    label: "Unknown",
    color: "#1a7a4a",
  };
}

async function getSidebarData(currentSlug: string) {
  const allNotes = await getCollection("notes");
  const currentSlugParts = currentSlug.split("/");
  const currentSemester = currentSlugParts[0];
  const currentSubject = currentSlugParts[1];

  // Group notes by semester and subject
  const grouped: Record<string, Record<string, any[]>> = {};

  allNotes.forEach((note) => {
    const parts = note.data.slug.split("/");
    const sem = parts[0];
    const subj = parts[1];

    if (!grouped[sem]) grouped[sem] = {};
    if (!grouped[sem][subj]) grouped[sem][subj] = [];

    grouped[sem][subj].push({
      slug: note.data.slug,
      title: note.data.title,
      label: note.data.sidebar?.label || note.data.title,
      order: note.data.sidebar?.order || 999,
    });
  });

  // Sort each subject's notes by order
  Object.keys(grouped).forEach((sem) => {
    Object.keys(grouped[sem]).forEach((subj) => {
      grouped[sem][subj].sort((a, b) => a.order - b.order);
    });
  });

  return {
    currentSemester,
    currentSubject,
    grouped,
    currentNotes: grouped[currentSemester]?.[currentSubject] || [],
  };
}

const sidebarData = await getSidebarData(slug);

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<Layout>
  <Nav />

  <main class="grid grid-cols-[auto_1fr_auto] gap-x-5">
    <aside class="sidebar">
      <div class="sb-sem">
        <div class="sb-sem-pip"></div>
        <div class="sb-sem-info">
          <span class="sb-sem-name">{getSemesterInfo(slugParts).label}</span>
        </div>
      </div>

      <div class="sb-group-title">Subjects</div>
      {
        Object.entries(
          sidebarData.grouped[sidebarData.currentSemester] || {},
        ).map(([subject, notes]) => (
          <a
            href={`/${subject}`}
            class={`sb-item ${subject === sidebarData.currentSubject ? "active" : ""}`}
          >
            {subject
              .replace(/-/g, " ")
              .replace(/\b\w/g, (l) => l.toUpperCase())}
            <span class="sb-item-count">{notes.length}</span>
          </a>
        ))
      }

      {
        sidebarData.currentNotes.length > 0 && (
          <>
            <div class="sb-rule" />
            <div class="sb-group-title">
              {sidebarData.currentSubject
                .replace(/-/g, " ")
                .replace(/\b\w/g, (l) => l.toUpperCase())}
            </div>
            {sidebarData.currentNotes.map((note) => (
              <a
                href={`/${note.slug}`}
                class={`sb-item sb-item-sub ${note.slug === slug ? "active" : ""}`}
              >
                {note.label}
              </a>
            ))}
          </>
        )
      }
    </aside>

    <article>
      <Breadcrumb slug={slug} />
      <h1 class="note-title">
        {notesEntry.data.title}
      </h1>
      <Content />
    </article>

    {
      tocHeadings.length > 0 && (
        <aside class="toc-rail">
          <div class="toc-title">On this page</div>
          {tocHeadings.map((heading, index) => (
            <a
              href={`#${heading.slug}`}
              class={`toc-item ${heading.depth === 3 ? "toc-sub" : ""} ${index === 0 ? "active" : ""}`}
            >
              {heading.text}
            </a>
          ))}
          {tocHeadings.length > 5 && <div class="toc-rule" />}
        </aside>
      )
    }
  </main>

  <script>
    // Theme toggle
    const html = document.documentElement;
    const toggle = document.getElementById("themeToggle");
    const iconSun = document.getElementById("iconSun");
    const iconMoon = document.getElementById("iconMoon");
    const saved = localStorage.getItem("sn-theme");
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)",
    ).matches;
    function applyTheme(dark) {
      html.setAttribute("data-theme", dark ? "dark" : "light");
      iconSun.style.display = dark ? "block" : "none";
      iconMoon.style.display = dark ? "none" : "block";
      localStorage.setItem("sn-theme", dark ? "dark" : "light");
    }
    applyTheme(saved ? saved === "dark" : prefersDark);
    toggle.addEventListener("click", () =>
      applyTheme(html.dataset.theme !== "dark"),
    );

    // TOC active state on scroll
    const headings = [...document.querySelectorAll(".prose h2, .prose h3")];
    const tocLinks = [...document.querySelectorAll(".toc-item")];

    if (headings.length > 0 && tocLinks.length > 0) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const i = headings.indexOf(e.target);
            if (i < 0) return;
            tocLinks.forEach((t) => t.classList.remove("active"));
            if (tocLinks[i]) tocLinks[i].classList.add("active");
          });
        },
        { rootMargin: "-10% 0px -75% 0px" },
      );
      headings.forEach((h) => obs.observe(h));

      // Smooth scroll for TOC links
      tocLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const href = link.getAttribute("href");
          if (href) {
            const targetId = href.substring(1);
            const targetElement = document.getElementById(targetId);
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            }
          }
        });
      });
    }
  </script>
</Layout>

<style>
  :root {
    --sidebar-w: 260px;
    --toc-w: 200px;
  }

  article {
    padding-top: 1rem;
  }

  article {
    font-family: var(--font-body);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--text-secondary);

    h2 {
      font-family: var(--font-ui);
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.4px;
      color: var(--text-primary);
      margin: 44px 0 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h2:first-child {
      margin-top: 0;
    }

    h3 {
      font-family: var(--font-ui);
      font-size: 14.5px;
      font-weight: 700;
      letter-spacing: -0.1px;
      color: var(--text-primary);
      margin: 30px 0 10px;
    }

    p {
      margin-bottom: 16px;
      text-wrap: pretty;
    }

    ul {
      list-style: none;
      padding: 0;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    ul li {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }

    ul li::before {
      content: "";
      flex-shrink: 0;
      width: 5px;
      height: 5px;
      border-radius: 2.5px;
      background: var(--sem);
      margin-top: 0.62em;
    }

    ol {
      padding-left: 22px;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    strong {
      font-weight: 700;
      color: var(--text-primary);
    }

    em {
      font-style: italic;
    }

    /* Inline code */
    code {
      font-family: var(--font-mono);
      font-size: 13px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      padding: 1px 6px;
      border-radius: 4px;
      color: var(--text-primary);
      font-weight: 400;
    }

    /* Code block */
    pre {
      background: #0c0e18;
      border-radius: 9px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 20px 22px;
      margin: 20px 0;
      overflow-x: auto;
      position: relative;
    }

    pre code {
      background: none;
      border: none;
      padding: 0;
      font-size: 13px;
      line-height: 1.7;
      color: #b0bdd8;
      font-weight: 400;
    }

    pre .kw {
      color: #7f98f8;
    }

    pre .fn {
      color: #6fcfb0;
    }

    pre .str {
      color: #98cc98;
    }

    pre .cm {
      color: #4a5a72;
      font-style: italic;
    }

    pre .num {
      color: #e8c870;
    }

    pre .tp {
      color: #c0a8e8;
    }

    /* Language label */
    pre::before {
      content: attr(data-lang);
      position: absolute;
      top: 10px;
      right: 14px;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.18);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    /* Callout */
    .callout {
      border-radius: 0 8px 8px 0;
      border: 1px solid var(--sem-border);
      border-left: 3px solid var(--sem);
      background: var(--sem-bg);
      padding: 14px 18px;
      margin: 20px 0;
      font-size: 14.5px;
      color: var(--sem-text);
      line-height: 1.6;
    }

    .callout-title {
      font-family: var(--font-ui);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: var(--sem);
      margin-bottom: 5px;
      display: block;
    }

    .callout p {
      margin: 0;
      font-family: var(--font-body);
      color: var(--sem-text);
    }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
      margin: 20px 0;
      font-family: var(--font-ui);
    }

    thead tr {
      border-bottom: 2px solid var(--border-strong);
    }

    th {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.5px;
      padding: 8px 14px;
      text-align: left;
      text-transform: uppercase;
    }

    td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      color: var(--text-secondary);
      vertical-align: top;
      line-height: 1.45;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Key term highlight */
    .term {
      background: var(--accent-dim);
      color: var(--accent);
      border-radius: 3px;
      padding: 0 5px;
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: 0.95em;
    }
  }

  /* ── LEFT SIDEBAR ─────────────────────────────────────────────── */
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 0 0 32px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .sidebar::-webkit-scrollbar {
    width: 3px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 2px;
  }

  /* Semester band at top of sidebar */
  .sb-sem {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sb-sem-pip {
    width: 3px;
    height: 28px;
    border-radius: 2px;
    background: var(--sem);
    flex-shrink: 0;
  }

  .sb-sem-info {
  }

  .sb-sem-label {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .sb-sem-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.2px;
  }

  .sb-group-title {
    padding: 10px 16px 4px;
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .sb-item {
    display: flex;
    align-items: center;
    padding: 5px 16px;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition:
      background 0.1s,
      color 0.1s,
      border-color 0.1s;
    line-height: 1.35;
  }

  .sb-item:hover {
    background: var(--surface-2);
    color: var(--text-primary);
  }

  .sb-item.active {
    background: var(--sem-dim);
    color: var(--sem);
    border-left-color: var(--sem);
    font-weight: 700;
  }

  .sb-item-sub {
    padding-left: 28px;
    font-size: 12px;
  }

  .sb-item-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-muted);
  }

  .sb-rule {
    height: 1px;
    background: var(--border);
    margin: 8px 0;
  }

  /* ── MAIN ─────────────────────────────────────────────────────── */
  .main {
    flex: 1;
    min-width: 0;
  }

  .content {
    max-width: 724px;
    margin: 0 auto;
    padding: 40px 48px 96px;
  }

  /* Note header */
  .note-hd {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .note-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--sem-bg);
    border: 1px solid var(--sem-border);
    color: var(--sem-text);
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 16px;
    font-family: var(--font-ui);
  }

  .note-tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background: var(--sem);
  }

  .note-title {
    font-family: var(--font-ui);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.08;
    color: var(--text-primary);
    margin-bottom: 14px;
    text-wrap: pretty;
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 0;
    font-size: 12px;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .note-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .note-meta-sep {
    margin: 0 10px;
    opacity: 0.4;
  }

  /* ── TOC RAIL ─────────────────────────────────────────────────── */
  .toc-rail {
    width: var(--toc-w);
    flex-shrink: 0;
    position: sticky;
    top: var(--nav-h);
    height: calc(100vh - var(--nav-h));
    overflow-y: auto;
    padding: 32px 16px 32px 0;
    border-left: 1px solid var(--border);
    scrollbar-width: none;
  }

  .toc-title {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 10px;
    padding-left: 14px;
  }

  .toc-item {
    display: block;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition:
      color 0.12s,
      border-color 0.12s;
    line-height: 1.4;
  }

  .toc-item:hover {
    color: var(--text-secondary);
  }

  .toc-item.active {
    color: var(--sem);
    border-left-color: var(--sem);
    font-weight: 700;
  }

  .toc-sub {
    padding-left: 24px;
    font-size: 11.5px;
  }

  .toc-rule {
    height: 1px;
    background: var(--border);
    margin: 10px 14px;
  }

  /* ── PREV / NEXT ──────────────────────────────────────────────── */
  .note-nav {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding-top: 36px;
    margin-top: 48px;
    border-top: 1px solid var(--border);
  }

  .note-nav-btn {
    flex: 1;
    max-width: 290px;
    padding: 14px 18px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.14s,
      box-shadow 0.14s,
      transform 0.12s;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .note-nav-btn:hover {
    border-color: var(--border-strong);
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.07);
    transform: translateY(-1px);
  }

  .note-nav-dir {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }

  .note-nav-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    letter-spacing: -0.1px;
  }

  .note-nav-btn.right {
    text-align: right;
  }

  /* ── DARK MODE ────────────────────────────────────────────────── */
  [data-theme="dark"] {
    --bg: #0d0e18;
    --surface: #13151f;
    --surface-2: #1b1d2b;
    --border: #252738;
    --border-strong: #363a52;

    --text-primary: #e8eaf5;
    --text-secondary: #9298b8;
    --text-muted: #555878;

    --accent: #6b82f0;
    --accent-dim: rgba(107, 130, 240, 0.12);

    --sem: #42c478;
    --sem-bg: #0c1d14;
    --sem-border: #153228;
    --sem-dim: rgba(66, 196, 120, 0.08);
    --sem-text: #7adfa8;
  }

  [data-theme="dark"] .prose pre {
    background: #090b14;
    border-color: rgba(255, 255, 255, 0.08);
  }

  [data-theme="dark"] .note-nav-btn:hover {
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.35);
  }

  [data-theme="dark"] .callout {
    background: var(--sem-bg);
    border-color: var(--sem-border);
    border-left-color: var(--sem);
  }

  /* Theme toggle */
  .theme-toggle {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.55);
    transition:
      background 0.12s,
      color 0.12s;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.11);
    color: rgba(255, 255, 255, 0.9);
  }
</style>
