---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getEntry, getEntries } from "astro:content";
import Nav from "../components/nav.astro";
import Breadcrumb from "../components/breadcrumb.astro";
import { SITE_NAME, SITE_HOST_URL, isWip } from "../utils/values";
import Note from "../components/note.astro";
import WalksVennDiagram from "../components/walks-venn-diagram.astro";
import TreePropertiesProofs from "../components/illustrations/tree-properties-proofs.astro";
import SimplexWalkthrough from "../components/illustrations/simplex-walkthrough.astro";
import SimplexStep from "../components/illustrations/simplex-step.astro";
import SequenceDiagram from "../components/illustrations/sequence-diagram.astro";
import FlowDiagram from "../components/illustrations/flow-diagram.astro";
import RgbCmykConverter from "../components/illustrations/rgb-cmyk-converter.astro";
import ComplexLogExplorer from "../components/illustrations/complex-log-explorer.astro";
import SensitivityRhsSlider from "../components/illustrations/sensitivity-rhs-slider.astro";
import SensitivityCostSlider from "../components/illustrations/sensitivity-cost-slider.astro";
import SensitivityCostRowOp from "../components/illustrations/sensitivity-cost-row-op.astro";
import SensitivityNewVariableSlider from "../components/illustrations/sensitivity-new-variable-slider.astro";
import SensitivityNewConstraintSlider from "../components/illustrations/sensitivity-new-constraint-slider.astro";
import BranchAndBoundTree from "../components/illustrations/branch-and-bound-tree.astro";
import TransportationTable from "../components/illustrations/transportation-table.astro";
import TransportationStep from "../components/illustrations/transportation-step.astro";
import TransportationWalkthrough from "../components/illustrations/transportation-walkthrough.astro";
import TocRail from "../components/toc-rail.astro";
import NoteFeedback from "../components/note-feedback.astro";
import NoteAuthors from "../components/note-authors.astro";
import RightSidebar from "../components/right-sidebar.astro";
import Article from "../components/article.astro";
import ScrollableTable from "../components/scrollable-table.astro";
import Prereqs from "../components/prereqs.astro";
import Packet from "../components/packet.astro";
import PermutationTable from "../components/permutation-table.astro";
import RotationSchedule from "../components/rotation-schedule.astro";
import AiLinks from "../components/ai-links.astro";
import MenuIcon from "../components/icons/MenuIcon.astro";
import TocIcon from "../components/icons/TocIcon.astro";
import NoteNav from "../components/note-nav.astro";
import { getSidebarData } from "../lib/sidebar";
import NoteSidebar from "../components/note-sidebar.astro";
import ImageZoom from "../components/image-zoom.astro";
import {
  titleize,
  calculateReadTime,
  calculateWordCount,
  generateDescription,
} from "../utils";

export const prerender = true;

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({ params: { slug: note.data.slug } }));
}

const { slug } = Astro.params;

if (slug === undefined) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const notesEntry = await getEntry("notes", slug);
const slugParts = slug.split("/");

if (!notesEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const { Content, headings, remarkPluginFrontmatter } = await render(notesEntry);
// Astro derives heading.text from rendered HTML, which mangles KaTeX
// headings (see remarkKatexMhchem in astro.config.mjs); use the real
// rendered heading markup instead, so the TOC shows properly typeset math.
const headingHtml = remarkPluginFrontmatter?.headingHtml as
  | string[]
  | undefined;
const cleanHeadings = headings.map((heading, i) => ({
  ...heading,
  html: headingHtml?.[i] ?? heading.text,
}));
const prereqEntries = notesEntry.data.prereqs
  ? (
      await Promise.all(
        notesEntry.data.prereqs.map(async (s) => {
          const entry = await getEntry(
            "notes",
            s.includes("#") ? s.slice(0, s.indexOf("#")) : s,
          );
          if (!entry) return null;
          return {
            entry,
            slug: s,
          };
        }),
      )
    ).filter((e): e is NonNullable<typeof e> => !!e)
  : [];

const authorEntries = await getEntries(notesEntry.data.authors);

const sidebarData = await getSidebarData(slug);
const wip = isWip(slug);

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = cleanHeadings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

// Pass raw ISO date for client-side calculation
const lastUpdatedIso = notesEntry.data.lastUpdatedOn;

const wordCount = calculateWordCount(notesEntry.body || "");
const description = generateDescription(notesEntry.body || "");

const topic = notesEntry.data.title;
const sectionLabel = slugParts.length >= 2 ? titleize(slugParts[1]) : null;
---

<Layout
  title={`${notesEntry.data.title} | ${SITE_NAME}`}
  description={description}
  image={`${SITE_HOST_URL}/og/${slug}.jpg`}
  canonical={`${SITE_HOST_URL}/${slug}`}
  slug={slug}
  authors={authorEntries.map((author) => ({
    name: author.data.name,
    url: author.data.url,
  }))}
  datePublished={notesEntry.data.dateCreated}
  dateModified={notesEntry.data.lastUpdatedOn}
>
  <Nav>
    <button
      slot="nav-start"
      class="nav-drawer-btn"
      id="open-sidebar"
      type="button"
      aria-label="Open contents"
    >
      <MenuIcon />
    </button>
    {
      tocHeadings.length > 0 && (
        <button
          slot="nav-end"
          class="nav-drawer-btn"
          id="open-toc"
          type="button"
          aria-label="Open table of contents"
        >
          <TocIcon />
        </button>
      )
    }
  </Nav>
  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
  <main
    data-pagefind-body
    class="grid grid-cols-[auto_1fr_auto]"
    style={`--sem: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-bg: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --sem-border: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-border); --sem-text: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-dim: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --link: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"});`}
  >
    <NoteSidebar sidebarData={sidebarData} slug={slug} slugParts={slugParts} />

    <section>
      <Breadcrumb slug={slug} title={notesEntry.data.title} />
      <h1 class="note-title">
        {notesEntry.data.title}
      </h1>

      {
        wip && (
          <p class="wip-banner" role="note">
            <span class="wip-dot" aria-hidden="true" />
            Work in progress. This note is still being written and incomplete.
          </p>
        )
      }

      <div class="note-meta">
        <AiLinks slug={slug} topic={topic} sectionLabel={sectionLabel} />
      </div>

      <Prereqs entries={prereqEntries} />

      <Article>
        <Content
          components={{
            Note,
            WalksVennDiagram,
            TreePropertiesProofs,
            SimplexWalkthrough,
            SimplexStep,
            Packet,
            SequenceDiagram,
            FlowDiagram,
            PermutationTable,
            RotationSchedule,
            RgbCmykConverter,
            ComplexLogExplorer,
            SensitivityRhsSlider,
            SensitivityCostSlider,
            SensitivityCostRowOp,
            SensitivityNewVariableSlider,
            SensitivityNewConstraintSlider,
            BranchAndBoundTree,
            TransportationTable,
            TransportationStep,
            TransportationWalkthrough,
            table: ScrollableTable,
          }}
        />
      </Article>

      <NoteAuthors
        authors={authorEntries}
        lastUpdatedOn={lastUpdatedIso}
        wordCount={wordCount}
      />

      <NoteFeedback slug={slug} />

      <NoteNav
        prevNote={sidebarData.prevNote}
        nextNote={sidebarData.nextNote}
      />
    </section>

    <RightSidebar>
      <TocRail headings={tocHeadings} />
      <!-- TODO: if the current slug starts with s4/theory-of-computing,
       add link to https://sahithyan.dev/tools/regex-compiler. It is a Regex to Automaton converter and visualizer tool that I made.
       It will help with understanding the logic behind the conversion. -->
    </RightSidebar>
  </main>

  <script>
    import "../scripts/drawers";
  </script>
  <script>
    import "../scripts/relative-time";
  </script>
  <script define:vars={{ slug, slugParts }} is:inline>
    window.stonks?.event("note_view", "/" + slug, {
      semester: slugParts[0] ?? "",
      module: slugParts[1] ?? "",
    });
  </script>
  <script>
    import "../scripts/copy-code";
  </script>
  <script>
    import "../scripts/image-zoom";
  </script>

  <ImageZoom />
</Layout>

<style>
  :root {
    --sidebar-w: 280px;
    --toc-w: 280px;
    --nav-h: 54px;
    --pip-size: 16px;
    --stripe-fg: #f5b800;
    --stripe-bg: #1a1200;
  }

  main {
    height: calc(100dvh - var(--nav-h));
    overflow: hidden;
  }

  section:has(article) {
    padding: 0 calc(5 * var(--spacing));
    overflow: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  /* ── MAIN ─────────────────────────────────────────────────────── */
  .main {
    flex: 1;
    min-width: 0;
  }

  .content {
    max-width: 724px;
    margin: 0 auto;
    padding: 40px 48px 96px;
  }

  /* Note header */
  .note-hd {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .note-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--sem-bg);
    border: 1px solid var(--sem-border);
    color: var(--sem-text);
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 16px;
    font-family: var(--font-ui);
  }

  .note-tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background: var(--sem);
  }

  .note-title {
    font-family: var(--font-ui);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.08;
    color: var(--text-primary);
    margin-bottom: 14px;
    text-wrap: pretty;
  }

  .wip-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin: 0 0 16px;
    padding: 8px 12px;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sem-text);
    background: var(--sem-bg);
    border: 1px solid var(--sem-border);
    border-radius: 6px;
  }

  .wip-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--sem);
    flex-shrink: 0;
  }

  .note-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .note-meta-sep {
    margin: 0 10px;
    opacity: 0.4;
  }

  .note-meta {
    display: flex;
    flex-direction: row;
    gap: 16px;
    width: fit-content;
    color: var(--text-muted);
  }

  @media (max-width: 48rem) {
    .note-meta {
      flex-direction: column;
      gap: 10px;
      font-size: 0.8125rem;
    }
  }

  .note-meta > * {
    width: fit-content;
    display: flex;
    gap: 12px;
  }

  :global(pre) {
    background: var(--shiki-light-bg);
    color: var(--shiki-light);
    border-color: var(--border);
  }

  :global(pre code span) {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }

  :global([data-theme="dark"]) :global(pre) {
    background: var(--shiki-dark-bg);
    color: var(--shiki-dark);
  }

  :global([data-theme="dark"]) :global(pre code span) {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
  }

  :global([data-theme="dark"]) :global(.copy-btn) {
    background: var(--shiki-dark-bg);
    border-color: var(--border);
    color: var(--shiki-dark);
  }

  /* ── DRAWER CONTROLS ─────────────────────────────────────────── */
  .nav-drawer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 7px;
    cursor: pointer;
    padding: 0;
    transition:
      background 0.12s,
      color 0.12s,
      border-color 0.12s;
  }

  .nav-drawer-btn:hover,
  .nav-drawer-btn:active {
    background: var(--sem-bg);
    border-color: var(--sem-border);
    color: var(--sem);
  }

  .drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
  }

  html.drawers-ready .drawer-backdrop {
    transition: opacity 0.2s ease;
  }

  [data-theme="dark"] .drawer-backdrop {
    background: rgba(0, 0, 0, 0.65);
  }

  html.sidebar-open .drawer-backdrop,
  html.toc-open .drawer-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 48rem) {
    main {
      display: block !important;
      height: auto;
      overflow: visible;
    }

    .drawer-backdrop {
      display: block;
    }

    section:has(article) {
      padding: 0 calc(4 * var(--spacing));
      overflow: visible;
      height: auto;
    }

    /* Article tweaks for narrow screens */
    .note-title {
      font-size: 1.4rem;
    }
  }
</style>
