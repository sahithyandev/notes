    top: -12px;
    transform: rotate(135deg);
  }

  /* Highlight diagonals when either adjacent segment is active. Selectors
     repeat the depth attributes to match the specificity of the default
     background rule above — otherwise var(--border) would win. */
  .toc-trail-segment[data-depth="2"].active
    + .toc-trail-segment[data-depth="3"]::before,
  .toc-trail-segment[data-depth="2"]
    + .toc-trail-segment[data-depth="3"].active::before,
  .toc-trail-segment[data-depth="3"].active
