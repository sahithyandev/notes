---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import Nav from "../components/nav.astro";
import Breadcrumb from "../components/breadcrumb.astro";
import { SITE_NAME, SITE_HOST_URL } from "../utils/values";
import Note from "../components/note.astro";
import WalksVennDiagram from "../components/walks-venn-diagram.astro";
import TreePropertiesProofs from "../components/illustrations/tree-properties-proofs.astro";
import TocRail from "../components/toc-rail.astro";
import ModulesList from "../components/modules-list.astro";
import NoteFeedback from "../components/note-feedback.astro";
import { getVoteCounts } from "../lib/supabase";
import RightSidebar from "../components/right-sidebar.astro";
import Article from "../components/article.astro";
import Prereqs from "../components/prereqs.astro";
import AiLinks from "../components/ai-links.astro";
import ChevronDown from "../components/icons/ChevronDown.astro";
import MenuIcon from "../components/icons/MenuIcon.astro";
import TocIcon from "../components/icons/TocIcon.astro";
import NoteNav from "../components/note-nav.astro";
import ModuleTree from "../components/module-tree.astro";
import { getSidebarData, getSemesterInfo } from "../lib/sidebar";
import { titleize } from "../utils";

export const prerender = true;
// ISR: revalidate note pages every 50 minutes so server-rendered vote counts stay fresh.
export const revalidate = 3000;

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { slug } = Astro.params;
const notesEntry = await getEntry("notes", slug);
const slugParts = slug.split("/");

if (!notesEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const { Content, headings } = await render(notesEntry);
const voteCounts = await getVoteCounts(slug);

const prereqEntries = notesEntry.data.prereqs
  ? (
      await Promise.all(
        notesEntry.data.prereqs.map((s) => getEntry("notes", s)),
      )
    ).filter((e): e is NonNullable<typeof e> => !!e)
  : [];

const sidebarData = await getSidebarData(slug);

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

// Pass raw ISO date for client-side calculation
const lastUpdatedIso = notesEntry.data.lastUpdatedOn;

// Calculate read time based on word count
function calculateReadTime(content: string): number {
  const words = content.trim().split(/\s+/).length;
  const wordsPerMinute = 200;
  return Math.ceil(words / wordsPerMinute);
}

// Generate description from first paragraph
function generateDescription(content: string): string {
  const firstParagraph = content.split("\n\n")[0];
  // Remove markdown formatting
  const cleanText = firstParagraph
    .replace(/[#*`_\[\]]/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // Remove markdown links
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "") // Remove images
    .trim();

  // Truncate to ~160 characters
  return cleanText.length > 160
    ? cleanText.substring(0, 157) + "..."
    : cleanText;
}

const readTime = calculateReadTime(notesEntry.body || "");
const description = generateDescription(notesEntry.body || "");

const topic = notesEntry.data.title;
const sectionLabel = slugParts.length >= 2 ? titleize(slugParts[1]) : null;
---

<Layout
  title={`${notesEntry.data.title} | ${SITE_NAME}`}
  description={description}
  image={`${SITE_HOST_URL}/og/${slug}`}
  canonical={`${SITE_HOST_URL}/${slug}`}
  slug={slug}
>
  <Nav />

  <div class="mobile-bar">
    <button
      class="mobile-bar-btn"
      id="open-sidebar"
      type="button"
      aria-label="Open contents"
    >
      <MenuIcon />
      <span>Contents</span>
    </button>
    {
      tocHeadings.length > 0 && (
        <button
          class="mobile-bar-btn right"
          id="open-toc"
          type="button"
          aria-label="Open table of contents"
        >
          <span>On this page</span>
          <TocIcon />
        </button>
      )
    }
  </div>
  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
  <main
    data-pagefind-body
    class="grid grid-cols-[auto_1fr_auto]"
    style={`--sem: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-bg: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --sem-border: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-border); --sem-text: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-dim: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --link: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"});`}
  >
    <aside class="sidebar">
      <div class="sb-sem-wrap">
        <button
          class="sb-sem"
          id="sem-switcher-btn"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <div class="sb-sem-pip"></div>
          <div class="sb-sem-info">
            <span class="sb-sem-name">{getSemesterInfo(slugParts).label}</span>
          </div>
          <ChevronDown class="sb-sem-chev" />
        </button>
        <div class="sb-sem-menu" id="sem-switcher-menu" hidden role="listbox">
          {
            sidebarData.semesters.map((s) => (
              <a
                href={`/${s.firstSlug}`}
                class={`sb-sem-opt ${s.number === Number(sidebarData.currentSemester.slice(1)) ? "active" : ""}`}
                style={`--opt-sem: var(--s${s.number}); --opt-sem-bg: var(--s${s.number}-bg); --opt-sem-border: var(--s${s.number}-border);`}
                role="option"
              >
                <span class="sb-sem-opt-pip" />
                <span>{s.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <ModulesList
        modules={Object.entries(
          sidebarData.grouped[sidebarData.currentSemester] || {},
        ).map(([module, notes]) => ({
          module,
          href: `/${sidebarData.currentSemester}/${module}`,
          count: notes.length,
          active: module === sidebarData.currentModule,
        }))}
      />

      <ModuleTree
        currentModule={sidebarData.currentModule}
        direct={sidebarData.currentModuleTree.direct}
        topics={sidebarData.currentModuleTree.topics}
        currentSlug={slug}
      />

      <div class="sb-rule"></div>
      <a href="/license" class="sb-item sb-license-link"> License </a>
    </aside>

    <section>
      <Breadcrumb slug={slug} title={notesEntry.data.title} />
      <h1 class="note-title">
        {notesEntry.data.title}
      </h1>

      <div class="note-meta">
        <div class="flex">
          <span class="note-meta-item">{readTime} min read</span>
          <span class="note-meta-item" data-date={lastUpdatedIso}
            >Updated {lastUpdatedIso}</span
          >
        </div>

        <AiLinks slug={slug} topic={topic} sectionLabel={sectionLabel} />
      </div>

      <Prereqs entries={prereqEntries} />

      <Article>
        <Content
          components={{ Note, WalksVennDiagram, TreePropertiesProofs }}
        />
      </Article>

      <NoteFeedback
        slug={slug}
        initialUp={voteCounts.up}
        initialDown={voteCounts.down}
      />

      <NoteNav
        prevNote={sidebarData.prevNote}
        nextNote={sidebarData.nextNote}
      />
    </section>

    <RightSidebar>
      <TocRail headings={tocHeadings} />
      <!-- TODO: if the current slug starts with s4/theory-of-computing,
       add link to https://sahithyan.dev/tools/regex-compiler. It is a Regex to Automaton converter and visualizer tool that I made.
       It will help with understanding the logic behind the conversion. -->
    </RightSidebar>
  </main>

  <script>
    // Semester switcher toggle
    const semBtn = document.getElementById("sem-switcher-btn");
    const semMenu = document.getElementById("sem-switcher-menu");
    if (semBtn && semMenu) {
      const close = () => {
        semMenu.hidden = true;
        semBtn.setAttribute("aria-expanded", "false");
      };
      const open = () => {
        semMenu.hidden = false;
        semBtn.setAttribute("aria-expanded", "true");
      };
      semBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        semMenu.hidden ? open() : close();
      });
      document.addEventListener("click", (e) => {
        if (semMenu.hidden) return;
        const target = e.target as Node;
        if (!semMenu.contains(target) && !semBtn.contains(target)) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !semMenu.hidden) {
          close();
          semBtn.focus();
        }
      });
    }
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const activeSidebarItem = document.querySelector(
        ".sidebar .sb-item-sub.active",
      );
      if (activeSidebarItem) {
        activeSidebarItem.scrollIntoView({ block: "center" });
      }
    });
  </script>

  <script>
    // Mobile drawer toggles
    const openSidebarBtn = document.getElementById("open-sidebar");
    const openTocBtn = document.getElementById("open-toc");
    const backdrop = document.getElementById("drawer-backdrop");
    const sidebarEl = document.querySelector(".sidebar");
    const tocEl = document.querySelector(".toc-rail");
    const root = document.documentElement;

    const closeDrawers = () => {
      root.classList.remove("sidebar-open", "toc-open");
      document.body.style.overflow = "";
    };
    const openSidebar = () => {
      root.classList.add("sidebar-open");
      root.classList.remove("toc-open");
      document.body.style.overflow = "hidden";
    };
    const openToc = () => {
      root.classList.add("toc-open");
      root.classList.remove("sidebar-open");
      document.body.style.overflow = "hidden";
    };

    openSidebarBtn?.addEventListener("click", openSidebar);
    openTocBtn?.addEventListener("click", openToc);
    backdrop?.addEventListener("click", closeDrawers);

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        (root.classList.contains("sidebar-open") ||
          root.classList.contains("toc-open"))
      ) {
        closeDrawers();
      }
    });

    // Close drawer when a link inside is tapped (before navigation completes)
    sidebarEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });
    tocEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });

    // Close drawers when crossing back to desktop
    const mqDesktop = window.matchMedia("(min-width: 48rem)");
    mqDesktop.addEventListener("change", (e) => {
      if (e.matches) closeDrawers();
    });

    // Enable drawer transitions only after initial paint, so the closed
    // state doesn't briefly animate in on page load / navigation.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.classList.add("drawers-ready"));
    });
  </script>

  <script>
    function formatRelativeTime(isoDate: string): string {
      const lastUpdated = new Date(isoDate);
      const now = new Date();
      const diffTime = Math.abs(now.getTime() - lastUpdated.getTime());
      const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

      if (diffDays === 0) return "today";
      if (diffDays === 1) return "yesterday";
      if (diffDays < 7) return `${diffDays} days ago`;

      const weeks = Math.floor(diffDays / 7);
      if (weeks < 4) return `${weeks} week${weeks > 1 ? "s" : ""} ago`;

      const months = Math.floor(diffDays / 30);
      return `${months} month${months > 1 ? "s" : ""} ago`;
    }

    // Update relative time label on page load
    document.addEventListener("DOMContentLoaded", () => {
      const metaElement = document.querySelector(".note-meta-item[data-date]");
      if (metaElement) {
        const isoDate = metaElement.getAttribute("data-date");
        if (isoDate) {
          metaElement.textContent = "Updated " + formatRelativeTime(isoDate);
        }
      }
    });
  </script>

  <script define:vars={{ slug, slugParts }}>
    window.stonks?.event("note_view", "/" + slug, {
      semester: slugParts[0] ?? "",
      module: slugParts[1] ?? "",
    });
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("article pre").forEach((pre) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-btn";
        btn.setAttribute("aria-label", "Copy code");
        btn.textContent = "Copy";

        btn.addEventListener("click", () => {
          const code = pre.querySelector("code");
          const text = code?.innerText ?? "";
          navigator.clipboard.writeText(text).then(
            () => {
              btn.textContent = "Copied";
              setTimeout(() => (btn.textContent = "Copy"), 1500);
            },
            () => {
              btn.textContent = "Failed";
              setTimeout(() => (btn.textContent = "Copy"), 1500);
            },
          );
        });

        pre.appendChild(btn);
      });
    });
  </script>
</Layout>

<style>
  :root {
    --sidebar-w: 280px;
    --toc-w: 280px;
    --nav-h: 54px;
    --pip-size: 16px;
    --stripe-fg: #f5b800;
    --stripe-bg: #1a1200;
  }

  main {
    height: calc(100dvh - var(--nav-h));
    overflow: hidden;
  }

  section:has(article) {
    padding: 0 calc(5 * var(--spacing));
    overflow: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  /* ── LEFT SIDEBAR ─────────────────────────────────────────────── */
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    overflow-y: auto;
    background: var(--surface);
    padding: 0;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .sidebar::-webkit-scrollbar {
    width: 3px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 2px;
  }

  /* Semester band at top of sidebar */
  .sb-sem-wrap {
    position: relative;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--border);
  }

  .sb-sem {
    width: 100%;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--sem-bg);
    border: 0;
    border-bottom: 1px solid var(--sem-border);
    color: var(--sem);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: filter 0.1s;
  }

  .sb-sem:hover {
    filter: brightness(0.97);
  }

  [data-theme="dark"] .sb-sem:hover {
    filter: brightness(1.25);
  }

  .sb-sem .sb-sem-name {
    color: var(--sem);
  }

  .sb-sem :global(.sb-sem-chev) {
    color: var(--sem);
    opacity: 0.7;
  }

  .sb-sem[aria-expanded="true"] :global(.sb-sem-chev) {
    transform: rotate(180deg);
  }

  .sb-sem-menu {
    position: absolute;
    top: 100%;
    left: 8px;
    right: 8px;
    z-index: 10;
    margin-top: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sb-sem-opt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 4px;
    transition:
      background 0.1s,
      color 0.1s;
  }

  .sb-sem-opt:hover {
    background: var(--surface-2);
    color: var(--text-primary);
  }

  .sb-sem-opt.active {
    color: var(--opt-sem);
  }

  .sb-sem-opt-pip,
  .sb-sem-pip {
    width: var(--pip-size);
    height: var(--pip-size);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .sb-sem-opt-pip {
    background: var(--opt-sem);
  }

  .sb-sem-pip {
    background: var(--sem);
  }

  .sb-sem-label {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .sb-sem-name {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.2px;
  }

  .sb-item {
    display: flex;
    align-items: center;
    padding: 5px 16px;
    font-size: 0.78125rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition:
      background 0.1s,
      color 0.1s,
      border-color 0.1s;
    line-height: 1.35;
  }

  .sb-item:hover {
    background: var(--surface-2);
    color: var(--text-primary);
  }

  .sb-item.active {
    background: var(--sem-dim);
    color: var(--sem);
    border-left-color: var(--sem);
    font-weight: 700;
  }

  .sb-item-sub {
    padding-left: 28px;
    font-size: 0.75rem;
  }

  .sb-item-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .sb-rule {
    height: 1px;
    background: var(--border);
    margin: 8px 0;
  }

  /* ── MAIN ─────────────────────────────────────────────────────── */
  .main {
    flex: 1;
    min-width: 0;
  }

  .content {
    max-width: 724px;
    margin: 0 auto;
    padding: 40px 48px 96px;
  }

  /* Note header */
  .note-hd {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .note-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--sem-bg);
    border: 1px solid var(--sem-border);
    color: var(--sem-text);
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 16px;
    font-family: var(--font-ui);
  }

  .note-tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background: var(--sem);
  }

  .note-title {
    font-family: var(--font-ui);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.08;
    color: var(--text-primary);
    margin-bottom: 14px;
    text-wrap: pretty;
  }

  .note-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .note-meta-sep {
    margin: 0 10px;
    opacity: 0.4;
  }

  .note-meta {
    display: flex;
    flex-direction: row;
    gap: 16px;
    width: fit-content;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .note-meta {
      flex-direction: column;
    }
  }

  .note-meta > * {
    width: fit-content;
    display: flex;
    gap: 12px;
  }

  :global(pre) {
    background: var(--shiki-light-bg);
    color: var(--shiki-light);
    border-color: var(--border);
  }

  :global(pre code span) {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }

  :global([data-theme="dark"]) :global(pre) {
    background: var(--shiki-dark-bg);
    color: var(--shiki-dark);
  }

  :global([data-theme="dark"]) :global(pre code span) {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
  }

  :global([data-theme="dark"]) :global(.copy-btn) {
    background: var(--shiki-dark-bg);
    border-color: var(--border);
    color: var(--shiki-dark);
  }

  /* ── MOBILE ACTION BAR & DRAWER CONTROLS ──────────────────────── */
  .mobile-bar {
    display: none;
    position: sticky;
    top: var(--nav-h);
    z-index: 20;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 8px calc(4 * var(--spacing));
    gap: 8px;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    transition:
      background 0.12s,
      color 0.12s,
      border-color 0.12s;
  }

  .mobile-bar-btn:hover,
  .mobile-bar-btn:active {
    background: var(--sem-bg);
    border-color: var(--sem-border);
    color: var(--sem);
  }

  .drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
  }

  html.drawers-ready .drawer-backdrop {
    transition: opacity 0.2s ease;
  }

  [data-theme="dark"] .drawer-backdrop {
    background: rgba(0, 0, 0, 0.65);
  }

  html.sidebar-open .drawer-backdrop,
  html.toc-open .drawer-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 47.99rem) {
    main {
      display: block !important;
      height: auto;
      overflow: visible;
    }

    .mobile-bar {
      display: flex;
    }

    .drawer-backdrop {
      display: block;
    }

    section:has(article) {
      padding: 0 calc(4 * var(--spacing));
      overflow: visible;
      height: auto;
    }

    /* Left sidebar as slide-in drawer */
    .sidebar {
      position: fixed;
      top: var(--nav-h);
      left: 0;
      height: calc(100dvh - var(--nav-h));
      width: min(300px, 85vw);
      z-index: 50;
      transform: translateX(-100%);
      box-shadow: 2px 0 18px rgba(0, 0, 0, 0.18);
    }

    html.drawers-ready .sidebar {
      transition: transform 0.22s ease;
    }

    html.sidebar-open .sidebar {
      transform: translateX(0);
    }

    /* Article tweaks for narrow screens */
    .note-title {
      font-size: 1.625rem;
    }

    article {
      font-size: 0.9375rem;
    }

    .note-action-btn:first-of-type {
      margin-left: 0;
    }
  }
</style>
