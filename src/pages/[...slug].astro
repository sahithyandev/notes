---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import Nav from "../components/nav.astro";
import Breadcrumb from "../components/breadcrumb.astro";
import { SITE_NAME, SITE_HOST_URL } from "../utils/values";
import Note from "../components/note.astro";
import WalksVennDiagram from "../components/walks-venn-diagram.astro";
import { titleize } from "../utils";
import TreePropertiesProofs from "../components/illustrations/tree-properties-proofs.astro";
import TocRail from "../components/toc-rail.astro";
import ModulesList from "../components/modules-list.astro";
import NoteFeedback from "../components/note-feedback.astro";
import { getVoteCounts } from "../lib/supabase";

export const prerender = true;
// ISR: revalidate note pages every 5 minutes so server-rendered vote counts stay fresh.
export const revalidate = 300;

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { slug } = Astro.params;
const notesEntry = await getEntry("notes", slug);
const slugParts = slug.split("/");

if (!notesEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const { Content, headings } = await render(notesEntry);
const voteCounts = await getVoteCounts(slug);

const prereqEntries = notesEntry.data.prereqs
  ? (
      await Promise.all(
        notesEntry.data.prereqs.map((s) => getEntry("notes", s)),
      )
    ).filter((e): e is NonNullable<typeof e> => !!e)
  : [];

// Helper functions to generate sidebar data
function getSemesterInfo(slugParts: string[]) {
  const match = slugParts[0].match(/^s(\d)$/);
  if (match) {
    const n = match[1];
    return {
      label: `Semester ${n}`,
    };
  }
  return {
    label: "Unknown",
  };
}

// Parse the numeric prefix of a topic-group directory from a note's filePath.
// e.g. "docs/s1/fluid-mechanics/3-statics/01-intro.mdx" → 3
// Returns Infinity when no prefixed dir segment is found.
function moduleOrderFromFilePath(filePath: string | undefined): number {
  if (!filePath) return Infinity;
  const parts = filePath.split("/");
  // parts: ["docs","s1","fluid-mechanics","3-statics","01-intro.mdx"]
  // The topic-group dir is at index 3 (when 4 parts after "docs/" exist)
  const topicDir = parts[3];
  if (!topicDir) return Infinity;
  const m = topicDir.match(/^(\d+)-/);
  return m ? parseInt(m[1], 10) : Infinity;
}

async function getSidebarData(currentSlug: string) {
  const allNotes = await getCollection("notes");
  const currentSlugParts = currentSlug.split("/");
  const currentSemester = currentSlugParts[0];
  const currentSubject = currentSlugParts[1];

  // Group notes by semester and subject
  const grouped: Record<string, Record<string, any[]>> = {};

  allNotes.forEach((note) => {
    const parts = note.data.slug.split("/");
    const sem = parts[0];
    const subj = parts[1];

    if (!grouped[sem]) grouped[sem] = {};
    if (!grouped[sem][subj]) grouped[sem][subj] = [];

    grouped[sem][subj].push({
      slug: note.data.slug,
      title: note.data.title,
      label: note.data.sidebar?.label || note.data.title,
      order: note.data.sidebar?.order || 999,
      moduleOrder: moduleOrderFromFilePath(note.filePath),
    });
  });

  // Sort each subject's notes by order
  Object.keys(grouped).forEach((sem) => {
    Object.keys(grouped[sem]).forEach((subj) => {
      grouped[sem][subj].sort((a, b) => a.order - b.order);
    });
  });

  // Build current subject tree with nested modules
  const currentSubjectNotes = grouped[currentSemester]?.[currentSubject] || [];
  const currentSubjectTree = {
    direct: [] as any[],
    modules: {} as Record<string, any[]>,
  };

  currentSubjectNotes.forEach((note) => {
    const parts = note.slug.split("/");
    if (parts.length === 3) {
      // s1/subject/note - direct note under subject
      currentSubjectTree.direct.push(note);
    } else if (parts.length >= 4) {
      // s1/subject/module/... - nested under module
      const module = parts[2];
      if (!currentSubjectTree.modules[module]) {
        currentSubjectTree.modules[module] = [];
      }
      currentSubjectTree.modules[module].push(note);
    }
  });

  // Sort modules by their numeric dir prefix (moduleOrder)
  const sortedModules = Object.keys(currentSubjectTree.modules).sort((a, b) => {
    const orderA = currentSubjectTree.modules[a][0]?.moduleOrder ?? Infinity;
    const orderB = currentSubjectTree.modules[b][0]?.moduleOrder ?? Infinity;
    return orderA - orderB;
  });

  // Calculate prev/next navigation within current module
  let prevNote: any = null;
  let nextNote: any = null;
  const slugParts = currentSlug.split("/");

  if (slugParts.length >= 4) {
    const currentModule = slugParts[2];
    const moduleNotes = currentSubjectTree.modules[currentModule] || [];
    const currentIndex = moduleNotes.findIndex(
      (note) => note.slug === currentSlug,
    );

    if (currentIndex > 0) {
      prevNote = moduleNotes[currentIndex - 1];
    }
    if (currentIndex < moduleNotes.length - 1) {
      nextNote = moduleNotes[currentIndex + 1];
    }
  } else if (slugParts.length === 3) {
    const directNotes = currentSubjectTree.direct;
    const currentIndex = directNotes.findIndex(
      (note) => note.slug === currentSlug,
    );

    if (currentIndex > 0) {
      prevNote = directNotes[currentIndex - 1];
    }
    if (currentIndex < directNotes.length - 1) {
      nextNote = directNotes[currentIndex + 1];
    }
  }

  // Build semester switcher list: each semester -> first note slug
  const semesterMap: Record<
    number,
    Record<string, { slug: string; order: number }[]>
  > = {};
  allNotes.forEach((note) => {
    const parts = note.data.slug.split("/");
    const match = parts[0].match(/^s(\d)$/);
    if (!match) return;
    const n = parseInt(match[1]);
    const moduleKey = parts[1] ?? "general";
    if (!semesterMap[n]) semesterMap[n] = {};
    if (!semesterMap[n][moduleKey]) semesterMap[n][moduleKey] = [];
    semesterMap[n][moduleKey].push({
      slug: note.data.slug,
      order: note.data.sidebar?.order ?? 999,
    });
  });

  const semesters = Object.keys(semesterMap)
    .map((n) => parseInt(n))
    .sort((a, b) => a - b)
    .map((number) => {
      const modules = semesterMap[number];
      const firstModuleKey = Object.keys(modules).sort((a, b) =>
        titleize(a).localeCompare(titleize(b)),
      )[0];
      const firstNote = [...modules[firstModuleKey]].sort(
        (a, b) => a.order - b.order,
      )[0];
      return {
        number,
        label: `Semester ${number}`,
        firstSlug: firstNote.slug,
      };
    });

  return {
    currentSemester,
    currentSubject,
    grouped,
    semesters,
    currentSubjectTree: {
      ...currentSubjectTree,
      modules: Object.fromEntries(
        sortedModules.map((key) => [key, currentSubjectTree.modules[key]]),
      ),
    },
    prevNote,
    nextNote,
  };
}

const sidebarData = await getSidebarData(slug);

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

// Pass raw ISO date for client-side calculation
const lastUpdatedIso = notesEntry.data.lastUpdatedOn;

// Calculate read time based on word count
function calculateReadTime(content: string): number {
  const words = content.trim().split(/\s+/).length;
  const wordsPerMinute = 200;
  return Math.ceil(words / wordsPerMinute);
}

// Generate description from first paragraph
function generateDescription(content: string): string {
  const firstParagraph = content.split("\n\n")[0];
  // Remove markdown formatting
  const cleanText = firstParagraph
    .replace(/[#*`_\[\]]/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // Remove markdown links
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "") // Remove images
    .trim();

  // Truncate to ~160 characters
  return cleanText.length > 160
    ? cleanText.substring(0, 157) + "..."
    : cleanText;
}

const readTime = calculateReadTime(notesEntry.body || "");
const description = generateDescription(notesEntry.body || "");

const currentURL = `${SITE_HOST_URL}/${slug}`;
const topic = notesEntry.data.title;
const sectionLabel = slugParts.length >= 2 ? titleize(slugParts[1]) : null;
const tutorPrompt = `I'm working through the "${topic}" section${sectionLabel ? ` under ${sectionLabel}` : ""}: ${currentURL} on ${SITE_NAME} at ${currentURL}

Please help me use it effectively:
- Explain any concept I mention (from the notes or topic) in clear, simple English as if you're a lecturer.
- Provide examples (numeric, diagrammatic, or step-by-step) drawn from or inspired by the material.
- Help me debug my understanding or answer conceptual questions I raise.
- If the notes reference a figure, table, or diagram, help me interpret it, annotate it, and connect it clearly to the concept.
- Offer "Check Your Understanding" quick questions (with answers or hints) based on the material so I can test myself.

I'll specify which concept / page / figure I'm on, and you'll respond accordingly.`;
const encodedPrompt = encodeURIComponent(tutorPrompt);
const chatgptUrl = `https://chatgpt.com/?q=${encodedPrompt}`;
const claudeUrl = `https://claude.ai/new?q=${encodedPrompt}`;
---

<Layout
  title={`${notesEntry.data.title} | ${SITE_NAME}`}
  description={description}
  image={`${SITE_HOST_URL}/og/${slug}`}
  canonical={`${SITE_HOST_URL}/${slug}`}
  slug={slug}
>
  <Nav />

  <div class="mobile-bar">
    <button
      class="mobile-bar-btn"
      id="open-sidebar"
      type="button"
      aria-label="Open contents"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="3" y1="6" x2="21" y2="6"></line><line
          x1="3"
          y1="12"
          x2="15"
          y2="12"></line><line x1="3" y1="18" x2="18" y2="18"></line></svg
      >
      <span>Contents</span>
    </button>
    {
      tocHeadings.length > 0 && (
        <button
          class="mobile-bar-btn right"
          id="open-toc"
          type="button"
          aria-label="Open table of contents"
        >
          <span>On this page</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </>
          </svg>
        </button>
      )
    }
  </div>
  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
  <main
    data-pagefind-body
    class="grid grid-cols-[auto_1fr_auto]"
    style={`--sem: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-bg: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --sem-border: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-border); --sem-text: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-dim: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --link: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"});`}
  >
    <aside class="sidebar">
      <div class="sb-sem-wrap">
        <button
          class="sb-sem"
          id="sem-switcher-btn"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <div class="sb-sem-pip"></div>
          <div class="sb-sem-info">
            <span class="sb-sem-name">{getSemesterInfo(slugParts).label}</span>
          </div>
          <svg
            class="sb-sem-chev"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div class="sb-sem-menu" id="sem-switcher-menu" hidden role="listbox">
          {
            sidebarData.semesters.map((s) => (
              <a
                href={`/${s.firstSlug}`}
                class={`sb-sem-opt ${s.number === Number(sidebarData.currentSemester.slice(1)) ? "active" : ""}`}
                style={`--opt-sem: var(--s${s.number}); --opt-sem-bg: var(--s${s.number}-bg); --opt-sem-border: var(--s${s.number}-border);`}
                role="option"
              >
                <span class="sb-sem-opt-pip" />
                <span>{s.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <ModulesList
        subjects={Object.entries(
          sidebarData.grouped[sidebarData.currentSemester] || {},
        ).map(([subject, notes]) => ({
          subject,
          href: `/${sidebarData.currentSemester}/${subject}`,
          count: notes.length,
          active: subject === sidebarData.currentSubject,
        }))}
      />

      {
        (sidebarData.currentSubjectTree.direct.length > 0 ||
          Object.keys(sidebarData.currentSubjectTree.modules).length > 0) && (
          <>
            <div class="sb-rule" />
            <div class="sb-group-title">
              {sidebarData.currentSubject
                .replace(/-/g, " ")
                .replace(/\b\w/g, (l) => l.toUpperCase())}
            </div>

            {/* Direct notes under subject */}
            {sidebarData.currentSubjectTree.direct.map((note: any) => (
              <a
                href={`/${note.slug}`}
                class={`sb-item sb-item-sub ${note.slug === slug ? "active" : ""}`}
              >
                {note.label}
              </a>
            ))}

            {/* Nested modules */}
            {Object.entries(sidebarData.currentSubjectTree.modules).map(
              ([moduleKey, moduleNotes]) => (
                <>
                  <div class="sb-module-title">
                    {moduleKey
                      .replace(/-/g, " ")
                      .replace(/\b\w/g, (l) => l.toUpperCase())}
                  </div>
                  {moduleNotes.map((note: any) => (
                    <a
                      href={`/${note.slug}`}
                      class={`sb-item sb-item-sub ${note.slug === slug ? "active" : ""}`}
                    >
                      {note.label}
                    </a>
                  ))}
                </>
              ),
            )}
          </>
        )
      }

      <div class="sb-rule"></div>
      <a href="/license" class="sb-item sb-license-link"> License </a>
    </aside>

    <section>
      <Breadcrumb slug={slug} title={notesEntry.data.title} />
      <h1 class="note-title">
        {notesEntry.data.title}
      </h1>

      <div class="note-meta">
        <div class="flex">
          <span class="note-meta-item">{readTime} min read</span>
          <span class="note-meta-item" data-date={lastUpdatedIso}
            >Updated {lastUpdatedIso}</span
          >
        </div>

        <div class="flex">
          <a
            class="note-action-btn"
            href={chatgptUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open in ChatGPT"
          >
            <span>Open in ChatGPT</span>
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.142-.08 4.774-2.758a.795.795 0 0 0 .393-.681v-6.737l2.018 1.165a.071.071 0 0 1 .039.06v5.583a4.504 4.504 0 0 1-4.49 4.488zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.778 2.758a.777.777 0 0 0 .78 0l5.832-3.367v2.33a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.164a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.896zm16.59 3.857-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.413-.667zm2.01-3.023-.142-.086-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"
              ></path>
            </svg>
          </a>
          <a
            class="note-action-btn"
            href={claudeUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open in Claude"
          >
            <span>Open in Claude</span>
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M4.709 15.955l4.72-2.647.079-.23-.079-.128h-.23l-.79-.048-2.695-.073-2.337-.097-2.265-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.367-1.605-2.561-1.694-1.343-.976-.726-.493-.365-.462-.158-1.011.658-.724.881.06.225.061.893.686 1.908 1.476 2.491 1.834.365.304.146-.103.018-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.418 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.207-1.659-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      {
        prereqEntries.length > 0 && (
          <aside class="prereqs">
            <div class="prereqs-label">Prerequisites</div>
            <ul class="prereqs-list">
              {prereqEntries.map((p) => {
                const semMatch = p.data.slug.match(/^s(\d)/);
                const semNum = semMatch ? semMatch[1] : null;
                return (
                  <li>
                    <a
                      href={`/${p.data.slug}`}
                      style={semNum ? `--sem: var(--s${semNum});` : undefined}
                    >
                      <span class="prereqs-title">{p.data.title}</span>
                      {semNum && (
                        <span class="prereqs-sem"> — Semester {semNum}</span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </aside>
        )
      }

      <article data-pagefind-body>
        <Content
          components={{ Note, WalksVennDiagram, TreePropertiesProofs }}
        />
      </article>

      <NoteFeedback
        slug={slug}
        initialUp={voteCounts.up}
        initialDown={voteCounts.down}
      />

      {
        sidebarData.prevNote || sidebarData.nextNote ? (
          <div class="note-nav">
            {sidebarData.prevNote && (
              <a
                href={`/${sidebarData.prevNote.slug}`}
                class="note-nav-btn left"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="note-nav-icon"
                >
                  <path d="m15 18-6-6 6-6" />
                </svg>
                <div class="note-nav-content">
                  <span class="note-nav-dir">Previous</span>
                  <span class="note-nav-title">
                    {sidebarData.prevNote.label}
                  </span>
                </div>
              </a>
            )}
            {sidebarData.nextNote && (
              <a
                href={`/${sidebarData.nextNote.slug}`}
                class="note-nav-btn right"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="note-nav-icon"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
                <div class="note-nav-content">
                  <span class="note-nav-dir">Next</span>
                  <span class="note-nav-title">
                    {sidebarData.nextNote.label}
                  </span>
                </div>
              </a>
            )}
          </div>
        ) : null
      }
    </section>

    <TocRail headings={tocHeadings} />
  </main>

  <script>
    // Semester switcher toggle
    const semBtn = document.getElementById("sem-switcher-btn");
    const semMenu = document.getElementById("sem-switcher-menu");
    if (semBtn && semMenu) {
      const close = () => {
        semMenu.hidden = true;
        semBtn.setAttribute("aria-expanded", "false");
      };
      const open = () => {
        semMenu.hidden = false;
        semBtn.setAttribute("aria-expanded", "true");
      };
      semBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        semMenu.hidden ? open() : close();
      });
      document.addEventListener("click", (e) => {
        if (semMenu.hidden) return;
        const target = e.target as Node;
        if (!semMenu.contains(target) && !semBtn.contains(target)) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !semMenu.hidden) {
          close();
          semBtn.focus();
        }
      });
    }
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const activeSidebarItem = document.querySelector(
        ".sidebar .sb-item-sub.active",
      );
      if (activeSidebarItem) {
        activeSidebarItem.scrollIntoView({ block: "center" });
      }
    });
  </script>

  <script>
    // Mobile drawer toggles
    const openSidebarBtn = document.getElementById("open-sidebar");
    const openTocBtn = document.getElementById("open-toc");
    const backdrop = document.getElementById("drawer-backdrop");
    const sidebarEl = document.querySelector(".sidebar");
    const tocEl = document.querySelector(".toc-rail");
    const root = document.documentElement;

    const closeDrawers = () => {
      root.classList.remove("sidebar-open", "toc-open");
      document.body.style.overflow = "";
    };
    const openSidebar = () => {
      root.classList.add("sidebar-open");
      root.classList.remove("toc-open");
      document.body.style.overflow = "hidden";
    };
    const openToc = () => {
      root.classList.add("toc-open");
      root.classList.remove("sidebar-open");
      document.body.style.overflow = "hidden";
    };

    openSidebarBtn?.addEventListener("click", openSidebar);
    openTocBtn?.addEventListener("click", openToc);
    backdrop?.addEventListener("click", closeDrawers);

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        (root.classList.contains("sidebar-open") ||
          root.classList.contains("toc-open"))
      ) {
        closeDrawers();
      }
    });

    // Close drawer when a link inside is tapped (before navigation completes)
    sidebarEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });
    tocEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });

    // Close drawers when crossing back to desktop
    const mqDesktop = window.matchMedia("(min-width: 48rem)");
    mqDesktop.addEventListener("change", (e) => {
      if (e.matches) closeDrawers();
    });

    // Enable drawer transitions only after initial paint, so the closed
    // state doesn't briefly animate in on page load / navigation.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.classList.add("drawers-ready"));
    });
  </script>

  <script>
    function formatRelativeTime(isoDate: string): string {
      const lastUpdated = new Date(isoDate);
      const now = new Date();
      const diffTime = Math.abs(now.getTime() - lastUpdated.getTime());
      const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

      if (diffDays === 0) return "today";
      if (diffDays === 1) return "yesterday";
      if (diffDays < 7) return `${diffDays} days ago`;

      const weeks = Math.floor(diffDays / 7);
      if (weeks < 4) return `${weeks} week${weeks > 1 ? "s" : ""} ago`;

      const months = Math.floor(diffDays / 30);
      return `${months} month${months > 1 ? "s" : ""} ago`;
    }

    // Update relative time label on page load
    document.addEventListener("DOMContentLoaded", () => {
      const metaElement = document.querySelector(".note-meta-item[data-date]");
      if (metaElement) {
        const isoDate = metaElement.getAttribute("data-date");
        if (isoDate) {
          metaElement.textContent = "Updated " + formatRelativeTime(isoDate);
        }
      }
    });
  </script>

  <script define:vars={{ slug, slugParts }}>
    window.stonks?.event("note_view", "/" + slug, {
      semester: slugParts[0] ?? "",
      module: slugParts[1] ?? "",
    });
  </script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelectorAll("article pre").forEach((pre) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-btn";
        btn.setAttribute("aria-label", "Copy code");
        btn.textContent = "Copy";

        btn.addEventListener("click", () => {
          const code = pre.querySelector("code");
          const text = code?.innerText ?? "";
          navigator.clipboard.writeText(text).then(
            () => {
              btn.textContent = "Copied";
              setTimeout(() => (btn.textContent = "Copy"), 1500);
            },
            () => {
              btn.textContent = "Failed";
              setTimeout(() => (btn.textContent = "Copy"), 1500);
            },
          );
        });

        pre.appendChild(btn);
      });
    });
  </script>
</Layout>

