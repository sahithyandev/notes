---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import Nav from "../components/Nav.astro";
import Breadcrumb from "../components/breadcrumb.astro";
import { SITE_NAME, SITE_DOMAIN } from "../utils/values";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { slug } = Astro.params;
const notesEntry = await getEntry("notes", slug);
const slugParts = slug.split("/");

if (!notesEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const { Content, headings } = await render(notesEntry);

// Helper functions to generate sidebar data
function getSemesterInfo(slugParts: string[]) {
  const match = slugParts[0].match(/^s(\d)$/);
  if (match) {
    const n = match[1];
    return {
      label: `Semester ${n}`,
    };
  }
  return {
    label: "Unknown",
  };
}

async function getSidebarData(currentSlug: string) {
  const allNotes = await getCollection("notes");
  const currentSlugParts = currentSlug.split("/");
  const currentSemester = currentSlugParts[0];
  const currentSubject = currentSlugParts[1];

  // Group notes by semester and subject
  const grouped: Record<string, Record<string, any[]>> = {};

  allNotes.forEach((note) => {
    const parts = note.data.slug.split("/");
    const sem = parts[0];
    const subj = parts[1];

    if (!grouped[sem]) grouped[sem] = {};
    if (!grouped[sem][subj]) grouped[sem][subj] = [];

    grouped[sem][subj].push({
      slug: note.data.slug,
      title: note.data.title,
      label: note.data.sidebar?.label || note.data.title,
      order: note.data.sidebar?.order || 999,
    });
  });

  // Sort each subject's notes by order
  Object.keys(grouped).forEach((sem) => {
    Object.keys(grouped[sem]).forEach((subj) => {
      grouped[sem][subj].sort((a, b) => a.order - b.order);
    });
  });

  // Build current subject tree with nested modules
  const currentSubjectNotes = grouped[currentSemester]?.[currentSubject] || [];
  const currentSubjectTree = {
    direct: [] as any[],
    modules: {} as Record<string, any[]>,
  };

  currentSubjectNotes.forEach((note) => {
    const parts = note.slug.split("/");
    if (parts.length === 3) {
      // s1/subject/note - direct note under subject
      currentSubjectTree.direct.push(note);
    } else if (parts.length >= 4) {
      // s1/subject/module/... - nested under module
      const module = parts[2];
      if (!currentSubjectTree.modules[module]) {
        currentSubjectTree.modules[module] = [];
      }
      currentSubjectTree.modules[module].push(note);
    }
  });

  // Sort modules alphabetically by key
  const sortedModules = Object.keys(currentSubjectTree.modules).sort();

  return {
    currentSemester,
    currentSubject,
    grouped,
    currentSubjectTree: {
      ...currentSubjectTree,
      modules: Object.fromEntries(
        sortedModules.map((key) => [key, currentSubjectTree.modules[key]]),
      ),
    },
  };
}

const sidebarData = await getSidebarData(slug);

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

// Format last updated date
function formatLastUpdated(date: Date | undefined): string | null {
  if (!date) return null;
  const lastUpdated = new Date(date);
  const now = new Date();
  const diffTime = Math.abs(now.getTime() - lastUpdated.getTime());
  const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

  if (diffDays === 0) return "today";
  if (diffDays === 1) return "yesterday";
  if (diffDays < 7) return `${diffDays} days ago`;

  const weeks = Math.floor(diffDays / 7);
  if (weeks < 4) return `${weeks} week${weeks > 1 ? "s" : ""} ago`;

  const months = Math.floor(diffDays / 30);
  return `${months} month${months > 1 ? "s" : ""} ago`;
}

// Calculate read time based on word count
function calculateReadTime(content: string): number {
  const words = content.trim().split(/\s+/).length;
  const wordsPerMinute = 200;
  return Math.ceil(words / wordsPerMinute);
}

// Generate description from first paragraph
function generateDescription(content: string): string {
  const firstParagraph = content.split("\n\n")[0];
  // Remove markdown formatting
  const cleanText = firstParagraph
    .replace(/[#*`_\[\]]/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // Remove markdown links
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "") // Remove images
    .trim();

  // Truncate to ~160 characters
  return cleanText.length > 160
    ? cleanText.substring(0, 157) + "..."
    : cleanText;
}

const lastUpdated = formatLastUpdated(notesEntry.data.lastUpdatedOn);
const readTime = calculateReadTime(notesEntry.body || "");
const description = generateDescription(notesEntry.body || "");
---

<Layout
  title={`${notesEntry.data.title} | ${SITE_NAME}`}
  description={description}
  image={`${SITE_DOMAIN}/og/${slug}`}
  canonical={`${SITE_DOMAIN}/notes/${slug}`}
>
  <Nav />

  <main
    data-pagefind-body
    class="grid grid-cols-[auto_1fr_auto]"
    style={`--sem: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-bg: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --sem-border: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-border); --sem-text: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-dim: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg);`}
  >
    <aside class="sidebar">
      <div class="sb-sem">
        <div class="sb-sem-pip"></div>
        <div class="sb-sem-info">
          <span class="sb-sem-name">{getSemesterInfo(slugParts).label}</span>
        </div>
      </div>

      <div class="sb-group-title">Subjects</div>
      {
        Object.entries(
          sidebarData.grouped[sidebarData.currentSemester] || {},
        ).map(([subject, notes]) => (
          <a
            href={`/${subject}`}
            class={`sb-item ${subject === sidebarData.currentSubject ? "active" : ""}`}
          >
            {subject
              .replace(/-/g, " ")
              .replace(/\b\w/g, (l) => l.toUpperCase())}
            <span class="sb-item-count">{notes.length}</span>
          </a>
        ))
      }

      {
        (sidebarData.currentSubjectTree.direct.length > 0 ||
          Object.keys(sidebarData.currentSubjectTree.modules).length > 0) && (
          <>
            <div class="sb-rule" />
            <div class="sb-group-title">
              {sidebarData.currentSubject
                .replace(/-/g, " ")
                .replace(/\b\w/g, (l) => l.toUpperCase())}
            </div>

            {/* Direct notes under subject */}
            {sidebarData.currentSubjectTree.direct.map((note: any) => (
              <a
                href={`/${note.slug}`}
                class={`sb-item sb-item-sub ${note.slug === slug ? "active" : ""}`}
              >
                {note.label}
              </a>
            ))}

            {/* Nested modules */}
            {Object.entries(sidebarData.currentSubjectTree.modules).map(
              ([moduleKey, moduleNotes]) => (
                <>
                  <div class="sb-module-title">
                    {moduleKey
                      .replace(/-/g, " ")
                      .replace(/\b\w/g, (l) => l.toUpperCase())}
                  </div>
                  {moduleNotes.map((note: any) => (
                    <a
                      href={`/${note.slug}`}
                      class={`sb-item sb-item-sub ${note.slug === slug ? "active" : ""}`}
                    >
                      {note.label}
                    </a>
                  ))}
                </>
              ),
            )}
          </>
        )
      }
    </aside>

    <section>
      <Breadcrumb slug={slug} />
      <h1 class="note-title">
        {notesEntry.data.title}
      </h1>
      {
        (lastUpdated || readTime) && (
          <div class="note-meta">
            {readTime && (
              <span class="note-meta-item">{readTime} min read</span>
            )}
            {readTime && lastUpdated && <span class="note-meta-sep">·</span>}
            {lastUpdated && (
              <span class="note-meta-item">Updated {lastUpdated}</span>
            )}
          </div>
        )
      }

      <article data-pagefind-body>
        <Content />
      </article>
    </section>

    {
      tocHeadings.length > 0 && (
        <aside class="toc-rail">
          <div class="toc-title">On this page</div>
          <div class="toc-trail">
            {tocHeadings.map((heading, index) => (
              <div
                class={`toc-trail-segment ${heading.depth === 3 ? "toc-trail-sub" : ""}`}
                data-depth={heading.depth}
                data-index={index}
              />
            ))}
          </div>
          {tocHeadings.map((heading, index) => (
            <a
              href={`#${heading.slug}`}
              class={`toc-item ${heading.depth === 3 ? "toc-sub" : ""} ${index === 0 ? "active" : ""}`}
              data-depth={heading.depth}
              data-index={index}
            >
              {heading.text}
            </a>
          ))}
          {tocHeadings.length > 5 && <div class="toc-rule" />}
        </aside>
      )
    }
  </main>

  <script>
    // TOC active state on scroll
    const headings = [...document.querySelectorAll("article h2, article h3")];
    const tocLinks = [...document.querySelectorAll(".toc-item")];
    const trailSegments = [...document.querySelectorAll(".toc-trail-segment")];

    if (headings.length > 0 && tocLinks.length > 0) {
      // Position trail segments to match TOC items
      const positionTrailSegments = () => {
        const tocTrail = document.querySelector(".toc-trail");
        if (!tocTrail) return;
        const trailRect = tocTrail.getBoundingClientRect();
        // Shorten segments on the side where they meet a different-depth
        // neighbour, so the diagonal connector can occupy that gap.
        const JOIN = 5;
        trailSegments.forEach((segment, index) => {
          const tocItem = tocLinks[index];
          if (!tocItem) return;
          const tocRect = tocItem.getBoundingClientRect();
          const relativeTop = tocRect.top - trailRect.top;
          const depth = segment.getAttribute("data-depth");
          const prevDepth =
            trailSegments[index - 1]?.getAttribute("data-depth");
          const nextDepth =
            trailSegments[index + 1]?.getAttribute("data-depth");
          const shrinkTop = prevDepth && prevDepth !== depth ? JOIN : 0;
          const shrinkBottom = nextDepth && nextDepth !== depth ? JOIN : 0;
          (segment as HTMLElement).style.top = `${relativeTop + shrinkTop}px`;
          (segment as HTMLElement).style.height =
            `${tocRect.height - shrinkTop - shrinkBottom}px`;
        });
      };

      // Function to update active TOC items based on visible headings
      const updateActiveToc = () => {
        const section = document.querySelector("section");
        if (!section) return;

        const sectionRect = section.getBoundingClientRect();
        const viewportTop = section.scrollTop;
        const viewportBottom = viewportTop + sectionRect.height;

        // Remove active from all TOC links and trail segments
        tocLinks.forEach((t) => t.classList.remove("active"));
        trailSegments.forEach((t) => t.classList.remove("active"));

        // Add active to all headings visible in viewport
        headings.forEach((heading, index) => {
          const rect = heading.getBoundingClientRect();
          const sectionRect = section.getBoundingClientRect();
          const relativeTop = rect.top - sectionRect.top;
          const relativeBottom = relativeTop + rect.height;

          // Check if heading is visible in section viewport
          if (relativeBottom > viewportTop && relativeTop < viewportBottom) {
            if (tocLinks[index]) tocLinks[index].classList.add("active");
            if (trailSegments[index]) trailSegments[index].classList.add("active");
          }
        });
      };

      // Initial positioning
      positionTrailSegments();

      // Update on scroll
      const section = document.querySelector("section");
      if (section) {
        section.addEventListener("scroll", updateActiveToc);
      }

      // Initial update
      updateActiveToc();

      // Reposition on resize
      window.addEventListener("resize", positionTrailSegments);

      // Smooth scroll for TOC links
      tocLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const href = link.getAttribute("href");
          if (href) {
            const targetId = href.substring(1);
            const targetElement = document.getElementById(targetId);
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            }
          }
        });
      });
    }
  </script>
</Layout>

<style>
  :root {
    --sidebar-w: 280px;
    --toc-w: 200px;
    --nav-h: 54px;
  }

  main {
    height: calc(100dvh - var(--nav-h));
    overflow: hidden;
  }

  section:has(article) {
    padding: 0 calc(5 * var(--spacing));
    overflow: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  article {
    padding-top: 1rem;
  }

  article {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);

    h2 {
      font-family: var(--font-ui);
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      color: var(--text-primary);
      margin: 44px 0 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h2:first-child {
      margin-top: 0;
    }

    h3 {
      font-family: var(--font-ui);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.1px;
      color: var(--text-primary);
      margin: 30px 0 10px;
    }

    h4 {
      font-family: var(--font-ui);
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 24px 0 8px;
    }

    p {
      margin-bottom: 16px;
      font-size: 1.06rem;
      text-wrap: pretty;
    }

    ul {
      list-style: none;
      padding: 0;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    ul li {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }

    ul li::before {
      content: "";
      flex-shrink: 0;
      width: 5px;
      height: 5px;
      border-radius: 2.5px;
      background: var(--sem);
      margin-top: 0.62em;
    }

    ol {
      padding-left: 22px;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    strong {
      font-weight: 700;
      color: var(--text-primary);
    }

    em {
      font-style: italic;
    }

    /* Inline code */
    code {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      background: var(--surface-2);
      border: 1px solid var(--border);
      padding: 1px 6px;
      border-radius: 4px;
      color: var(--text-primary);
      font-weight: 400;
    }

    /* Code block */
    pre {
      background: #0c0e18;
      border-radius: 9px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 20px 22px;
      margin: 20px 0;
      overflow-x: auto;
      position: relative;
    }

    pre code {
      background: none;
      border: none;
      padding: 0;
      font-size: 0.875rem;
      line-height: 1.7;
      color: #b0bdd8;
      font-weight: 400;
    }

    pre .kw {
      color: #7f98f8;
    }

    pre .fn {
      color: #6fcfb0;
    }

    pre .str {
      color: #98cc98;
    }

    pre .cm {
      color: #4a5a72;
      font-style: italic;
    }

    pre .num {
      color: #e8c870;
    }

    pre .tp {
      color: #c0a8e8;
    }

    /* Language label */
    pre::before {
      content: attr(data-lang);
      position: absolute;
      top: 10px;
      right: 14px;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.18);
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    /* Callout */
    .callout {
      border-radius: 0 8px 8px 0;
      border: 1px solid var(--sem-border);
      border-left: 3px solid var(--sem);
      background: var(--sem-bg);
      padding: 14px 18px;
      margin: 20px 0;
      font-size: 0.9375rem;
      color: var(--sem-text);
      line-height: 1.6;
    }

    .callout-title {
      font-family: var(--font-ui);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: var(--sem);
      margin-bottom: 5px;
      display: block;
    }

    .callout p {
      margin: 0;
      font-family: var(--font-body);
      color: var(--sem-text);
    }

    /* Table */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
      margin: 20px 0;
      font-family: var(--font-ui);
    }

    thead tr {
      border-bottom: 2px solid var(--border-strong);
    }

    th {
      font-size: 0.6875rem;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.5px;
      padding: 8px 14px;
      text-align: left;
      text-transform: uppercase;
    }

    td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      color: var(--text-secondary);
      vertical-align: top;
      line-height: 1.45;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Key term highlight */
    .term {
      background: var(--accent-dim);
      color: var(--accent);
      border-radius: 3px;
      padding: 0 5px;
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: 0.95em;
    }

    /* Additional article content styles */
    p {
      font-size: 1rem;
      line-height: 1.6;

      &:not(:has(.MathJax:only-of-type)):not(:has(img:only-of-type)) {
        max-width: 84ch;
      }

      &:has(svg.block-image:only-child),
      img {
        margin-left: auto;
        margin-right: auto;
      }

      &:has(.MathJax:only-of-type) mjx-container svg,
      &:has(.MathJax):not(:has(.MathJax:only-of-type)) mjx-container svg {
        display: inline-block;
        font-size: 1.25rem;
      }

      &:has(.MathJax:only-of-type) {
        text-align: center;
      }
    }

    li {
      font-size: 1rem;
      line-height: 1.6;

      .MathJax {
        font-size: 1.25rem;

        svg {
          display: inline-block;
          margin-left: 0.25rem;
          margin-right: 0.25rem;
        }
      }
    }

    svg.block-image {
      margin-left: auto;
      margin-right: auto;
    }

    mjx-container[display="true"] svg {
      text-align: center;
      font-size: 1.25rem;
      margin: 2.5rem auto;
    }

    h2 mjx-container svg,
    h3 mjx-container svg,
    h4 mjx-container svg {
      display: inline-block !important;
    }

    .katex-display {
      text-align: center;
      font-size: 1.25rem;
      overflow-x: scroll;
      overflow-y: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;

      thead,
      tbody,
      tr {
        width: 100%;
      }

      th,
      td {
        padding: 0.5rem 1rem;
        vertical-align: middle;
      }

      .MathJax {
        display: inline-block;
        font-size: 1.25rem;
      }

      img {
        margin: auto;
      }

      td .MathJax {
        margin: auto;
      }
    }

    strong {
      color: var(--accent);
    }

    blockquote {
      font-size: 1rem;
      font-weight: 500;
      padding: 0.5rem;
      background-color: var(--accent-subtle);
      border-radius: 0.375rem;
    }

    figure {
      img {
        border-radius: 0.375rem;
      }

      figcaption {
        text-align: center;
        margin-top: 1rem;

        p {
          display: contents;
          font-size: 0.875rem;
        }
      }
    }
  }

  /* ── LEFT SIDEBAR ─────────────────────────────────────────────── */
  .sidebar {
    width: var(--sidebar-w);
    flex-shrink: 0;
    overflow-y: auto;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 0 0 32px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .sidebar::-webkit-scrollbar {
    width: 3px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 2px;
  }

  /* Semester band at top of sidebar */
  .sb-sem {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sb-sem-pip {
    width: 3px;
    height: 28px;
    border-radius: 2px;
    background: var(--sem);
    flex-shrink: 0;
  }

  .sb-sem-info {
  }

  .sb-sem-label {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  .sb-sem-name {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.2px;
  }

  .sb-group-title {
    padding: 10px 16px 4px;
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .sb-module-title {
    padding: 8px 16px 2px;
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .sb-item {
    display: flex;
    align-items: center;
    padding: 5px 16px;
    font-size: 0.78125rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition:
      background 0.1s,
      color 0.1s,
      border-color 0.1s;
    line-height: 1.35;
  }

  .sb-item:hover {
    background: var(--surface-2);
    color: var(--text-primary);
  }

  .sb-item.active {
    background: var(--sem-dim);
    color: var(--sem);
    border-left-color: var(--sem);
    font-weight: 700;
  }

  .sb-item-sub {
    padding-left: 28px;
    font-size: 0.75rem;
  }

  .sb-item-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .sb-rule {
    height: 1px;
    background: var(--border);
    margin: 8px 0;
  }

  /* ── MAIN ─────────────────────────────────────────────────────── */
  .main {
    flex: 1;
