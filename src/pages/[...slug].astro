---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import Nav from "../components/nav.astro";
import Breadcrumb from "../components/breadcrumb.astro";
import { SITE_NAME, SITE_HOST_URL } from "../utils/values";
import Note from "../components/note.astro";
import WalksVennDiagram from "../components/walks-venn-diagram.astro";
import TreePropertiesProofs from "../components/illustrations/tree-properties-proofs.astro";
import TocRail from "../components/toc-rail.astro";
import NoteFeedback from "../components/note-feedback.astro";
import { getVoteCounts } from "../lib/supabase";
import RightSidebar from "../components/right-sidebar.astro";
import Article from "../components/article.astro";
import Prereqs from "../components/prereqs.astro";
import AiLinks from "../components/ai-links.astro";
import MenuIcon from "../components/icons/MenuIcon.astro";
import TocIcon from "../components/icons/TocIcon.astro";
import NoteNav from "../components/note-nav.astro";
import { getSidebarData } from "../lib/sidebar";
import NoteSidebar from "../components/note-sidebar.astro";
import { titleize, calculateReadTime, generateDescription } from "../utils";

export const prerender = false;
// ISR: revalidate note pages every 50 minutes so server-rendered vote counts stay fresh.
export const revalidate = 3000;

const { slug } = Astro.params;

if (slug === undefined) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const notesEntry = await getEntry("notes", slug);
const slugParts = slug.split("/");

if (!notesEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const { Content, headings } = await render(notesEntry);
const voteCounts = await getVoteCounts(slug);

const prereqEntries = notesEntry.data.prereqs
  ? (
      await Promise.all(
        notesEntry.data.prereqs.map((s) => getEntry("notes", s)),
      )
    ).filter((e): e is NonNullable<typeof e> => !!e)
  : [];

const sidebarData = await getSidebarData(slug);

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

// Pass raw ISO date for client-side calculation
const lastUpdatedIso = notesEntry.data.lastUpdatedOn;

const readTime = calculateReadTime(notesEntry.body || "");
const description = generateDescription(notesEntry.body || "");

const topic = notesEntry.data.title;
const sectionLabel = slugParts.length >= 2 ? titleize(slugParts[1]) : null;
---

<Layout
  title={`${notesEntry.data.title} | ${SITE_NAME}`}
  description={description}
  image={`${SITE_HOST_URL}/og/${slug}`}
  canonical={`${SITE_HOST_URL}/${slug}`}
  slug={slug}
>
  <Nav />

  <div class="mobile-bar">
    <button
      class="mobile-bar-btn"
      id="open-sidebar"
      type="button"
      aria-label="Open contents"
    >
      <MenuIcon />
      <span>Contents</span>
    </button>
    {
      tocHeadings.length > 0 && (
        <button
          class="mobile-bar-btn right"
          id="open-toc"
          type="button"
          aria-label="Open table of contents"
        >
          <span>On this page</span>
          <TocIcon />
        </button>
      )
    }
  </div>
  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
  <main
    data-pagefind-body
    class="grid grid-cols-[auto_1fr_auto]"
    style={`--sem: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-bg: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --sem-border: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-border); --sem-text: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-dim: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --link: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"});`}
  >
    <NoteSidebar sidebarData={sidebarData} slug={slug} slugParts={slugParts} />

    <section>
      <Breadcrumb slug={slug} title={notesEntry.data.title} />
      <h1 class="note-title">
        {notesEntry.data.title}
      </h1>

      <div class="note-meta">
        <div class="flex">
          <span class="note-meta-item">{readTime} min read</span>
          <span class="note-meta-item" data-date={lastUpdatedIso}
            >Updated {lastUpdatedIso}</span
          >
        </div>

        <AiLinks slug={slug} topic={topic} sectionLabel={sectionLabel} />
      </div>

      <Prereqs entries={prereqEntries} />

      <Article>
        <Content
          components={{ Note, WalksVennDiagram, TreePropertiesProofs }}
        />
      </Article>

      <NoteFeedback
        slug={slug}
        initialUp={voteCounts.up}
        initialDown={voteCounts.down}
      />

      <NoteNav
        prevNote={sidebarData.prevNote}
        nextNote={sidebarData.nextNote}
      />
    </section>

    <RightSidebar>
      <TocRail headings={tocHeadings} />
      <!-- TODO: if the current slug starts with s4/theory-of-computing,
       add link to https://sahithyan.dev/tools/regex-compiler. It is a Regex to Automaton converter and visualizer tool that I made.
       It will help with understanding the logic behind the conversion. -->
    </RightSidebar>
  </main>

  <script>
    import "../scripts/drawers";
  </script>
  <script>
    import "../scripts/relative-time";
  </script>
  <script define:vars={{ slug, slugParts }} is:inline>
    window.stonks?.event("note_view", "/" + slug, {
      semester: slugParts[0] ?? "",
      module: slugParts[1] ?? "",
    });
  </script>
  <script>
    import "../scripts/copy-code";
  </script>
</Layout>

<style>
  :root {
    --sidebar-w: 280px;
    --toc-w: 280px;
    --nav-h: 54px;
    --pip-size: 16px;
    --stripe-fg: #f5b800;
    --stripe-bg: #1a1200;
  }

  main {
    height: calc(100dvh - var(--nav-h));
    overflow: hidden;
  }

  section:has(article) {
    padding: 0 calc(5 * var(--spacing));
    overflow: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  /* ── MAIN ─────────────────────────────────────────────────────── */
  .main {
    flex: 1;
    min-width: 0;
  }

  .content {
    max-width: 724px;
    margin: 0 auto;
    padding: 40px 48px 96px;
  }

  /* Note header */
  .note-hd {
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .note-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--sem-bg);
    border: 1px solid var(--sem-border);
    color: var(--sem-text);
    border-radius: 5px;
    padding: 3px 10px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 16px;
    font-family: var(--font-ui);
  }

  .note-tag-dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background: var(--sem);
  }

  .note-title {
    font-family: var(--font-ui);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.08;
    color: var(--text-primary);
    margin-bottom: 14px;
    text-wrap: pretty;
  }

  .note-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .note-meta-sep {
    margin: 0 10px;
    opacity: 0.4;
  }

  .note-meta {
    display: flex;
    flex-direction: row;
    gap: 16px;
    width: fit-content;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .note-meta {
      flex-direction: column;
    }
  }

  .note-meta > * {
    width: fit-content;
    display: flex;
    gap: 12px;
  }

  :global(pre) {
    background: var(--shiki-light-bg);
    color: var(--shiki-light);
    border-color: var(--border);
  }

  :global(pre code span) {
    color: var(--shiki-light);
    background-color: var(--shiki-light-bg);
  }

  :global([data-theme="dark"]) :global(pre) {
    background: var(--shiki-dark-bg);
    color: var(--shiki-dark);
  }

  :global([data-theme="dark"]) :global(pre code span) {
    color: var(--shiki-dark);
    background-color: var(--shiki-dark-bg);
  }

  :global([data-theme="dark"]) :global(.copy-btn) {
    background: var(--shiki-dark-bg);
    border-color: var(--border);
    color: var(--shiki-dark);
  }

  /* ── MOBILE ACTION BAR & DRAWER CONTROLS ──────────────────────── */
  .mobile-bar {
    display: none;
    position: sticky;
    top: var(--nav-h);
    z-index: 20;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 8px calc(4 * var(--spacing));
    gap: 8px;
    justify-content: space-between;
    align-items: center;
  }

  .mobile-bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    transition:
      background 0.12s,
      color 0.12s,
      border-color 0.12s;
  }

  .mobile-bar-btn:hover,
  .mobile-bar-btn:active {
    background: var(--sem-bg);
    border-color: var(--sem-border);
    color: var(--sem);
  }

  .drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 40;
    opacity: 0;
    pointer-events: none;
  }

  html.drawers-ready .drawer-backdrop {
    transition: opacity 0.2s ease;
  }

  [data-theme="dark"] .drawer-backdrop {
    background: rgba(0, 0, 0, 0.65);
  }

  html.sidebar-open .drawer-backdrop,
  html.toc-open .drawer-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 47.99rem) {
    main {
      display: block !important;
      height: auto;
      overflow: visible;
    }

    .mobile-bar {
      display: flex;
    }

    .drawer-backdrop {
      display: block;
    }

    section:has(article) {
      padding: 0 calc(4 * var(--spacing));
      overflow: visible;
      height: auto;
    }

    /* Article tweaks for narrow screens */
    .note-title {
      font-size: 1.625rem;
    }

    article {
      font-size: 0.9375rem;
    }

    .note-action-btn:first-of-type {
      margin-left: 0;
    }
  }
</style>
