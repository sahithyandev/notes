---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getEntry } from "astro:content";
import Nav from "../components/nav.astro";
import Breadcrumb from "../components/breadcrumb.astro";
import { SITE_NAME, SITE_HOST_URL } from "../utils/values";
import Note from "../components/note.astro";
import WalksVennDiagram from "../components/walks-venn-diagram.astro";
import { titleize } from "../utils";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.data.slug },
    props: { note },
  }));
}

const { slug } = Astro.params;
const notesEntry = await getEntry("notes", slug);
const slugParts = slug.split("/");

if (!notesEntry) {
  return new Response(null, {
    status: 404,
    statusText: "Not Found",
  });
}

const { Content, headings } = await render(notesEntry);

// Helper functions to generate sidebar data
function getSemesterInfo(slugParts: string[]) {
  const match = slugParts[0].match(/^s(\d)$/);
  if (match) {
    const n = match[1];
    return {
      label: `Semester ${n}`,
    };
  }
  return {
    label: "Unknown",
  };
}

async function getSidebarData(currentSlug: string) {
  const allNotes = await getCollection("notes");
  const currentSlugParts = currentSlug.split("/");
  const currentSemester = currentSlugParts[0];
  const currentSubject = currentSlugParts[1];

  // Group notes by semester and subject
  const grouped: Record<string, Record<string, any[]>> = {};

  allNotes.forEach((note) => {
    const parts = note.data.slug.split("/");
    const sem = parts[0];
    const subj = parts[1];

    if (!grouped[sem]) grouped[sem] = {};
    if (!grouped[sem][subj]) grouped[sem][subj] = [];

    grouped[sem][subj].push({
      slug: note.data.slug,
      title: note.data.title,
      label: note.data.sidebar?.label || note.data.title,
      order: note.data.sidebar?.order || 999,
    });
  });

  // Sort each subject's notes by order
  Object.keys(grouped).forEach((sem) => {
    Object.keys(grouped[sem]).forEach((subj) => {
      grouped[sem][subj].sort((a, b) => a.order - b.order);
    });
  });

  // Build current subject tree with nested modules
  const currentSubjectNotes = grouped[currentSemester]?.[currentSubject] || [];
  const currentSubjectTree = {
    direct: [] as any[],
    modules: {} as Record<string, any[]>,
  };

  currentSubjectNotes.forEach((note) => {
    const parts = note.slug.split("/");
    if (parts.length === 3) {
      // s1/subject/note - direct note under subject
      currentSubjectTree.direct.push(note);
    } else if (parts.length >= 4) {
      // s1/subject/module/... - nested under module
      const module = parts[2];
      if (!currentSubjectTree.modules[module]) {
        currentSubjectTree.modules[module] = [];
      }
      currentSubjectTree.modules[module].push(note);
    }
  });

  // Sort modules alphabetically by key
  const sortedModules = Object.keys(currentSubjectTree.modules).sort();

  // Calculate prev/next navigation within current module
  let prevNote: any = null;
  let nextNote: any = null;
  const slugParts = currentSlug.split("/");

  if (slugParts.length >= 4) {
    const currentModule = slugParts[2];
    const moduleNotes = currentSubjectTree.modules[currentModule] || [];
    const currentIndex = moduleNotes.findIndex(
      (note) => note.slug === currentSlug,
    );

    if (currentIndex > 0) {
      prevNote = moduleNotes[currentIndex - 1];
    }
    if (currentIndex < moduleNotes.length - 1) {
      nextNote = moduleNotes[currentIndex + 1];
    }
  }

  // Build semester switcher list: each semester -> first note slug
  const semesterMap: Record<
    number,
    Record<string, { slug: string; order: number }[]>
  > = {};
  allNotes.forEach((note) => {
    const parts = note.data.slug.split("/");
    const match = parts[0].match(/^s(\d)$/);
    if (!match) return;
    const n = parseInt(match[1]);
    const moduleKey = parts[1] ?? "general";
    if (!semesterMap[n]) semesterMap[n] = {};
    if (!semesterMap[n][moduleKey]) semesterMap[n][moduleKey] = [];
    semesterMap[n][moduleKey].push({
      slug: note.data.slug,
      order: note.data.sidebar?.order ?? 999,
    });
  });

  const semesters = Object.keys(semesterMap)
    .map((n) => parseInt(n))
    .sort((a, b) => a - b)
    .map((number) => {
      const modules = semesterMap[number];
      const firstModuleKey = Object.keys(modules).sort((a, b) =>
        titleize(a).localeCompare(titleize(b)),
      )[0];
      const firstNote = [...modules[firstModuleKey]].sort(
        (a, b) => a.order - b.order,
      )[0];
      return {
        number,
        label: `Semester ${number}`,
        firstSlug: firstNote.slug,
      };
    });

  return {
    currentSemester,
    currentSubject,
    grouped,
    semesters,
    currentSubjectTree: {
      ...currentSubjectTree,
      modules: Object.fromEntries(
        sortedModules.map((key) => [key, currentSubjectTree.modules[key]]),
      ),
    },
    prevNote,
    nextNote,
  };
}

const sidebarData = await getSidebarData(slug);

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);

// Format last updated date
function formatLastUpdated(date: Date | undefined): string | null {
  if (!date) return null;
  const lastUpdated = new Date(date);
  const now = new Date();
  const diffTime = Math.abs(now.getTime() - lastUpdated.getTime());
  const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

  if (diffDays === 0) return "today";
  if (diffDays === 1) return "yesterday";
  if (diffDays < 7) return `${diffDays} days ago`;

  const weeks = Math.floor(diffDays / 7);
  if (weeks < 4) return `${weeks} week${weeks > 1 ? "s" : ""} ago`;

  const months = Math.floor(diffDays / 30);
  return `${months} month${months > 1 ? "s" : ""} ago`;
}

// Calculate read time based on word count
function calculateReadTime(content: string): number {
  const words = content.trim().split(/\s+/).length;
  const wordsPerMinute = 200;
  return Math.ceil(words / wordsPerMinute);
}

// Generate description from first paragraph
function generateDescription(content: string): string {
  const firstParagraph = content.split("\n\n")[0];
  // Remove markdown formatting
  const cleanText = firstParagraph
    .replace(/[#*`_\[\]]/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") // Remove markdown links
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, "") // Remove images
    .trim();

  // Truncate to ~160 characters
  return cleanText.length > 160
    ? cleanText.substring(0, 157) + "..."
    : cleanText;
}

const lastUpdated = formatLastUpdated(notesEntry.data.lastUpdatedOn);
const readTime = calculateReadTime(notesEntry.body || "");
const description = generateDescription(notesEntry.body || "");
---

<Layout
  title={`${notesEntry.data.title} | ${SITE_NAME}`}
  description={description}
  image={`${SITE_HOST_URL}/og/${slug}`}
  canonical={`${SITE_HOST_URL}/${slug}`}
  slug={slug}
>
  <Nav />

  <div class="mobile-bar">
    <button
      class="mobile-bar-btn"
      id="open-sidebar"
      type="button"
      aria-label="Open contents"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><line x1="3" y1="6" x2="21" y2="6"></line><line
          x1="3"
          y1="12"
          x2="15"
          y2="12"></line><line x1="3" y1="18" x2="18" y2="18"></line></svg
      >
      <span>Contents</span>
    </button>
    {
      tocHeadings.length > 0 && (
        <button
          class="mobile-bar-btn right"
          id="open-toc"
          type="button"
          aria-label="Open table of contents"
        >
          <span>On this page</span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </>
          </svg>
        </button>
      )
    }
  </div>
  <div class="drawer-backdrop" id="drawer-backdrop" aria-hidden="true"></div>
  <main
    data-pagefind-body
    class="grid grid-cols-[auto_1fr_auto]"
    style={`--sem: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-bg: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --sem-border: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-border); --sem-text: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}); --sem-dim: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"}-bg); --link: var(--s${slugParts[0].match(/^s(\d)$/)?.[1] || "1"});`}
  >
    <aside class="sidebar">
      <div class="sb-sem-wrap">
        <button
          class="sb-sem"
          id="sem-switcher-btn"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <div class="sb-sem-pip"></div>
          <div class="sb-sem-info">
            <span class="sb-sem-name">{getSemesterInfo(slugParts).label}</span>
          </div>
          <svg
            class="sb-sem-chev"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>
        <div class="sb-sem-menu" id="sem-switcher-menu" hidden role="listbox">
          {
            sidebarData.semesters.map((s) => (
              <a
                href={`/${s.firstSlug}`}
                class={`sb-sem-opt ${s.number === Number(sidebarData.currentSemester.slice(1)) ? "active" : ""}`}
                style={`--opt-sem: var(--s${s.number}); --opt-sem-bg: var(--s${s.number}-bg); --opt-sem-border: var(--s${s.number}-border);`}
                role="option"
              >
                <span class="sb-sem-opt-pip" />
                <span>{s.label}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="sb-group-title">Subjects</div>
      {
        Object.entries(
          sidebarData.grouped[sidebarData.currentSemester] || {},
        ).map(([subject, notes]) => (
          <a
            href={`/${sidebarData.currentSemester}/${subject}`}
            class={`sb-item ${subject === sidebarData.currentSubject ? "active" : ""}`}
          >
            {subject
              .replace(/-/g, " ")
              .replace(/\b\w/g, (l) => l.toUpperCase())}
            <span class="sb-item-count">{notes.length}</span>
          </a>
        ))
      }

      {
        (sidebarData.currentSubjectTree.direct.length > 0 ||
          Object.keys(sidebarData.currentSubjectTree.modules).length > 0) && (
          <>
            <div class="sb-rule" />
            <div class="sb-group-title">
              {sidebarData.currentSubject
                .replace(/-/g, " ")
                .replace(/\b\w/g, (l) => l.toUpperCase())}
            </div>

            {/* Direct notes under subject */}
            {sidebarData.currentSubjectTree.direct.map((note: any) => (
              <a
                href={`/${note.slug}`}
                class={`sb-item sb-item-sub ${note.slug === slug ? "active" : ""}`}
              >
                {note.label}
              </a>
            ))}

            {/* Nested modules */}
            {Object.entries(sidebarData.currentSubjectTree.modules).map(
              ([moduleKey, moduleNotes]) => (
                <>
                  <div class="sb-module-title">
                    {moduleKey
                      .replace(/-/g, " ")
                      .replace(/\b\w/g, (l) => l.toUpperCase())}
                  </div>
                  {moduleNotes.map((note: any) => (
                    <a
                      href={`/${note.slug}`}
                      class={`sb-item sb-item-sub ${note.slug === slug ? "active" : ""}`}
                    >
                      {note.label}
                    </a>
                  ))}
                </>
              ),
            )}
          </>
        )
      }

      <div class="sb-rule"></div>
      <a href="/license" class="sb-item sb-license-link"> License </a>
    </aside>

    <section>
      <Breadcrumb slug={slug} />
      <h1 class="note-title">
        {notesEntry.data.title}
      </h1>
      {
        (lastUpdated || readTime) && (
          <div class="note-meta">
            {readTime && (
              <span class="note-meta-item">{readTime} min read</span>
            )}
            {readTime && lastUpdated && <span class="note-meta-sep">·</span>}
            {lastUpdated && (
              <span class="note-meta-item">Updated {lastUpdated}</span>
            )}
          </div>
        )
      }

      <article data-pagefind-body>
        <Content components={{ Note, WalksVennDiagram }} />
      </article>

      {
        notesEntry.data.prev || notesEntry.data.next ? (
          <div class="note-nav">
            {sidebarData.prevNote && (
              <a
                href={`/${sidebarData.prevNote.slug}`}
                class="note-nav-btn left"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="note-nav-icon"
                >
                  <path d="m15 18-6-6 6-6" />
                </svg>
                <div class="note-nav-content">
                  <span class="note-nav-dir">Previous</span>
                  <span class="note-nav-title">
                    {sidebarData.prevNote.label}
                  </span>
                </div>
              </a>
            )}
            {sidebarData.nextNote && (
              <a
                href={`/${sidebarData.nextNote.slug}`}
                class="note-nav-btn right"
              >
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="note-nav-icon"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
                <div class="note-nav-content">
                  <span class="note-nav-dir">Next</span>
                  <span class="note-nav-title">
                    {sidebarData.nextNote.label}
                  </span>
                </div>
              </a>
            )}
          </div>
        ) : null
      }
    </section>

    {
      tocHeadings.length > 0 && (
        <aside class="toc-rail">
          <div class="toc-title">On this page</div>
          <div class="toc-trail">
            {tocHeadings.map((heading, index) => (
              <div
                class={`toc-trail-segment ${heading.depth === 3 ? "toc-trail-sub" : ""}`}
                data-depth={heading.depth}
                data-index={index}
              />
            ))}
          </div>
          {tocHeadings.map((heading, index) => (
            <a
              href={`#${heading.slug}`}
              class={`toc-item ${heading.depth === 3 ? "toc-sub" : ""} ${index === 0 ? "active" : ""}`}
              data-depth={heading.depth}
              data-index={index}
            >
              {heading.text}
            </a>
          ))}
          {tocHeadings.length > 5 && <div class="toc-rule" />}
        </aside>
      )
    }
  </main>

  <script>
    // Semester switcher toggle
    const semBtn = document.getElementById("sem-switcher-btn");
    const semMenu = document.getElementById("sem-switcher-menu");
    if (semBtn && semMenu) {
      const close = () => {
        semMenu.hidden = true;
        semBtn.setAttribute("aria-expanded", "false");
      };
      const open = () => {
        semMenu.hidden = false;
        semBtn.setAttribute("aria-expanded", "true");
      };
      semBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        semMenu.hidden ? open() : close();
      });
      document.addEventListener("click", (e) => {
        if (semMenu.hidden) return;
        const target = e.target as Node;
        if (!semMenu.contains(target) && !semBtn.contains(target)) close();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !semMenu.hidden) {
          close();
          semBtn.focus();
        }
      });
    }
  </script>

  <script>
    // Mobile drawer toggles
    const openSidebarBtn = document.getElementById("open-sidebar");
    const openTocBtn = document.getElementById("open-toc");
    const backdrop = document.getElementById("drawer-backdrop");
    const sidebarEl = document.querySelector(".sidebar");
    const tocEl = document.querySelector(".toc-rail");
    const root = document.documentElement;

    const closeDrawers = () => {
      root.classList.remove("sidebar-open", "toc-open");
      document.body.style.overflow = "";
    };
    const openSidebar = () => {
      root.classList.add("sidebar-open");
      root.classList.remove("toc-open");
      document.body.style.overflow = "hidden";
    };
    const openToc = () => {
      root.classList.add("toc-open");
      root.classList.remove("sidebar-open");
      document.body.style.overflow = "hidden";
    };

    openSidebarBtn?.addEventListener("click", openSidebar);
    openTocBtn?.addEventListener("click", openToc);
    backdrop?.addEventListener("click", closeDrawers);

    document.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        (root.classList.contains("sidebar-open") ||
          root.classList.contains("toc-open"))
      ) {
        closeDrawers();
      }
    });

    // Close drawer when a link inside is tapped (before navigation completes)
    sidebarEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });
    tocEl?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a")) closeDrawers();
    });

    // Close drawers when crossing back to desktop
    const mqDesktop = window.matchMedia("(min-width: 48rem)");
    mqDesktop.addEventListener("change", (e) => {
      if (e.matches) closeDrawers();
    });

    // Enable drawer transitions only after initial paint, so the closed
    // state doesn't briefly animate in on page load / navigation.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.classList.add("drawers-ready"));
    });
  </script>

  <script>
    // TOC active state on scroll
    const headings = [...document.querySelectorAll("article h2, article h3")];
    const tocLinks = [...document.querySelectorAll(".toc-item")];
    const trailSegments = [...document.querySelectorAll(".toc-trail-segment")];

    if (headings.length > 0 && tocLinks.length > 0) {
      // Position trail segments to match TOC items
      const positionTrailSegments = () => {
        const tocTrail = document.querySelector(".toc-trail");
        if (!tocTrail) return;
        const trailRect = tocTrail.getBoundingClientRect();
        // Shorten segments on the side where they meet a different-depth
        // neighbour, so the diagonal connector can occupy that gap.
        const JOIN = 5;
        trailSegments.forEach((segment, index) => {
          const tocItem = tocLinks[index];
          if (!tocItem) return;
          const tocRect = tocItem.getBoundingClientRect();
          const relativeTop = tocRect.top - trailRect.top;
          const depth = segment.getAttribute("data-depth");
          const prevDepth =
            trailSegments[index - 1]?.getAttribute("data-depth");
          const nextDepth =
            trailSegments[index + 1]?.getAttribute("data-depth");
          const shrinkTop = prevDepth && prevDepth !== depth ? JOIN : 0;
          const shrinkBottom = nextDepth && nextDepth !== depth ? JOIN : 0;
          (segment as HTMLElement).style.top = `${relativeTop + shrinkTop}px`;
          (segment as HTMLElement).style.height =
            `${tocRect.height - shrinkTop - shrinkBottom}px`;
        });
      };

      const mqDesktop = window.matchMedia("(min-width: 48rem)");

      // Function to update active TOC items based on visible headings
      const updateActiveToc = () => {
        const section = document.querySelector("section");
        if (!section) return;

        const isDesktop = mqDesktop.matches;
        const viewportTop = isDesktop ? section.getBoundingClientRect().top : 0;
        const viewportHeight = isDesktop
          ? section.clientHeight
          : window.innerHeight;

        tocLinks.forEach((t) => t.classList.remove("active"));
        trailSegments.forEach((t) => t.classList.remove("active"));

        headings.forEach((heading, index) => {
          const rect = heading.getBoundingClientRect();
          const relativeTop = rect.top - viewportTop;
          const relativeBottom = relativeTop + rect.height;

          if (relativeBottom > 0 && relativeTop < viewportHeight) {
            if (tocLinks[index]) tocLinks[index].classList.add("active");
            if (trailSegments[index])
              trailSegments[index].classList.add("active");
          }
        });
      };

      // Initial positioning
      positionTrailSegments();

      // Update on scroll — section on desktop, window on mobile
      const section = document.querySelector("section");
      section?.addEventListener("scroll", updateActiveToc);
      window.addEventListener("scroll", updateActiveToc, { passive: true });

      // Initial update
      updateActiveToc();

      // Reposition on resize
      window.addEventListener("resize", positionTrailSegments);

      // Smooth scroll for TOC links
      tocLinks.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const href = link.getAttribute("href");
          if (href) {
            const targetId = href.substring(1);
            const targetElement = document.getElementById(targetId);
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: "smooth",
                block: "start",
              });
            }
          }
        });
      });
    }
  </script>
</Layout>

<style>
  :root {
    --sidebar-w: 280px;
    --toc-w: 250px;
    --nav-h: 54px;
  }

  main {
    height: calc(100dvh - var(--nav-h));
    overflow: hidden;
  }

  section:has(article) {
    padding: 0 calc(5 * var(--spacing));
    overflow: scroll;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  article {
    padding-top: 1rem;
  }

  article {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);

    h2 {
      font-family: var(--font-ui);
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      color: var(--text-primary);
      margin: 44px 0 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h2:first-child {
      margin-top: 0;
    }

    h3 {
      font-family: var(--font-ui);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.1px;
      color: var(--text-primary);
      margin: 30px 0 10px;
    }

    h4 {
      font-family: var(--font-ui);
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 24px 0 8px;
    }

    p {
      margin-bottom: 16px;
      font-size: 1.06rem;
      text-wrap: pretty;
    }

    ul {
      list-style: none;
      padding: 0;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    ul li {
      display: flex;
      gap: 12px;
      align-items: flex-start;
