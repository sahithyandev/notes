---
/**
 * Print route — renders all notes of a module as one long book-styled page.
 * Used by the PDF generation script (plugins/generate-pdfs.ts).
 *
 * URL pattern: /print/<sem>/<module>   e.g. /print/s4/computer-networks
 */
import { getCollection, render } from "astro:content";
import { titleize } from "../../utils";
import Note from "../../components/note.astro";
import WalksVennDiagram from "../../components/walks-venn-diagram.astro";
import TreePropertiesProofs from "../../components/illustrations/tree-properties-proofs.astro";
import { SITE_HOST_URL } from "../../utils/values";

console.log(Astro.params);

export const prerender = true;

export async function getStaticPaths() {
  if (import.meta.env.PROD) return [];

  const allNotes = await getCollection("notes");

  const moduleMap = new Map<string, typeof allNotes>();
  for (const note of allNotes) {
    const parts = note.data.slug.split("/");
    const sem = parts[0];
    const mod = parts[1];
    if (!sem || !mod) continue;
    const key = `${sem}/${mod}`;
    if (!moduleMap.has(key)) moduleMap.set(key, []);
    moduleMap.get(key)!.push(note);
  }

  return Array.from(moduleMap.entries()).map(([key, notes]) => {
    const [sem, mod] = key.split("/");

    const direct = notes
      .filter((n) => n.data.slug.split("/").length === 3)
      .sort(
        (a, b) =>
          (a.data.sidebar?.order ?? 999) - (b.data.sidebar?.order ?? 999),
      );

    const submoduleGroups: Record<string, typeof allNotes> = {};
    for (const note of notes) {
      const parts = note.data.slug.split("/");
      if (parts.length >= 4) {
        const sub = parts[2];
        if (!submoduleGroups[sub]) submoduleGroups[sub] = [];
        submoduleGroups[sub].push(note);
      }
    }
    for (const sub of Object.keys(submoduleGroups)) {
      submoduleGroups[sub].sort(
        (a, b) =>
          (a.data.sidebar?.order ?? 999) - (b.data.sidebar?.order ?? 999),
      );
    }
    const submodules = Object.keys(submoduleGroups).sort();

    const orderedNotes = [
      ...direct,
      ...submodules.flatMap((sub) => submoduleGroups[sub]),
    ];

    return {
      params: { module: key },
      props: { sem, mod, orderedNotes },
    };
  });
}

const { sem, mod, orderedNotes } = Astro.props;
const moduleTitle = titleize(mod);
const semLabel = `Semester ${sem.replace(/^s/, "")}`;

const renderedNotes = await Promise.all(
  orderedNotes.map(async (note) => {
    const { Content } = await render(note);
    return { note, Content };
  }),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{moduleTitle} — {semLabel}</title>
    <meta name="author" content="Sahithyan Kandathasan" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
      rel="stylesheet"
    />
  </head>

  <body>
    {
      renderedNotes.map(({ note, Content }, index) => (
        <>
          {index === 0 ? null : <h1 class="note-title">{note.data.title}</h1>}

          {/* Note content */}
          <section class="note-body">
            <article>
              <Content
                components={{ Note, WalksVennDiagram, TreePropertiesProofs }}
              />
            </article>
          </section>
        </>
      ))
    }
  </body>
  <script>
    // Fires right before Puppeteer's page.pdf() renders — print CSS is active at this point.
    // We measure each heading's position and inject break-before:page only where needed.
    // Iterating in DOM order means each getBoundingClientRect() call reflects previously
    // injected breaks, so cascades are handled without over-breaking.
    window.addEventListener("beforeprint", () => {
      // Content height per page in CSS pixels:
      // A4 (297mm) minus Puppeteer margins (top 14mm + bottom 18mm) = 265mm
      // 265mm × (96px ÷ 25.4mm) ≈ 1001px
      const CONTENT_H = 265 * (96 / 25.4);
      const THRESHOLD = 0.75;

      document
        .querySelectorAll(
          "h1.note-title, article h2, article h3, article h4, article h5, article h6",
        )
        .forEach((h) => {
          const absTop = (h as HTMLElement).getBoundingClientRect().top;
          const posInPage = (absTop % CONTENT_H) / CONTENT_H;
          if (posInPage > THRESHOLD) {
            (h as HTMLElement).style.breakBefore = "page";
            (h as HTMLElement).style.pageBreakBefore = "always";
          }
        });
    });
  </script>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 15px;
  }

  body {
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    color: #111;
    background: #fff;
  }

  .note-title {
    padding-left: 3rem;
  }

  /* ── Content pages ───────────────────────────────────────── */
  .note-body {
    padding: 0rem 3rem 3rem 3rem;
  }

  article {
    max-width: 72ch;
  }

  article h2 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #111;
    margin: 2rem 0 0.55rem;
    letter-spacing: -0.1px;
  }

  article h2:first-child {
    margin-top: 0;
  }

  article h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111;
    margin: 1.5rem 0 0.4rem;
  }

  article h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: #222;
    margin: 1.25rem 0 0.35rem;
  }

  article h5,
  article h6 {
    font-size: 0.9rem;
    font-weight: 600;
    color: #333;
    margin: 1rem 0 0.3rem;
  }

  article p {
    margin-bottom: 0.8rem;
    text-wrap: pretty;
    break-inside: avoid;
    page-break-inside: avoid; /* legacy support */
  }

  article strong {
    font-weight: 700;
    color: #111;
  }

  article em {
    font-style: italic;
  }

  article ul {
    list-style: disc outside;
    padding-left: 1.3rem;
    margin-bottom: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  article ol {
    padding-left: 1.3rem;
    margin-bottom: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    list-style: decimal;
  }

  article ul ul {
    list-style: circle outside;
    margin-bottom: 0;
  }

  article ul ul ul {
    list-style: square outside;
  }

  article li {
    line-height: 1.55;
  }

  article blockquote {
    border-left: 3px solid #ddd;
    padding: 0.4rem 0.85rem;
    background: #fafafa;
    margin: 0.8rem 0;
    color: #333;
  }

  article code {
    font-family: "JetBrains Mono", "Courier New", monospace;
    font-size: 0.82em;
    background: #f4f4f4;
    border: 1px solid #e4e4e4;
    padding: 1px 5px;
    border-radius: 3px;
  }

  article pre {
    background: #1c1c1c;
    color: #d4d4d4;
    border-radius: 5px;
    padding: 0.8rem 1rem;
    margin: 0.9rem 0;
    overflow-x: auto;
    font-size: 0.77rem;
    line-height: 1.55;
  }

  article pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  article table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin: 0.9rem 0;
  }

  article thead tr {
    border-bottom: 2px solid #ccc;
  }

  article th {
    font-size: 0.7rem;
    font-weight: 700;
    color: #555;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    padding: 5px 10px;
    text-align: left;
  }

  article td {
    padding: 6px 10px;
    border-bottom: 1px solid #e8e8e8;
    vertical-align: top;
    line-height: 1.45;
  }

  article tr:last-child td {
    border-bottom: none;
  }

  article img,
  article svg:not(.katex svg) {
    max-width: 100%;
    display: block;
    margin: 0.8rem auto;
  }

  article .katex-display {
    text-align: center;
    font-size: 1rem;
    overflow-x: auto;
    margin: 0.9rem 0;
  }

  article .term {
    background: #f0f0ff;
    color: #333;
    border-radius: 3px;
    padding: 0 4px;
    font-weight: 600;
    font-size: 0.93em;
  }

  @media print {
    @page {
      /* Match Puppeteer's margin option exactly so beforeprint layout = PDF pagination */
      margin: 14mm 0 18mm;
    }

    body {
      font-size: 11pt;
    }

    .note-title {
      font-size: 2rem;
      padding-left: 2.5cm;
      padding-top: 2rem;
      margin-top: 0;
    }

    .note-body {
      padding: 0.5cm 2.5cm 1.5cm 2.5cm;
    }

    /* padding-top (not margin-top) is preserved when a heading lands at the top of a new page */
    article h2 { padding-top: 2rem; margin-top: 0; }
    article h3 { padding-top: 1.5rem; margin-top: 0; }
    article h4 { padding-top: 1.25rem; margin-top: 0; }
    article h5, article h6 { padding-top: 1rem; margin-top: 0; }

    article pre {
      white-space: pre-wrap;
      word-break: break-word;
    }

    article p {
      break-inside: avoid;
      page-break-inside: avoid; /* legacy support */
    }
  }
</style>
