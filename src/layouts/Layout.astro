---
import "../styles/global.css";
import { SITE_NAME, SITE_HOST_URL, SITE_DESCRIPTION } from "../utils/values";
import LiveEditBar from "../components/dev/live-edit-bar.astro";

interface Author {
  name: string;
  url?: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string[];
  slug?: string;
  authors?: Author[];
  datePublished?: Date;
  dateModified?: Date;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image = `${SITE_HOST_URL}/og/default.jpg`,
  canonical = SITE_HOST_URL,
  keywords,
  slug,
  authors,
  datePublished,
  dateModified,
} = Astro.props;

const isArticle = Boolean(authors && authors.length > 0);

const jsonLd = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      image,
      url: canonical,
      ...(datePublished && { datePublished: datePublished.toISOString() }),
      ...(dateModified && { dateModified: dateModified.toISOString() }),
      author: authors!.map((author) => ({
        "@type": "Person",
        name: author.name,
        ...(author.url && { url: author.url }),
      })),
    }
  : null;

const finalizedKeywords: Array<string> = [SITE_NAME];

if (slug) {
  // Extract path from slug prop
  const slugParts = slug.split("/").filter(Boolean);

  // Add semester (s1, s2, etc.)
  if (slugParts.length > 0) {
    finalizedKeywords.push(`semester ${slugParts[0].slice(1)}`);
  }

  // Add module name
  if (slugParts.length > 1) {
    finalizedKeywords.push(slugParts[1]);
  }

  // Add submodule name
  if (slugParts.length > 2) {
    finalizedKeywords.push(slugParts[2]);
  }

  // Add note name
  if (slugParts.length > 3) {
    finalizedKeywords.push(slugParts[3]);
  }
}

if (keywords && keywords.length > 0) {
  finalizedKeywords.push(...keywords);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#2338c0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={finalizedKeywords.join(", ")} />
    {authors && authors.length > 0 && (
      <meta
        name="author"
        content={authors.map((author) => author.name).join(", ")}
      />
    )}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:url" content={image} />
    <meta property="og:image:alt" content={`Preview image for ${title}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    {isArticle && (
      <>
        {authors!.map((author) => (
          <meta property="article:author" content={author.url ?? author.name} />
        ))}
        {datePublished && (
          <meta
            property="article:published_time"
            content={datePublished.toISOString()}
          />
        )}
        {dateModified && (
          <meta
            property="article:modified_time"
            content={dateModified.toISOString()}
          />
        )}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@sahithyandev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      ></script>
    )}

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/katex@0.17.0/dist/katex.min.css"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem("sn-theme");
          if (pref !== "light" && pref !== "dark" && pref !== "auto") {
            pref = "auto";
          }
          var mql = window.matchMedia("(prefers-color-scheme: dark)");
          var resolved =
            pref === "auto" ? (mql.matches ? "dark" : "light") : pref;
          var root = document.documentElement;
          root.setAttribute("data-theme", resolved);
          root.dataset.themePref = pref;
          mql.addEventListener("change", function (e) {
            if (root.dataset.themePref === "auto") {
              root.setAttribute("data-theme", e.matches ? "dark" : "light");
            }
          });
        } catch (_) {}
      })();
    </script>
    <script
      is:inline
      defer
      src="https://assets.onedollarstats.com/stonks.js"
    ></script>
  </head>
  <body>
    <slot />
    {import.meta.env.DEV && <LiveEditBar />}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
