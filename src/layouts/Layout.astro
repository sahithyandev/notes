---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Sahithyan's Notes</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<link href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" rel="stylesheet" />
		<script is:inline>
			(function () {
				try {
					var pref = localStorage.getItem("sn-theme");
					if (pref !== "light" && pref !== "dark" && pref !== "auto") {
						pref = "auto";
					}
					var mql = window.matchMedia("(prefers-color-scheme: dark)");
					var resolved = pref === "auto" ? (mql.matches ? "dark" : "light") : pref;
					var root = document.documentElement;
					root.setAttribute("data-theme", resolved);
					root.dataset.themePref = pref;
					mql.addEventListener("change", function (e) {
						if (root.dataset.themePref === "auto") {
							root.setAttribute("data-theme", e.matches ? "dark" : "light");
						}
					});
				} catch (_) {}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
