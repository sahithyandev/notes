---
import "../styles/global.css";
import { SITE_NAME, SITE_HOST_URL, SITE_DESCRIPTION } from "../utils/values";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string[];
  slug?: string;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image = `${SITE_HOST_URL}/og/default`,
  canonical = SITE_HOST_URL,
  keywords,
  slug,
} = Astro.props;

const finalizedKeywords: Array<string> = [SITE_NAME];

if (slug) {
  // Extract path from slug prop
  const slugParts = slug.split("/").filter(Boolean);

  // Add semester (s1, s2, etc.)
  if (slugParts.length > 0) {
    finalizedKeywords.push(`semester ${slugParts[0].slice(1)}`);
  }

  // Add module name
  if (slugParts.length > 1) {
    finalizedKeywords.push(slugParts[1]);
  }

  // Add submodule name
  if (slugParts.length > 2) {
    finalizedKeywords.push(slugParts[2]);
  }

  // Add note name
  if (slugParts.length > 3) {
    finalizedKeywords.push(slugParts[3]);
  }
}

if (keywords && keywords.length > 0) {
  finalizedKeywords.push(...keywords);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={finalizedKeywords.join(", ")} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`Preview image for ${title}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@sahithyandev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem("sn-theme");
          if (pref !== "light" && pref !== "dark" && pref !== "auto") {
            pref = "auto";
          }
          var mql = window.matchMedia("(prefers-color-scheme: dark)");
          var resolved =
            pref === "auto" ? (mql.matches ? "dark" : "light") : pref;
          var root = document.documentElement;
          root.setAttribute("data-theme", resolved);
          root.dataset.themePref = pref;
          mql.addEventListener("change", function (e) {
            if (root.dataset.themePref === "auto") {
              root.setAttribute("data-theme", e.matches ? "dark" : "light");
            }
          });
        } catch (_) {}
      })();
    </script>
    <script is:inline defer src="https://assets.onedollarstats.com/stonks.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
