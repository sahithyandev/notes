---
export interface HeadingItem {
  depth: number;
  slug: string;
  html: string;
}

export interface HeadingNode {
  heading: HeadingItem;
  children: HeadingNode[];
}

interface Props {
  nodes: HeadingNode[];
  minDepth?: number;
}

const { nodes, minDepth = 2 } = Astro.props;
---

<ul class="toc-list">
  {
    nodes.map((node) => (
      <li class="toc-item-node">
        <a
          href={`#${node.heading.slug}`}
          class={`toc-link ${node.heading.depth === 3 ? "toc-sub" : ""}`}
          style={`margin-left: ${(node.heading.depth - minDepth) * 10}px;`}
          set:html={node.heading.html}
        />
        {node.children.length > 0 && (
          <Astro.self nodes={node.children} minDepth={minDepth} />
        )}
      </li>
    ))
  }
</ul>

<style>
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item-node {
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: block;
    padding: 2px 10px 2px 13px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
    line-height: 1.45;
    position: relative;
    z-index: 1;
  }

  .toc-link:hover {
    color: var(--text-secondary);
  }

  .toc-link.active {
    color: var(--sem);
    font-weight: 500;
  }

  @media (max-width: 48rem) {
    .toc-link {
      padding: 9px 12px 9px 15px;
    }
  }
</style>
