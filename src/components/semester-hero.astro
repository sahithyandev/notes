---
interface Props {
  number: number;
  title: string;
  description?: string;
  moduleCount: number;
  noteCount: number;
}

const { number, title, description, moduleCount, noteCount } = Astro.props;
const color = `var(--s${number})`;
const numLabel = number.toString().padStart(2, "0");
---

<div class="sem-hero" style={`--sem: ${color};`}>
  <div class="sem-hero-inner">
    <div class="hero-breadcrumb">
      <a href="/">Home</a>
      <span class="hero-breadcrumb-sep">/</span>
      <span class="hero-breadcrumb-current">Semester {number}</span>
    </div>
    <h1 class="sem-hero-title">
      {title}
    </h1>
    {description && <p class="sem-hero-desc">{description}</p>}
    <div class="sem-stats">
      <div class="sem-stat">
        <span class="sem-stat-val">{moduleCount}</span>
        <span class="sem-stat-label">Modules</span>
      </div>
      <div class="sem-stat">
        <span class="sem-stat-val">{noteCount}</span>
        <span class="sem-stat-label">Notes</span>
      </div>
    </div>
  </div>
</div>

<style>
  .sem-hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    padding: 52px var(--body-margin-x) 0;
  }
  .sem-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, color-mix(in oklab, var(--text-primary) 18%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 90% 100% at 50% 0%, black 20%, transparent 80%);
  }
  .sem-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 70% at 8% 60%, color-mix(in oklab, var(--sem) 40%, transparent) 0%, transparent 60%),
      radial-gradient(ellipse 40% 55% at 80% 10%, color-mix(in oklab, var(--sem) 18%, transparent) 0%, transparent 55%);
  }

  .hero-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .hero-breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.12s;
  }
  .hero-breadcrumb a:hover {
    color: var(--text-secondary);
  }
  .hero-breadcrumb-sep {
    opacity: 0.3;
  }
  .hero-breadcrumb-current {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .sem-hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px 4px 8px;
    border-radius: 99px;
    background: color-mix(in oklab, var(--sem) 22%, transparent);
    border: 1px solid color-mix(in oklab, var(--sem) 35%, transparent);
    font-size: 11.5px;
    font-weight: 700;
    color: color-mix(in oklab, var(--sem) 80%, white);
    letter-spacing: 0.3px;
    margin-bottom: 18px;
  }
  .sem-hero-tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--sem);
  }

  .sem-hero-title {
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.02;
    letter-spacing: -1.8px;
    margin-bottom: 14px;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .sem-hero-title-num {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.5px;
    padding-bottom: 6px;
  }
  .sem-hero-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 560px;
    margin-bottom: 36px;
  }

  .sem-stats {
    display: flex;
    gap: 0;
    border-top: 1px solid var(--border);
  }
  .sem-stat {
    padding: 20px 32px 22px;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .sem-stat:first-child {
    padding-left: 0;
  }
  .sem-stat:last-child {
    border-right: none;
  }
  .sem-stat-val {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -1px;
    line-height: 1;
  }
  .sem-stat-label {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.3px;
  }
</style>
