  <button type="button" class="update-toast-reload" data-update-reload>
    Reload
  </button>
  <button
    type="button"
    class="update-toast-dismiss"
    data-update-dismiss
    aria-label="Dismiss"
  >
    ✕
  </button>
</div>

<style>
  .update-toast {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 900;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px 8px 14px;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    animation: toast-in 0.18s ease-out;
  }

  .update-toast[hidden] {
    display: none;
  }

  .update-toast button {
    font: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .update-toast-reload {
    font-weight: 600;
    color: var(--text-primary);
  }

  .update-toast button:hover {
    background: var(--border);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .update-toast {
      animation: none;
    }
  }
</style>
