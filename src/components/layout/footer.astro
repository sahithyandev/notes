---
interface LinkItem {
  href: string;
  label: string;
}

const LINKS: readonly LinkItem[] = Object.freeze([
  { href: "/site-graph", label: "Site Graph" },
  { href: "/glossary", label: "Glossary" },
  { href: "/notebooks", label: "Notebooks" },
  { href: "/license", label: "License" },
  { href: "/security", label: "Security" },
]);
---

<footer class="footer">
  <div class="footer-inner">
    <span class="footer-copy">
      © 2026-present
      <a href="https://sahithyan.dev" target="_blank">
        Sahithyan K.
      </a>
    </span>
    <nav class="footer-links" aria-label="Footer">
      {LINKS.map(({ href, label }) => (
        <a href={href}>{label}</a>
      ))}
      <button type="button" class="footer-shortcuts" data-open-shortcuts>
        Shortcuts (?)
      </button>
    </nav>
  </div>
</footer>

<script>
  import { track } from "../../scripts/analytics";

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const link = target?.closest<HTMLElement>(".footer a, .footer button");
    if (link) track("footer_click", { target: link.textContent?.trim() });
  });
</script>

<style>
  .footer {
    padding: 20px var(--body-margin-x);
    background: var(--bg);
  }

  .footer-copy a {
    margin-left: 6px;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-muted);
  }

  .footer-copy {
    font-family: var(--font-ui);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-shortcuts {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .footer-shortcuts:hover {
    text-decoration: underline;
  }

  @media (hover: none) {
    .footer-shortcuts {
      display: none;
    }
  }
</style>
