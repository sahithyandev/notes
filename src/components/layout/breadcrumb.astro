---
import { generateBreadcrumb } from "../../utils/breadcrumb";

export interface Props {
  slug: string;
  title?: string;
}

const { slug, title } = Astro.props;

const breadcrumbItems = generateBreadcrumb(slug, title);
---

<div class="breadcrumb" aria-label="Breadcrumb">
  {breadcrumbItems.map((item, index) => (
    <>
      {index > 0 && (
        <span
          class={`breadcrumb-sep${index === breadcrumbItems.length - 1 ? " last" : ""}`}
        >
          /
        </span>
      )}
      {item.href ? (
        <a href={item.href} class="breadcrumb-link">
          {item.label}
        </a>
      ) : (
        <span class="breadcrumb-current">{item.label}</span>
      )}
    </>
  ))}
</div>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
    font-weight: 500;
  }

  .breadcrumb-link:hover {
    color: var(--text-secondary);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .breadcrumb-sep {
    color: var(--text-muted);
    opacity: 0.5;
    font-weight: 400;
  }

  /* Responsive */
  @media (max-width: 48rem) {
    .breadcrumb {
      font-size: 12px;
      gap: 6px;
      margin-top: 10px;
      margin-bottom: 10px;
    }

    .breadcrumb-current,
    .breadcrumb-sep.last {
      display: none;
    }
  }
</style>
