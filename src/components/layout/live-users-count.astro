<div
  id="live-users-count-container"
  title="Currently active users"
  class="hide"
>
  <span class="live-dot" aria-hidden="true"></span>
  <span class="live-count">1</span>
</div>

<script is:inline>
  // Restore the last known count before first paint so the badge does not
  // vanish and pop back in on every page navigation.
  try {
    var cached = sessionStorage.getItem("sn-live-count");
    var box = document.getElementById("live-users-count-container");
    if (
      box &&
      navigator.onLine &&
      cached !== null &&
      Number.parseInt(cached) >= 0
    ) {
      box.querySelector(".live-count").textContent = cached;
      box.classList.remove("hide");
    }
  } catch (_) {}
</script>

<script>
  import { SITE_DOMAIN } from "../../utils/values";
  (() => {
    const container = document.getElementById("live-users-count-container");
    if (!container) {
      return;
    }
    const countDisplay = container.querySelector("span.live-count");
    if (!countDisplay) {
      return;
    }
    const hideCountDisplay = () => {
      container.classList.add("hide");
      try {
        sessionStorage.removeItem("sn-live-count");
      } catch {}
    };
    const showCountDisplay = () => {
      container.classList.remove("hide");
    };
    const eventSource = new EventSource(
      `//rando.sahithyan.dev/live-users-count?d=${SITE_DOMAIN}`,
      {},
    );
    eventSource.addEventListener("message", function (event) {
      try {
        if (Number.parseInt(event.data) >= 0) {
          countDisplay.textContent = event.data;
          try {
            sessionStorage.setItem("sn-live-count", event.data);
          } catch {}
          showCountDisplay();
        } else {
          hideCountDisplay();
        }
      } catch {}
    });
    eventSource.addEventListener("error", function () {
      hideCountDisplay();
    });
    window.addEventListener("offline", hideCountDisplay);
  })();
</script>

<style>
  #live-users-count-container {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    height: 26px;
    border-radius: 7px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 12px;
    font-family: var(--font-ui);
    color: var(--text-secondary);
    line-height: 1;
  }

  #live-users-count-container.hide {
    display: none;
  }

  @media (max-width: 48rem) {
    #live-users-count-container {
      display: none;
    }
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px color-mix(in oklab, #22c55e 22%, transparent);
    animation: live-pulse 2s ease-in-out infinite;
  }

  .live-count {
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .live-label {
    color: var(--text-muted);
  }

  @keyframes live-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }
</style>
