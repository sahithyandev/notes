---

---

<nav class="nav">
    <a href="index.html" class="nav-logo">
        <span class="nav-name">Sahithyan's Notes</span>
    </a>
    <div class="nav-links">
        <a href="#semesters" class="nav-link">Semesters</a>
        <a href="#recent" class="nav-link">Recent</a>
        <a href="#" class="nav-link">About</a>
    </div>
    <div class="nav-right">
        <div class="nav-search">
            <svg
                width="13"
                height="13"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
            >
                <circle cx="6.5" cy="6.5" r="5"></circle>
                <path d="M10.5 10.5l4 4"></path>
            </svg>
            Search notes…
            <kbd>⌘K</kbd>
        </div>
        <button
            class="theme-toggle"
            id="themeToggle"
            title="Toggle dark mode"
            aria-label="Toggle dark mode"
        >
            <svg
                id="iconSun"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                display="none"
            >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                    d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
                ></path>
            </svg>
            <svg
                id="iconMoon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
            >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                ></path>
            </svg>
        </button>
    </div>
</nav>

<style>
    .nav {
        position: sticky;
        top: 0;
        z-index: 100;
        height: 54px;
        display: flex;
        align-items: center;
        padding: 0 36px;
        background: rgba(9, 10, 18, 0.78);
        backdrop-filter: blur(20px) saturate(1.8);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        gap: 0;
    }

    .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .nav-logomark {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        flex-shrink: 0;
        background: linear-gradient(135deg, #3348c8 0%, #6b38a0 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        color: #fff;
        letter-spacing: -1px;
    }

    .nav-name {
        font-size: 14.5px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.9);
        letter-spacing: -0.3px;
    }

    .nav-slash {
        color: rgba(255, 255, 255, 0.2);
        margin: 0 4px;
        font-weight: 300;
    }

    .nav-links {
        display: flex;
        margin-left: 28px;
        gap: 2px;
    }

    .nav-link {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.5);
        text-decoration: none;
        transition:
            color 0.12s,
            background 0.12s;
        letter-spacing: 0.05px;
    }

    .nav-link:hover {
        color: rgba(255, 255, 255, 0.9);
        background: rgba(255, 255, 255, 0.06);
    }

    .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .nav-search {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.09);
        font-size: 12.5px;
        color: rgba(255, 255, 255, 0.35);
        cursor: text;
        font-family: var(--font-ui);
        transition: border-color 0.12s;
    }

    .nav-search:hover {
        border-color: rgba(255, 255, 255, 0.16);
    }

    .nav-search kbd {
        font-family: var(--font-mono);
        font-size: 10px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 3px;
        padding: 1px 5px;
        color: rgba(255, 255, 255, 0.35);
        margin-left: 4px;
    }
</style>
