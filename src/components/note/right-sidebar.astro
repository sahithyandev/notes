<aside
  class="right-sidebar"
  id="note-toc"
  tabindex="-1"
  aria-label="Table of contents"
>
  <slot />
</aside>

<style>
  .right-sidebar {
    width: var(--toc-w);
    flex-shrink: 0;
    overflow: hidden;
    background: var(--surface);
    padding: 32px 16px 32px 0;
    border-left: 1px solid var(--border);
    position: relative;
  }

  @media (min-width: 48rem) {
    :global(html.study-mode) .right-sidebar {
      transform: translateX(0);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }

    :global(html.drawers-ready) .right-sidebar {
      transition:
        transform var(--study-dur) var(--study-ease),
        opacity var(--study-dur) var(--study-ease),
        visibility 0s;
    }

    :global(html.drawers-ready.study-mode) .right-sidebar {
      transition:
        transform var(--study-dur) var(--study-ease),
        opacity var(--study-dur) var(--study-ease),
        visibility 0s var(--study-dur);
    }

    :global(html.study-mode.study-sidebar-right) .right-sidebar {
      z-index: 10;
      transform: translateX(-100%);
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
      box-shadow: -8px 0 12px rgba(0, 0, 0, 0.12);
      transition:
        transform var(--study-dur) var(--study-ease),
        opacity var(--study-dur) var(--study-ease),
        visibility 0s;
    }
  }

  @media (max-width: 48rem) {
    .right-sidebar {
      position: fixed;
      top: var(--nav-h);
      right: 0;
      height: calc(100dvh - var(--nav-h));
      width: min(320px, 90vw);
      z-index: 50;
      transform: translateX(100%);
      background: var(--surface);
      border-left: 1px solid var(--border);
      box-shadow: -2px 0 18px rgba(0, 0, 0, 0.18);
      padding: 20px 16px 20px 0;
      overflow-y: auto;
    }

    :global(html.drawers-ready) .right-sidebar {
      transition: transform 0.22s ease;
    }

    :global(html.toc-open) .right-sidebar {
      transform: translateX(0);
    }
  }
</style>
