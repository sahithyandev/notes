---
import { titleize } from "../../utils";
import type { ModuleItem } from "../../utils/types";

interface Props {
  modules: ModuleItem[];
}

const { modules } = Astro.props;
---

<div class="sb-group-title">Modules</div>
{modules.map(({ module, href, count, active, elective }) => (
  <a
    href={href}
    class={`sb-item${active ? " active" : ""}${elective ? " elective" : ""}`}
    title={elective ? "Elective" : undefined}
  >
    <span class="sb-item-name">{titleize(module)}</span>
    {elective && <span class="sr-only">(elective)</span>}
    <span class="sb-item-count">{count}</span>
  </a>
))}

<style>
  .sb-group-title {
    padding: 10px 16px 4px;
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .sb-item {
    display: flex;
    align-items: center;
    padding: 5px 16px;
    font-size: 0.78125rem;
    font-weight: 500;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    text-decoration: none;
    transition:
      background 0.1s,
      color 0.1s,
      border-color 0.1s;
    line-height: 1.35;
  }

  .sb-item:hover {
    background: var(--surface-2);
    color: var(--text-primary);
  }

  .sb-item.active {
    background: var(--sem-dim);
    color: var(--sem);
    border-left-color: var(--sem);
    font-weight: 700;
  }

  .sb-item-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-muted);
  }

  .sb-item.elective .sb-item-name {
    font-style: italic;
  }

  .sb-item.elective:not(.active) {
    color: var(--text-muted);
  }

  .sb-item.elective:not(.active):hover {
    color: var(--text-primary);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
