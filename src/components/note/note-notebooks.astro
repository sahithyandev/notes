---
import type { CollectionEntry } from "astro:content";
import MathematicaIcon from "../icons/mathematica-icon.astro";

interface Props {
  /**
   * Notebook entries listed in the note's `notebooks` frontmatter. Each one
   * links to `/notebooks/<id>.nb`, served from the .nb file under docs/.
   */
  notebooks: CollectionEntry<"notebooks">[];
  /**
   * The module's summary notebook, linked from every note in the module. It
   * is not listed in the note's frontmatter.
   */
  summary?: CollectionEntry<"notebooks"> | undefined;
}

const { notebooks, summary } = Astro.props;
const entries = summary ? [...notebooks, summary] : notebooks;
---

{entries.length > 0 && (
  <section class="note-notebooks" aria-labelledby="note-notebooks-title">
    <p class="note-notebooks-title" id="note-notebooks-title">
      {entries.length > 1
        ? "Wolfram Mathematica notebooks"
        : "Wolfram Mathematica notebook"}
    </p>
    {notebooks.length > 0 && (
      <p class="note-notebooks-desc">
        {notebooks.length > 1
          ? "Companion notebooks for this note. Open one in Mathematica and evaluate the cells to reproduce the worked example."
          : "A companion notebook for this note. Open it in Mathematica and evaluate the cells to reproduce the worked example."}
      </p>
    )}
    <ul class="note-notebooks-list">
      {entries.map((entry) => (
        <li>
          <a
            class="note-notebooks-link"
            href={entry.data.url}
            download={`${entry.id}.nb`}
          >
            <MathematicaIcon width={22} height={22} />
            <span>Download {entry.id}.nb</span>
          </a>
        </li>
      ))}
    </ul>
    {summary && (
      <p class="note-notebooks-desc">
        The summary notebook defines every function used in this module, with
        documentation and no examples, as a starting point for your own
        problems.
      </p>
    )}
  </section>
)}

<style>
  .note-notebooks {
    margin: 36px 0 0;
    font-family: var(--font-ui);
  }

  .note-notebooks-title {
    margin: 0 0 6px;
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .note-notebooks-desc {
    margin: 0 0 14px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .note-notebooks-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note-notebooks-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--sem);
    background: var(--sem-bg);
    border: 1px solid var(--sem-border);
    border-radius: 8px;
    text-decoration: none;
    transition:
      background 0.12s ease,
      border-color 0.12s ease,
      transform 0.12s ease;
  }

  .note-notebooks-link:hover {
    background: var(--sem-border);
  }

  .note-notebooks-link:active {
    transform: translateY(1px);
  }

  .note-notebooks-link svg {
    flex-shrink: 0;
  }
</style>
