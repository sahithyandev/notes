---
interface Props {
  slug: string;
  initialUp?: number;
  initialDown?: number;
}
const { slug, initialUp = 0, initialDown = 0 } = Astro.props;
---

<div class="note-feedback" data-slug={slug} aria-label="Was this note helpful?">
  <span class="note-feedback-label">Was this helpful?</span>
  <div class="note-feedback-btns">
    <button
      class="note-feedback-btn"
      data-vote="1"
      aria-label="Yes, this note was helpful"
      aria-pressed="false"
    >
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"></path>
        <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
      </svg>
      <span class="note-feedback-btn-label">Yes</span>
      <span class="note-feedback-count" data-count="up">
        {initialUp}
      </span>
    </button>

    <button
      class="note-feedback-btn"
      data-vote="-1"
      aria-label="No, this note was not helpful"
      aria-pressed="false"
    >
      <svg
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3H10z"></path>
        <path d="M17 2h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"></path>
      </svg>
      <span class="note-feedback-btn-label">No</span>
      <span class="note-feedback-count" data-count="down">
        {initialDown}
      </span>
    </button>
  </div>
</div>

<script>
  import { initNoteFeedback } from "../../scripts/note-feedback";
  initNoteFeedback();
</script>

<style>
  .note-feedback {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    font-family: var(--font-ui);
    flex-wrap: wrap;
  }

  .note-feedback-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .note-feedback-btns {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .note-feedback-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    transition:
      background 0.12s ease,
      border-color 0.12s ease,
      color 0.12s ease,
      transform 0.1s ease;
  }

  .note-feedback-btn:hover {
    color: var(--sem);
    background: var(--sem-bg);
    border-color: var(--sem-border);
  }

  .note-feedback-btn:active {
    transform: scale(0.95);
  }

  .note-feedback-btn.is-active {
    color: var(--sem);
    background: var(--sem-bg);
    border-color: var(--sem-border);
  }

  .note-feedback-btn.is-active svg {
    fill: currentColor;
    opacity: 1;
  }

  .note-feedback-btn svg {
    flex-shrink: 0;
    opacity: 0.75;
  }

  .note-feedback-btn-label {
    line-height: 1;
  }

  .note-feedback-count {
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    line-height: 1;
    min-width: 1ch;
    text-align: center;
  }

  .note-feedback-btn.is-active .note-feedback-count {
    color: currentColor;
    opacity: 0.75;
  }
</style>
