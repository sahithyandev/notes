---

---

<article data-pagefind-body>
  <slot />
</article>

<style>
  :where(article) {
    margin-top: calc(var(--spacing) * 10);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);

    h2 {
      font-family: var(--font-ui);
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      line-height: 1;
      color: var(--text-primary);
      margin: 24px 0 14px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    h2:first-child {
      margin-top: 0;
    }

    h3 {
      font-family: var(--font-ui);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.1px;
      color: var(--text-primary);
      margin: 20px 0 10px;
    }

    h4 {
      font-family: var(--font-ui);
      font-size: 1.125rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 24px 0 8px;
    }

    ul {
      list-style: disc outside;
      padding-left: 1.4rem;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 1px;
    }

    ul:has(li br) {
      gap: 6px;
    }

    li {
      max-width: 84ch;
    }

    ul li::marker {
      color: var(--sem);
    }

    ul ul {
      list-style: circle outside;
      margin-bottom: 0;
    }

    ul ul ul {
      list-style: square outside;
    }

    ol {
      padding-left: 22px;
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      list-style: decimal;
    }

    strong {
      font-weight: 700;
      color: var(--text-primary);
    }

    em {
      font-style: italic;
    }

    /* Inline code */
    code {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      background: var(--surface-2);
      border: 1px solid var(--border);
      padding: 1px 6px;
      border-radius: 4px;
      color: var(--text-primary);
      font-weight: 400;
    }

    /* Code block */
    pre {
      border-radius: 9px;
      padding: 12px 16px;
      margin: 20px 0;
      overflow-x: auto;
      position: relative;
      scrollbar-width: thin;
      scrollbar-color: var(--border-strong) transparent;
    }

    pre::-webkit-scrollbar {
      height: 6px;
    }

    pre::-webkit-scrollbar-thumb {
      background: var(--border-strong);
      border-radius: 3px;
    }

    pre,
    code {
      line-height: 1.4;
    }

    pre code {
      background: none;
      border: none;
      padding: 0;
      font-size: 0.78125rem;
      font-weight: 400;
    }

    pre .kw {
      color: #7f98f8;
    }

    pre .fn {
      color: #6fcfb0;
    }

    pre .str {
      color: #98cc98;
    }

    pre .cm {
      color: #4a5a72;
      font-style: italic;
    }

    pre .num {
      color: #e8c870;
    }

    pre .tp {
      color: #c0a8e8;
    }

    /* Language label */
    pre::before {
      content: attr(data-lang);
      position: absolute;
      top: 10px;
      right: 14px;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      transition: opacity 120ms;
    }

    pre:hover::before {
      opacity: 0;
    }

    :global(.copy-btn) {
      position: absolute;
      top: 6px;
      right: 8px;
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      font-weight: 500;
      padding: 2px 8px;
      border-radius: 5px;
      border: 1px solid var(--border);
      background: var(--surface-2, var(--surface));
      color: var(--text-2, var(--text));
      cursor: pointer;
      opacity: 0;
      transition: opacity 120ms;
      line-height: 1.6;
    }

    :global(pre:hover .copy-btn) {
      opacity: 1;
    }

    @media (hover: none) {
      :global(.copy-btn) {
        opacity: 1;
      }
    }

    /* Table */
    thead tr {
      border-bottom: 2px solid var(--border-strong);
    }

    th {
      font-size: 0.9em;
      font-weight: 700;
      letter-spacing: 0.5px;
      padding: 8px 14px;
      text-align: left;
    }

    td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      color: var(--text-secondary);
      vertical-align: top;
      line-height: 1.45;
    }

    :where(tr:last-child td) {
      border-bottom: none;
    }

    /* Key term highlight */
    .term {
      background: var(--accent-dim);
      color: var(--accent);
      border-radius: 3px;
      padding: 0 5px;
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: 0.95em;
    }

    p,
    blockquote {
      margin-bottom: 16px;
    }

    /* Additional article content styles */
    p {
      font-size: 1em;
      font-size: 1.06em;
      line-height: 1.6;
      text-wrap: pretty;

      &:not(:has(.MathJax:only-of-type)):not(:has(img:only-of-type)) {
        max-width: 84ch;
      }

      &:has(svg.block-image:only-child),
      img {
        margin-left: auto;
        margin-right: auto;
      }

      &:has(.MathJax:only-of-type) mjx-container svg,
      &:has(.MathJax):not(:has(.MathJax:only-of-type)) mjx-container svg {
        display: inline-block;
        font-size: 1.25rem;
      }

      &:has(.MathJax:only-of-type) {
        text-align: center;
      }
    }

    li {
      font-size: 1rem;
      line-height: 1.6;

      .MathJax {
        font-size: 1.25rem;

        svg {
          display: inline-block;
          margin-left: 0.25rem;
          margin-right: 0.25rem;
        }
      }
    }

    img,
    svg:not(.katex svg) {
      max-width: min(90ch, 100%);
      height: auto;
    }

    img,
    svg.block-image {
      display: block;
      margin: 0 auto;
    }

    img {
      cursor: zoom-in;
    }

    mjx-container[display="true"] svg {
      text-align: center;
      font-size: 1.25rem;
      margin: 2.5rem auto;
    }

    h2 mjx-container svg,
    h3 mjx-container svg,
    h4 mjx-container svg {
      display: inline-block !important;
    }

    .katex-display {
      text-align: center;
      font-size: 1.12rem;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
    }

    .katex-display::-webkit-scrollbar {
      display: none;
    }

    :where(table) {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
      margin: 20px 0;
      font-family: var(--font-ui);

      thead,
      tbody,
      tr {
        width: 100%;
      }

      th,
      td {
        padding: 0.5rem 1rem;
        vertical-align: middle;
      }

      .MathJax {
        display: inline-block;
        font-size: 1.25rem;
      }

      img,
      svg:not(mjx-container svg) {
        max-width: 100%;
        height: auto;
        margin: auto;
      }

      td .MathJax {
        margin: auto;
      }
    }

    strong {
      color: var(--accent);
    }

    a {
      color: var(--link, var(--sem));
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s ease;
    }

    a:hover {
      border-bottom-color: var(--link, var(--sem));
    }

    a[href^="/s1"] {
      --link: var(--s1);
    }
    a[href^="/s2"] {
      --link: var(--s2);
    }
    a[href^="/s3"] {
      --link: var(--s3);
    }
    a[href^="/s4"] {
      --link: var(--s4);
    }
    a[href^="/s5"] {
      --link: var(--s5);
    }
    a[href^="/s6"] {
      --link: var(--s6);
    }
    a[href^="/s7"] {
      --link: var(--s7);
    }
    a[href^="/s8"] {
      --link: var(--s8);
    }

    blockquote {
      font-size: 1.1rem;
      font-weight: 500;
      padding: 0.5rem 1rem;
      background-color: var(--accent-subtle);
      border-radius: 0.375rem;

      p {
        margin-bottom: 0;
      }
    }

    figure {
      /* Interactive illustration components anchor a visually-hidden
         aria-live region with position:absolute. Without a positioned
         ancestor, Chromium/WebKit (not Firefox) can place that box far
         outside the figure and blow out the page's scroll height. Every
         illustration is rooted in <figure>, so this containing block
         covers them all instead of each component setting it. */
      position: relative;

      img {
        border-radius: 0.375rem;
      }

      figcaption {
        text-align: center;
        margin: 1rem auto 0 auto;
        line-height: 1.3;
        font-size: 0.875rem;
        max-width: 64ch;
      }
    }

    @media (max-width: 48rem) {
      margin-top: 20px;
      font-size: 0.9375rem;

      h2 {
        font-size: 1.1875rem;
      }

      h3 {
        font-size: 1.0625rem;
      }

      h4 {
        font-size: 1rem;
      }

      p {
        line-height: 1.55;
      }

      p:has(.MathJax:only-of-type) mjx-container svg,
      p:has(.MathJax):not(:has(.MathJax:only-of-type)) mjx-container svg {
        font-size: 1.05rem;
      }

      li {
        font-size: 0.9375rem;

        .MathJax {
          font-size: 1.05rem;
        }
      }

      blockquote {
        font-size: 0.9375rem;
      }

      table {
        font-size: 0.8125rem;

        th,
        td {
          padding: 0.375rem 0.5rem;
        }

        .MathJax {
          font-size: 1rem;
        }
      }

      mjx-container[display="true"] svg {
        font-size: 1.05rem;
        margin: 1.5rem auto;
      }

      .katex-display {
        font-size: 1rem;
      }
    }
  }

  :global(.table-scroll) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  article :global(mjx-container[display="true"]) {
    overflow-x: auto;
    overflow-y: hidden;
  }
</style>
