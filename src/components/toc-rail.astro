---
interface Props {
  headings: { depth: 2 | 3; slug: string; text: string }[];
}

const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <>
      <div class="toc-title">On this page</div>
      <div class="toc-trail">
        {headings.map((heading, index) => (
          <div
            class={`toc-trail-segment ${heading.depth === 3 ? "toc-trail-sub" : ""}`}
            data-depth={heading.depth}
            data-index={index}
          />
        ))}
      </div>
      {headings.map((heading, index) => (
        <a
          href={`#${heading.slug}`}
          class={`toc-item ${heading.depth === 3 ? "toc-sub" : ""} ${index === 0 ? "active" : ""}`}
          data-depth={heading.depth}
          data-index={index}
        >
          {heading.text}
        </a>
      ))}
      {headings.length > 5 && <div class="toc-rule" />}
    </>
  )
}

<script>
  const headings = [...document.querySelectorAll("article h2, article h3")];
  const tocLinks = [...document.querySelectorAll(".toc-item")];
  const trailSegments = [...document.querySelectorAll(".toc-trail-segment")];

  if (headings.length > 0 && tocLinks.length > 0) {
    const positionTrailSegments = () => {
      const tocTrail = document.querySelector(".toc-trail");
      if (!tocTrail) return;
      const trailRect = tocTrail.getBoundingClientRect();
      const JOIN = 5;
      trailSegments.forEach((segment, index) => {
        const tocItem = tocLinks[index];
        if (!tocItem) return;
        const tocRect = tocItem.getBoundingClientRect();
        const relativeTop = tocRect.top - trailRect.top;
        const depth = segment.getAttribute("data-depth");
        const prevDepth = trailSegments[index - 1]?.getAttribute("data-depth");
        const nextDepth = trailSegments[index + 1]?.getAttribute("data-depth");
        const shrinkTop = prevDepth && prevDepth !== depth ? JOIN : 0;
        const shrinkBottom = nextDepth && nextDepth !== depth ? JOIN : 0;
        (segment as HTMLElement).style.top = `${relativeTop + shrinkTop}px`;
        (segment as HTMLElement).style.height =
          `${tocRect.height - shrinkTop - shrinkBottom}px`;
      });
    };

    const mqDesktop = window.matchMedia("(min-width: 48rem)");

    const updateActiveToc = () => {
      const section = document.querySelector("section");
      if (!section) return;

      const isDesktop = mqDesktop.matches;
      const viewportTop = isDesktop ? section.getBoundingClientRect().top : 0;
      const viewportHeight = isDesktop
        ? section.clientHeight
        : window.innerHeight;

      tocLinks.forEach((t) => t.classList.remove("active"));
      trailSegments.forEach((t) => t.classList.remove("active"));

      headings.forEach((heading, index) => {
        const rect = heading.getBoundingClientRect();
        const relativeTop = rect.top - viewportTop;
        const relativeBottom = relativeTop + rect.height;

        if (relativeBottom > 0 && relativeTop < viewportHeight) {
          if (tocLinks[index]) tocLinks[index].classList.add("active");
          if (trailSegments[index])
            trailSegments[index].classList.add("active");
        }
      });
    };

    positionTrailSegments();

    const section = document.querySelector("section");
    section?.addEventListener("scroll", updateActiveToc);
    window.addEventListener("scroll", updateActiveToc, { passive: true });

    updateActiveToc();

    window.addEventListener("resize", positionTrailSegments);

    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (!href) return;
        const targetId = href.substring(1);
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }
      });
    });
  }
</script>

<style>
  .toc-title {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 10px;
    padding-left: 14px;
  }

  .toc-item {
    display: block;
    padding: 2px 14px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color 0.12s,
      border-color 0.12s;
    line-height: 1.4;
  }

  .toc-item:hover {
    color: var(--text-secondary);
  }

  .toc-item.active {
    color: var(--sem);
    font-weight: 700;
  }

  .toc-sub {
    padding-left: 24px;
    font-size: 0.71875rem;
  }

  .toc-rule {
    height: 1px;
    background: var(--border);
    margin: 10px 14px;
  }

  .toc-trail {
    position: absolute;
    left: 0;
    top: 32px;
    bottom: 32px;
    width: 14px;
    pointer-events: none;
  }

  .toc-trail-segment {
    position: absolute;
    left: 5px;
    width: 2px;
    background: var(--border);
    transition: background 0.2s ease;
  }

  .toc-trail-segment:first-of-type {
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
  }

  .toc-trail-segment:last-of-type {
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
  }

  .toc-trail-segment.active {
    background: var(--sem);
  }

  .toc-trail-sub {
    left: 15px;
  }

  .toc-trail-segment[data-depth="2"]
    + .toc-trail-segment[data-depth="3"]::before,
  .toc-trail-segment[data-depth="3"]
    + .toc-trail-segment[data-depth="2"]::before {
    border-radius: 1px;
    content: "";
    position: absolute;
    width: 15.9px;
    height: 2px;
    background: var(--border);
    transform-origin: left center;
  }

  .toc-trail-segment[data-depth="2"]
    + .toc-trail-segment[data-depth="3"]::before {
    left: -9.6px;
    top: -12px;
    transform: rotate(45deg);
  }

  .toc-trail-segment[data-depth="3"]
    + .toc-trail-segment[data-depth="2"]::before {
    left: 11.5px;
    top: -12px;
    transform: rotate(135deg);
  }

  .toc-trail-segment[data-depth="2"].active
    + .toc-trail-segment[data-depth="3"]::before,
  .toc-trail-segment[data-depth="2"]
    + .toc-trail-segment[data-depth="3"].active::before,
  .toc-trail-segment[data-depth="3"].active
    + .toc-trail-segment[data-depth="2"]::before,
  .toc-trail-segment[data-depth="3"]
    + .toc-trail-segment[data-depth="2"].active::before {
    background: var(--sem);
  }

  @media (max-width: 47.99rem) {
    .toc-rail {
      position: fixed;
      top: var(--nav-h);
      right: 0;
      height: calc(100dvh - var(--nav-h));
      width: min(280px, 85vw);
      z-index: 50;
      transform: translateX(100%);
      background: var(--surface);
      border-left: 1px solid var(--border);
      box-shadow: -2px 0 18px rgba(0, 0, 0, 0.18);
      padding: 20px 16px 20px 0;
      overflow-y: auto;
    }

    html.drawers-ready .toc-rail {
      transition: transform 0.22s ease;
    }

    html.toc-open .toc-rail {
      transform: translateX(0);
    }

    .toc-trail {
      top: 52px;
      bottom: 20px;
    }
  }
</style>
