<dialog id="search-modal" aria-label="Search notes">
    <div class="sm-inner">
        <div class="sm-input-row">
            <svg
                class="sm-icon"
                width="15"
                height="15"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <circle cx="6.5" cy="6.5" r="5"></circle>
                <path d="M10.5 10.5l4 4"></path>
            </svg>
            <input
                id="search-input"
                type="search"
                placeholder="Search notes…"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search"
                aria-controls="search-results"
                aria-autocomplete="list"
            />
            <kbd class="sm-esc">ESC</kbd>
        </div>
        <div id="search-results" role="listbox" aria-label="Search results"></div>
        <div class="sm-footer">
            <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
            <span><kbd>↵</kbd> open</span>
            <span><kbd>ESC</kbd> close</span>
        </div>
    </div>
</dialog>

<script>
    const IS_DEV = import.meta.env.DEV;
    let pagefind: any = null;
    let pagefindReady = false;
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;
    let selectedIndex = -1;

    const modal = document.getElementById("search-modal") as HTMLDialogElement;
    const input = document.getElementById("search-input") as HTMLInputElement;
    const resultsEl = document.getElementById("search-results") as HTMLElement;

    const EXCEPTIONS = new Set(["and", "or", "the", "a", "an"]);
    function titleize(s: string): string {
        return s
            .split("-")
            .map((w) => (EXCEPTIONS.has(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)))
            .join(" ");
    }

    function parseUrl(url: string) {
        const parts = url.replace(/^\//, "").split("/").filter(Boolean);
        const semPart = parts[0] ?? "";
        const semMatch = semPart.match(/^s(\d+)$/);
        return {
            semSlug: semPart,
            semNumber: semMatch ? parseInt(semMatch[1]) : null,
            semLabel: semMatch ? `Semester ${semMatch[1]}` : titleize(semPart),
            moduleSlug: parts[1] ?? "",
            moduleLabel: titleize(parts[1] ?? ""),
            groupKey: `${semPart}/${parts[1] ?? ""}`,
        };
    }

    function escHtml(s: string): string {
        return s
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    async function ensurePagefind(): Promise<boolean> {
        if (IS_DEV) return false;
        if (pagefindReady) return true;
        try {
            // Use eval to bypass Vite's static analysis
            // @ts-ignore
            const pf = await eval('import("/pagefind/pagefind.js")');
            pagefind = pf;
            await pagefind.init();
            pagefindReady = true;
            return true;
        } catch {
            return false;
        }
    }

    function openModal() {
        modal.showModal();
        input.value = "";
        selectedIndex = -1;
        if (IS_DEV) {
            input.disabled = true;
            input.placeholder = "Search disabled in dev";
            resultsEl.innerHTML = `<div class="sr-empty">Search is disabled in development.<br/>Run <code>bun build &amp;&amp; bun preview</code> to try it.</div>`;
        } else {
            resultsEl.innerHTML = `<div class="sr-idle"><span class="sr-idle-prompt">$&nbsp;<span class="sr-idle-cursor">_</span></span><span class="sr-idle-hint">All notes indexed. Awaiting query.</span></div>`;
            requestAnimationFrame(() => input.focus());
        }
    }

    function closeModal() {
        modal.close();
        input.value = "";
        selectedIndex = -1;
    }

    type ParsedUrl = ReturnType<typeof parseUrl>;

    function renderResults(
        groups: Map<string, { parsed: ParsedUrl; data: any }[]> | null,
        query: string
    ) {
        if (!query) {
            resultsEl.innerHTML = "";
            return;
        }
        if (!groups || groups.size === 0) {
            resultsEl.innerHTML = `<div class="sr-empty">No results for "<strong>${escHtml(query)}</strong>"</div>`;
            selectedIndex = -1;
            return;
        }

        const frags: string[] = [];
        for (const [, items] of groups) {
            const first = items[0].parsed;
            const semN = first.semNumber;
            const semColor = semN ? `var(--s${semN})` : "var(--text-muted)";
            frags.push(`
                <div class="sr-group">
                    <span class="sr-group-dot" style="background:${semColor}"></span>
                    ${escHtml(first.semLabel)} &rsaquo; ${escHtml(first.moduleLabel)}
                </div>
            `);
            for (const { data, parsed } of items) {
                const path = `${parsed.semLabel} / ${parsed.moduleLabel}`;
                const title = data.meta?.title ?? parsed.moduleLabel;
                frags.push(`
                    <a class="sr-item" href="${escHtml(data.url)}" role="option" aria-selected="false">
                        <div class="sr-item-path">${escHtml(path)}</div>
                        <div class="sr-item-title">${escHtml(title)}</div>
                        <div class="sr-item-excerpt">${data.excerpt ?? ""}</div>
                    </a>
                `);
            }
        }
        resultsEl.innerHTML = frags.join("");
        selectedIndex = -1;
    }

    function getItems(): HTMLAnchorElement[] {
        return Array.from(resultsEl.querySelectorAll<HTMLAnchorElement>(".sr-item"));
    }

    function setSelected(index: number) {
        const items = getItems();
        items.forEach((el, i) => {
            const active = i === index;
            el.setAttribute("aria-selected", active ? "true" : "false");
            if (active) el.scrollIntoView({ block: "nearest" });
        });
        selectedIndex = index;
    }

    async function doSearch(query: string) {
        if (!query) {
            renderResults(null, "");
            return;
        }
        const ready = await ensurePagefind();
        if (!ready) {
            resultsEl.innerHTML = `<div class="sr-empty">Search is only available in the production build.</div>`;
            return;
        }
        const search = await pagefind.search(query);
        const top5 = search.results.slice(0, 5);
        const dataArr: any[] = await Promise.all(top5.map((r: any) => r.data()));

        const groups = new Map<string, { parsed: ParsedUrl; data: any }[]>();
        for (const data of dataArr) {
            const parsed = parseUrl(data.url);
            if (!groups.has(parsed.groupKey)) groups.set(parsed.groupKey, []);
            groups.get(parsed.groupKey)!.push({ parsed, data });
        }
        renderResults(groups, query);
    }

    input.addEventListener("input", () => {
        const query = input.value.trim();
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => doSearch(query), 200);
    });

    modal.addEventListener("keydown", (e: KeyboardEvent) => {
        const items = getItems();
        if (items.length === 0) return;
        if (e.key === "ArrowDown") {
            e.preventDefault();
            setSelected(Math.min(selectedIndex + 1, items.length - 1));
        } else if (e.key === "ArrowUp") {
            e.preventDefault();
            setSelected(Math.max(selectedIndex - 1, 0));
        } else if (e.key === "Enter" && selectedIndex >= 0) {
            e.preventDefault();
            const href = items[selectedIndex].getAttribute("href");
            if (href) {
                closeModal();
                window.location.href = href;
            }
        }
    });

    modal.addEventListener("click", (e: MouseEvent) => {
        const rect = modal.getBoundingClientRect();
        const inside =
            e.clientX >= rect.left &&
            e.clientX <= rect.right &&
            e.clientY >= rect.top &&
            e.clientY <= rect.bottom;
        if (!inside) closeModal();
    });

    modal.addEventListener("close", () => {
        input.value = "";
        selectedIndex = -1;
    });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
            e.preventDefault();
            if (modal.open) closeModal();
            else openModal();
        }
    });

    document.getElementById("search-trigger")?.addEventListener("click", openModal);
</script>

<style>
    #search-modal::backdrop {
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(4px);
    }

    :global([data-theme="dark"]) #search-modal::backdrop {
        background: rgba(0, 0, 0, 0.65);
    }

    #search-modal {
        position: fixed;
        top: 12vh;
        left: 50%;
        transform: translateX(-50%);
        width: min(640px, 92vw);
        max-height: 72vh;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 14px;
        padding: 0;
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.22);
        overflow: hidden;
        display: none;
        flex-direction: column;
        color: var(--text-primary);
        font-family: var(--font-ui);
    }

    #search-modal[open] {
        display: flex;
    }

    :global([data-theme="dark"]) #search-modal {
        box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
    }

    .sm-inner {
        display: flex;
        flex-direction: column;
        max-height: 72vh;
        overflow: hidden;
    }

    .sm-input-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .sm-icon {
        color: var(--text-muted);
        flex-shrink: 0;
    }

    #search-input {
        flex: 1;
        border: none;
        background: transparent;
        font-family: var(--font-ui);
        font-size: 15px;
        font-weight: 500;
        color: var(--text-primary);
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        min-width: 0;
    }

    #search-input::placeholder {
        color: var(--text-muted);
    }

    #search-input::-webkit-search-cancel-button {
        display: none;
    }

    .sm-esc {
        font-family: var(--font-mono);
        font-size: 10px;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 2px 6px;
        color: var(--text-muted);
        flex-shrink: 0;
    }

    #search-results {
        flex: 1;
        overflow-y: auto;
        padding: 6px 0;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
        min-height: 0;
    }

    :global(.sr-group) {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 10px 16px 4px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    :global(.sr-group-dot) {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        flex-shrink: 0;
    }

    :global(.sr-item) {
        display: block;
        padding: 10px 16px;
        cursor: pointer;
        border-left: 2px solid transparent;
        text-decoration: none;
        transition:
            background 0.08s,
            border-color 0.08s;
    }

    :global(.sr-item:hover),
    :global(.sr-item[aria-selected="true"]) {
        background: var(--accent-subtle);
        border-left-color: var(--accent);
    }

    :global(.sr-item-path) {
        font-size: 10.5px;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 3px;
        letter-spacing: 0.15px;
    }

    :global(.sr-item-title) {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.2px;
        margin-bottom: 4px;
    }

    :global(.sr-item-excerpt) {
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--text-secondary);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    :global(.sr-item-excerpt mark) {
        background: var(--accent-dim);
        color: var(--accent);
        border-radius: 2px;
        padding: 0 2px;
        font-weight: 600;
    }

    :global(.sr-empty) {
        padding: 36px 16px;
        text-align: center;
        color: var(--text-muted);
        font-size: 13.5px;
    }

    :global(.sr-idle) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 36px 16px;
    }

    :global(.sr-idle-prompt) {
        font-family: var(--font-mono);
        font-size: 15px;
        font-weight: 500;
        color: var(--text-secondary);
    }

    :global(.sr-idle-cursor) {
        animation: sr-blink 1.1s step-start infinite;
    }

    :global(.sr-idle-hint) {
        font-size: 12px;
        color: var(--text-muted);
    }

    .sm-footer {
        display: flex;
        gap: 16px;
        padding: 9px 16px;
        border-top: 1px solid var(--border);
        flex-shrink: 0;
        font-size: 11px;
        color: var(--text-muted);
        font-family: var(--font-mono);
    }

    .sm-footer kbd {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 3px;
        padding: 1px 5px;
        font-size: 10px;
        font-family: var(--font-mono);
        margin-right: 3px;
    }
</style>

<style is:global>
    @keyframes sr-blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }
</style>
