<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-tag">
      <div class="hero-tag-dot"></div> Computer Science · 8 Semesters
    </div>
    <h1 class="hero-title">
      Navigate your degree,<br /><em>one concept at a time.</em>
    </h1>
    <p class="hero-sub">
      Structured university notes from foundations through capstone - organized
      by semester, searchable by topic.
    </p>
    <div class="hero-cta">
      <a href="#semesters" class="btn-primary">
        Browse Semesters
        <svg
          width="13"
          height="13"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
        >
          <path d="M3 8h10M8 3l5 5-5 5"></path>
        </svg>
      </a>
      <a href="Short Notes.html" class="btn-ghost">View Sample Notes</a>
    </div>
    <div class="sem-strip">
      <a href="#" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s1)"></div><span
          class="sem-chip-name">Semester 1</span
        >
      </a>
      <a href="#" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s2)"></div><span
          class="sem-chip-name">Semester 2</span
        >
      </a>
      <a href="Short Notes.html" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s3)"></div><span
          class="sem-chip-name">Semester 3</span
        >
      </a>
      <a href="#" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s4)"></div><span
          class="sem-chip-name">Semester 4</span
        >
      </a>
      <a href="#" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s5)"></div><span
          class="sem-chip-name">Semester 5</span
        >
      </a>
      <a href="#" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s6)"></div><span
          class="sem-chip-name">Semester 6</span
        >
      </a>
      <a href="#" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s7)"></div><span
          class="sem-chip-name">Semester 7</span
        >
      </a>
      <a href="#" class="sem-chip">
        <div class="sem-chip-dot" style="background:var(--s8)"></div><span
          class="sem-chip-name">Semester 8</span
        >
      </a>
    </div>
  </div>
</section>

<style>
  /* ── HERO ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    background: #090a12;
    padding: 88px 36px 0;
  }

  /* Dot grid */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.12) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 0%,
      black 20%,
      transparent 80%
    );
  }

  /* Color wash */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 55% 65% at 15% 50%,
        rgba(51, 72, 200, 0.28) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 45% 55% at 85% 20%,
        rgba(107, 56, 160, 0.18) 0%,
        transparent 55%
      ),
      radial-gradient(
        ellipse 35% 45% at 65% 95%,
        rgba(14, 122, 150, 0.14) 0%,
        transparent 50%
      );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 30px;
    padding: 4px 12px 4px 8px;
    border-radius: 99px;
    background: rgba(51, 72, 200, 0.15);
    border: 1px solid rgba(51, 72, 200, 0.28);
    font-size: 11.5px;
    font-weight: 600;
    color: #8fa4f0;
    letter-spacing: 0.2px;
  }

  .hero-tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--accent);
  }

  .hero-title {
    font-size: clamp(40px, 4.8vw, 60px);
    font-weight: 800;
    color: #edf0fa;
    line-height: 1.02;
    letter-spacing: -2px;
    margin-bottom: 22px;
    max-width: 700px;
  }

  .hero-title em {
    font-style: normal;
    color: #7f98f8;
  }

  .hero-sub {
    font-size: 16.5px;
    line-height: 1.7;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.42);
    max-width: 500px;
    margin-bottom: 38px;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 80px;
  }


  .btn-primary {
    padding: 11px 22px;
    border-radius: 8px;
    background: var(--accent);
    border: none;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 13.5px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.1px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition:
      background 0.14s,
      transform 0.1s,
      box-shadow 0.14s;
    box-shadow: 0 0 0 0 rgba(51, 72, 200, 0);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(51, 72, 200, 0.45);
  }

  .btn-ghost {
    padding: 10px 20px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 13.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition:
      border-color 0.14s,
      color 0.14s;
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.26);
    color: #fff;
  }

  /* Semester scroll strip */
  .sem-strip {
    display: flex;
    gap: 8px;
    padding-bottom: 32px;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 32px,
      black calc(100% - 32px),
      transparent
    );
  }

  .sem-strip::-webkit-scrollbar {
    display: none;
  }

  .sem-chip {
    flex-shrink: 0;
    padding: 7px 16px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    cursor: pointer;
    text-decoration: none;
    transition:
      background 0.12s,
      border-color 0.12s;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .sem-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.18);
  }

  .sem-chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .sem-chip-name {
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
  }
</style>
