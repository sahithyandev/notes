---
// Hero section component with bold typography and gradients
import { Book, Code, Beaker, ArrowRight } from '@lucide/astro';
---

<section class="hero-section">
  <div class="hero-content">
    <div class="hero-text">
      <h1 class="hero-title">
        <span class="gradient-text">Sahithyan's</span>
        <br />
        <span class="gradient-text-secondary">Notes</span>
      </h1>
      <p class="hero-description">
        Organized, clear, and comprehensive study materials across 8 semesters. 
        Navigate through modules effortlessly and excel in your academic journey.
      </p>
    </div>
    <div class="hero-illustration">
      <div class="module-codes-background">
        <svg class="module-codes-svg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="modulePattern" x="0" y="0" width="80" height="80" patternUnits="userSpaceOnUse">
              <text x="10" y="25" class="module-code-text" fill="rgba(30, 64, 175, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS101</text>
              <text x="50" y="45" class="module-code-text" fill="rgba(5, 150, 105, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS201</text>
              <text x="15" y="65" class="module-code-text" fill="rgba(124, 58, 237, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS301</text>
              <text x="45" y="15" class="module-code-text" fill="rgba(220, 38, 38, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS401</text>
              <text x="5" y="35" class="module-code-text" fill="rgba(234, 88, 12, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS501</text>
              <text x="55" y="55" class="module-code-text" fill="rgba(8, 145, 178, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS601</text>
              <text x="25" y="75" class="module-code-text" fill="rgba(190, 18, 60, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS701</text>
              <text x="35" y="5" class="module-code-text" fill="rgba(67, 56, 202, 0.08)" font-family="monospace" font-size="14" font-weight="600">CS801</text>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#modulePattern)" />
        </svg>
      </div>
      <div class="floating-elements">
        <div class="floating-element element-1">CS101</div>
        <div class="floating-element element-2">CS201</div>
        <div class="floating-element element-3">CS301</div>
        <div class="floating-element element-4">CS401</div>
        <div class="floating-element element-5">DS501</div>
        <div class="floating-element element-6">AI601</div>
      </div>
    </div>
  </div>
  <div class="hero-gradient-bg"></div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: hidden;
    background: linear-gradient(135deg, #fafbfc 0%, #f1f5f9 25%, #e2e8f0 100%);
  }

  [data-theme="dark"] .hero-section {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
  }

  .hero-gradient-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(102, 126, 234, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(240, 147, 251, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 40%, rgba(79, 172, 254, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    max-width: 1200px;
    width: 100%;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-text {
    animation: slideInLeft 0.8s ease-out;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-text-secondary {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-description {
    font-size: 1.25rem;
    color: #4a5568;
    line-height: 1.6;
    margin-bottom: 3rem;
    max-width: 500px;
  }

  [data-theme="dark"] .hero-description {
    color: #cbd5e0;
  }

  .hero-stats {
    display: flex;
    gap: 3rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-number {
    font-size: 2.5rem;
    font-weight: 800;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #718096;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  [data-theme="dark"] .stat-label {
    color: #a0aec0;
  }

  .hero-illustration {
    position: relative;
    height: 400px;
    animation: slideInRight 0.8s ease-out;
  }

  .module-codes-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.6;
  }

  .module-codes-svg {
    width: 100%;
    height: 100%;
  }

  .floating-elements {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .floating-element {
    position: absolute;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-family: monospace;
    font-weight: 700;
    font-size: 1rem;
    color: #1e40af;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  [data-theme="dark"] .floating-element {
    background: rgba(30, 41, 59, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #60a5fa;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .floating-element:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
  }

  .element-1 {
    top: 15%;
    left: 20%;
    animation: float 6s ease-in-out infinite;
  }

  .element-2 {
    top: 25%;
    right: 25%;
    animation: float 8s ease-in-out infinite 2s;
  }

  .element-3 {
    top: 45%;
    left: 15%;
    animation: float 7s ease-in-out infinite 1s;
  }

  .element-4 {
    top: 55%;
    right: 15%;
    animation: float 9s ease-in-out infinite 3s;
  }

  .element-5 {
    top: 70%;
    left: 30%;
    animation: float 6.5s ease-in-out infinite 2.5s;
  }

  .element-6 {
    top: 35%;
    right: 35%;
    animation: float 7.5s ease-in-out infinite 1.5s;
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  @media (max-width: 768px) {
    .hero-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .hero-illustration {
      height: 300px;
      margin-top: 2rem;
    }

    .hero-stats {
      justify-content: center;
    }

    .floating-card {
      transform: scale(0.8);
    }

    .card-1 {
      top: 10%;
      left: 20%;
    }

    .card-2 {
      top: 40%;
      right: 10%;
    }

    .card-3 {
      bottom: 10%;
      left: 40%;
    }
  }
</style>
