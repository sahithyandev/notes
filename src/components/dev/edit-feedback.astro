---
// Dev-only: select text in this note's <article> and attach a comment to
// get a proposed edit back from src/integrations/edit-feedback/ (a
// long-lived headless `claude` session). Only rendered under
// import.meta.env.DEV by [...slug].astro, so none of this reaches a
// production build. The review panel for what this submits lives in the
// site-wide <EditFeedbackBar /> (src/components/dev/edit-feedback-bar.astro,
// mounted by Layout.astro), not here - this component only captures the
// selection and posts the request.
interface Props {
  filePath: string;
}
const { filePath } = Astro.props;
---

<div id="edit-feedback-selection" data-file-path={filePath}>
  <button type="button" class="ef-select-btn" data-ef-select-btn hidden>
    Suggest edit
  </button>

  <div class="ef-popover" data-ef-popover hidden>
    <textarea
      class="ef-comment"
      data-ef-comment
      placeholder="What should change? (⌘/Ctrl+Enter to send)"
      rows="3"
    ></textarea>
    <div class="ef-popover-actions">
      <button type="button" class="ef-btn ef-btn-ghost" data-ef-cancel>
        Cancel
      </button>
      <button type="button" class="ef-btn ef-btn-primary" data-ef-submit>
        Send
      </button>
    </div>
  </div>
</div>

<script>
  interface PendingSelection {
    text: string;
    heading?: string;
    context?: string;
  }

  function init() {
    const root = document.getElementById("edit-feedback-selection");
    if (!root) return;

    const filePath = root.dataset.filePath ?? "";
    const article = document.querySelector("article");
    if (!article) return;

    const selectBtn = root.querySelector<HTMLButtonElement>(
      "[data-ef-select-btn]",
    )!;
    const popover = root.querySelector<HTMLElement>("[data-ef-popover]")!;
    const commentInput =
      root.querySelector<HTMLTextAreaElement>("[data-ef-comment]")!;
    const submitBtn =
      root.querySelector<HTMLButtonElement>("[data-ef-submit]")!;
    const cancelBtn =
      root.querySelector<HTMLButtonElement>("[data-ef-cancel]")!;

    let pendingSelection: PendingSelection | null = null;

    function nearestHeading(node: Node | null): string | undefined {
      let el: Element | null =
        node instanceof Element ? node : (node?.parentElement ?? null);
      while (el && el !== article) {
        let sib: Element | null = el;
        while (sib) {
          if (/^H[2-4]$/.test(sib.tagName)) return sib.textContent?.trim();
          sib = sib.previousElementSibling;
        }
        el = el.parentElement;
      }
      return undefined;
    }

    // Katex renders each formula as MathML + a raw-TeX <annotation>; swap
    // the rendered glyphs for "$tex$" so the captured selection reads as
    // Markdown source, not KaTeX's visual output.
    function serializeRange(range: Range): string {
      const clone = range.cloneContents();
      const wrapper = document.createElement("div");
      wrapper.appendChild(clone);
      wrapper.querySelectorAll(".katex").forEach((katex) => {
        const tex = katex.querySelector(
          'annotation[encoding="application/x-tex"]',
        )?.textContent;
        const displayMode = katex.closest(".katex-display") !== null;
        const delim = displayMode ? "$$" : "$";
        katex.replaceWith(
          document.createTextNode(`${delim}${tex ?? ""}${delim}`),
        );
      });
      return wrapper.textContent?.trim() ?? "";
    }

    function surroundingContext(range: Range): string {
      const full = article!.textContent ?? "";
      const before =
        range.startContainer.textContent?.slice(0, range.startOffset) ?? "";
      const idx = full.indexOf(before.slice(-40));
      if (idx === -1) return "";
      const start = Math.max(0, idx - 100);
      return full.slice(start, idx + 140);
    }

    // Reads the current selection and, if it's a non-empty selection inside
    // the article, stashes it as pendingSelection and positions the button
    // above it. Returns whether there was a usable selection.
    function captureSelection(): boolean {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || sel.rangeCount === 0) return false;
      const range = sel.getRangeAt(0);
      if (!article!.contains(range.commonAncestorContainer)) return false;
      const text = serializeRange(range);
      if (!text) return false;

      pendingSelection = {
        text,
        heading: nearestHeading(range.startContainer),
        context: surroundingContext(range),
      };
      const rect = range.getBoundingClientRect();
      selectBtn.style.top = `${rect.top + window.scrollY - 36}px`;
      selectBtn.style.left = `${rect.left + window.scrollX}px`;
      return true;
    }

    // The button only appears once the selection has settled (mouseup/
    // touchend/keyup, not on every intermediate selectionchange fired while
    // dragging), and only after a short delay so a quick click-and-release
    // that immediately collapses the selection again doesn't flash it.
    const SHOW_DELAY_MS = 200;
    let showTimer: ReturnType<typeof setTimeout> | null = null;

    function clearShowTimer(): void {
      if (showTimer !== null) {
        clearTimeout(showTimer);
        showTimer = null;
      }
    }

    function scheduleShowButton(): void {
      clearShowTimer();
      showTimer = setTimeout(() => {
        showTimer = null;
        selectBtn.hidden = !captureSelection();
      }, SHOW_DELAY_MS);
    }

    document.addEventListener("selectionchange", () => {
      // Covers both an active drag (selection still changing) and the
      // selection being cleared: hide immediately and cancel any pending
      // show so a stale button can't flash in mid-drag.
      clearShowTimer();
      selectBtn.hidden = true;
    });

    document.addEventListener("mouseup", scheduleShowButton);
    document.addEventListener("touchend", scheduleShowButton);
    document.addEventListener("keyup", (e) => {
      // Keyboard selection (Shift+Arrow/Home/End) ends on keyup of the
      // shift combo, with no mouseup to hook into.
      if (e.key === "Shift" || e.shiftKey) scheduleShowButton();
    });

    selectBtn.addEventListener("click", () => {
      if (!pendingSelection) return;
      const rect = selectBtn.getBoundingClientRect();
      popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
      popover.style.left = `${rect.left + window.scrollX}px`;
      popover.hidden = false;
      selectBtn.hidden = true;
      commentInput.value = "";
      commentInput.focus();
    });

    cancelBtn.addEventListener("click", () => {
      popover.hidden = true;
    });

    async function submitFeedback() {
      if (!pendingSelection) return;
      const comment = commentInput.value.trim();
      if (!comment) return;

      popover.hidden = true;

      await fetch("/__edit-feedback/request", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind: "selection",
          filePath,
          selection: pendingSelection.text,
          heading: pendingSelection.heading,
          context: pendingSelection.context,
          comment,
        }),
      });
      pendingSelection = null;
      window.getSelection()?.removeAllRanges();
      document.dispatchEvent(new CustomEvent("ef-panel-open-request"));
    }

    submitBtn.addEventListener("click", submitFeedback);
    commentInput.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
        e.preventDefault();
        void submitFeedback();
      }
    });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  #edit-feedback-selection {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .ef-select-btn {
    position: absolute;
    z-index: 60;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 0.75rem;
    font-family: var(--font-ui);
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }

  .ef-select-btn:hover {
    border-color: var(--sem, var(--border-strong));
  }

  .ef-popover {
    position: absolute;
    z-index: 61;
    width: min(320px, 90vw);
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 8px;
    padding: 10px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .ef-comment {
    width: 100%;
    box-sizing: border-box;
    resize: vertical;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 8px;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
  }

  .ef-popover-actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 8px;
  }

  .ef-btn {
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-family: var(--font-ui);
    cursor: pointer;
    border: 1px solid transparent;
  }

  .ef-btn-primary {
    background: var(--sem, #2563eb);
    color: #fff;
  }

  .ef-btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text-secondary);
  }
</style>
