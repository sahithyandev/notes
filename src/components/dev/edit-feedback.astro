---
// Dev-only: select text in this note's <article> and attach a comment to
// get a proposed edit back from src/integrations/edit-feedback/ (a
// long-lived headless `claude` session). Only rendered under
// import.meta.env.DEV by [...slug].astro, so none of this reaches a
// production build.
//
// The proposal, and its Apply/Discard/Refine controls, render inline in the
// article right after the selected text - not in the site-wide review
// panel (that panel, in edit-feedback-bar.astro, is only for whole-note /
// cross-note feedback, which has no single spot in the body to anchor to).
interface Props {
  filePath: string;
}
const { filePath } = Astro.props;
---

<div id="edit-feedback-selection" data-file-path={filePath}>
  <button type="button" class="ef-select-btn" data-ef-select-btn hidden>
    Suggest edit
  </button>

  <div class="ef-popover" data-ef-popover hidden>
    <textarea
      class="ef-comment"
      data-ef-comment
      placeholder="What should change? (⌘/Ctrl+Enter to send)"
      rows="3"
    ></textarea>
    <div class="ef-popover-actions">
      <button type="button" class="ef-btn ef-btn-ghost" data-ef-cancel>
        Cancel
      </button>
      <button type="button" class="ef-btn ef-btn-primary" data-ef-submit>
        Send
      </button>
    </div>
  </div>
</div>

<script>
  interface FileChange {
    file: string;
    edits: { old: string; new: string }[];
  }

  interface FeedbackItem {
    id: string;
    kind: "selection" | "whole-note";
    files: string[];
    selection?: string;
    heading?: string;
    comment: string;
    status:
      "queued" | "running" | "proposed" | "error" | "applied" | "discarded";
    progress: string[];
    summary?: string;
    changes?: FileChange[];
    deletions?: string[];
    error?: string;
  }

  interface PendingSelection {
    text: string;
    heading?: string;
    context?: string;
    range: Range;
  }

  function init() {
    const root = document.getElementById("edit-feedback-selection");
    if (!root) return;

    const filePath = root.dataset.filePath ?? "";
    const article = document.querySelector("article");
    if (!article) return;

    const selectBtn = root.querySelector<HTMLButtonElement>(
      "[data-ef-select-btn]",
    )!;
    const popover = root.querySelector<HTMLElement>("[data-ef-popover]")!;
    const commentInput =
      root.querySelector<HTMLTextAreaElement>("[data-ef-comment]")!;
    const submitBtn =
      root.querySelector<HTMLButtonElement>("[data-ef-submit]")!;
    const cancelBtn =
      root.querySelector<HTMLButtonElement>("[data-ef-cancel]")!;

    let pendingSelection: PendingSelection | null = null;

    function nearestHeading(node: Node | null): string | undefined {
      let el: Element | null =
        node instanceof Element ? node : (node?.parentElement ?? null);
      while (el && el !== article) {
        let sib: Element | null = el;
        while (sib) {
          if (/^H[2-4]$/.test(sib.tagName)) return sib.textContent?.trim();
          sib = sib.previousElementSibling;
        }
        el = el.parentElement;
      }
      return undefined;
    }

    // Katex renders each formula as MathML + a raw-TeX <annotation>; swap
    // the rendered glyphs for "$tex$" so the captured selection reads as
    // Markdown source, not KaTeX's visual output.
    function serializeRange(range: Range): string {
      const clone = range.cloneContents();
      const wrapper = document.createElement("div");
      wrapper.appendChild(clone);
      wrapper.querySelectorAll(".katex").forEach((katex) => {
        const tex = katex.querySelector(
          'annotation[encoding="application/x-tex"]',
        )?.textContent;
        const displayMode = katex.closest(".katex-display") !== null;
        const delim = displayMode ? "$$" : "$";
        katex.replaceWith(
          document.createTextNode(`${delim}${tex ?? ""}${delim}`),
        );
      });
      return wrapper.textContent?.trim() ?? "";
    }

    function surroundingContext(range: Range): string {
      const full = article!.textContent ?? "";
      const before =
        range.startContainer.textContent?.slice(0, range.startOffset) ?? "";
      const idx = full.indexOf(before.slice(-40));
      if (idx === -1) return "";
      const start = Math.max(0, idx - 100);
      return full.slice(start, idx + 140);
    }

    // Reads the current selection and, if it's a non-empty selection inside
    // the article, stashes it (including the live Range, so the eventual
    // proposal can be anchored right after it in the body) and positions
    // the button above it. Returns whether there was a usable selection.
    function captureSelection(): boolean {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || sel.rangeCount === 0) return false;
      const range = sel.getRangeAt(0);
      if (!article!.contains(range.commonAncestorContainer)) return false;
      const text = serializeRange(range);
      if (!text) return false;

      pendingSelection = {
        text,
        heading: nearestHeading(range.startContainer),
        context: surroundingContext(range),
        range: range.cloneRange(),
      };
      const rect = range.getBoundingClientRect();
      selectBtn.style.top = `${rect.top + window.scrollY - 36}px`;
      selectBtn.style.left = `${rect.left + window.scrollX}px`;
      return true;
    }

    // The button only appears once the selection has settled (mouseup/
    // touchend/keyup, not on every intermediate selectionchange fired while
    // dragging), and only after a short delay so a quick click-and-release
    // that immediately collapses the selection again doesn't flash it.
    const SHOW_DELAY_MS = 200;
    let showTimer: ReturnType<typeof setTimeout> | null = null;

    function clearShowTimer(): void {
      if (showTimer !== null) {
        clearTimeout(showTimer);
        showTimer = null;
      }
    }

    function scheduleShowButton(): void {
      clearShowTimer();
      showTimer = setTimeout(() => {
        showTimer = null;
        selectBtn.hidden = !captureSelection();
      }, SHOW_DELAY_MS);
    }

    document.addEventListener("selectionchange", () => {
      // Covers both an active drag (selection still changing) and the
      // selection being cleared: hide immediately and cancel any pending
      // show so a stale button can't flash in mid-drag.
      clearShowTimer();
      selectBtn.hidden = true;
    });

    document.addEventListener("mouseup", scheduleShowButton);
    document.addEventListener("touchend", scheduleShowButton);
    document.addEventListener("keyup", (e) => {
      // Keyboard selection (Shift+Arrow/Home/End) ends on keyup of the
      // shift combo, with no mouseup to hook into.
      if (e.key === "Shift" || e.shiftKey) scheduleShowButton();
    });

    selectBtn.addEventListener("click", () => {
      if (!pendingSelection) return;
      const rect = selectBtn.getBoundingClientRect();
      popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
      popover.style.left = `${rect.left + window.scrollX}px`;
      popover.hidden = false;
      selectBtn.hidden = true;
      commentInput.value = "";
      commentInput.focus();
    });

    cancelBtn.addEventListener("click", () => {
      popover.hidden = true;
    });

    // --- inline anchors: one marker element per submitted item, inserted
    // right after the selected text, never modifying the selected text
    // itself. Safer than wrapping the selection (which throws if the range
    // partially crosses an element boundary) and keeps Apply/Discard/Refine
    // exactly where the feedback was given, not in a corner popup. -------

    function closestBlock(node: Node): Element | null {
      let el: Element | null =
        node instanceof Element ? node : node.parentElement;
      while (el && !/^(P|LI|DIV|BLOCKQUOTE|H[1-6]|TD|TH)$/.test(el.tagName)) {
        el = el.parentElement;
      }
      return el;
    }

    function insertMarker(range: Range, marker: HTMLElement): void {
      try {
        const r = range.cloneRange();
        r.collapse(false);
        r.insertNode(marker);
        return;
      } catch {
        // Fall through to the block-level fallback below.
      }
      closestBlock(range.endContainer)?.after(marker);
    }

    const markers = new Map<string, HTMLElement>();

    // Deleting files is the one destructive action a proposal can carry, so
    // it gets a distinct confirmation - naming the exact files - on top of
    // the click on Apply itself. The relay also refuses to delete without a
    // matching confirmDelete flag in the request body, so this isn't just a
    // client-side nicety.
    async function applyItem(item: FeedbackItem): Promise<void> {
      const deletions = item.deletions ?? [];
      if (deletions.length > 0) {
        const ok = window.confirm(
          `Delete ${deletions.length} file(s)?\n\n${deletions.join("\n")}\n\nThis removes them from disk (recoverable via git, but not from this widget).`,
        );
        if (!ok) return;
        await fetch(`/__edit-feedback/apply/${item.id}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ confirmDelete: true }),
        });
        return;
      }
      await fetch(`/__edit-feedback/apply/${item.id}`, { method: "POST" });
    }

    function makeToolbar(
      item: FeedbackItem,
      opts: { canApply: boolean },
    ): HTMLElement {
      const bar = document.createElement("span");
      bar.className = "ef-inline-toolbar";

      if (opts.canApply) {
        const applyBtn = document.createElement("button");
        applyBtn.type = "button";
        applyBtn.className = "ef-btn ef-btn-primary";
        applyBtn.textContent =
          (item.deletions?.length ?? 0) > 0 ? "Apply & Delete" : "Apply";
        applyBtn.onclick = () => void applyItem(item);
        bar.append(applyBtn);
      }

      const discardBtn = document.createElement("button");
      discardBtn.type = "button";
      discardBtn.className = "ef-btn ef-btn-ghost";
      discardBtn.textContent = "Discard";
      discardBtn.onclick = () =>
        fetch(`/__edit-feedback/discard/${item.id}`, { method: "POST" });
      bar.append(discardBtn);

      const refineBtn = document.createElement("button");
      refineBtn.type = "button";
      refineBtn.className = "ef-btn ef-btn-ghost";
      refineBtn.textContent = "Refine…";
      refineBtn.onclick = () => {
        const comment = window.prompt("Refine this suggestion:");
        if (!comment) return;
        void fetch(`/__edit-feedback/refine/${item.id}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ comment }),
        });
      };
      bar.append(refineBtn);

      return bar;
    }

    function renderMarker(item: FeedbackItem, marker: HTMLElement): void {
      marker.innerHTML = "";
      marker.className = `ef-marker ef-status-${item.status}`;

      if (item.status === "queued" || item.status === "running") {
        const badge = document.createElement("span");
        badge.className = "ef-inline-badge";
        badge.textContent = item.progress.at(-1)
          ? `Working: ${item.progress.at(-1)}`
          : "Suggesting edit…";
        marker.append(badge);
        return;
      }

      if (item.status === "proposed") {
        if ((item.changes ?? []).length > 0) {
          const del = document.createElement("del");
          del.className = "ef-inline-del";
          del.textContent = pendingText(item);
          const ins = document.createElement("ins");
          ins.className = "ef-inline-ins";
          ins.textContent = (item.changes ?? [])
            .flatMap((c) => c.edits.map((e) => e.new))
            .join(" … ");
          marker.append(del, document.createTextNode(" → "), ins);
        }
        if ((item.deletions ?? []).length > 0) {
          const badge = document.createElement("span");
          badge.className = "ef-inline-badge ef-inline-deletions";
          badge.textContent = `🗑 Delete ${item.deletions!.length} file(s): ${item.deletions!.join(", ")}`;
          marker.append(badge);
        }
        marker.append(makeToolbar(item, { canApply: true }));
        return;
      }

      if (item.status === "error") {
        const badge = document.createElement("span");
        badge.className = "ef-inline-badge ef-inline-error";
        badge.textContent = item.error
          ? `⚠ ${item.error.slice(0, 200)}`
          : "⚠ Error";
        marker.append(badge);
        marker.append(makeToolbar(item, { canApply: false }));
        return;
      }

      if (item.status === "applied") {
        const badge = document.createElement("span");
        badge.className = "ef-inline-badge";
        badge.textContent = "✓ Applied — reloading…";
        marker.append(badge);
        return;
      }

      // discarded: leave the marker empty (about to be removed below).
    }

    function pendingText(item: FeedbackItem): string {
      // The proposal's own "old" text if there's exactly one edit (most
      // selection-based proposals), otherwise fall back to what was
      // actually selected.
      const changes = item.changes ?? [];
      if (changes.length === 1 && changes[0].edits.length === 1) {
        return changes[0].edits[0].old;
      }
      return item.selection ?? "";
    }

    document.addEventListener("ef-item", (e) => {
      const item = (e as CustomEvent<FeedbackItem>).detail;
      if (item.kind !== "selection" || item.files[0] !== filePath) return;

      if (item.status === "discarded") {
        markers.get(item.id)?.remove();
        markers.delete(item.id);
        return;
      }

      const marker = markers.get(item.id);
      if (marker) renderMarker(item, marker);
      // An item with no tracked marker here either belongs to a different
      // page load (this component only anchors items it itself submitted,
      // since only it has the live Range) or hasn't been created yet by
      // this page's own submitFeedback() below - nothing to render for it.
    });

    async function submitFeedback() {
      if (!pendingSelection) return;
      const comment = commentInput.value.trim();
      if (!comment) return;

      popover.hidden = true;
      const { range, text, heading, context } = pendingSelection;
      pendingSelection = null;
      window.getSelection()?.removeAllRanges();

      const marker = document.createElement("span");
      marker.className = "ef-marker ef-status-queued";
      const badge = document.createElement("span");
      badge.className = "ef-inline-badge";
      badge.textContent = "Sending…";
      marker.append(badge);
      insertMarker(range, marker);

      const res = await fetch("/__edit-feedback/request", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind: "selection",
          filePath,
          selection: text,
          heading,
          context,
          comment,
        }),
      });
      const body = (await res.json().catch(() => null)) as {
        id?: string;
      } | null;
      if (!body?.id) {
        marker.remove();
        return;
      }
      markers.set(body.id, marker);
    }

    submitBtn.addEventListener("click", submitFeedback);
    commentInput.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
        e.preventDefault();
        void submitFeedback();
      }
    });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  #edit-feedback-selection {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .ef-select-btn {
    position: absolute;
    z-index: 60;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 0.75rem;
    font-family: var(--font-ui);
    cursor: pointer;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
  }

  .ef-select-btn:hover {
    border-color: var(--sem, var(--border-strong));
  }

  .ef-popover {
    position: absolute;
    z-index: 61;
    width: min(320px, 90vw);
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 8px;
    padding: 10px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .ef-comment {
    width: 100%;
    box-sizing: border-box;
    resize: vertical;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 8px;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
  }

  .ef-popover-actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 8px;
  }

  .ef-btn {
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 0.75rem;
    font-family: var(--font-ui);
    cursor: pointer;
    border: 1px solid transparent;
  }

  .ef-btn-primary {
    background: var(--sem, #2563eb);
    color: #fff;
  }

  .ef-btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text-secondary);
  }
</style>

<style is:global>
  /* Inline, in the article body - not a corner popup. Global because the
     marker is inserted straight into <article>'s rendered content, outside
     this component's own scoped-style boundary. */
  .ef-marker {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    vertical-align: middle;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .ef-marker.ef-status-proposed {
    border-color: var(--sem, #2563eb);
  }

  .ef-marker.ef-status-error {
    border-color: #dc2626;
  }

  .ef-marker.ef-status-applied {
    border-color: #16a34a;
  }

  .ef-inline-badge {
    color: var(--text-secondary);
  }

  .ef-inline-error {
    color: #dc2626;
  }

  .ef-inline-deletions {
    color: #dc2626;
    font-weight: 600;
  }

  .ef-inline-del {
    color: #7f1d1d;
    background: #fecaca;
    text-decoration: line-through;
    padding: 1px 4px;
    border-radius: 4px;
  }

  .ef-inline-ins {
    color: #14532d;
    background: #bbf7d0;
    text-decoration: none;
    padding: 1px 4px;
    border-radius: 4px;
  }

  .ef-inline-toolbar {
    display: inline-flex;
    gap: 4px;
  }

  :root[data-theme="dark"] {
    .ef-inline-del {
      background: #7f1d1d;
      color: #fecaca;
    }
    .ef-inline-ins {
      background: #14532d;
      color: #bbf7d0;
    }
  }
</style>
