---
// Dev-only: select text in this note's <article> and it's automatically
// attached as context to the floating input in
// src/components/dev/live-edit-bar.astro - no explicit "suggest edit"
// button, no popup of its own. Once a selection settles, this dispatches
// an "le-attach-selection" DOM event that the bar listens for, and this
// widget only handles what needs the live DOM Range it captured: the
// eventual proposal (and its Apply/Discard/Refine controls) still render
// inline in the article right after the selected text, not in the dev
// toolbar's "Live Edit" panel (src/integrations/live-edit/toolbar-app.ts),
// which only covers whole-note/cross-note feedback since that has no
// single spot in a note's body to anchor to. Only rendered under
// import.meta.env.DEV by [...slug].astro, so none of this reaches a
// production build.
interface Props {
  filePath: string;
}
const { filePath } = Astro.props;
---

<div id="live-edit-selection" data-file-path={filePath}></div>

<script>
  import {
    isEnabled,
    onEnabledChange,
  } from "../../integrations/live-edit/enabled-state.ts";

  interface FileChange {
    file: string;
    edits: { old: string; new: string }[];
  }

  interface FeedbackItem {
    id: string;
    kind: "selection" | "whole-note";
    files: string[];
    selection?: string;
    heading?: string;
    comment: string;
    status:
      "queued" | "running" | "proposed" | "error" | "applied" | "discarded";
    progress: string[];
    summary?: string;
    changes?: FileChange[];
    deletions?: string[];
    error?: string;
  }

  interface PendingSelection {
    text: string;
    heading?: string;
    context?: string;
    range: Range;
  }

  async function init() {
    const root = document.getElementById("live-edit-selection");
    if (!root) return;

    const filePath = root.dataset.filePath ?? "";
    const article = document.querySelector("article");
    if (!article) return;

    // Live Edit only works with a `claude` or `opencode` backend (see
    // src/integrations/live-edit/agent.ts); when neither is available,
    // this widget stays fully inert - selecting text never attaches
    // anything, regardless of the enabled-state toggle. The site-wide bar
    // (live-edit-bar.astro) is what shows the disabled message.
    try {
      const res = await fetch("/__live-edit/status");
      const body = (await res.json()) as { available: boolean };
      if (!body.available) return;
    } catch {
      // A failed status check doesn't necessarily mean live-edit is
      // unavailable; treat it as available and let a real request surface
      // any error.
    }

    // The selection currently attached (handed off via "le-attach-selection"
    // and shown as a chip in the bar, waiting on its Send). Kept around
    // locally because only this widget has the live Range needed to anchor
    // a marker once the bar actually submits it.
    let attachedSelection: PendingSelection | null = null;

    function nearestHeading(node: Node | null): string | undefined {
      let el: Element | null =
        node instanceof Element ? node : (node?.parentElement ?? null);
      while (el && el !== article) {
        let sib: Element | null = el;
        while (sib) {
          if (/^H[2-4]$/.test(sib.tagName)) return sib.textContent?.trim();
          sib = sib.previousElementSibling;
        }
        el = el.parentElement;
      }
      return undefined;
    }

    // Katex renders each formula as MathML + a raw-TeX <annotation>; swap
    // the rendered glyphs for "$tex$" so the captured selection reads as
    // Markdown source, not KaTeX's visual output.
    function serializeRange(range: Range): string {
      const clone = range.cloneContents();
      const wrapper = document.createElement("div");
      wrapper.appendChild(clone);
      wrapper.querySelectorAll(".katex").forEach((katex) => {
        const tex = katex.querySelector(
          'annotation[encoding="application/x-tex"]',
        )?.textContent;
        const displayMode = katex.closest(".katex-display") !== null;
        const delim = displayMode ? "$$" : "$";
        katex.replaceWith(
          document.createTextNode(`${delim}${tex ?? ""}${delim}`),
        );
      });
      return wrapper.textContent?.trim() ?? "";
    }

    function surroundingContext(range: Range): string {
      const full = article!.textContent ?? "";
      const before =
        range.startContainer.textContent?.slice(0, range.startOffset) ?? "";
      const idx = full.indexOf(before.slice(-40));
      if (idx === -1) return "";
      const start = Math.max(0, idx - 100);
      return full.slice(start, idx + 140);
    }

    // Reads the current selection and, if it's a non-empty selection inside
    // the article, attaches it (dispatching "le-attach-selection" for the
    // bar to show as a chip) and keeps the live Range locally so the
    // eventual proposal can be anchored right after it in the body.
    // Attaching again (a new selection replacing an already-attached one)
    // just overwrites - both here and in the bar's own chip - matching
    // "only one selection can be in context at a time".
    function captureAndAttach(): void {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || sel.rangeCount === 0) return;
      const range = sel.getRangeAt(0);
      if (!article!.contains(range.commonAncestorContainer)) return;
      const text = serializeRange(range);
      if (!text) return;

      attachedSelection = {
        text,
        heading: nearestHeading(range.startContainer),
        context: surroundingContext(range),
        range: range.cloneRange(),
      };
      document.dispatchEvent(
        new CustomEvent("le-attach-selection", {
          detail: {
            filePath,
            text: attachedSelection.text,
            heading: attachedSelection.heading,
            context: attachedSelection.context,
          },
        }),
      );
    }

    // Attaching only happens once the selection has settled (mouseup/
    // touchend/keyup, not on every intermediate selectionchange fired while
    // dragging), and only after a short delay so a quick click-and-release
    // that immediately collapses the selection again doesn't attach
    // anything. Clearing the selection afterward (e.g. clicking into the
    // bar's textarea to type the comment) does NOT detach it - once
    // attached, it stays in context until sent or removed via the bar's
    // chip (see "le-selection-detached" below).
    const ATTACH_DELAY_MS = 200;
    let attachTimer: ReturnType<typeof setTimeout> | null = null;

    function clearAttachTimer(): void {
      if (attachTimer !== null) {
        clearTimeout(attachTimer);
        attachTimer = null;
      }
    }

    // Enabled by default; the dev toolbar's "Live Edit" icon
    // (toolbar-app.ts) is a pure on/off switch for this behavior.
    let enabled = isEnabled();
    onEnabledChange((next) => {
      enabled = next;
      if (!enabled) clearAttachTimer();
    });

    function scheduleAttach(): void {
      clearAttachTimer();
      if (!enabled) return;
      attachTimer = setTimeout(() => {
        attachTimer = null;
        captureAndAttach();
      }, ATTACH_DELAY_MS);
    }

    document.addEventListener("selectionchange", () => {
      // Covers an active drag (selection still changing): cancel any
      // pending attach so a fast, since-superseded selection can't sneak
      // in after the drag has already moved on.
      clearAttachTimer();
    });

    document.addEventListener("mouseup", scheduleAttach);
    document.addEventListener("touchend", scheduleAttach);
    document.addEventListener("keyup", (e) => {
      // Keyboard selection (Shift+Arrow/Home/End) ends on keyup of the
      // shift combo, with no mouseup to hook into.
      if (e.key === "Shift" || e.shiftKey) scheduleAttach();
    });

    // The bar's chip-remove (×) button on a selection it hasn't sent yet.
    document.addEventListener("le-selection-detached", () => {
      attachedSelection = null;
    });

    // --- inline anchors: one marker element per submitted item, inserted
    // right after the selected text, never modifying the selected text
    // itself. Safer than wrapping the selection (which throws if the range
    // partially crosses an element boundary) and keeps Apply/Discard/Refine
    // exactly where the feedback was given, not in a corner popup. -------

    function closestBlock(node: Node): Element | null {
      let el: Element | null =
        node instanceof Element ? node : node.parentElement;
      while (el && !/^(P|LI|DIV|BLOCKQUOTE|H[1-6]|TD|TH)$/.test(el.tagName)) {
        el = el.parentElement;
      }
      return el;
    }

    function insertMarker(range: Range, marker: HTMLElement): void {
      try {
        const r = range.cloneRange();
        r.collapse(false);
        r.insertNode(marker);
        return;
      } catch {
        // Fall through to the block-level fallback below.
      }
      closestBlock(range.endContainer)?.after(marker);
    }

    const markers = new Map<string, HTMLElement>();

    // Deleting files is the one destructive action a proposal can carry, so
    // it gets a distinct confirmation - naming the exact files - on top of
    // the click on Apply itself. The relay also refuses to delete without a
    // matching confirmDelete flag in the request body, so this isn't just a
    // client-side nicety.
    async function applyItem(item: FeedbackItem): Promise<void> {
      const deletions = item.deletions ?? [];
      if (deletions.length > 0) {
        const ok = window.confirm(
          `Delete ${deletions.length} file(s)?\n\n${deletions.join("\n")}\n\nThis removes them from disk (recoverable via git, but not from this widget).`,
        );
        if (!ok) return;
        await fetch(`/__live-edit/apply/${item.id}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ confirmDelete: true }),
        });
        return;
      }
      await fetch(`/__live-edit/apply/${item.id}`, { method: "POST" });
    }

    function makeToolbar(
      item: FeedbackItem,
      opts: { canApply: boolean },
    ): HTMLElement {
      const bar = document.createElement("span");
      bar.className = "le-inline-toolbar";

      if (opts.canApply) {
        const applyBtn = document.createElement("button");
        applyBtn.type = "button";
        applyBtn.className = "le-btn le-btn-primary";
        applyBtn.textContent =
          (item.deletions?.length ?? 0) > 0 ? "Apply & Delete" : "Apply";
        applyBtn.onclick = () => void applyItem(item);
        bar.append(applyBtn);
      }

      const discardBtn = document.createElement("button");
      discardBtn.type = "button";
      discardBtn.className = "le-btn le-btn-ghost";
      discardBtn.textContent = "Discard";
      discardBtn.onclick = () =>
        fetch(`/__live-edit/discard/${item.id}`, { method: "POST" });
      bar.append(discardBtn);

      const refineBtn = document.createElement("button");
      refineBtn.type = "button";
      refineBtn.className = "le-btn le-btn-ghost";
      refineBtn.textContent = "Refine…";
      refineBtn.onclick = () => {
        const comment = window.prompt("Refine this suggestion:");
        if (!comment) return;
        void fetch(`/__live-edit/refine/${item.id}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ comment }),
        });
      };
      bar.append(refineBtn);

      return bar;
    }

    function renderMarker(item: FeedbackItem, marker: HTMLElement): void {
      marker.innerHTML = "";
      marker.className = `le-marker le-status-${item.status}`;

      if (item.status === "queued" || item.status === "running") {
        const badge = document.createElement("span");
        badge.className = "le-inline-badge";
        badge.textContent = item.progress.at(-1)
          ? `Working: ${item.progress.at(-1)}`
          : "Suggesting edit…";
        marker.append(badge);
        return;
      }

      if (item.status === "proposed") {
        if ((item.changes ?? []).length > 0) {
          const del = document.createElement("del");
          del.className = "le-inline-del";
          del.textContent = pendingText(item);
          const ins = document.createElement("ins");
          ins.className = "le-inline-ins";
          ins.textContent = (item.changes ?? [])
            .flatMap((c) => c.edits.map((e) => e.new))
            .join(" … ");
          marker.append(del, document.createTextNode(" → "), ins);
        }
        if ((item.deletions ?? []).length > 0) {
          const badge = document.createElement("span");
          badge.className = "le-inline-badge le-inline-deletions";
          badge.textContent = `🗑 Delete ${item.deletions!.length} file(s): ${item.deletions!.join(", ")}`;
          marker.append(badge);
        }
        marker.append(makeToolbar(item, { canApply: true }));
        return;
      }

      if (item.status === "error") {
        const badge = document.createElement("span");
        badge.className = "le-inline-badge le-inline-error";
        badge.textContent = item.error
          ? `⚠ ${item.error.slice(0, 200)}`
          : "⚠ Error";
        marker.append(badge);
        marker.append(makeToolbar(item, { canApply: false }));
        return;
      }

      if (item.status === "applied") {
        const badge = document.createElement("span");
        badge.className = "le-inline-badge";
        badge.textContent = "✓ Applied — reloading…";
        marker.append(badge);
        return;
      }

      // discarded: leave the marker empty (about to be removed below).
    }

    function pendingText(item: FeedbackItem): string {
      // The proposal's own "old" text if there's exactly one edit (most
      // selection-based proposals), otherwise fall back to what was
      // actually selected.
      const changes = item.changes ?? [];
      if (changes.length === 1 && changes[0].edits.length === 1) {
        return changes[0].edits[0].old;
      }
      return item.selection ?? "";
    }

    document.addEventListener("le-item", (e) => {
      const item = (e as CustomEvent<FeedbackItem>).detail;
      if (item.kind !== "selection" || item.files[0] !== filePath) return;

      if (item.status === "discarded") {
        markers.get(item.id)?.remove();
        markers.delete(item.id);
        return;
      }

      const marker = markers.get(item.id);
      if (marker) renderMarker(item, marker);
      // An item with no tracked marker here either belongs to a different
      // page load (this component only anchors items it itself submitted,
      // since only it has the live Range) or hasn't been created yet by the
      // "le-selection-submitted" handler below - nothing to render for it.
    });

    // The bar (live-edit-bar.astro) owns the actual request now - this
    // just reacts once it's sent one, inserting the marker at the Range
    // only this widget has. A null id means the request failed; nothing to
    // anchor in that case, matching the previous popup flow's behavior.
    document.addEventListener("le-selection-submitted", (e) => {
      const { filePath: submittedFile, id } = (
        e as CustomEvent<{ filePath: string; id: string | null }>
      ).detail;
      if (submittedFile !== filePath || !attachedSelection) return;

      const { range } = attachedSelection;
      attachedSelection = null;
      window.getSelection()?.removeAllRanges();
      if (!id) return;

      const marker = document.createElement("span");
      marker.className = "le-marker le-status-queued";
      const badge = document.createElement("span");
      badge.className = "le-inline-badge";
      badge.textContent = "Sending…";
      marker.append(badge);
      insertMarker(range, marker);
      markers.set(id, marker);
    });
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  #live-edit-selection {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .le-btn {
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 0.75rem;
    font-family: var(--font-ui);
    cursor: pointer;
    border: 1px solid transparent;
  }

  .le-btn-primary {
    background: var(--sem, #2563eb);
    color: #fff;
  }

  .le-btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text-secondary);
  }
</style>

<style is:global>
  /* Inline, in the article body - not a corner popup. Global because the
     marker is inserted straight into <article>'s rendered content, outside
     this component's own scoped-style boundary. */
  .le-marker {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: 6px;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    vertical-align: middle;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  .le-marker.le-status-proposed {
    border-color: var(--sem, #2563eb);
  }

  .le-marker.le-status-error {
    border-color: #dc2626;
  }

  .le-marker.le-status-applied {
    border-color: #16a34a;
  }

  .le-inline-badge {
    color: var(--text-secondary);
  }

  .le-inline-error {
    color: #dc2626;
  }

  .le-inline-deletions {
    color: #dc2626;
    font-weight: 600;
  }

  .le-inline-del {
    color: #7f1d1d;
    background: #fecaca;
    text-decoration: line-through;
    padding: 1px 4px;
    border-radius: 4px;
  }

  .le-inline-ins {
    color: #14532d;
    background: #bbf7d0;
    text-decoration: none;
    padding: 1px 4px;
    border-radius: 4px;
  }

  .le-inline-toolbar {
    display: inline-flex;
    gap: 4px;
  }

  :root[data-theme="dark"] {
    .le-inline-del {
      background: #7f1d1d;
      color: #fecaca;
    }
    .le-inline-ins {
      background: #14532d;
      color: #bbf7d0;
    }
  }
</style>
