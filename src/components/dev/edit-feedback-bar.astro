---
// Dev-only, site-wide: a floating bar for whole-note feedback ("tighten
// this note") and cross-note merges ("fold this into that note"), plus the
// review panel for every feedback item - both the ones this bar submits and
// the selection-based ones submitted by the per-note
// src/components/dev/edit-feedback.astro widget. Mounted once by
// src/layouts/Layout.astro under import.meta.env.DEV, so it's present on
// every page (note pages and otherwise) and none of it reaches a
// production build.
---

<div id="edit-feedback-bar">
  <div class="efb-panel" data-efb-panel hidden>
    <div class="efb-panel-header">
      <span>Whole-note / merge feedback</span>
      <button
        type="button"
        class="efb-icon-btn"
        data-efb-panel-close
        aria-label="Close panel"
      >
        ×
      </button>
    </div>
    <div class="efb-list" data-efb-list></div>
  </div>

  <div class="efb-bar">
    <div class="efb-files" data-efb-files>
      <button type="button" class="efb-add-file" data-efb-add-file>
        + note
      </button>
    </div>

    <div class="efb-picker" data-efb-picker hidden>
      <input
        type="text"
        class="efb-picker-input"
        data-efb-picker-input
        placeholder="Search notes by title or slug…"
      />
      <div class="efb-picker-results" data-efb-picker-results></div>
    </div>

    <div class="efb-input-row">
      <textarea
        class="efb-comment"
        data-efb-comment
        placeholder="Feedback on the note(s) above… (⌘/Ctrl+Enter to send)"
        rows="1"
      ></textarea>
      <button
        type="button"
        class="efb-icon-btn efb-panel-toggle"
        data-efb-panel-toggle
        aria-expanded="false"
        aria-label="Toggle edit feedback panel"
      >
        ✎
      </button>
      <button type="button" class="ef-btn ef-btn-primary" data-efb-send>
        Send
      </button>
    </div>
  </div>

  <template data-efb-chip-template>
    <span class="efb-chip" data-efb-chip>
      <span data-efb-chip-label></span>
      <button type="button" data-efb-chip-remove aria-label="Remove note">
        ×
      </button>
    </span>
  </template>

  <template data-efb-result-template>
    <button type="button" class="efb-picker-result" data-efb-result>
      <span class="efb-picker-result-title" data-efb-result-title></span>
      <span class="efb-picker-result-slug" data-efb-result-slug></span>
    </button>
  </template>

  <template data-efb-item-template>
    <div class="ef-item">
      <div class="ef-item-header">
        <span class="ef-item-status" data-ef-status></span>
        <span class="ef-item-files" data-ef-files></span>
      </div>
      <div class="ef-item-comment" data-ef-comment-text></div>
      <div class="ef-item-progress" data-ef-progress hidden></div>
      <div class="ef-item-summary" data-ef-summary hidden></div>
      <div class="ef-item-diff" data-ef-diff hidden></div>
      <div class="ef-item-deletions" data-ef-deletions hidden></div>
      <div class="ef-item-error" data-ef-error hidden></div>
      <div class="ef-item-actions" data-ef-actions hidden>
        <button type="button" class="ef-btn ef-btn-primary" data-ef-apply>
          Apply
        </button>
        <button type="button" class="ef-btn ef-btn-ghost" data-ef-discard>
          Discard
        </button>
      </div>
      <div class="ef-item-refine" data-ef-refine hidden>
        <textarea
          class="ef-comment"
          data-ef-refine-input
          placeholder="Refine…"
          rows="2"
        ></textarea>
        <button type="button" class="ef-btn ef-btn-ghost" data-ef-refine-btn>
          Send
        </button>
      </div>
    </div>
  </template>
</div>

<script>
  interface FileChange {
    file: string;
    edits: { old: string; new: string }[];
  }

  interface FeedbackItem {
    id: string;
    kind: "selection" | "whole-note";
    files: string[];
    selection?: string;
    heading?: string;
    comment: string;
    status:
      "queued" | "running" | "proposed" | "error" | "applied" | "discarded";
    progress: string[];
    agentReply?: string;
    summary?: string;
    changes?: FileChange[];
    deletions?: string[];
    error?: string;
    createdAt: number;
    updatedAt: number;
  }

  interface NoteInfo {
    file: string;
    slug: string;
    title: string;
  }

  function init() {
    const root = document.getElementById("edit-feedback-bar");
    if (!root) return;

    const panel = root.querySelector<HTMLElement>("[data-efb-panel]")!;
    const panelClose = root.querySelector<HTMLButtonElement>(
      "[data-efb-panel-close]",
    )!;
    const panelToggle = root.querySelector<HTMLButtonElement>(
      "[data-efb-panel-toggle]",
    )!;
    const list = root.querySelector<HTMLElement>("[data-efb-list]")!;
    const itemTemplate = root.querySelector<HTMLTemplateElement>(
      "[data-efb-item-template]",
    )!;

    const filesEl = root.querySelector<HTMLElement>("[data-efb-files]")!;
    const addFileBtn = root.querySelector<HTMLButtonElement>(
      "[data-efb-add-file]",
    )!;
    const chipTemplate = root.querySelector<HTMLTemplateElement>(
      "[data-efb-chip-template]",
    )!;

    const picker = root.querySelector<HTMLElement>("[data-efb-picker]")!;
    const pickerInput = root.querySelector<HTMLInputElement>(
      "[data-efb-picker-input]",
    )!;
    const pickerResults = root.querySelector<HTMLElement>(
      "[data-efb-picker-results]",
    )!;
    const resultTemplate = root.querySelector<HTMLTemplateElement>(
      "[data-efb-result-template]",
    )!;

    const commentInput =
      root.querySelector<HTMLTextAreaElement>("[data-efb-comment]")!;
    const sendBtn = root.querySelector<HTMLButtonElement>("[data-efb-send]")!;

    // --- panel open/close, persisted across page loads within a tab -----

    function setPanelOpen(open: boolean): void {
      panel.hidden = !open;
      panelToggle.setAttribute("aria-expanded", String(open));
      try {
        sessionStorage.setItem("ef-panel-open", open ? "1" : "0");
      } catch {
        // ignore
      }
    }

    try {
      if (sessionStorage.getItem("ef-panel-open") === "1") setPanelOpen(true);
    } catch {
      // ignore
    }

    panelToggle.addEventListener("click", () => setPanelOpen(panel.hidden));
    panelClose.addEventListener("click", () => setPanelOpen(false));

    // --- file chips -------------------------------------------------

    const selectedFiles: string[] = [];
    const chipEls = new Map<string, HTMLElement>();

    // Default to the note currently being viewed, if any: the per-note
    // widget's root carries the file path as a data attribute.
    const currentNoteFile = document.getElementById("edit-feedback-selection")
      ?.dataset.filePath;
    if (currentNoteFile) addFile(currentNoteFile);

    function addFile(file: string): void {
      if (selectedFiles.includes(file)) return;
      selectedFiles.push(file);
      const chip = (
        chipTemplate.content.firstElementChild as HTMLElement
      ).cloneNode(true) as HTMLElement;
      chip.querySelector("[data-efb-chip-label]")!.textContent = file
        .replace(/^docs\//, "")
        .replace(/\.mdx?$/, "");
      chip.querySelector<HTMLButtonElement>("[data-efb-chip-remove]")!.onclick =
        () => removeFile(file);
      chipEls.set(file, chip);
      filesEl.insertBefore(chip, addFileBtn);
    }

    function removeFile(file: string): void {
      const idx = selectedFiles.indexOf(file);
      if (idx === -1) return;
      selectedFiles.splice(idx, 1);
      chipEls.get(file)?.remove();
      chipEls.delete(file);
    }

    // --- note picker (searches /__edit-feedback/notes) ---------------

    let notesCache: NoteInfo[] | null = null;

    async function loadNotes(): Promise<NoteInfo[]> {
      if (notesCache) return notesCache;
      const res = await fetch("/__edit-feedback/notes");
      const body = (await res.json()) as { notes: NoteInfo[] };
      notesCache = body.notes;
      return notesCache;
    }

    function renderResults(notes: NoteInfo[], query: string): void {
      pickerResults.innerHTML = "";
      const q = query.trim().toLowerCase();
      const matches = notes
        .filter((n) => !selectedFiles.includes(n.file))
        .filter(
          (n) =>
            q.length === 0 ||
            n.title.toLowerCase().includes(q) ||
            n.slug.toLowerCase().includes(q),
        )
        .slice(0, 20);
      for (const note of matches) {
        const el = (
          resultTemplate.content.firstElementChild as HTMLElement
        ).cloneNode(true) as HTMLElement;
        el.querySelector("[data-efb-result-title]")!.textContent =
          note.title || note.slug;
        el.querySelector("[data-efb-result-slug]")!.textContent = note.slug;
        el.addEventListener("click", () => {
          addFile(note.file);
          picker.hidden = true;
          pickerInput.value = "";
        });
        pickerResults.append(el);
      }
    }

    addFileBtn.addEventListener("click", async () => {
      picker.hidden = !picker.hidden;
      if (picker.hidden) return;
      pickerInput.value = "";
      pickerInput.focus();
      renderResults(await loadNotes(), "");
    });

    pickerInput.addEventListener("input", async () => {
      renderResults(await loadNotes(), pickerInput.value);
    });

    document.addEventListener("click", (e) => {
      if (
        !picker.hidden &&
        !picker.contains(e.target as Node) &&
        e.target !== addFileBtn
      ) {
        picker.hidden = true;
      }
    });

    // --- submit --------------------------------------------------------

    async function submit() {
      const comment = commentInput.value.trim();
      if (!comment || selectedFiles.length === 0) return;

      commentInput.value = "";
      setPanelOpen(true);

      await fetch("/__edit-feedback/request", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind: "whole-note",
          files: [...selectedFiles],
          comment,
        }),
      });
    }

    sendBtn.addEventListener("click", submit);
    commentInput.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "Enter") {
        e.preventDefault();
        void submit();
      }
    });

    // --- item rendering --------------------------------------------------

    // Deleting files is the one destructive action a proposal can carry, so
    // it gets a distinct confirmation - naming the exact files - on top of
    // (not instead of) the click on Apply itself. The relay also refuses to
    // delete without a matching confirmDelete flag in the request body, so
    // this isn't just a client-side nicety.
    async function applyItem(item: FeedbackItem): Promise<void> {
      const deletions = item.deletions ?? [];
      if (deletions.length > 0) {
        const ok = window.confirm(
          `Delete ${deletions.length} file(s)?\n\n${deletions.join("\n")}\n\nThis removes them from disk (recoverable via git, but not from this widget).`,
        );
        if (!ok) return;
        await fetch(`/__edit-feedback/apply/${item.id}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ confirmDelete: true }),
        });
        return;
      }
      await fetch(`/__edit-feedback/apply/${item.id}`, { method: "POST" });
    }

    const itemEls = new Map<string, HTMLElement>();

    function renderItem(item: FeedbackItem) {
      let el = itemEls.get(item.id);
      if (!el) {
        el = (itemTemplate.content.firstElementChild as HTMLElement).cloneNode(
          true,
        ) as HTMLElement;
        itemEls.set(item.id, el);
        list.prepend(el);
      }

      el.dataset.status = item.status;
      el.querySelector("[data-ef-files]")!.textContent = item.files
        .map((f) => f.replace(/^docs\//, "").replace(/\.mdx?$/, ""))
        .join(", ");
      el.querySelector("[data-ef-comment-text]")!.textContent = item.comment;
      el.querySelector("[data-ef-status]")!.textContent = statusLabel(item);

      const progressEl = el.querySelector<HTMLElement>("[data-ef-progress]")!;
      progressEl.textContent = item.progress.at(-1) ?? "";
      progressEl.hidden =
        item.status !== "running" || item.progress.length === 0;

      const summaryEl = el.querySelector<HTMLElement>("[data-ef-summary]")!;
      summaryEl.textContent = item.summary ?? "";
      summaryEl.hidden = !item.summary;

      const diffEl = el.querySelector<HTMLElement>("[data-ef-diff]")!;
      diffEl.innerHTML = "";
      diffEl.hidden = !item.changes || item.changes.length === 0;
      for (const change of item.changes ?? []) {
        if ((item.changes?.length ?? 0) > 1) {
          const label = document.createElement("div");
          label.className = "ef-edit-file";
          label.textContent = change.file;
          diffEl.append(label);
        }
        for (const edit of change.edits) {
          const oldEl = document.createElement("del");
          oldEl.textContent = edit.old;
          const newEl = document.createElement("ins");
          newEl.textContent = edit.new;
          const wrap = document.createElement("div");
          wrap.className = "ef-edit";
          wrap.append(oldEl, newEl);
          diffEl.append(wrap);
        }
      }

      const deletionsEl = el.querySelector<HTMLElement>("[data-ef-deletions]")!;
      deletionsEl.innerHTML = "";
      const deletions = item.deletions ?? [];
      deletionsEl.hidden = deletions.length === 0;
      if (deletions.length > 0) {
        const label = document.createElement("div");
        label.className = "ef-deletions-label";
        label.textContent = `Delete ${deletions.length} file(s):`;
        deletionsEl.append(label);
        for (const file of deletions) {
          const row = document.createElement("div");
          row.className = "ef-deletions-file";
          row.textContent = file;
          deletionsEl.append(row);
        }
      }

      const errorEl = el.querySelector<HTMLElement>("[data-ef-error]")!;
      errorEl.textContent = item.error ?? "";
      errorEl.hidden = !item.error;

      const actions = el.querySelector<HTMLElement>("[data-ef-actions]")!;
      actions.hidden = item.status !== "proposed";

      const refineForm = el.querySelector<HTMLElement>("[data-ef-refine]")!;
      refineForm.hidden = !(
        item.status === "proposed" || item.status === "error"
      );

      const applyBtn = el.querySelector<HTMLButtonElement>("[data-ef-apply]")!;
      applyBtn.onclick = () => void applyItem(item);

      const discardBtn =
        el.querySelector<HTMLButtonElement>("[data-ef-discard]")!;
      discardBtn.onclick = () =>
        fetch(`/__edit-feedback/discard/${item.id}`, { method: "POST" });

      const refineInput = el.querySelector<HTMLTextAreaElement>(
        "[data-ef-refine-input]",
      )!;
      const refineBtn = el.querySelector<HTMLButtonElement>(
        "[data-ef-refine-btn]",
      )!;
      refineBtn.onclick = () => {
        const comment = refineInput.value.trim();
        if (!comment) return;
        refineInput.value = "";
        void fetch(`/__edit-feedback/refine/${item.id}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ comment }),
        });
      };
    }

    function statusLabel(item: FeedbackItem): string {
      switch (item.status) {
        case "queued":
          return "Queued";
        case "running":
          return "Working…";
        case "proposed":
          return "Proposed";
        case "error":
          return "Error";
        case "applied":
          return "Applied";
        case "discarded":
          return "Discarded";
      }
    }

    // This panel only covers "whole-note" items - a "selection" item
    // renders inline in the article by the per-note widget
    // (edit-feedback.astro), which only has the live DOM Range needed to
    // anchor it. Every item still gets dispatched as an "ef-item" DOM
    // event, which is how that widget learns about updates to items it
    // submitted, without both components needing to share an EventSource.
    function handleItem(item: FeedbackItem): void {
      document.dispatchEvent(new CustomEvent("ef-item", { detail: item }));
      if (item.kind === "whole-note") renderItem(item);
    }

    const es = new EventSource("/__edit-feedback/events");
    es.onmessage = (ev) => {
      const msg = JSON.parse(ev.data) as
        | { type: "snapshot"; items: FeedbackItem[] }
        | { type: "item"; item: FeedbackItem };
      if (msg.type === "snapshot") {
        for (const item of msg.items) handleItem(item);
      } else {
        handleItem(msg.item);
      }
    };
  }

  document.addEventListener("DOMContentLoaded", init);
</script>

<style>
  #edit-feedback-bar {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .ef-btn {
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 0.75rem;
    font-family: var(--font-ui);
    cursor: pointer;
    border: 1px solid transparent;
  }

  .ef-btn-primary {
    background: var(--sem, #2563eb);
    color: #fff;
  }

  .ef-btn-ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--text-secondary);
  }

  .efb-icon-btn {
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-primary);
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
  }

  /* --- bottom bar ---------------------------------------------------- */

  .efb-bar {
    position: fixed;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    z-index: 62;
    width: min(560px, calc(100vw - 24px));
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 10px 32px rgb(0 0 0 / 0.22);
    padding-bottom: calc(8px + env(safe-area-inset-bottom, 0px));
  }

  .efb-files {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .efb-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 4px 2px 10px;
    font-size: 0.75rem;
  }

  .efb-chip button {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    line-height: 1;
  }

  .efb-add-file {
    border: 1px dashed var(--border-strong);
    background: transparent;
    color: var(--text-secondary);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.75rem;
    font-family: var(--font-ui);
    cursor: pointer;
  }

  .efb-picker {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    width: min(360px, 90vw);
    max-height: 320px;
    overflow-y: auto;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 8px;
    padding: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .efb-picker-input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-primary);
    border-radius: 6px;
    padding: 6px 8px;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    margin-bottom: 6px;
  }

  .efb-picker-results {
    display: flex;
    flex-direction: column;
  }

  .efb-picker-result {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    border: none;
    background: transparent;
    text-align: left;
    padding: 6px 8px;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text-primary);
  }

  .efb-picker-result:hover {
    background: var(--surface-2);
  }

  .efb-picker-result-slug {
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  .efb-input-row {
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }

  .efb-comment {
    flex: 1;
    resize: vertical;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-primary);
    border-radius: 8px;
    padding: 6px 10px;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    min-height: 30px;
  }

  /* --- panel ----------------------------------------------------------- */

  .efb-panel {
    position: fixed;
    right: 12px;
    bottom: 90px;
    z-index: 61;
    width: min(380px, calc(100vw - 24px));
    max-height: min(65vh, 620px);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 10px;
    box-shadow: 0 10px 32px rgb(0 0 0 / 0.25);
    overflow: hidden;
  }

  .efb-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    font-weight: 700;
    border-bottom: 1px solid var(--border);
  }

  .efb-panel-header .efb-icon-btn {
    width: 24px;
    height: 24px;
  }

  .efb-list {
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ef-item {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px;
    background: var(--surface-2);
  }

  .ef-item[data-status="error"] {
    border-color: #dc2626;
  }

  .ef-item[data-status="applied"] {
    border-color: #16a34a;
  }

  .ef-item-header {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }

  .ef-item-status {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--text-secondary);
    flex: none;
  }

  .ef-item-files {
    font-size: 0.6875rem;
    color: var(--text-secondary);
    text-align: right;
    overflow-wrap: anywhere;
  }

  .ef-item-comment {
    margin-top: 4px;
    font-style: italic;
  }

  .ef-item-progress {
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .ef-item-summary {
    margin-top: 6px;
    font-weight: 600;
  }

  .ef-item-diff {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.75rem;
  }

  .ef-item-diff :global(.ef-edit-file) {
    font-weight: 600;
    font-size: 0.6875rem;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  .ef-item-diff :global(.ef-edit) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ef-item-diff :global(del) {
    background: #fecaca;
    color: #7f1d1d;
    text-decoration: line-through;
    padding: 2px 4px;
    border-radius: 4px;
  }

  .ef-item-diff :global(ins) {
    background: #bbf7d0;
    color: #14532d;
    text-decoration: none;
    padding: 2px 4px;
    border-radius: 4px;
  }

  .ef-item-deletions {
    margin-top: 6px;
    border: 1px solid #dc2626;
    border-radius: 6px;
    padding: 6px 8px;
