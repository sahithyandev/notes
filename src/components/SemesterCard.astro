---
interface Props {
  semesterNumber: number;
  modulesCount: number;
  isActive?: boolean;
}

const { semesterNumber, modulesCount, isActive = false } = Astro.props;
import { Book, ArrowRight } from "@lucide/astro";

// Premium color schemes for each semester
const semesterColors = [
  { primary: "#1e40af", secondary: "#3b82f6", accent: "#60a5fa" }, // S1: Professional Blue
  { primary: "#059669", secondary: "#10b981", accent: "#34d399" }, // S2: Emerald Green
  { primary: "#7c3aed", secondary: "#a78bfa", accent: "#c4b5fd" }, // S3: Royal Purple
  { primary: "#dc2626", secondary: "#ef4444", accent: "#f87171" }, // S4: Ruby Red
  { primary: "#ea580c", secondary: "#f97316", accent: "#fb923c" }, // S5: Amber Orange
  { primary: "#0891b2", secondary: "#06b6d4", accent: "#22d3ee" }, // S6: Cyan Blue
  { primary: "#be123c", secondary: "#e11d48", accent: "#f43f5e" }, // S7: Rose Red
  { primary: "#4338ca", secondary: "#6366f1", accent: "#818cf8" }, // S8: Indigo
];

const colors = semesterColors[semesterNumber - 1] || semesterColors[0];
const gradient = `linear-gradient(135deg, ${colors.primary} 0%, ${colors.secondary} 100%)`;
---

<div
  class={`semester-card ${isActive ? "active" : ""}`}
  style={`--gradient: ${gradient}; --primary: ${colors.primary}; --secondary: ${colors.secondary}; --accent: ${colors.accent};`}
>
  <div class="card-header">
    <div class="semester-badge">
      <span class="semester-number">S{semesterNumber}</span>
      <span class="semester-full">Semester {semesterNumber}</span>
    </div>
    <div class="module-count">
      <span class="count">{modulesCount}</span>
      <span class="label">Modules</span>
    </div>
  </div>

  <div class="card-glow"></div>
</div>

<style>
  .semester-card {
    position: relative;
    background: white;
    border-radius: 10px;
    padding: 1.5rem;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    overflow: hidden;
    border: 2px solid transparent;
    background-clip: padding-box;
  }

  [data-theme="dark"] .semester-card {
    background: #2d3748;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .semester-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--gradient);
    opacity: 0.05;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .semester-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
    border-color: var(--primary);
  }

  .semester-card:hover::before {
    opacity: 0.1;
  }

  .semester-card.active {
    border-color: var(--primary);
    box-shadow:
      0 0 0 3px rgba(0, 0, 0, 0.1),
      0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .semester-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .semester-number {
    font-size: 1.5rem;
    font-weight: 900;
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .semester-full {
    font-size: 0.875rem;
    color: #718096;
    font-weight: 600;
  }

  [data-theme="dark"] .semester-full {
    color: #a0aec0;
  }

  .module-count {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .count {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--primary);
  }

  .label {
    font-size: 0.75rem;
    color: #a0aec0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-content {
    position: relative;
    z-index: 1;
  }

  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .module-item {
    display: flex;
    align-items: center;
    padding: 0.75rem;
    background: rgba(0, 0, 0, 0.02);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
    animation: slideIn 0.3s ease-out forwards;
    animation-delay: var(--delay);
    opacity: 0;
  }

  [data-theme="dark"] .module-item {
    background: rgba(255, 255, 255, 0.05);
  }

  .module-item:hover {
    background: rgba(0, 0, 0, 0.05);
    transform: translateX(5px);
  }

  [data-theme="dark"] .module-item:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .module-icon {
    font-size: 1.25rem;
    margin-right: 0.75rem;
    color: var(--primary);
  }

  .module-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .module-name {
    font-weight: 600;
    color: #2d3748;
    font-size: 0.875rem;
  }

  [data-theme="dark"] .module-name {
    color: #e2e8f0;
  }

  .module-code {
    font-size: 0.75rem;
    color: #718096;
    font-family: monospace;
  }

  [data-theme="dark"] .module-code {
    color: #a0aec0;
  }

  .module-arrow {
    font-size: 1rem;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .module-item:hover .module-arrow {
    transform: translateX(3px);
  }

  .view-more {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    background: rgba(0, 0, 0, 0.02);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  [data-theme="dark"] .view-more {
    background: rgba(255, 255, 255, 0.05);
  }

  .view-more:hover {
    background: rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
  }

  [data-theme="dark"] .view-more:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .view-more-text {
    font-size: 0.875rem;
    color: var(--primary);
    font-weight: 500;
  }

  .view-more-arrow {
    font-size: 0.875rem;
    color: var(--primary);
    transition: transform 0.2s ease;
  }

  .view-more:hover .view-more-arrow {
    transform: translateX(3px);
  }

  .card-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, var(--primary) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    filter: blur(40px);
  }

  .semester-card:hover .card-glow {
    opacity: 0.1;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (max-width: 640px) {
    .semester-card {
      padding: 1rem;
    }

    .card-header {
      margin-bottom: 1rem;
    }

    .semester-number {
      font-size: 1.25rem;
    }

    .module-item {
      padding: 0.5rem;
    }

    .module-icon {
      font-size: 1rem;
      margin-right: 0.5rem;
    }
  }
</style>
