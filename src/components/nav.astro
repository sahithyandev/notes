---
import { Monitor, Sun, Moon } from "@lucide/astro";
import SearchModal from "./search-modal.astro";
import LiveUsersCount from "./live-users-count.astro";
import Logo from "./icons/Logo.astro";

const shouldStretchFull = Astro.url.pathname.startsWith("/s");
const semMatch = Astro.url.pathname.match(/^\/(s[1-8])(?:\/|$)/);
const logoRule = semMatch
  ? `color-mix(in oklab, var(--${semMatch[1]}) 60%, transparent)`
  : undefined;
---

<nav
  class="nav"
  style={shouldStretchFull
    ? "padding: 0 12px;"
    : "padding: 0 var(--body-margin-x);"}
>
  <span class="nav-drawer-slot nav-drawer-slot-start">
    <slot name="nav-start" />
  </span>

  <a href="/" class="nav-logo" aria-label="Sahithyan's Notes, home">
    <Logo width={20} height={20} class="nav-mark" rule={logoRule} />
    <span class="nav-name">
      <span class="nav-name-owner">Sahithyan's</span><span class="nav-name-main"
        >Notes</span
      >
    </span>
  </a>

  <LiveUsersCount />

  <SearchModal />

  <div class="nav-right">
    <span class="nav-drawer-slot nav-drawer-slot-end">
      <slot name="nav-end" />
    </span>
    <button
      class="nav-search"
      id="search-trigger"
      type="button"
      aria-label="Open search"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="6.5" cy="6.5" r="5"></circle>
        <path d="M10.5 10.5l4 4"></path>
      </svg>
      <span class="nav-search-label">Search notes…</span>
      <kbd>⌘K</kbd>
    </button>
    <button
      class="theme-toggle"
      id="themeToggle"
      title="Theme: auto"
      aria-label="Change theme"
    >
      <span class="theme-icon" data-pref="auto"><Monitor size={15} /></span>
      <span class="theme-icon" data-pref="light"><Sun size={15} /></span>
      <span class="theme-icon" data-pref="dark"><Moon size={14} /></span>
    </button>
  </div>
</nav>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("themeToggle");
  const order = ["auto", "light", "dark"] as const;
  type Pref = (typeof order)[number];

  function syncUI(pref: Pref) {
    document.querySelectorAll<HTMLElement>(".theme-icon").forEach((el) => {
      el.style.display = el.dataset.pref === pref ? "flex" : "none";
    });
    if (btn) {
      const nextIndex = (order.indexOf(pref) + 1) % order.length;
      const next = order[nextIndex];
      btn.setAttribute("title", `Theme: ${pref} (click for ${next})`);
      btn.setAttribute(
        "aria-label",
        `Theme: ${pref}. Click to switch to ${next}.`,
      );
    }
  }

  function apply(pref: Pref) {
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)",
    ).matches;
    const resolved = pref === "auto" ? (prefersDark ? "dark" : "light") : pref;
    root.setAttribute("data-theme", resolved);
    root.dataset.themePref = pref;
    localStorage.setItem("sn-theme", pref);
    syncUI(pref);
  }

  const initial = (root.dataset.themePref as Pref) || "auto";
  syncUI(initial);

  btn?.addEventListener("click", () => {
    const current = (root.dataset.themePref as Pref) || "auto";
    const next = order[(order.indexOf(current) + 1) % order.length];
    apply(next);
    (window as any).stonks?.("event", "theme_change", { theme: next });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 54px;
    display: flex;
    align-items: center;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(20px) saturate(1.8);
    border-bottom: 1px solid var(--border);
    gap: 8px;
  }

  @media (min-width: 48rem) {
    .nav {
      padding: 0 36px;
      gap: 0;
    }
  }

  .nav-drawer-slot {
    display: flex;
    align-items: center;
  }

  .nav-drawer-slot-start {
    margin-right: 2px;
  }

  .nav-drawer-slot:not(:has(*)) {
    display: none;
  }

  @media (min-width: 48rem) {
    .nav-drawer-slot {
      display: none;
    }
  }

  .nav-logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-primary);
  }

  .nav-mark {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform 0.15s ease;
  }

  .nav-logo:hover .nav-mark {
    transform: rotate(-6deg);
  }

  .nav-name {
    font-size: 14.5px;
    letter-spacing: -0.3px;
    margin-right: 0.28em;
    white-space: nowrap;
  }

  .nav-name-owner {
    font-weight: 500;
    color: var(--text-muted);
  }

  .nav-name-main {
    font-weight: 700;
    color: var(--text-primary);
    margin-left: 0.28em;
  }

  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 7px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 12.5px;
    color: var(--text-muted);
    cursor: pointer;
    appearance: none;
    font-family: var(--font-ui);
    transition: border-color 0.12s;
  }

  @media (min-width: 48rem) {
    .nav-search {
      padding: 6px 14px;
    }
  }

  .nav-search:hover {
    border-color: var(--border-strong);
  }

  .nav-search-label {
    display: none;
  }

  @media (min-width: 48rem) {
    .nav-search-label {
      display: inline;
    }
  }

  .nav-search kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
    color: var(--text-muted);
    margin-left: 4px;
  }

  @media (min-width: 48rem) {
    .nav-search kbd {
      display: inline-block;
    }
  }

  .theme-toggle {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition:
      background 0.12s,
      color 0.12s,
      border-color 0.12s;
    flex-shrink: 0;
    padding: 0;
  }

  @media (max-width: 48rem) {
    .theme-toggle {
      width: 40px;
      height: 40px;
    }

    .nav-search {
      width: 40px;
      height: 40px;
      justify-content: center;
      padding: 0;
    }
  }

  .theme-toggle:hover {
    background: var(--surface);
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .theme-icon {
    display: none;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
</style>
