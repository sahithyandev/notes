---
import { Monitor, Sun, Moon } from "@lucide/astro";
import SearchModal from "./search-modal.astro";
import LiveUsersCount from "./live-users-count.astro";
---

<nav class="nav">
  <a href="/" class="nav-logo">
    <span class="nav-name">Sahithyan's Notes</span>
  </a>

  <LiveUsersCount />

  <SearchModal />

  <div class="nav-right">
    <button
      class="nav-search"
      id="search-trigger"
      type="button"
      aria-label="Open search"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="6.5" cy="6.5" r="5"></circle>
        <path d="M10.5 10.5l4 4"></path>
      </svg>
      Search notes…
      <kbd>⌘K</kbd>
    </button>
    <button
      class="theme-toggle"
      id="themeToggle"
      title="Theme: auto"
      aria-label="Change theme"
    >
      <span class="theme-icon" data-pref="auto"><Monitor size={15} /></span>
      <span class="theme-icon" data-pref="light"><Sun size={15} /></span>
      <span class="theme-icon" data-pref="dark"><Moon size={14} /></span>
    </button>
  </div>
</nav>

<script>
  const root = document.documentElement;
  const btn = document.getElementById("themeToggle");
  const order = ["auto", "light", "dark"] as const;
  type Pref = (typeof order)[number];

  function syncUI(pref: Pref) {
    document.querySelectorAll<HTMLElement>(".theme-icon").forEach((el) => {
      el.style.display = el.dataset.pref === pref ? "flex" : "none";
    });
    if (btn) {
      const nextIndex = (order.indexOf(pref) + 1) % order.length;
      const next = order[nextIndex];
      btn.setAttribute("title", `Theme: ${pref} (click for ${next})`);
      btn.setAttribute(
        "aria-label",
        `Theme: ${pref}. Click to switch to ${next}.`,
      );
    }
  }

  function apply(pref: Pref) {
    const prefersDark = window.matchMedia(
      "(prefers-color-scheme: dark)",
    ).matches;
    const resolved = pref === "auto" ? (prefersDark ? "dark" : "light") : pref;
    root.setAttribute("data-theme", resolved);
    root.dataset.themePref = pref;
    localStorage.setItem("sn-theme", pref);
    syncUI(pref);
  }

  const initial = (root.dataset.themePref as Pref) || "auto";
  syncUI(initial);

  btn?.addEventListener("click", () => {
    const current = (root.dataset.themePref as Pref) || "auto";
    const next = order[(order.indexOf(current) + 1) % order.length];
    apply(next);
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 54px;
    display: flex;
    align-items: center;
    padding: 0 36px;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(20px) saturate(1.8);
    border-bottom: 1px solid var(--border);
    gap: 0;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .nav-name {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.3px;
  }

  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-search {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 7px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 12.5px;
    color: var(--text-muted);
    cursor: pointer;
    appearance: none;
    font-family: var(--font-ui);
    transition: border-color 0.12s;
  }

  .nav-search:hover {
    border-color: var(--border-strong);
  }

  .nav-search kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1px 5px;
    color: var(--text-muted);
    margin-left: 4px;
  }

  .theme-toggle {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    transition:
      background 0.12s,
      color 0.12s,
      border-color 0.12s;
    flex-shrink: 0;
    padding: 0;
  }

  .theme-toggle:hover {
    background: var(--surface);
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .theme-icon {
    display: none;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }
</style>
