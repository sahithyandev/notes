---
interface Props {
  data: number[];
  columns?: number;
  title?: string;
  caption?: string;
  accentCols?: number[];
}

const { data, columns = 8, title, caption, accentCols = [] } = Astro.props;
const accent = new Set(accentCols);
---

<figure class="permtable">
  {title && <figcaption class="title">{title}</figcaption>}
  <ol class="grid" style={`--cols:${columns}`}>
    {
      data.map((src, i) => (
        <li class:list={["cell", { accent: accent.has(i % columns) }]}>
          <span class="out">{i + 1}</span>
          <span class="src">{src}</span>
        </li>
      ))
    }
  </ol>
  {caption && <p class="caption">{caption}</p>}
</figure>

<style>
  .permtable {
    margin: 20px 0;
    text-align: center;
  }

  .title {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .grid {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    display: grid;
    grid-template-columns: repeat(var(--cols), 3rem);
    gap: 3px;
  }

  .cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .cell.accent {
    background: color-mix(in oklab, var(--dia-ct) 14%, var(--surface));
    border-color: color-mix(in oklab, var(--dia-ct) 45%, var(--surface));
  }

  .src {
    margin-top: 0.35em;
  }

  .out {
    position: absolute;
    top: 2px;
    left: 3px;
    font-size: 0.5rem;
    line-height: 1;
    color: var(--text-muted);
  }

  .caption {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 8px auto 0;
    max-width: 54ch !important;
  }
</style>
