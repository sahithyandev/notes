---
import StatCard from "./stat-card.astro";
---

<div class="stats-band">
    <StatCard value="8" label="Semesters" />
    <StatCard value="32" label="Modules" />
    <StatCard value="200+" label="Notes" />
</div>

<style>
    /* ── STATS BAND ───────────────────────────────────────────────── */
    .stats-band {
        background: var(--surface);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: center;
    }
</style>
