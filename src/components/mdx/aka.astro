---
// Inline alias lead-in: <Aka>SNR, signal-to-noise ratio</Aka>. Ratio of signal to noise power.
interface Props {
  original?: string;
}
const { original } = Astro.props;
const hasOriginal = original !== undefined;
let label = "Also known as ";
if (hasOriginal) {
  label = label.toLowerCase();
}
---

<!-- prettier-ignore -->
<span class="aka" data-pagefind-weight="1.2">{hasOriginal && `${original} (`}<span class="aka-label">{label}</span><span class="aka-names"><slot /></span>{hasOriginal && ")"}</span>

<style is:global>
  .aka-label {
    color: var(--text-muted);
  }

  .aka-names {
    font-weight: 500;
  }
</style>
