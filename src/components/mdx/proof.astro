---
interface Props {
  label?: string;
}

const { label = "Proof" } = Astro.props;
---

<details class="proof">
  <summary>
    <span class="proof-label">{label}</span>
    <span class="proof-hint">
      <span class="proof-when-closed">Show</span>
      <span class="proof-when-open">Hide</span>
    </span>
  </summary>
  <div class="proof-body">
    <slot />
  </div>
</details>

<style is:global>
  .proof {
    --proof-ease: cubic-bezier(0.22, 1, 0.36, 1);

    margin: 12px 0 24px;
    interpolate-size: allow-keywords;
  }

  .proof > summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
    font-family: var(--font-ui);
  }

  .proof > summary::-webkit-details-marker {
    display: none;
  }

  .proof > summary:focus-visible {
    outline: 2px solid var(--sem);
    outline-offset: 2px;
  }

  .proof-label {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .proof-hint {
    display: grid;
    justify-items: end;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .proof-hint > span {
    grid-area: 1 / 1;
  }

  .proof-when-open,
  .proof[open] > summary .proof-when-closed {
    opacity: 0;
  }

  .proof[open] > summary .proof-when-open {
    opacity: 1;
  }

  .proof > summary:hover .proof-hint {
    color: var(--text-primary);
  }

  .proof-body {
    padding: 4px 0 0 16px;
    border-left: 2px solid var(--border);
    overflow-x: auto;
  }

  .proof-body > :first-child {
    margin-top: 0;
  }

  .proof-body::after {
    content: "\220E";
    display: block;
    text-align: right;
    color: var(--text-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .proof-hint > span {
      transition: opacity 0.2s ease;
    }

    .proof[open] > .proof-body {
      animation: proof-in 0.3s var(--proof-ease);
    }

    @supports selector(::details-content) {
      .proof::details-content {
        block-size: 0;
        overflow: clip;
        transition:
          block-size 0.2s var(--proof-ease),
          content-visibility 0.2s allow-discrete;
      }

      .proof[open]::details-content {
        block-size: auto;
        transition:
          block-size 0.35s var(--proof-ease),
          content-visibility 0.35s allow-discrete;
      }
    }
  }

  @keyframes proof-in {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }
</style>
