---
interface Props {
  label?: string;
}

const { label = "Proof" } = Astro.props;
const isHint = /hint/i.test(label);
---

<aside class="proof">
  <div class="proof-sheet">
    <p class="proof-label">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        {isHint ? (
          <>
            <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
            <path d="M9 18h6" />
            <path d="M10 22h4" />
          </>
        ) : (
          <>
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </>
        )}
      </svg>
      <span>{label}</span>
    </p>
    <div class="proof-body">
      <slot />
    </div>
  </div>
</aside>

<style is:global>
  .proof {
    margin: 20px 0 24px;
  }

  .proof-sheet {
    padding: 14px 20px 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .proof-label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.75rem !important;
    font-weight: 500;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .proof-label svg {
    flex-shrink: 0;
  }

  .proof-body {
    overflow-x: auto;
  }

  .proof-body > :first-child {
    margin-top: 0;
  }

  .proof-body > :last-child {
    margin-bottom: 0;
  }

  .proof-body::after {
    content: "\220E";
    display: block;
    text-align: right;
    line-height: 1;
    color: var(--text-muted);
  }
</style>
