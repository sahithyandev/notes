---
// Inline defined term with a hover/focus definition: <Term def="Ratio of signal to noise power">SNR</Term>
interface Props {
  def: string;
}

const { def } = Astro.props;
---

<dfn class="term-def" tabindex="0" data-def={def} aria-description={def}>
  <slot />
</dfn>

<style is:global>
  .term-def {
    position: relative;
    font-style: normal;
    text-decoration: underline dotted;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.2em;
    cursor: help;
  }

  .term-def::after {
    content: attr(data-def);
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.4em);
    z-index: 20;
    width: max-content;
    max-width: min(18rem, 80vw);
    padding: 0.4em 0.65em;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-primary);
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: left;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity 0.12s;
  }

  .term-def:hover::after,
  .term-def:focus-visible::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .term-def::after {
      transition: none;
    }
  }
</style>
