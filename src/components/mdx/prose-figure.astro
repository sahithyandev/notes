---
// Pairs a compact figure with the prose that introduces it. The source order
// remains prose then figure for narrow viewports and assistive technology.
---

<div class="prose-figure">
  <div class="prose">
    <slot />
  </div>
  <div class="figure">
    <slot name="figure" />
  </div>
</div>

<style>
  .prose-figure {
    display: grid;
    gap: 0;
  }

  .prose,
  .figure {
    min-width: 0;
  }

  .figure {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 48rem) {
    .prose-figure {
      column-gap: clamp(1.5rem, 4vw, 2.5rem);
      grid-template-columns: minmax(0, 1fr) minmax(12.5rem, 0.75fr);
    }
  }
</style>
