---
interface Props {}
---

<div class="formula">
  <slot />
</div>

<style is:global>
  .formula {
    margin: 20px 0;
    text-align: center;
  }

  .formula-name {
    margin: 0 0 4px;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.6px;
    text-transform: uppercase;
  }

  .formula > :last-child {
    margin-bottom: 0;
  }

  .formula .katex-display {
    margin: 0.4em 0;
    overflow-x: auto;
    overflow-y: hidden;
  }
</style>
