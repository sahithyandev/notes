---
interface Props {
  number: number;
  subjects: string[];
  notesCount: string;
  href?: string;
}

const { number, subjects, notesCount, href = "#" } = Astro.props;

// Get the CSS variable for this semester
const semesterVar = `--s${number}`;
const semesterColor = `var(${semesterVar})`;
---

<a href={href} class="sem-card" data-s={number}>
  <div class="sem-card-top" style={`background:${semesterColor}`}></div>
  <div class="sem-card-wm" style={`color:${semesterColor}`}>{number.toString().padStart(2, '0')}</div>
  <div class="sem-card-body">
    <div class="sem-card-num" style={`color:${semesterColor}`}>
      <div class="sem-card-num-dot" style={`background:${semesterColor}`}></div>
      Semester {number}
    </div>
    <ul class="sem-card-subjects">
      {subjects.map(subject => <li>{subject}</li>)}
    </ul>
  </div>
  <div class="sem-card-footer">
    <span class="sem-card-count">{notesCount} notes</span>
    <span class="sem-open" style={`color:${semesterColor}`}>Open →</span>
  </div>
</a>

<style>
  .sem-card {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.16s,
      box-shadow 0.16s,
      transform 0.14s;
  }

  .sem-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  /* Watermark number */
  .sem-card-wm {
    position: absolute;
    right: -8px;
    top: -10px;
    font-size: 96px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -4px;
    pointer-events: none;
    user-select: none;
    opacity: 0.055;
    font-variant-numeric: tabular-nums;
  }

  .sem-card-top {
    height: 4px;
    flex-shrink: 0;
  }

  .sem-card-body {
    padding: 18px 20px 14px;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .sem-card-num {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .sem-card-num-dot {
    --spacing: 8px;
    width: var(--spacing);
    height: var(--spacing);
    border-radius: 3px;
    flex-shrink: 0;
  }

  .sem-card-subjects {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 10px;
  }

  .sem-card-subjects li {
    font-size: 12.5px;
    color: var(--text-secondary);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 9px;
    line-height: 1.3;
  }

  .sem-card-subjects li::before {
    content: "";
    width: 3px;
    height: 3px;
    border-radius: 1.5px;
    background: currentColor;
    opacity: 0.4;
    flex-shrink: 0;
  }

  .sem-card-footer {
    padding: 10px 20px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .sem-card-count {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
    font-family: var(--font-mono);
  }

  .sem-open {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--accent);
  }

  /* Per-semester hover shadows */
  .sem-card[data-s="1"]:hover {
    box-shadow: 0 8px 28px rgba(51, 72, 200, 0.12);
  }

  .sem-card[data-s="2"]:hover {
    box-shadow: 0 8px 28px rgba(107, 56, 160, 0.12);
  }

  .sem-card[data-s="3"]:hover {
    box-shadow: 0 8px 28px rgba(26, 122, 74, 0.12);
  }

  .sem-card[data-s="4"]:hover {
    box-shadow: 0 8px 28px rgba(138, 90, 24, 0.12);
  }

  .sem-card[data-s="5"]:hover {
    box-shadow: 0 8px 28px rgba(79, 58, 192, 0.12);
  }

  .sem-card[data-s="6"]:hover {
    box-shadow: 0 8px 28px rgba(160, 36, 90, 0.12);
  }

  .sem-card[data-s="7"]:hover {
    box-shadow: 0 8px 28px rgba(14, 122, 150, 0.12);
  }

  .sem-card[data-s="8"]:hover {
    box-shadow: 0 8px 28px rgba(148, 64, 24, 0.12);
  }
</style>