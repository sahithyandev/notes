---
interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 14, height = 14, class: className } = Astro.props;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m6 9 6 6 6-6"></path>
</svg>

<style>
  svg {
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
</style>
