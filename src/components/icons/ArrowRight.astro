---
interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 24, height = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m9 18 6-6-6-6"></path>
</svg>
