---
interface Author {
  data: {
    slug: string;
    name: string;
    url?: string;
  };
}

interface Props {
  authors: Author[];
  lastUpdatedOn?: Date;
  readTime: number;
}

const { authors, lastUpdatedOn, readTime } = Astro.props;

function initials(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join("");
}

const formattedDate = lastUpdatedOn
  ? new Intl.DateTimeFormat("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    }).format(lastUpdatedOn)
  : null;

const metaLine = [formattedDate, `${readTime} min read`]
  .filter(Boolean)
  .join(" · ");
---

{
  authors.length > 0 && (
    <div class="note-authors" aria-label="Note authors">
      <span class="note-authors-label">Written by</span>

      <ul class="note-authors-list">
        {authors.map((author) => (
          <li class="note-authors-item">
            <span class="note-authors-avatar" aria-hidden="true">
              {initials(author.data.name)}
            </span>
            {author.data.url ? (
              <a
                class="note-authors-link"
                href={author.data.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {author.data.name}
              </a>
            ) : (
              <span class="note-authors-name">{author.data.name}</span>
            )}
          </li>
        ))}
      </ul>

      {metaLine && <span class="note-authors-meta">{metaLine}</span>}
    </div>
  )
}

<style>
  .note-authors {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-family: var(--font-ui);
  }

  .note-authors-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.3px;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .note-authors-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .note-authors-item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .note-authors-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sem-bg);
    color: var(--sem-text);
    border: 1px solid var(--sem-border);
    font-size: 0.6875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .note-authors-name,
  .note-authors-link {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
  }

  .note-authors-link:hover {
    color: var(--sem);
    text-decoration: underline;
  }

  .note-authors-meta {
    display: block;
    margin-top: 12px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>
