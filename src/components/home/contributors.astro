---
import { getCollection } from "astro:content";

const [notes, authors] = await Promise.all([
  getCollection("notes"),
  getCollection("authors"),
]);

const totals = new Map(
  authors.map((author) => [
    author.id,
    { notes: 0, modules: new Set<string>() },
  ]),
);
const allModules = new Set<string>();

for (const note of notes) {
  const moduleId = note.id.split("/").slice(0, 2).join("/");
  allModules.add(moduleId);
  for (const ref of note.data.authors) {
    const entry = totals.get(ref.id);
    if (entry) {
      entry.notes++;
      entry.modules.add(moduleId);
    }
  }
}

const contributors = authors
  .map((author) => ({ author, ...totals.get(author.id)! }))
  .filter((c) => c.notes > 0)
  .sort((a, b) => b.notes - a.notes);

function initials(name: string) {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join("");
}
---

<div class="contributors">
  <ul class="contributor-list">
    {contributors.map(({ author, notes, modules }) => (
      <li class="contributor" style={`--author-color: ${author.data.color}`}>
        <div class="avatar" aria-hidden="true">
          {author.data.github_id ? (
            <>
              <img
                src={`https://github.com/${author.data.github_id}.png?size=136`}
                alt=""
                loading="lazy"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
              />
              <span class="avatar-fallback">{initials(author.data.name)}</span>
            </>
          ) : (
            initials(author.data.name)
          )}
        </div>
        <div class="info">
          {author.data.url ? (
            <a
              class="name"
              href={author.data.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {author.data.name}
            </a>
          ) : (
            <span class="name">{author.data.name}</span>
          )}
          <span class="meta">
            {notes} {notes === 1 ? "note" : "notes"} · {modules.size}{" "}
            {modules.size === 1 ? "module" : "modules"}
          </span>
        </div>
      </li>
    ))}
  </ul>

  <p class="summary">
    {notes.length} notes across {allModules.size} modules, written by{" "}
    {contributors.length}
    {contributors.length === 1 ? "author" : "authors"}.
  </p>
</div>

<style>
  .contributor-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contributor {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    border-radius: 9px;
    background: var(--surface);
    border: 1px solid var(--border);
    --author-bg: color-mix(in oklab, var(--author-color) 13%, var(--surface));
    --author-border: color-mix(
      in oklab,
      var(--author-color) 32%,
      var(--surface)
    );
  }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--author-bg);
    color: var(--author-color);
    border: 1px solid var(--author-border);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-fallback {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
  }

  a.name:hover {
    color: var(--author-color);
    text-decoration: underline;
  }

  .meta {
    font-size: 12px;
    color: var(--text-muted);
  }

  .summary {
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-muted);
  }
</style>
