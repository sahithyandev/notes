---

---

<dialog id="image-zoom" aria-label="Zoomed image">
  <img id="image-zoom-img" alt="" />
  <figcaption id="image-zoom-caption" hidden></figcaption>
  <button id="image-zoom-close" type="button" aria-label="Close zoomed image">
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
</dialog>

<style>
  #image-zoom {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 2rem 1.5rem;
    border: none;
    background: transparent;
    overflow: hidden;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    cursor: zoom-out;
  }

  #image-zoom[open] {
    display: flex;
  }

  #image-zoom::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  :global([data-theme="dark"]) #image-zoom::backdrop {
    background: rgba(0, 0, 0, 0.92);
  }

  #image-zoom.is-open::backdrop {
    opacity: 1;
  }

  #image-zoom-img {
    flex: 0 1 auto;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 0.375rem;
  }

  #image-zoom-caption {
    flex: 0 0 auto;
    margin: 0;
    max-width: min(64ch, 100%);
    max-height: 20vh;
    overflow-y: auto;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.3;
    color: #e8e8f0;
  }

  #image-zoom-caption[hidden] {
    display: none;
  }

  #image-zoom-caption :global(a) {
    color: #fff;
    text-decoration: underline;
  }

  /* Match the in-article `figcaption p` metrics (article.astro) so the text
     does not visibly resize when the morph lands on the live element. */
  #image-zoom-caption :global(p) {
    margin: 0;
    font-size: 1.06em;
    line-height: 1.6;
  }

  #image-zoom-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: #e8e8f0;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.28s ease,
      background 0.15s ease;
  }

  #image-zoom-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  #image-zoom.is-open #image-zoom-close {
    opacity: 1;
  }
</style>

<style is:global>
  /* The dialog opens/closes inside document.startViewTransition(), so the
     browser morphs the thumbnail into the full-screen image (and its caption)
     for free. Only the tagged groups animate; the rest of the page holds still. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
  }

  ::view-transition-group(zoom-image) {
    animation-duration: 0.22s;
    animation-timing-function: ease-out;
  }

  ::view-transition-image-pair(zoom-image) {
    overflow: clip;
  }

  /* The caption is tagged on both ends so it glides from its in-text spot to
     the bottom bar. object-fit: none keeps the text rendered at its true
     pixel size in both snapshots, so only the box translates -- the glyphs
     never scale or smear. */
  ::view-transition-group(zoom-caption) {
    animation-duration: 0.22s;
    animation-timing-function: ease-out;
  }

  ::view-transition-old(zoom-caption),
  ::view-transition-new(zoom-caption) {
    height: 100%;
    width: 100%;
    object-fit: none;
    object-position: center;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(zoom-image),
    ::view-transition-group(zoom-caption),
    ::view-transition-old(zoom-image),
    ::view-transition-new(zoom-image),
    ::view-transition-old(zoom-caption),
    ::view-transition-new(zoom-caption) {
      animation-duration: 1ms !important;
    }
  }
</style>
