---
// Static node-and-arrow project network diagram: events as circles, activities
// as labeled directed arrows between them (dashed for a dummy activity). With
// `times` on a node, its earliest finish and latest finish values sit in 2
// squares above the circle.
import { makeUid } from "./lib/uid";
import ArrowMarker from "./primitives/arrow-marker.astro";
import FigureCaption from "./primitives/figure-caption.astro";

interface Times {
  // Earliest finish time at the event.
  ef?: string;
  // Latest finish time at the event.
  lf?: string;
  // Set in the current step of a walkthrough.
  current?: boolean;
}

interface Node {
  id: string;
  x: number;
  y: number;
  times?: Times;
}

interface Edge {
  from: string;
  to: string;
  label: string;
  dashed?: boolean;
  // On the critical path.
  critical?: boolean;
}

interface Props {
  nodes: Node[];
  edges: Edge[];
  width?: number;
  height?: number;
  caption?: string;
}

const {
  nodes,
  edges,
  width = 560,
  height = 300,
  caption = "Project network diagram with events as circles and activities as arrows between them",
} = Astro.props;

const uid = makeUid("net");

const R = 18;
const SQ = 46;
const SQ_H = 34;
const SQ_GAP = 4;

const byId = new Map(nodes.map((n) => [n.id, n]));

const arrows = edges.map((edge) => {
  const from = byId.get(edge.from)!;
  const to = byId.get(edge.to)!;
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const dist = Math.hypot(dx, dy) || 1;
  const ux = dx / dist;
  const uy = dy / dist;
  const x1 = from.x + ux * R;
  const y1 = from.y + uy * R;
  const x2 = to.x - ux * R;
  const y2 = to.y - uy * R;
  const midX = (x1 + x2) / 2;
  const midY = (y1 + y2) / 2;
  // Offset the label off the line, on its perpendicular side.
  const nx = -uy;
  const ny = ux;
  const labelX = midX + nx * 12;
  const labelY = midY + ny * 12;
  return { ...edge, x1, y1, x2, y2, labelX, labelY };
});

const boxes = nodes
  .filter((n) => n.times)
  .map((n) => {
    const top = n.y - R - 8 - SQ_H;
    const left = n.x - SQ - SQ_GAP / 2;
    const right = n.x + SQ_GAP / 2;
    return {
      ...n,
      cells: [
        { x: left, label: "EF", value: n.times!.ef ?? "" },
        { x: right, label: "LF", value: n.times!.lf ?? "" },
      ].map((c) => ({ ...c, top })),
      current: n.times!.current,
      top,
    };
  });
---

<figure class="network" id={uid} style={`max-width: ${width}px`}>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width="100%"
    role="img"
    aria-label="Project network diagram"
  >
    <defs>
      <ArrowMarker id={`${uid}-arrow`} />
    </defs>

    {arrows.map((a) => (
      <g class="edge">
        <line
          x1={a.x1}
          y1={a.y1}
          x2={a.x2}
          y2={a.y2}
          class:list={["shaft", { dummy: a.dashed, critical: a.critical }]}
          marker-end={`url(#${uid}-arrow)`}
        />
        <text x={a.labelX} y={a.labelY} class="edge-label" text-anchor="middle">
          {a.label}
        </text>
      </g>
    ))}

    {nodes.map((n) => (
      <g class="node">
        <circle cx={n.x} cy={n.y} r={R} />
        <text x={n.x} y={n.y} text-anchor="middle" dominant-baseline="central">
          {n.id}
        </text>
      </g>
    ))}

    {boxes.map((b) => (
      <g class:list={["values", { current: b.current }]}>
        {b.cells.map((c) => (
          <g class="cell">
            <rect x={c.x} y={c.top} width={SQ} height={SQ_H} rx="4" />
            <text
              x={c.x + SQ / 2}
              y={c.top + 11}
              text-anchor="middle"
              class="cell-label"
            >
              {c.label}
            </text>
            <text
              x={c.x + SQ / 2}
              y={c.top + 27}
              text-anchor="middle"
              class="cell-value"
            >
              {c.value}
            </text>
          </g>
        ))}
      </g>
    ))}
  </svg>
  <FigureCaption hidden>{caption}</FigureCaption>
</figure>

<style>
  .network {
    max-width: 560px;
    margin: 20px auto;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .shaft {
    stroke: var(--text-secondary);
    stroke-width: 1.5;
  }

  .shaft.dummy {
    stroke-dasharray: 5 4;
  }

  .shaft.critical {
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .edge-label {
    fill: var(--text-secondary);
    font-size: 12px;
    font-family: var(--font-mono);
  }

  .cell rect {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .values.current .cell rect {
    stroke: var(--accent);
    stroke-width: 2;
  }

  .cell-label {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .cell-value {
    fill: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  .node circle {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .node text {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
  }
</style>
