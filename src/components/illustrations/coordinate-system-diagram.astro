---
import { makeUid } from "./lib/uid";
import ArrowMarker from "./primitives/arrow-marker.astro";
import FigureCaption from "./primitives/figure-caption.astro";

interface Props {
  variant: "rectangular" | "cylindrical" | "spherical";
}
const { variant } = Astro.props;
const uid = makeUid("coord");
const title = {
  rectangular: "Rectangular coordinates",
  cylindrical: "Cylindrical coordinates",
  spherical: "Spherical coordinates",
}[variant];
---

<figure
  class="coordinate-diagram"
  data-coordinate-system
  data-variant={variant}
  data-uid={uid}
>
  <div class="stage">
    <svg
      class="scene"
      viewBox="-260 -170 520 340"
      data-scene
      tabindex="0"
      role="img"
      aria-label={`${title}. Drag to rotate or use the arrow keys.`}
    >
      <defs>
        <ArrowMarker id={`${uid}-axis`} fill="var(--text-muted)" size={7} />
        <ArrowMarker id={`${uid}-parameter`} fill="var(--accent)" size={7} />
      </defs>
      <g data-layer></g>
    </svg>
    <button type="button" class="reset" data-reset hidden>
      Reset view
    </button>
  </div>
  <FigureCaption>
    <span class="hint">
      Drag to rotate. Use the arrow keys for precise rotation.
    </span>
    {variant === "rectangular" && (
      <>
        Signed distances <span class="accent">x</span>,{" "}
        <span class="accent">y</span>, and <span class="accent">z</span> locate{" "}
        <i>P</i>.
      </>
    )}
    {variant === "cylindrical" && (
      <>
        The parameters are radial distance <span class="accent">r</span>,
        azimuth <span class="accent">θ</span>, and height{" "}
        <span class="accent">z</span>.
      </>
    )}
    {variant === "spherical" && (
      <>
        The parameters are radius <span class="accent">ρ</span>, azimuth{" "}
        <span class="accent">θ</span>, and polar angle{" "}
        <span class="accent">φ</span>.
      </>
    )}
  </FigureCaption>
</figure>

<script>
  type Vec = [number, number, number];
  type Kind =
    | "axis"
    | "axis-label"
    | "parameter"
    | "angle"
    | "plane"
    | "point"
    | "label"
    | "point-label"
    | "plane-label";
  type Item = {
    kind: Kind;
    points?: Vec[];
    text?: string;
    at?: Vec;
    anchor?: string;
    marker?: string;
  };
  const PI = Math.PI;
  const defaults = { yaw: -0.45, pitch: 0.32 };
  const clamp = (n: number, min: number, max: number) =>
    Math.max(min, Math.min(max, n));
  const add = (a: Vec, b: Vec): Vec => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
  const scale = (a: Vec, n: number): Vec => [a[0] * n, a[1] * n, a[2] * n];
  const spherical = (rho: number, phi: number, theta: number): Vec => [
    rho * Math.sin(phi) * Math.cos(theta),
    rho * Math.sin(phi) * Math.sin(theta),
    rho * Math.cos(phi),
  ];
  const sample = (count: number, fn: (t: number) => Vec) =>
    Array.from({ length: count + 1 }, (_, i) => fn(i / count));

  function itemsFor(variant: string): Item[] {
    const O: Vec = [0, 0, 0];
    const items: Item[] = [
      { kind: "axis", points: [O, [3.8, 0, 0]], marker: "axis" },
      { kind: "axis", points: [O, [0, 3, 0]], marker: "axis" },
      { kind: "axis", points: [O, [0, 0, 3.2]], marker: "axis" },
      { kind: "axis-label", at: [4.05, 0, 0], text: "x" },
      { kind: "axis-label", at: [0, 3.2, 0], text: "y" },
      { kind: "axis-label", at: [0, 0, 3.45], text: "z" },
      { kind: "axis-label", at: [-0.18, -0.18, 0], text: "O", anchor: "end" },
    ];
    if (variant === "rectangular") {
      const P: Vec = [2.35, 1.35, 1.8];
      const X: Vec = [P[0], 0, 0];
      const XY: Vec = [P[0], P[1], 0];
      items.push(
        { kind: "parameter", points: [O, X], marker: "parameter" },
        { kind: "parameter", points: [X, XY], marker: "parameter" },
        { kind: "parameter", points: [XY, P], marker: "parameter" },
        { kind: "point", at: P },
        { kind: "point-label", at: add(P, [0.16, 0.12, 0.08]), text: "P" },
        { kind: "label", at: [1.2, -0.12, 0], text: "x" },
        { kind: "label", at: [2.25, 0.88, -0.08], text: "y" },
        { kind: "label", at: [2.5, 1.35, 0.92], text: "z" },
      );
      return items;
    }
    if (variant === "cylindrical") {
      const r = 2.2;
      const theta = 0.55;
      const z = 1.8;
      const Q: Vec = [r * Math.cos(theta), r * Math.sin(theta), 0];
      const P: Vec = [Q[0], Q[1], z];
      items.push(
        { kind: "parameter", points: [O, Q], marker: "parameter" },
        { kind: "parameter", points: [Q, P], marker: "parameter" },
        {
          kind: "angle",
          points: sample(12, (t) => [
            0.78 * Math.cos(theta * t),
            0.78 * Math.sin(theta * t),
            0,
          ]),
        },
        { kind: "point", at: P },
        { kind: "point-label", at: add(P, [0.15, 0.1, 0.1]), text: "P" },
        { kind: "label", at: scale(Q, 0.53), text: "r" },
        { kind: "label", at: [0.88, 0.3, 0], text: "θ" },
        { kind: "label", at: add(Q, [0.12, 0, z * 0.5]), text: "z" },
      );
      return items;
    }
    const rho = 3;
    const theta = 0.58;
    const phi = 0.78;
    const P = spherical(rho, phi, theta);
    const Q: Vec = [P[0], P[1], 0];
    items.push(
      { kind: "parameter", points: [O, P], marker: "parameter" },
      {
        kind: "angle",
        points: sample(12, (t) => [
          0.78 * Math.cos(theta * t),
          0.78 * Math.sin(theta * t),
          0,
        ]),
      },
      {
        kind: "angle",
        points: sample(16, (t) => spherical(0.9, t * phi, theta)),
      },
      { kind: "point", at: P },
      { kind: "point-label", at: add(P, [0.15, 0.1, 0.1]), text: "P" },
      { kind: "label", at: scale(P, 0.52), text: "ρ" },
      { kind: "label", at: [0.88, 0.3, 0], text: "θ" },
      { kind: "label", at: spherical(1.02, phi * 0.52, theta), text: "φ" },
    );
    return items;
  }

  function init(root: HTMLElement) {
    if (root.dataset.coordinateSystemInit) return;
    root.dataset.coordinateSystemInit = "1";
    const scene = root.querySelector<SVGSVGElement>("[data-scene]")!;
    const layer = root.querySelector<SVGGElement>("[data-layer]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-reset]")!;
    const uid = root.dataset.uid!;
    const items = itemsFor(root.dataset.variant!);
    const SCALE = 78;
    const ORIGIN_X = -175;
    const ORIGIN_Y = 110;
    let yaw = defaults.yaw;
    let pitch = defaults.pitch;
    let drag: { x: number; y: number } | null = null;
    const project = (p: Vec) => {
      const cy = Math.cos(yaw),
        sy = Math.sin(yaw),
        cp = Math.cos(pitch),
        sp = Math.sin(pitch);
      const x = p[0] * cy - p[1] * sy;
      const y = p[0] * sy + p[1] * cy;
      return {
        x: ORIGIN_X + SCALE * x,
        y: ORIGIN_Y - SCALE * (y * sp + p[2] * cp),
      };
    };
    const path = (points: Vec[]) =>
      points
        .map((p, i) => {
          const q = project(p);
          return `${i ? "L" : "M"}${q.x.toFixed(1)},${q.y.toFixed(1)}`;
        })
        .join(" ");
    const element = (tag: string, cls: string) => {
      const node = document.createElementNS("http://www.w3.org/2000/svg", tag);
      node.setAttribute("class", cls);
      return node;
    };
    function render() {
      layer.replaceChildren();
      for (const item of items) {
        if (
          item.kind === "label" ||
          item.kind === "axis-label" ||
          item.kind === "point-label" ||
          item.kind === "plane-label"
        ) {
          const q = project(item.at!);
          const text = element("text", item.kind);
          text.setAttribute("x", q.x.toFixed(1));
          text.setAttribute("y", q.y.toFixed(1));
          text.setAttribute("text-anchor", item.anchor ?? "middle");
          text.textContent = item.text!;
          layer.append(text);
          continue;
        }
        if (item.kind === "point") {
          const q = project(item.at!);
          const point = element("circle", "point");
          point.setAttribute("cx", q.x.toFixed(1));
          point.setAttribute("cy", q.y.toFixed(1));
          point.setAttribute("r", "5");
          layer.append(point);
          continue;
        }
        const shape = element(
          item.kind === "plane" ? "polygon" : "path",
          item.kind,
        );
        if (item.kind === "plane")
          shape.setAttribute(
            "points",
            item
              .points!.map((p) => {
                const q = project(p);
                return `${q.x},${q.y}`;
              })
              .join(" "),
          );
        else shape.setAttribute("d", path(item.points!));
        if (item.marker)
          shape.setAttribute("marker-end", `url(#${uid}-${item.marker})`);
        layer.append(shape);
      }
    }
    const rotate = (dx: number, dy: number) => {
      yaw += dx;
      pitch = clamp(pitch + dy, -1.45, 1.45);
      render();
      reset.hidden = false;
    };
    scene.addEventListener("pointerdown", (event) => {
      drag = { x: event.clientX, y: event.clientY };
      scene.setPointerCapture(event.pointerId);
    });
    scene.addEventListener("pointermove", (event) => {
      if (!drag) return;
      rotate(
        (event.clientX - drag.x) * 0.012,
        (event.clientY - drag.y) * 0.012,
      );
      drag = { x: event.clientX, y: event.clientY };
    });
    scene.addEventListener("pointerup", () => {
      drag = null;
    });
    scene.addEventListener("pointercancel", () => {
      drag = null;
    });
    scene.addEventListener("keydown", (event) => {
      const step = 0.1;
      if (event.key === "ArrowLeft") rotate(-step, 0);
      if (event.key === "ArrowRight") rotate(step, 0);
      if (event.key === "ArrowUp") rotate(0, -step);
      if (event.key === "ArrowDown") rotate(0, step);
    });
    reset.addEventListener("click", () => {
      yaw = defaults.yaw;
      pitch = defaults.pitch;
      reset.hidden = true;
      render();
      scene.focus();
    });
    render();
  }
  document
    .querySelectorAll<HTMLElement>("[data-coordinate-system]")
    .forEach(init);
</script>

<style>
  .coordinate-diagram {
    max-width: 560px;
    margin: 24px auto;
  }
  .stage {
    position: relative;
  }
  .scene {
    display: block;
    width: 100% !important;
    height: auto !important;
    border-radius: 6px;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }
  .scene:active {
    cursor: grabbing;
  }
  .scene:focus-visible,
  .reset:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .reset {
    position: absolute;
    top: 4px;
    right: 4px;
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-secondary);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .reset:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .coordinate-diagram :global(.axis) {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.3;
  }
  .coordinate-diagram :global(.axis-label),
  .coordinate-diagram :global(.origin) {
    fill: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .coordinate-diagram :global(.origin) {
    font-size: 12px;
  }
  .coordinate-diagram :global(.parameter) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .coordinate-diagram :global(.angle) {
    fill: none;
    stroke: var(--dia-pt);
    stroke-width: 2;
  }
  .coordinate-diagram :global(.point) {
    fill: var(--accent);
  }
  .coordinate-diagram :global(.label),
  .coordinate-diagram :global(.point-label),
  .coordinate-diagram :global(.plane-label) {
    paint-order: stroke;
    stroke: var(--bg);
    stroke-linejoin: round;
  }
  .coordinate-diagram :global(.label),
  .coordinate-diagram :global(.point-label) {
    fill: var(--accent);
    font-family: var(--font-mono);
    font-size: 17px;
    font-style: italic;
    stroke-width: 4px;
  }
  .coordinate-diagram :global(.point-label) {
    font-style: normal;
    font-weight: 600;
  }
  .coordinate-diagram :global(.plane-label) {
    fill: var(--dia-ct);
    font-family: var(--font-mono);
    font-size: 13px;
    stroke-width: 3px;
  }
  .hint {
    display: block;
    margin-bottom: 4px;
    color: var(--text-muted);
    font-size: 0.9em;
  }
  .accent {
    color: var(--accent);
    font-weight: 600;
  }
</style>
