---
// Side-by-side RGB and CMYK editor. Editing one space recomputes the other
// using the exact formulas from the note. One swatch: a display emits RGB
// only, so a separate CMYK swatch would be the same pixels. The readout
// instead shows the canonical CMYK a round trip through RGB lands on.
function rgbToCmyk(r: number, g: number, b: number) {
  const R = r / 255,
    G = g / 255,
    B = b / 255;
  const k = 1 - Math.max(R, G, B);
  if (k === 1) return { c: 0, m: 0, y: 0, k: 1 };
  return {
    c: (1 - R - k) / (1 - k),
    m: (1 - G - k) / (1 - k),
    y: (1 - B - k) / (1 - k),
    k,
  };
}

const R0 = 62,
  G0 = 40,
  B0 = 184;
const c0 = rgbToCmyk(R0, G0, B0);
const f2 = (n: number) => n.toFixed(2);
const rgbChannels = [
  { ch: "r", label: "R" },
  { ch: "g", label: "G" },
  { ch: "b", label: "B" },
] as const;
const cmykChannels = [
  { ch: "c", label: "C", v: c0.c },
  { ch: "m", label: "M", v: c0.m },
  { ch: "y", label: "Y", v: c0.y },
  { ch: "k", label: "K", v: c0.k },
] as const;
const rgb0 = [R0, G0, B0] as const;
---

<figure class="rgb-cmyk">
  <div class="panels">
    <div class="panel" data-space="rgb">
      <div class="panel-head">
        <span class="panel-title">RGB</span>
        <input
          type="color"
          data-picker
          value={`#${[R0, G0, B0].map((n) => n.toString(16).padStart(2, "0")).join("")}`}
          aria-label="Pick an RGB colour"
        />
      </div>
      {
        rgbChannels.map(({ ch, label }, i) => (
          <label class="row">
            <span class="ch">{label}</span>
            <input
              type="range"
              min="0"
              max="255"
              step="1"
              data-ch={ch}
              value={rgb0[i]}
            />
            <input
              type="number"
              min="0"
              max="255"
              step="1"
              data-ch={ch}
              value={rgb0[i]}
            />
          </label>
        ))
      }
    </div>

    <div class="panel" data-space="cmyk">
      <div class="panel-head">
        <span class="panel-title">CMYK</span>
      </div>
      {
        cmykChannels.map(({ ch, label, v }) => (
          <label class="row">
            <span class="ch">{label}</span>
            <input
              type="range"
              min="0"
              max="1"
              step="0.01"
              data-ch={ch}
              value={f2(v)}
            />
            <input
              type="number"
              min="0"
              max="1"
              step="0.01"
              data-ch={ch}
              value={f2(v)}
            />
          </label>
        ))
      }
    </div>
  </div>

  <div class="output">
    <div class="chip" data-swatch style={`background:rgb(${R0}, ${G0}, ${B0})`}>
    </div>
    <div class="caps">
      <span class="cap" data-cap="rgb">rgb({R0}, {G0}, {B0})</span>
      <span class="cap" data-cap="cmyk"
        >cmyk({f2(c0.c)}, {f2(c0.m)}, {f2(c0.y)}, {f2(c0.k)})</span
      >
    </div>
  </div>

  <p class="canonical" hidden data-canonical></p>
  <p class="live" aria-live="polite"></p>
</figure>

<style>
  .rgb-cmyk {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 16px;
    font-family: var(--font-ui);
  }

  .panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 40rem) {
    .panels {
      grid-template-columns: 1fr;
    }
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 1.8rem;
    margin-bottom: 10px;
  }
  .panel-title {
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.4px;
    color: var(--text-primary);
  }
  .panel-head input[type="color"] {
    width: 2rem;
    height: 1.6rem;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    background: none;
    cursor: pointer;
  }

  .row {
    display: grid;
    grid-template-columns: 1.2rem 1fr 3rem;
    align-items: center;
    gap: 8px;
    margin: 6px 0;
  }
  .ch {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .row input[type="range"] {
    width: 100%;
    accent-color: var(--sem, var(--accent));
  }
  .row input[type="number"] {
    width: 100%;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    text-align: right;
    padding: 2px 4px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-primary);
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .row input[type="number"]::-webkit-inner-spin-button,
  .row input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .rgb-cmyk input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .output {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
  }
  .chip {
    width: 84px;
    height: 56px;
    flex: none;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
  }
  .caps {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .cap {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .canonical {
    margin: 12px 0 0;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .canonical code {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  type Rgb = { r: number; g: number; b: number };
  type Cmyk = { c: number; m: number; y: number; k: number };

  function rgbToCmyk(r: number, g: number, b: number): Cmyk {
    const R = r / 255,
      G = g / 255,
      B = b / 255;
    const k = 1 - Math.max(R, G, B);
    if (k === 1) return { c: 0, m: 0, y: 0, k: 1 };
    return {
      c: (1 - R - k) / (1 - k),
      m: (1 - G - k) / (1 - k),
      y: (1 - B - k) / (1 - k),
      k,
    };
  }

  function cmykToRgb(c: number, m: number, y: number, k: number): Rgb {
    return {
      r: 255 * (1 - c) * (1 - k),
      g: 255 * (1 - m) * (1 - k),
      b: 255 * (1 - y) * (1 - k),
    };
  }

  const clamp = (n: number, lo: number, hi: number) =>
    Math.min(hi, Math.max(lo, Number.isFinite(n) ? n : lo));
  const f2 = (n: number) => n.toFixed(2);
  const hex = (rgb: Rgb) =>
    "#" +
    [rgb.r, rgb.g, rgb.b]
      .map((n) => Math.round(n).toString(16).padStart(2, "0"))
      .join("");

  function initConverter(root: HTMLElement) {
    const inputs = Array.from(
      root.querySelectorAll<HTMLInputElement>("input[data-ch]"),
    );
    const picker = root.querySelector<HTMLInputElement>("[data-picker]")!;
    const swatch = root.querySelector<HTMLElement>("[data-swatch]")!;
    const capRgb = root.querySelector<HTMLElement>('[data-cap="rgb"]')!;
    const capCmyk = root.querySelector<HTMLElement>('[data-cap="cmyk"]')!;
    const canonical = root.querySelector<HTMLElement>("[data-canonical]")!;
    const live = root.querySelector<HTMLElement>(".live")!;

    const chInputs = (ch: string) =>
      inputs.filter((el) => el.dataset.ch === ch);

    let rgb: Rgb = { r: 62, g: 40, b: 184 };
    let cmyk: Cmyk = rgbToCmyk(rgb.r, rgb.g, rgb.b);

    function writeRgbInputs() {
      (["r", "g", "b"] as const).forEach((ch) => {
        const v = String(Math.round(rgb[ch]));
        chInputs(ch).forEach((el) => {
          if (el !== document.activeElement || el.type === "range")
            el.value = v;
        });
      });
      picker.value = hex(rgb);
    }

    function writeCmykInputs() {
      (["c", "m", "y", "k"] as const).forEach((ch) => {
        const v = f2(cmyk[ch]);
        chInputs(ch).forEach((el) => {
          if (el !== document.activeElement || el.type === "range")
            el.value = v;
        });
      });
    }

    function render() {
      const rgbCss = `rgb(${Math.round(rgb.r)}, ${Math.round(rgb.g)}, ${Math.round(rgb.b)})`;
      swatch.style.background = rgbCss;
      capRgb.textContent = rgbCss;
      capCmyk.textContent = `cmyk(${f2(cmyk.c)}, ${f2(cmyk.m)}, ${f2(cmyk.y)}, ${f2(cmyk.k)})`;

      const under = Math.min(cmyk.c, cmyk.m, cmyk.y);
      if (under > 1e-9) {
        const back = cmykToRgb(cmyk.c, cmyk.m, cmyk.y, cmyk.k);
        const canon = rgbToCmyk(back.r, back.g, back.b);
        canonical.hidden = false;
        canonical.innerHTML =
          `A round trip through RGB re-expresses the same colour as ` +
          `<code>cmyk(${f2(canon.c)}, ${f2(canon.m)}, ${f2(canon.y)}, ${f2(canon.k)})</code>. ` +
          `Only tuples with at least one of C, M, Y at 0 survive the round trip unchanged.`;
      } else {
        canonical.hidden = true;
      }

      live.textContent = `${rgbCss}, cmyk ${f2(cmyk.c)} ${f2(cmyk.m)} ${f2(cmyk.y)} ${f2(cmyk.k)}`;
    }

    function fromRgb() {
      cmyk = rgbToCmyk(rgb.r, rgb.g, rgb.b);
      writeCmykInputs();
      render();
    }

    function fromCmyk() {
      rgb = cmykToRgb(cmyk.c, cmyk.m, cmyk.y, cmyk.k);
      writeRgbInputs();
      render();
    }

    inputs.forEach((el) => {
      el.addEventListener("input", () => {
        const ch = el.dataset.ch as keyof Rgb | keyof Cmyk;
        if (ch === "r" || ch === "g" || ch === "b") {
          rgb[ch] = clamp(Math.round(Number(el.value)), 0, 255);
          chInputs(ch).forEach((o) => {
            if (o !== el) o.value = String(rgb[ch]);
          });
          fromRgb();
        } else {
          cmyk[ch] = clamp(Number(el.value), 0, 1);
          chInputs(ch).forEach((o) => {
            if (o !== el) o.value = f2(cmyk[ch]);
          });
          fromCmyk();
        }
      });
    });

    picker.addEventListener("input", () => {
      const v = picker.value;
      rgb = {
        r: parseInt(v.slice(1, 3), 16),
        g: parseInt(v.slice(3, 5), 16),
        b: parseInt(v.slice(5, 7), 16),
      };
      writeRgbInputs();
      fromRgb();
    });

    writeRgbInputs();
    writeCmykInputs();
    render();
  }

  document
    .querySelectorAll<HTMLElement>(".rgb-cmyk")
    .forEach((el) => initConverter(el));
</script>
