---
import type { ComponentProps } from "astro/types";
import AssignmentTable from "./assignment-table.astro";
import StepNote from "./primitives/step-note.astro";

type Props = Omit<ComponentProps<typeof AssignmentTable>, "dataSource"> & {
  label: string;
};

const { label, ...table } = Astro.props;
---

<div class="step" data-label={label}>
  <AssignmentTable dataSource {...table} />
  <StepNote><slot /></StepNote>
</div>
