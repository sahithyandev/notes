---
// Static architecture + interaction diagram for Kerberos: the KDC (AS, TGS,
// shared K_T), the client workstation with its credential cache, and the
// Service, with the 5 protocol messages drawn as animated arrows carrying
// tickets. Orange marks the TGT side, green the SGT side, purple the
// password-derived key. Everything else is neutral.
// Deliberately not a formal UML sequence diagram.
const uid = "krb-" + Math.random().toString(36).slice(2, 9);

const W = 1000;
const H = 620;

// Turns K_{C,T} and Auth_{1} tokens into text with subscript tspans.
function fmt(s: string): string {
  return s
    .replace(
      /K_\{([^}]+)\}/g,
      '<tspan>K</tspan><tspan baseline-shift="sub" font-size="70%">$1</tspan>',
    )
    .replace(
      /Auth_\{(\d)\}/g,
      'Auth<tspan baseline-shift="sub" font-size="70%">$1</tspan>',
    );
}

const messages = [
  { name: "AS_REQ", body: "C, T, IP-list" },
  { name: "AS_REP", body: "TGT, Enc[K_{C}](K_{C,T})" },
  { name: "TGS_REQ", body: "V, TGT, Auth_{1}" },
  { name: "TGS_REP", body: "SGT, Enc[K_{C,T}](K_{C,V})" },
  { name: "AP_REQ", body: "SGT, Auth_{2}" },
];

const cache = [
  { label: "TGT", ticket: "tgt" },
  { label: "K_{C,T}", ticket: "" },
  { label: "SGT", ticket: "sgt" },
  { label: "K_{C,V}", ticket: "" },
];

const tickets = [
  { x: 362, y: 307, label: "TGT", cls: "tgt" },
  { x: 594, y: 307, label: "SGT", cls: "sgt" },
  { x: 724, y: 338, label: "TGT", cls: "tgt" },
  { x: 659, y: 470, label: "SGT", cls: "sgt" },
];
const cls = ["", "tgt", "tgt", "sgt", "sgt"];
---

<figure class="krb" id={uid}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    role="img"
    aria-label="Kerberos architecture and message flow. Inside a Realm, the Key Distribution Centre hosts the Authentication Server and the Ticket Granting Server, which share the key K_T. The client sends AS_REQ to the AS and gets AS_REP with a TGT. It then sends TGS_REQ with the TGT to the TGS and gets TGS_REP with an SGT. Finally it sends AP_REQ with the SGT to the Service, which shares the key K_V with the TGS."
  >
    <defs>
      <marker
        id={`${uid}-arrow-plain`}
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="head plain"></path>
      </marker>
      <marker
        id={`${uid}-arrow-tgt`}
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="head tgt"></path>
      </marker>
      <marker
        id={`${uid}-arrow-sgt`}
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="head sgt"></path>
      </marker>
    </defs>

    <!-- Realm -->
    <rect
      x="8"
      y="8"
      width={W - 16}
      height={H - 16}
      rx="22"
      class="realm"
    ></rect>
    <text x="28" y="30" class="realm-label">
      REALM · uom.lk
    </text>

    <!-- KDC -->
    <rect x="40" y="52" width="920" height="218" rx="16" class="kdc"></rect>
    <text x="500" y="76" text-anchor="middle" class="kdc-label">
      KEY DISTRIBUTION CENTRE
    </text>

    <!-- K_T link between AS and TGS -->
    <line x1="330" y1="165" x2="670" y2="165" class="share tgt"></line>
    <g transform="translate(500 165)">
      <rect
        x="-30"
        y="-14"
        width="60"
        height="28"
        rx="14"
        class="chip tgt"
      ></rect>
      <text
        text-anchor="middle"
        y="5"
        class="chip-text"
        set:html={fmt("K_{T}")}
      />
    </g>
    <text x="500" y="198" text-anchor="middle" class="note-text">
      shared long-term key
    </text>

    <!-- AS -->
    <g transform="translate(80 100)">
      <rect width="250" height="130" rx="12" class="node"></rect>
      <path
        d="M 0 36 V 12 A 12 12 0 0 1 12 0 H 238 A 12 12 0 0 1 250 12 V 36 Z"
        class="band as"
      ></path>
      <text x="125" y="24" text-anchor="middle" class="node-title">
        Authentication Server
      </text>
      <text x="125" y="66" text-anchor="middle" class="node-line">
        checks the User's password
      </text>
      <text x="125" y="88" text-anchor="middle" class="node-line">
        replies under the key
      </text>
      <g transform="translate(125 111)">
        <rect
          x="-30"
          y="-12"
          width="60"
          height="24"
          rx="12"
          class="chip pw"
        ></rect>
        <text
          text-anchor="middle"
          y="4.5"
          class="chip-text small"
          set:html={fmt("K_{C}")}
        />
      </g>
    </g>

    <!-- TGS -->
    <g transform="translate(670 100)">
      <rect width="250" height="130" rx="12" class="node"></rect>
      <path
        d="M 0 36 V 12 A 12 12 0 0 1 12 0 H 238 A 12 12 0 0 1 250 12 V 36 Z"
        class="band tgs"
      ></path>
      <text x="125" y="24" text-anchor="middle" class="node-title">
        Ticket Granting Server
      </text>
      <text x="125" y="66" text-anchor="middle" class="node-line">
        trusts a TGT on sight
      </text>
      <text x="125" y="88" text-anchor="middle" class="node-line">
        never sees the password
      </text>
      <text x="125" y="112" text-anchor="middle" class="node-line dim">
        issues 1 SGT per Service
      </text>
    </g>

    <!-- K_V link between TGS and V -->
    <line x1="900" y1="230" x2="900" y2="400" class="share sgt"></line>
    <g transform="translate(900 315)">
      <rect
        x="-30"
        y="-14"
        width="60"
        height="28"
        rx="14"
        class="chip sgt"
      ></rect>
      <text
        text-anchor="middle"
        y="5"
        class="chip-text"
        set:html={fmt("K_{V}")}
      />
    </g>

    <!-- Client -->
    <g transform="translate(330 400)">
      <rect width="250" height="140" rx="12" class="node client"></rect>
      <circle cx="34" cy="34" r="9" class="icon"></circle>
      <path d="M 16 60 Q 16 46 34 46 Q 52 46 52 60 Z" class="icon"></path>
      <text x="70" y="32" class="node-title left">
        Client C
      </text>
      <text x="70" y="52" class="node-line left dim">
        shared workstation
      </text>
      <text x="16" y="88" class="node-line left dim">
        credential cache
      </text>
      {cache.map((c, i) => (
        <g transform={`translate(${16 + i * 58} 100)`}>
          <rect
            width="50"
            height="26"
            rx="6"
            class={c.ticket ? `ticket ${c.ticket}` : "chip sq"}
          />
          <text
            x="25"
            y="17.5"
            text-anchor="middle"
            class={c.ticket ? "ticket-text" : "chip-text small"}
            set:html={fmt(c.label)}
          />
        </g>
      ))}
    </g>

    <!-- Service -->
    <g transform="translate(740 400)">
      <rect width="220" height="140" rx="12" class="node"></rect>
      <rect x="18" y="34" width="24" height="18" rx="3" class="icon"></rect>
      <path d="M 23 34 V 27 A 7 7 0 0 1 37 27 V 34" class="icon-line"></path>
      <text x="58" y="32" class="node-title left">
        Service V
      </text>
      <text x="58" y="52" class="node-line left dim">
        file, print, mail
      </text>
      <text x="18" y="94" class="node-line left">
        decrypts the SGT
      </text>
      <text x="18" y="116" class="node-line left">
        checks the Authenticator
      </text>
    </g>

    <!-- Arrows -->
    <g class="flows">
      <path
        d="M 375 400 Q 200 360 150 232"
        class="flow plain"
        marker-end={`url(#${uid}-arrow-plain)`}
      ></path>
      <path
        d="M 260 232 Q 380 300 430 398"
        class="flow tgt"
        marker-end={`url(#${uid}-arrow-tgt)`}
      ></path>
      <path
        d="M 535 400 Q 760 360 840 232"
        class="flow tgt"
        marker-end={`url(#${uid}-arrow-tgt)`}
      ></path>
      <path
        d="M 730 232 Q 580 300 485 398"
        class="flow sgt"
        marker-end={`url(#${uid}-arrow-sgt)`}
      ></path>
      <path
        d="M 580 470 L 738 470"
        class="flow sgt"
        marker-end={`url(#${uid}-arrow-sgt)`}
      ></path>
    </g>

    <!-- Tickets riding the arrows -->
    {tickets.map((t) => (
      <g transform={`translate(${t.x} ${t.y})`}>
        <rect
          x="-19"
          y="-10"
          width="38"
          height="20"
          rx="4"
          class={`ticket ${t.cls}`}
        />
        <circle cx="-19" cy="0" r="3.5" class="notch" />
        <circle cx="19" cy="0" r="3.5" class="notch" />
        <text text-anchor="middle" y="4" class="ticket-text">
          {t.label}
        </text>
      </g>
    ))}

    <!-- Message labels -->
    <g transform="translate(58 345)">
      <circle r="14" class="badge plain"></circle>
      <text text-anchor="middle" y="5.5" class="badge-text">
        1
      </text>
      <text x="18" y="-2" class="msg-name">
        {messages[0].name}
      </text>
      <text x="18" y="14" class="msg-body" set:html={fmt(messages[0].body)} />
    </g>
    <g transform="translate(346 258)">
      <circle r="14" class="badge tgt"></circle>
      <text text-anchor="middle" y="5.5" class="badge-text">
        2
      </text>
      <text x="18" y="-2" class="msg-name">
        {messages[1].name}
      </text>
      <text x="18" y="14" class="msg-body" set:html={fmt(messages[1].body)} />
    </g>
    <g transform="translate(776 366)">
      <circle r="14" class="badge tgt"></circle>
      <text text-anchor="middle" y="5.5" class="badge-text">
        3
      </text>
      <text x="18" y="-2" class="msg-name">
        {messages[2].name}
      </text>
      <text x="18" y="14" class="msg-body" set:html={fmt(messages[2].body)} />
    </g>
    <g transform="translate(640 270)">
      <circle r="14" class="badge sgt"></circle>
      <text text-anchor="middle" y="5.5" class="badge-text">
        4
      </text>
      <text x="18" y="-2" class="msg-name">
        {messages[3].name}
      </text>
      <text x="18" y="14" class="msg-body" set:html={fmt(messages[3].body)} />
    </g>
    <g transform="translate(606 506)">
      <circle r="14" class="badge sgt"></circle>
      <text text-anchor="middle" y="5.5" class="badge-text">
        5
      </text>
      <text x="18" y="-2" class="msg-name">
        {messages[4].name}
      </text>
      <text x="18" y="14" class="msg-body" set:html={fmt(messages[4].body)} />
    </g>

    <!-- Phase brackets -->
    <g class="bracket">
      <path d="M 60 568 V 576 H 440 V 568"></path>
      <path d="M 520 568 V 576 H 940 V 568"></path>
    </g>
    <text x="250" y="598" text-anchor="middle" class="bracket-text">
      Steps 1 to 2: once per login
    </text>
    <text x="730" y="598" text-anchor="middle" class="bracket-text">
      Steps 3 to 5: repeat per Service
    </text>
  </svg>

  <figcaption>
    Kerberos architecture. The client holds no long-term key for the TGS or any
    Service, only tickets and fresh session keys.
  </figcaption>
</figure>

<style>
  .krb {
    --c-tgt: var(--dia-ct);
    --c-sgt: var(--dia-pt);
    --c-pw: var(--dia-key);
    --on-color: #fff;
    max-width: 1000px;
    margin: 20px auto;
  }
  :global([data-theme="dark"]) .krb {
    --on-color: #15161a;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-ui);
  }

  .realm {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
    stroke-dasharray: 8 6;
  }
  .realm-label {
    fill: var(--text-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }

  .kdc {
    fill: var(--surface-2);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .kdc-label {
    fill: var(--text-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .node {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  .node.client {
    stroke: var(--text-muted);
    stroke-width: 2;
  }
  .band {
    fill: var(--surface-2);
  }
  .node-title {
    fill: var(--text-primary);
    font-size: 14px;
    font-weight: 700;
  }
  .node-title.left {
    text-anchor: start;
  }
  .node-line {
    fill: var(--text-secondary);
    font-size: 12.5px;
  }
  .node-line.left {
    text-anchor: start;
  }
  .dim {
    fill: var(--text-muted);
  }
  .icon {
    fill: var(--text-secondary);
  }
  .icon-line {
    fill: none;
    stroke: var(--text-secondary);
    stroke-width: 3;
  }

  .chip {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  .chip-text {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
    font-family: var(--font-mono);
  }
  .chip-text.small {
    font-size: 11px;
  }

  .share {
    stroke: var(--text-muted);
    stroke-width: 2.4;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .note-text {
    fill: var(--text-muted);
    font-size: 11.5px;
    font-style: italic;
  }

  .flow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-dasharray: 7 5;
    animation: krb-march 1.1s linear infinite;
  }
  .head {
    fill: var(--text-muted);
  }

  .band.as {
    fill: color-mix(in srgb, var(--c-pw) 24%, var(--surface));
  }
  .chip.pw {
    stroke: var(--c-pw);
    stroke-width: 2.5;
  }
  .chip.tgt {
    stroke: var(--c-tgt);
    stroke-width: 2.5;
  }
  .chip.sgt {
    stroke: var(--c-sgt);
    stroke-width: 2.5;
  }
  .share.tgt {
    stroke: var(--c-tgt);
  }
  .share.sgt {
    stroke: var(--c-sgt);
  }
  .flow.tgt,
  .badge.tgt {
    stroke: var(--c-tgt);
  }
  .flow.sgt,
  .badge.sgt {
    stroke: var(--c-sgt);
  }
  .head.tgt,
  .ticket.tgt {
    fill: var(--c-tgt);
  }
  .head.sgt,
  .ticket.sgt {
    fill: var(--c-sgt);
  }
  @keyframes krb-march {
    to {
      stroke-dashoffset: -12;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow {
      animation: none;
    }
  }

  .ticket {
    fill: var(--text-muted);
  }
  .notch {
    fill: var(--bg);
  }
  .ticket-text {
    fill: var(--on-color);
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .badge {
    fill: var(--surface);
    stroke: var(--text-muted);
    stroke-width: 3;
  }
  .badge-text {
    fill: var(--text-primary);
    font-size: 16px;
    font-weight: 800;
  }
  .msg-name {
    fill: var(--text-primary);
    font-size: 12.5px;
    font-weight: 700;
    font-family: var(--font-mono);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
  }
  .msg-body {
    fill: var(--text-secondary);
    font-size: 11.5px;
    font-family: var(--font-mono);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
  }

  .bracket path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .bracket-text {
    fill: var(--text-secondary);
    font-size: 12.5px;
    font-weight: 600;
  }

  figcaption {
    margin-top: 10px;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--text-secondary);
    text-align: center;
  }
</style>
