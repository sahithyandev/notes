---
// Square grid of the JPEG zig-zag scan: each cell shows its index in the scan
// and a path through the cell centres shows the visiting order.
import ArrowMarker from "./primitives/arrow-marker.astro";
import FigureCaption from "./primitives/figure-caption.astro";
import { makeUid } from "./lib/uid";

interface Props {
  size?: number;
  caption?: string;
}

const {
  size = 8,
  caption = `Zig-zag scan order of a ${size}x${size} block. Cell numbers give the position in the scan, starting at the DC coefficient in the top-left corner.`,
} = Astro.props;

const cell = 44;
const pad = 26;
const side = pad + size * cell;
const markerId = makeUid("zz-arrow");

// Visit every anti-diagonal in turn. Even diagonals run bottom-left to
// top-right, odd diagonals run the other way.
const order: [number, number][] = [];
for (let d = 0; d <= 2 * (size - 1); d++) {
  const cells: [number, number][] = [];
  for (let row = 0; row < size; row++) {
    const col = d - row;
    if (col >= 0 && col < size) cells.push([row, col]);
  }
  if (d % 2 === 0) cells.reverse();
  order.push(...cells);
}

const centre = ([row, col]: [number, number]) => [
  pad + col * cell + cell / 2,
  pad + row * cell + cell / 2,
];
const path = order
  .map((rc, i) => {
    const [x, y] = centre(rc);
    return `${i === 0 ? "M" : "L"}${x} ${y}`;
  })
  .join(" ");

// A short arrow at the midpoint of every step shows the direction of travel.
const arrows = order.slice(1).map((rc, i) => {
  const [x1, y1] = centre(order[i]);
  const [x2, y2] = centre(rc);
  const mx = (x1 + x2) / 2;
  const my = (y1 + y2) / 2;
  const len = Math.hypot(x2 - x1, y2 - y1);
  const dx = ((x2 - x1) / len) * 3;
  const dy = ((y2 - y1) / len) * 3;
  return [mx - dx, my - dy, mx + dx, my + dy];
});
---

<figure class="zigzag">
  <svg
    viewBox={`0 0 ${side} ${side}`}
    role="img"
    aria-labelledby={`${markerId}-t`}
  >
    <title id={`${markerId}-t`}>Zig-zag scan of a {size}x{size} block</title>
    <defs>
      <ArrowMarker id={markerId} variant="open" size={4} refX={7} />
    </defs>
    <text class="axis" x={pad + (size * cell) / 2} y="14" text-anchor="middle">
      u
    </text>
    <text class="axis" x="10" y={pad + (size * cell) / 2} text-anchor="middle">
      v
    </text>
    {order.map(([row, col], i) => (
      <g>
        <rect
          class:list={["cell", { dc: i === 0 }]}
          x={pad + col * cell}
          y={pad + row * cell}
          width={cell}
          height={cell}
        />
        <text class="idx" x={pad + col * cell + 5} y={pad + row * cell + 13}>
          {i}
        </text>
      </g>
    ))}
    <path class="trail" d={path}></path>
    {arrows.map(([x1, y1, x2, y2]) => (
      <line
        class="trail"
        x1={x1}
        y1={y1}
        x2={x2}
        y2={y2}
        marker-end={`url(#${markerId})`}
      />
    ))}
  </svg>
  <FigureCaption>{caption}</FigureCaption>
</figure>

<style>
  .zigzag {
    margin: 24px auto;
    max-width: 420px;
    font-family: var(--font-ui);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .cell {
    fill: var(--surface);
    stroke: var(--border);
    stroke-width: 1;
  }
  .cell.dc {
    fill: color-mix(in oklab, var(--accent) 16%, var(--surface));
  }
  .idx {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-secondary);
  }
  .axis {
    font-size: 12px;
    font-style: italic;
    dominant-baseline: middle;
    fill: var(--text-secondary);
  }
  .trail {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }
</style>
