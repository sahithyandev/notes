---
// Interactive 3D picture of Fubini's theorem on a box. The box is cut into
// slabs along x. One slab is highlighted and cut into columns along z, and one
// column is highlighted. The box is projected by hand (no 3D library), so its
// proportions are for looks, not to scale. Drag the scene or use the arrow keys
// to rotate it.
import { makeUid } from "./lib/uid";
import ArrowMarker from "./primitives/arrow-marker.astro";
import FigureCaption from "./primitives/figure-caption.astro";

const uid = makeUid("fubini");
---

<figure class="fubini" data-fubini data-uid={uid}>
  <div class="stage">
    <svg
      class="scene"
      viewBox="0 0 420 340"
      data-scene
      tabindex="0"
      role="group"
      aria-label="3D view of a box split into thin slabs along the x-axis, with one slab highlighted and cut into columns along the z-axis. Drag or use arrow keys to rotate the view."
    >
      <defs>
        <ArrowMarker id={`${uid}-ax`} fill="var(--text-muted)" size={6} />
      </defs>
      <g data-layer></g>
    </svg>
    <button type="button" class="reset" data-reset hidden>
      Reset view
    </button>
  </div>
  <FigureCaption>
    Integrating <i>f</i> along a <span class="c-col">column</span> gives its
    total. Integrating across the columns of a <span class="c-slab">slab</span>
    gives the slab total. Integrating across the slabs gives the integral over
    the <span class="c-box">box</span>.
  </FigureCaption>
</figure>

<style>
  .c-col {
    color: var(--accent);
    font-weight: 600;
  }
  .c-slab {
    color: var(--dia-ct);
    font-weight: 600;
  }
  .c-box {
    color: var(--dia-pt);
    font-weight: 600;
  }
  .fubini {
    margin: 24px 0;
  }
  .stage {
    position: relative;
    max-width: 440px;
    margin: 0 auto;
  }
  .scene {
    display: block;
    /* the article's "svg:not(.katex svg)" rule is more specific, so !important */
    width: 100% !important;
    height: auto !important;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    cursor: grab;
    border-radius: 6px;
  }
  .scene:active {
    cursor: grabbing;
  }
  .scene:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .reset {
    position: absolute;
    top: 4px;
    right: 4px;
    padding: 3px 10px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text-secondary);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .reset[hidden] {
    display: none;
  }
  .reset:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .reset:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .fubini :global(.edge) {
    stroke: var(--border-strong);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .fubini :global(.edge.back) {
    stroke-dasharray: 3 3;
    stroke-opacity: 0.6;
  }
  .fubini :global(.slab) {
    fill: var(--dia-pt);
    fill-opacity: 0.1;
    stroke: var(--dia-pt);
    stroke-opacity: 0.5;
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .fubini :global(.slab.picked) {
    fill: var(--dia-ct);
    fill-opacity: 0.3;
    stroke: var(--dia-ct);
    stroke-opacity: 1;
    stroke-width: 1.8;
  }
  .fubini :global(.col) {
    stroke: var(--accent);
    stroke-width: 1.3;
    stroke-opacity: 0.7;
    stroke-linecap: round;
  }
  .fubini :global(.col.picked) {
    stroke-width: 3.2;
    stroke-opacity: 1;
  }
  .fubini :global(.dot) {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .fubini :global(.axis) {
    stroke: var(--text-muted);
    stroke-width: 1.2;
  }
  .fubini :global(.axlabel) {
    fill: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 14px;
    font-style: italic;
    text-anchor: middle;
    dominant-baseline: central;
  }
</style>

<script>
  type Vec = [number, number, number];

  const W = 420;
  const H = 340;
  const SCALE = 58;
  const DEFAULT_YAW = -0.75;
  const DEFAULT_PITCH = 0.42;
  const MIN_PITCH = -1.45;
  const MAX_PITCH = 1.45;
  // Box extents along x, y, z.
  const BX = 2.2;
  const BY = 3;
  const BZ = 2.4;

  const N_SLABS = 5;
  const PICK = 2;
  const N_COLS = 11;
  const COL_PICK = 5;
  const pickedX = (BX * (PICK + 0.5)) / N_SLABS;

  function initFubini(root: HTMLElement) {
    if (root.dataset.fubiniInit) return;
    root.dataset.fubiniInit = "1";

    const uid = root.dataset.uid!;
    const scene = root.querySelector<SVGSVGElement>("[data-scene]")!;
    const layer = root.querySelector<SVGGElement>("[data-layer]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-reset]")!;

    let yaw = DEFAULT_YAW;
    let pitch = DEFAULT_PITCH;

    // Rotate about z by yaw, then about x by pitch. The 3rd value is larger the
    // farther the point is from the viewer.
    function project(p: Vec): Vec {
      const x = p[0] - BX / 2;
      const y = p[1] - BY / 2;
      const z = p[2] - BZ / 2;
      const cy = Math.cos(yaw);
      const sy = Math.sin(yaw);
      const cp = Math.cos(pitch);
      const sp = Math.sin(pitch);
      const x1 = x * cy - y * sy;
      const y1 = x * sy + y * cy;
      return [
        W / 2 + SCALE * x1,
        H / 2 + 8 - SCALE * (y1 * sp + z * cp),
        y1 * cp - z * sp,
      ];
    }

    const xy = (p: Vec) => {
      const [x, y] = project(p);
      return { x: +x.toFixed(1), y: +y.toFixed(1) };
    };
    const poly = (ps: Vec[]) =>
      ps
        .map((p) => {
          const { x, y } = xy(p);
          return `${x},${y}`;
        })
        .join(" ");
    const line = (cls: string, a: Vec, b: Vec, extra = "") => {
      const p = xy(a);
      const q = xy(b);
      return `<line class="${cls}" x1="${p.x}" y1="${p.y}" x2="${q.x}" y2="${q.y}" ${extra}/>`;
    };

    const slabAt = (s: number): Vec[] => [
      [s, 0, 0],
      [s, BY, 0],
      [s, BY, BZ],
      [s, 0, BZ],
    ];

    function render() {
      const out: string[] = [];

      // Box edges, dashed when they touch the corner farthest from the viewer.
      const corners: Vec[] = Array.from({ length: 8 }, (_, i) => [
        i & 1 ? BX : 0,
        i & 2 ? BY : 0,
        i & 4 ? BZ : 0,
      ]);
      const depths = corners.map((c) => project(c)[2]);
      const farthest = depths.indexOf(Math.max(...depths));
      for (let i = 0; i < 8; i++) {
        for (const bit of [1, 2, 4]) {
          if (i & bit) continue;
          const j = i | bit;
          const back = i === farthest || j === farthest;
          out.push(line(back ? "edge back" : "edge", corners[i], corners[j]));
        }
      }

      // Slabs, painted from the farthest to the nearest.
      const slabs = Array.from({ length: N_SLABS }, (_, i) => {
        const s = (BX * (i + 0.5)) / N_SLABS;
        return {
          picked: i === PICK,
          points: poly(slabAt(s)),
          depth: project([s, BY / 2, BZ / 2])[2],
        };
      }).sort((a, b) => b.depth - a.depth);
      for (const s of slabs) {
        out.push(
          `<polygon class="${s.picked ? "slab picked" : "slab"}" points="${s.points}"/>`,
        );
      }

      // Columns of the picked slab.
      for (let i = 0; i < N_COLS; i++) {
        const y = (BY * (i + 0.5)) / N_COLS;
        out.push(
          line(
            i === COL_PICK ? "col picked" : "col",
            [pickedX, y, 0],
            [pickedX, y, BZ],
          ),
        );
      }
      const base = xy([pickedX, (BY * (COL_PICK + 0.5)) / N_COLS, 0]);
      out.push(`<circle class="dot" cx="${base.x}" cy="${base.y}" r="4"/>`);

      // Axis arrows run along the 3 edges that meet at the origin corner.
      const axes: [string, Vec, Vec][] = [
        ["x", [BX + 0.6, 0, 0], [BX + 0.95, 0, 0]],
        ["y", [0, BY + 0.6, 0], [0, BY + 0.95, 0]],
        ["z", [0, 0, BZ + 0.6], [0, 0, BZ + 0.9]],
      ];
      for (const [key, tip, lab] of axes) {
        const l = xy(lab);
        out.push(
          line("axis", [0, 0, 0], tip, `marker-end="url(#${uid}-ax)"`),
          `<text class="axlabel" x="${l.x}" y="${l.y}">${key}</text>`,
        );
      }

      layer.innerHTML = out.join("");
      reset.hidden = yaw === DEFAULT_YAW && pitch === DEFAULT_PITCH;
    }

    let frame = 0;
    const stopTween = () => cancelAnimationFrame(frame);
    reset.addEventListener("click", () => {
      stopTween();
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        yaw = DEFAULT_YAW;
        pitch = DEFAULT_PITCH;
        render();
        return;
      }
      const TAU = 2 * Math.PI;
      const fromYaw = yaw;
      const fromPitch = pitch;
      // Turn the short way round to the default yaw.
      const dYaw =
        ((((DEFAULT_YAW - yaw) % TAU) + 3 * Math.PI) % TAU) - Math.PI;
      const dPitch = DEFAULT_PITCH - pitch;
      const start = performance.now();
      const DURATION = 400;
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        const e = 1 - (1 - t) ** 3;
        if (t < 1) {
          yaw = fromYaw + dYaw * e;
          pitch = fromPitch + dPitch * e;
          frame = requestAnimationFrame(step);
        } else {
          yaw = DEFAULT_YAW;
          pitch = DEFAULT_PITCH;
        }
        render();
      };
      frame = requestAnimationFrame(step);
    });

    const rotate = (dYaw: number, dPitch: number) => {
      stopTween();
      yaw += dYaw;
      pitch = Math.max(MIN_PITCH, Math.min(MAX_PITCH, pitch + dPitch));
      render();
    };

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    scene.addEventListener("pointerdown", (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      scene.setPointerCapture(e.pointerId);
    });
    scene.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      rotate((e.clientX - lastX) * 0.01, (e.clientY - lastY) * 0.01);
      lastX = e.clientX;
      lastY = e.clientY;
    });
    const endDrag = (e: PointerEvent) => {
      dragging = false;
      if (scene.hasPointerCapture(e.pointerId)) {
        scene.releasePointerCapture(e.pointerId);
      }
    };
    scene.addEventListener("pointerup", endDrag);
    scene.addEventListener("pointercancel", endDrag);

    scene.addEventListener("keydown", (e) => {
      const step = e.shiftKey ? 0.25 : 0.08;
      switch (e.key) {
        case "ArrowLeft":
          rotate(-step, 0);
          break;
        case "ArrowRight":
          rotate(step, 0);
          break;
        case "ArrowUp":
          rotate(0, -step);
          break;
        case "ArrowDown":
          rotate(0, step);
          break;
        default:
          return;
      }
      e.preventDefault();
    });

    render();
  }

  document
    .querySelectorAll<HTMLElement>("[data-fubini]")
    .forEach((el) => initFubini(el));
</script>
