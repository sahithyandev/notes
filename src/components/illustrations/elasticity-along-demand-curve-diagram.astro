---
// Static diagram: a single straight-line demand curve split into 3
// colored segments to show that elasticity changes along the curve
// even though its slope stays constant.
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  title="Elasticity Along a Linear Demand Curve"
  y={{ label: "Price", domain: [0, 10] }}
  x={{ label: "Quantity Demanded", domain: [0, 10] }}
  curves={[
    {
      equation: (quantity) => 10.25 - quantity,
      domain: [1.18, 3.82],
      tone: "key",
      label: "More elastic",
      labelAt: 1.7,
      labelDx: 5,
      labelDy: -15,
    },
    {
      equation: (quantity) => 10.25 - quantity,
      domain: [3.82, 6.18],
      tone: "pt",
      label: "Unit elastic",
      labelAt: 4.55,
      labelDx: 7,
      labelDy: -10,
    },
    {
      equation: (quantity) => 10.25 - quantity,
      domain: [6.18, 8.82],
      tone: "ct",
      label: "More inelastic",
      labelAt: 6.05,
      labelDx: 8,
      labelDy: 28,
    },
    {
      equation: (quantity) => 10.25 - quantity,
      domain: [8.82, 9.05],
      tone: "s5",
      label: "D",
      labelAt: 9.05,
      labelDx: 7,
      labelDy: -3,
    },
  ]}
  points={[
    { x: 1.18, y: 9.07, tone: "key", radius: 4 },
    { x: 3.82, y: 6.3, tone: "pt", radius: 4 },
    { x: 6.18, y: 3.7, tone: "pt", radius: 4 },
    { x: 8.82, y: 0.93, tone: "ct", radius: 4 },
  ]}
>
  <Fragment slot="caption">
    Elasticity falls moving down the same straight-line demand curve
    <span class="tone-s5">D</span>: the
    <span class="tone-key">upper-left region</span> is more elastic, the
    <span class="tone-pt">middle region</span> is unit elastic, and the
    <span class="tone-ct">lower-right region</span> is more inelastic.
  </Fragment>
</CartesianGraph>
