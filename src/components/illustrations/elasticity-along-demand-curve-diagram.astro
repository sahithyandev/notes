---
// Static diagram: a single straight-line demand curve split into 3
// colored segments to show that elasticity changes along the curve
// even though its slope stays constant.
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  title="Elasticity Along a Linear Demand Curve"
  yLabel="Price"
  xLabel="Quantity Demanded"
>
  <line class="seg tone-key" x1="90" y1="45" x2="180" y2="120"></line>
  <line class="seg tone-pt" x1="180" y1="120" x2="260" y2="190"></line>
  <line class="seg tone-ct" x1="260" y1="190" x2="350" y2="265"></line>

  <circle class="pt tone-key" cx="90" cy="45" r="4"></circle>
  <circle class="pt tone-pt" cx="180" cy="120" r="4"></circle>
  <circle class="pt tone-pt" cx="260" cy="190" r="4"></circle>
  <circle class="pt tone-ct" cx="350" cy="265" r="4"></circle>

  <text class="seg-label tone-key" x="98" y="78">
    More elastic
  </text>
  <text class="seg-label tone-pt" x="205" y="145">
    Unit elastic
  </text>
  <text class="seg-label tone-ct" x="255" y="245">
    More inelastic
  </text>

  <text class="curve-label tone-s5" x="360" y="255">
    D
  </text>

  <Fragment slot="caption">
    Elasticity falls moving down the same straight-line demand curve
    <span class="tone-s5">D</span>: the
    <span class="tone-key">upper-left region</span> is more elastic, the
    <span class="tone-pt">middle region</span> is unit elastic, and the
    <span class="tone-ct">lower-right region</span> is more inelastic.
  </Fragment>
</AxesFigure>

<style>
  .seg {
    stroke: var(--tone);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .seg-label {
    fill: var(--tone);
    font-size: 12px;
    font-weight: 600;
  }
</style>
