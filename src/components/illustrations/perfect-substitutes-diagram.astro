  }

  #perfect-substitutes-diagram svg {
    width: 100%;
    height: auto;
  }

  #perfect-substitutes-diagram .axis {
    stroke: var(--text-muted);
    stroke-width: 1.8;
  }

  #perfect-substitutes-diagram .axis-label {
    fill: var(--text-secondary);
    font-size: 14px;
    font-weight: 600;
  }

  #perfect-substitutes-diagram .isoquant {
    stroke: var(--s5);
    stroke-width: 3;
  }

  #perfect-substitutes-diagram .point {
    fill: var(--text-primary);
  }

  #perfect-substitutes-diagram .point-label {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
  }

  #perfect-substitutes-diagram .curve-label {
    fill: var(--s5);
    font-size: 16px;
    font-weight: 700;
  }

  #perfect-substitutes-diagram figcaption {
    margin-top: 10px;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-secondary);
    text-align: center;
  }

  #perfect-substitutes-diagram figcaption strong {
    color: var(--text-primary);
  }
</style>
