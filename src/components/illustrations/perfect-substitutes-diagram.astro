---
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Perfectly Substitutable Inputs"
  y={{ label: "Capital (K)", domain: [0, 10] }}
  x={{ label: "Labour (L)", domain: [0, 10] }}
  curves={[
    {
      equation: (labour) => 9.67 - labour,
      domain: [1.2, 8.7],
      tone: "s5",
      label: "Q₁",
      labelAt: 4.8,
      labelDy: -10,
    },
  ]}
  points={[
    { x: 3.1, y: 6.6, label: "A", labelDx: -15, labelDy: -10 },
    { x: 5.9, y: 3.75, label: "B", labelDx: 10, labelDy: -5 },
  ]}
>
  <Fragment slot="caption">
    <strong>Constant MRTS.</strong>
    With perfectly substitutable inputs, capital and labour can replace each
    other at a constant rate, so the isoquant is a straight line.
  </Fragment>
</CartesianGraph>

<style>
  strong {
    color: var(--text-primary);
  }
</style>
