---
// A blurred step and its gradient magnitude. The shaded horizontal span shows
// how thresholding a broad response creates a thick binary edge.

import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  caption="A blurred step gives a broad gradient response. Thresholding retains every pixel between the 2 crossings, so the binary edge is thick."
  title="Blurred Step and Thresholded Gradient"
  desc="A smooth intensity step, a broad gradient-magnitude peak, a threshold line and the resulting thick binary edge."
  yLabel="Normalised Value"
  xLabel="Pixel Position"
  xLabelOffset={45}
>
  <rect class="edge-band" x="165" y="20" width="110" height="270"></rect>

  <path
    class="curve round tone-s5"
    d="M 50 270 C 140 270, 165 268, 195 230 C 225 190, 225 120, 255 80 C 285 42, 310 40, 390 40"
  ></path>
  <path
    class="curve round tone-ct"
    d="M 50 280 C 130 280, 145 275, 170 235 C 195 190, 200 125, 220 105 C 240 125, 245 190, 270 235 C 295 275, 310 280, 390 280"
  ></path>

  <line class="guide threshold" x1="50" y1="220" x2="390" y2="220"></line>
  <line class="guide" x1="165" y1="220" x2="165" y2="278"></line>
  <line class="guide" x1="275" y1="220" x2="275" y2="278"></line>
  <rect
    class="binary-edge tone-ct"
    x="165"
    y="300"
    width="110"
    height="9"
    rx="4.5"
  ></rect>

  <text class="curve-label tone-s5" x="310" y="72">
    f
  </text>
  <text class="curve-label tone-ct" x="232" y="98">
    |∇f|
  </text>
  <text class="pt-label tone-ink" x="382" y="214" text-anchor="end">
    T
  </text>
  <text class="edge-label" x="220" y="322" text-anchor="middle">
    thresholded edge
  </text>
</AxesFigure>
<style>
  .edge-band {
    fill: var(--s5);
    opacity: 0.04;
  }

  .threshold {
    stroke: var(--text-secondary);
  }

  .binary-edge {
    fill: var(--tone);
  }

  .edge-label {
    fill: var(--text-secondary);
    font-size: 12px;
  }

  :global(.axes-figure svg) {
    pointer-events: none;
  }
</style>
