---
// Static circular flow diagram: households and firms interacting
// through factor markets and product markets. Real flows (factors and goods)
// use the inner-loop colour (tone-pt); monetary flows (payments and spending)
// use the outer-loop colour (tone-key).
import ArrowFigure from "./primitives/arrow-figure.astro";
import { makeUid } from "./lib/uid";

const uid = makeUid("circular-flow");
---

<ArrowFigure
  uid={uid}
  title="Circular Flow Diagram"
  viewBox="0 0 600 400"
  captionSlot
>
  <circle class="flow-path" cx="300" cy="200" r="140" />
  <circle class="flow-path" cx="300" cy="200" r="100" />

  <g class="entity" transform="translate(100, 200)">
    <rect width="160" height="80" x="-80" y="-40" rx="12" />
    <text x="0" y="-10" text-anchor="middle" class="entity-label">
      Households
    </text>
    <text text-anchor="middle" class="entity-sub">
      <tspan x="0" y="14">
        Supply factors
      </tspan>
      <tspan x="0" y="28">
        Demand goods & services
      </tspan>
    </text>
  </g>

  <g class="entity" transform="translate(500, 200)">
    <rect width="160" height="80" x="-80" y="-40" rx="12" />
    <text x="0" y="-10" text-anchor="middle" class="entity-label">
      Firms
    </text>
    <text text-anchor="middle" class="entity-sub">
      <tspan x="0" y="14">
        Demand factors
      </tspan>
      <tspan x="0" y="28">
        Supply goods & services
      </tspan>
    </text>
  </g>

  <g class="market" transform="translate(300, 50)">
    <rect width="180" height="60" x="-90" y="-30" rx="10" />
    <text
      x="0"
      y="0"
      text-anchor="middle"
      dominant-baseline="middle"
      class="market-label"
    >
      Factor Markets
    </text>
    <text x="0" y="20" text-anchor="middle" class="market-sub">
      Labor, Land, Capital
    </text>
  </g>

  <g class="market" transform="translate(300, 350)">
    <rect width="180" height="60" x="-90" y="-30" rx="10" />
    <text
      x="0"
      y="0"
      text-anchor="middle"
      dominant-baseline="middle"
      class="market-label"
    >
      Product Markets
    </text>
    <text x="0" y="20" text-anchor="middle" class="market-sub">
      Goods & Services
    </text>
  </g>

  <path
    class="arrow tone-pt"
    d="M 125,160 C 125,110 150,65 210,65"
    marker-end={`url(#${uid}-pt)`}
  />
  <path
    class="arrow tone-key"
    d="M 210,35 C 150,35 55,90 55,160"
    marker-end={`url(#${uid}-key)`}
  />
  <path
    class="arrow tone-pt"
    d="M 390,65 C 450,65 475,110 475,160"
    marker-end={`url(#${uid}-pt)`}
  />
  <path
    class="arrow tone-key"
    d="M 545,160 C 545,90 450,35 390,35"
    marker-end={`url(#${uid}-key)`}
  />
  <path
    class="arrow tone-pt"
    d="M 475,240 C 475,300 450,345 390,345"
    marker-end={`url(#${uid}-pt)`}
  />
  <path
    class="arrow tone-key"
    d="M 390,365 C 450,365 545,300 545,240"
    marker-end={`url(#${uid}-key)`}
  />
  <path
    class="arrow tone-pt"
    d="M 210,345 C 150,345 125,300 125,240"
    marker-end={`url(#${uid}-pt)`}
  />
  <path
    class="arrow tone-key"
    d="M 55,240 C 55,300 125,365 210,365"
    marker-end={`url(#${uid}-key)`}
  />

  <Fragment slot="caption">
    <span class="tone-pt">Inner loop</span> carries real flows of factors and
    goods. <span class="tone-key">Outer loop</span> carries monetary flows of
    payments and spending.
  </Fragment>
</ArrowFigure>

<style>
  .flow-path {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  .entity rect,
  .market rect {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .entity-label,
  .market-label {
    font-size: 0.8rem;
    font-weight: 700;
    fill: var(--text-primary);
    font-family: var(--font-ui);
  }

  .market-label {
    font-size: 0.75rem;
  }

  .entity-sub,
  .market-sub {
    font-family: var(--font-mono);
    fill: var(--text-muted);
  }

  .entity-sub {
    font-size: 0.62rem;
    line-height: 1.3;
  }

  .market-sub {
    font-size: 0.58rem;
  }
</style>
