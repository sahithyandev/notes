---
import katex from "katex";

interface Props {
  currentSum: number;
  min: number;
  max: number;
}

const { currentSum, min, max } = Astro.props;

const tex = (v: string) =>
  katex.renderToString(v, { throwOnError: false, strict: false });
---

<div class="new-constraint-slider">
  <div class="row">
    <span class="label">
      <span set:html={tex("x_1 + x_2")} /> at the current optimum
    </span>
    <span class="value">{currentSum}</span>
  </div>

  <div class="control">
    <label for="new-constraint-k">
      Limit <span set:html={tex("k")} /> in{" "}
      <span set:html={tex("x_1 + x_2 \\le k")} />
    </label>
    <input
      id="new-constraint-k"
      type="range"
      min={min}
      max={max}
      step="0.01"
      value={max}
    />
    <output for="new-constraint-k" data-k>{max}</output>
  </div>

  <div class="status" data-status data-satisfied="true">
    Satisfied. The optimum stays as is.
  </div>
</div>

<script>
  const fmt = (n: number) => {
    const rounded = Math.round(n * 100) / 100;
    return Object.is(rounded, -0) ? "0" : String(rounded);
  };

  document
    .querySelectorAll<HTMLDivElement>(".new-constraint-slider")
    .forEach((widget) => {
      const slider = widget.querySelector<HTMLInputElement>(
        'input[type="range"]',
      )!;
      const kOut = widget.querySelector<HTMLElement>("[data-k]")!;
      const sum = Number(
        widget.querySelector<HTMLElement>(".row .value")!.textContent,
      );
      const status = widget.querySelector<HTMLElement>("[data-status]")!;

      const render = () => {
        const k = Number(slider.value);
        kOut.textContent = fmt(k);

        const satisfied = sum <= k;
        status.dataset.satisfied = String(satisfied);
        status.textContent = satisfied
          ? "Satisfied. The optimum stays as is, no further work."
          : `Violated. ${fmt(sum)} > ${fmt(k)}, so the tableau is optimal but infeasible and needs a dual simplex repair.`;
      };

      slider.addEventListener("input", render);
      render();
    });
</script>

<style>
  .new-constraint-slider {
    margin: 24px 0;
    padding: 16px 18px 18px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.9rem;
    font-family: var(--font-ui);
  }

  .row .label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }

  .row .value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  .control {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .control label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .control input[type="range"] {
    flex: 1 1 160px;
    accent-color: var(--s5);
  }

  .control output {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--s5);
    min-width: 4ch;
    text-align: right;
  }

  .status {
    margin-top: 12px;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 12.5px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .status[data-satisfied="true"] {
    background: color-mix(in oklab, var(--s3) 12%, var(--surface));
    border-color: var(--s3-border);
  }

  .status[data-satisfied="false"] {
    background: color-mix(in oklab, var(--s4) 12%, var(--surface));
    border-color: var(--s4-border);
  }
</style>
