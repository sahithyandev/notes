---
import { tex } from "../../utils/tex";
import Panel from "./primitives/panel.astro";
import SliderControl from "./primitives/slider-control.astro";
import StatusNote from "./primitives/status-note.astro";

interface Props {
  currentSum: number;
  min: number;
  max: number;
}

const { currentSum, min, max } = Astro.props;
---

<Panel class="new-constraint-slider">
  <div class="row">
    <span class="label">
      <span set:html={tex("x_1 + x_2")} /> at the current optimum
    </span>
    <span class="value">{currentSum}</span>
  </div>

  <SliderControl
    id="new-constraint-k"
    min={min}
    max={max}
    step={0.01}
    value={max}
  >
    Limit <span set:html={tex("k")} /> in{" "}
    <span set:html={tex("x_1 + x_2 \\le k")} />
  </SliderControl>

  <StatusNote ok={true}>Satisfied. The optimum stays as is.</StatusNote>
</Panel>

<script>
  import { fmt } from "./lib/format";

  document
    .querySelectorAll<HTMLDivElement>(".new-constraint-slider")
    .forEach((widget) => {
      const slider = widget.querySelector<HTMLInputElement>(
        'input[type="range"]',
      )!;
      const kOut = widget.querySelector<HTMLElement>("[data-delta]")!;
      const sum = Number(
        widget.querySelector<HTMLElement>(".row .value")!.textContent,
      );
      const status = widget.querySelector<HTMLElement>("[data-status]")!;

      const render = () => {
        const k = Number(slider.value);
        kOut.textContent = fmt(k);

        const satisfied = sum <= k;
        status.dataset.state = satisfied ? "ok" : "bad";
        status.textContent = satisfied
          ? "Satisfied. The optimum stays as is, no further work."
          : `Violated. ${fmt(sum)} > ${fmt(k)}, so the tableau is optimal but infeasible and needs a dual simplex repair.`;
      };

      slider.addEventListener("input", render);
      render();
    });
</script>

<style>
  :global(.panel.new-constraint-slider) {
    padding: 16px 18px 18px;
    border-radius: 10px;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.9rem;
    font-family: var(--font-ui);
  }

  .row .label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }

  .row .value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }
</style>
