---
// One persistent assignment table. Stepping forward copies only the cells
// that actually change, so unchanged costs stay put and the eye only tracks
// what the current step touched. Each <AssignmentStep> child is a hidden
// data source (a full <AssignmentTable dataSource />) plus its note.
const uid = "assignment-walk-" + Math.random().toString(36).slice(2, 9);
---

<figure class="aw" id={uid} tabindex="0" aria-roledescription="carousel">
  <div class="bar">
    <span class="label" data-label></span>
    <span class="count"
      ><span data-current>1</span> / <span data-total></span></span
    >
  </div>

  <p class="legend">
    <span class="chip zero">0 entry</span>
    <span class="chip covered">covering line</span>
    <span class="chip assigned">assigned</span>
    <span class="chip changed">updated this step</span>
  </p>

  <div class="scroll" data-live></div>

  <div class="stack"><slot /></div>

  <div class="foot">
    <div class="dots" role="tablist"></div>
    <div class="controls">
      <button type="button" data-prev disabled aria-label="Previous step">
        &#9664; Prev
      </button>
      <button type="button" data-next aria-label="Next step"
        >Next &#9654;</button
      >
    </div>
  </div>
  <p class="live" aria-live="polite"></p>
</figure>

<style>
  .aw {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 14px 16px 16px;
    font-family: var(--font-ui);
  }
  .aw:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .aw:not(.ready) .bar,
  .aw:not(.ready) .foot {
    visibility: hidden;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
    min-height: 1.2em;
  }
  .label {
    font-weight: 700;
    color: var(--text-primary);
  }
  .count {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0 0 12px;
    font-size: 0.72rem;
    color: var(--text-secondary);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .chip::before {
    content: "";
    width: 11px;
    height: 11px;
    border-radius: 3px;
    flex: none;
    border: 1px solid var(--border-strong);
  }
  .chip.zero::before {
    content: "0";
    width: auto;
    height: auto;
    border: none;
    border-radius: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85em;
    line-height: 1;
  }
  .chip.covered::before {
    width: 14px;
    height: 0;
    border: none;
    border-top: 2px dotted var(--accent);
    border-radius: 0;
  }
  .chip.assigned::before {
    background: var(--dia-pt);
    border-color: var(--dia-pt);
  }
  .chip.changed::before {
    display: none;
  }
  .chip.changed {
    color: var(--accent);
    font-weight: 600;
  }

  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  /* The hidden data tables inside each step; only notes stay visible. */
  .stack :global(.step > [data-stage]) {
    display: none;
  }

  /* Notes share one grid cell so the box does not resize between steps. */
  .stack {
    display: grid;
    margin-top: 2px;
  }
  .stack > :global(.step) {
    grid-area: 1 / 1;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }
  .stack > :global(.step.active) {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .stack > :global(.step) {
      transition: none;
    }
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots :global(.dot) {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    cursor: pointer;
  }
  .dots :global(.dot[aria-selected="true"]) {
    background: var(--accent);
    border-color: var(--accent);
  }

  .controls {
    display: flex;
    gap: 8px;
  }
  .controls button {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-primary);
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<noscript>
  <style>
    .aw [data-live] {
      display: none;
    }
    .aw .stack {
      display: block;
    }
    .aw .stack > .step {
      opacity: 1;
      visibility: visible;
      margin-top: 16px;
    }
    .aw .stack .step > [data-stage] {
      display: revert;
    }
    .aw .stack .step > [data-stage] table {
      display: revert;
    }
    .aw .foot {
      display: none;
    }
  </style>
</noscript>

<script>
  import { initWalkthrough } from "./lib/walkthrough";

  document
    .querySelectorAll<HTMLElement>(".aw")
    .forEach((el) => initWalkthrough(el));
</script>
