---
// One persistent assignment table. Stepping forward copies only the cells
// that actually change, so unchanged costs stay put and the eye only tracks
// what the current step touched. Each <AssignmentStep> child is a hidden
// data source (a full <AssignmentTable dataSource />) plus its note.
const uid = "assignment-walk-" + Math.random().toString(36).slice(2, 9);
---

<figure class="aw" id={uid} tabindex="0" aria-roledescription="carousel">
  <div class="bar">
    <span class="label" data-label></span>
    <span class="count"
      ><span data-current>1</span> / <span data-total></span></span
    >
  </div>

  <p class="legend">
    <span class="chip zero">0 entry</span>
    <span class="chip covered">covering line</span>
    <span class="chip assigned">assigned</span>
    <span class="chip changed">updated this step</span>
  </p>

  <div class="scroll" data-live></div>

  <div class="stack"><slot /></div>

  <div class="foot">
    <div class="dots" role="tablist"></div>
    <div class="controls">
      <button type="button" data-prev disabled aria-label="Previous step">
        &#9664; Prev
      </button>
      <button type="button" data-next aria-label="Next step"
        >Next &#9654;</button
      >
    </div>
  </div>
  <p class="live" aria-live="polite"></p>
</figure>

<style>
  .aw {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 14px 16px 16px;
    font-family: var(--font-ui);
  }
  .aw:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .aw:not(.ready) .bar,
  .aw:not(.ready) .foot {
    visibility: hidden;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
    min-height: 1.2em;
  }
  .label {
    font-weight: 700;
    color: var(--text-primary);
  }
  .count {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0 0 12px;
    font-size: 0.72rem;
    color: var(--text-secondary);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .chip::before {
    content: "";
    width: 11px;
    height: 11px;
    border-radius: 3px;
    flex: none;
    border: 1px solid var(--border-strong);
  }
  .chip.zero::before {
    content: "0";
    width: auto;
    height: auto;
    border: none;
    border-radius: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85em;
    line-height: 1;
  }
  .chip.covered::before {
    width: 14px;
    height: 0;
    border: none;
    border-top: 2px dotted var(--accent);
    border-radius: 0;
  }
  .chip.assigned::before {
    background: var(--dia-pt);
    border-color: var(--dia-pt);
  }
  .chip.changed::before {
    display: none;
  }
  .chip.changed {
    color: var(--accent);
    font-weight: 600;
  }

  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  /* The hidden data tables inside each step; only notes stay visible. */
  .stack :global(.step > [data-stage]) {
    display: none;
  }

  /* Notes share one grid cell so the box does not resize between steps. */
  .stack {
    display: grid;
    margin-top: 2px;
  }
  .stack > :global(.step) {
    grid-area: 1 / 1;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }
  .stack > :global(.step.active) {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .stack > :global(.step) {
      transition: none;
    }
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots :global(.dot) {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    cursor: pointer;
  }
  .dots :global(.dot[aria-selected="true"]) {
    background: var(--accent);
    border-color: var(--accent);
  }

  .controls {
    display: flex;
    gap: 8px;
  }
  .controls button {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-primary);
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<noscript>
  <style>
    .aw [data-live] {
      display: none;
    }
    .aw .stack {
      display: block;
    }
    .aw .stack > .step {
      opacity: 1;
      visibility: visible;
      margin-top: 16px;
    }
    .aw .stack .step > [data-stage] {
      display: revert;
    }
    .aw .stack .step > [data-stage] table {
      display: revert;
    }
    .aw .foot {
      display: none;
    }
  </style>
</noscript>

<script>
  function initAssignmentWalk(root: HTMLElement) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>(".step"));
    if (!steps.length) return;

    const holder = root.querySelector<HTMLElement>("[data-live]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const label = root.querySelector<HTMLElement>("[data-label]")!;
    const current = root.querySelector<HTMLElement>("[data-current]")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;
    const dotWrap = root.querySelector<HTMLElement>(".dots")!;
    const live = root.querySelector<HTMLElement>(".live")!;

    // The persistent figure: a clone of the first step's assignment table.
    const liveFigure = steps[0]
      .querySelector<HTMLElement>("[data-stage]")!
      .cloneNode(true) as HTMLElement;
    liveFigure.querySelector("table")?.removeAttribute("aria-hidden");
    holder.appendChild(liveFigure);

    total.textContent = String(steps.length);

    const dots = steps.map((s, idx) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "dot";
      b.setAttribute("aria-label", s.dataset.label ?? `Step ${idx + 1}`);
      b.addEventListener("click", () => show(idx));
      dotWrap.appendChild(b);
      return b;
    });

    let i = 0;

    function show(n: number) {
      i = Math.max(0, Math.min(steps.length - 1, n));
      const srcFigure = steps[i].querySelector<HTMLElement>("[data-stage]")!;
      const srcTable = srcFigure.querySelector("table")!;
      const dstTable = liveFigure.querySelector("table")!;

      const srcRows = srcTable.querySelectorAll("tr");
      const dstRows = dstTable.querySelectorAll("tr");
      srcRows.forEach((sr, ri) => {
        const dr = dstRows[ri];
        if (!dr) return;
        const sCells = sr.querySelectorAll<HTMLElement>("th,td");
        const dCells = dr.querySelectorAll<HTMLElement>("th,td");
        sCells.forEach((sc, ci) => {
          const dc = dCells[ci];
          if (!dc) return;
          const changed = dc.innerHTML !== sc.innerHTML;
          if (changed) dc.innerHTML = sc.innerHTML;
          dc.className = sc.className;
          dc.classList.toggle("changed", changed);
        });
      });

      const srcCaption = srcFigure.querySelector("figcaption");
      let dstCaption = liveFigure.querySelector("figcaption");
      if (srcCaption) {
        if (!dstCaption) {
          dstCaption = document.createElement("figcaption");
          liveFigure.appendChild(dstCaption);
        }
        dstCaption.innerHTML = srcCaption.innerHTML;
        dstCaption.hidden = false;
      } else if (dstCaption) {
        dstCaption.hidden = true;
      }

      steps.forEach((s, idx) => s.classList.toggle("active", idx === i));
      dots.forEach((d, idx) =>
        d.setAttribute("aria-selected", idx === i ? "true" : "false"),
      );
      prev.disabled = i === 0;
      next.disabled = i === steps.length - 1;
      label.textContent = steps[i].dataset.label ?? "";
      current.textContent = String(i + 1);
      const noteText =
        steps[i].querySelector(".step-note")?.textContent?.trim() ?? "";
      live.textContent = `${label.textContent}. ${noteText}`;
    }

    prev.addEventListener("click", () => show(i - 1));
    next.addEventListener("click", () => show(i + 1));
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        show(i - 1);
        e.preventDefault();
      } else if (e.key === "ArrowRight") {
        show(i + 1);
        e.preventDefault();
      }
    });

    root.classList.add("ready");
    show(0);
  }

  document
    .querySelectorAll<HTMLElement>(".aw")
    .forEach((el) => initAssignmentWalk(el));
</script>
