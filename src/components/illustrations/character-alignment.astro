---
interface Row {
  label: string;
  value: string;
}

interface Props {
  rows: Row[];
  caption?: string;
}

const { rows, caption = "Aligned character sequences." } = Astro.props;

if (
  rows.length === 0 ||
  new Set(rows.map((row) => row.value.length)).size !== 1
) {
  throw new Error(
    "CharacterAlignment requires 1 or more rows with values of equal length.",
  );
}
---

<figure class="character-alignment">
  <div class="table-scroll">
    <table aria-label="Aligned character sequences">
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            {Array.from(row.value).map((character) => (
              <td>{character}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .character-alignment {
    margin: 20px 0;
  }

  .table-scroll {
    overflow-x: auto;
  }

  table {
    border-collapse: separate;
    border-spacing: 2px;
    font-family: var(--font-mono) !important;
    margin: 0 auto !important;
    width: max-content !important;
  }

  tbody,
  tr {
    width: auto !important;
  }

  th {
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.68rem !important;
    font-weight: 600;
    padding: 0 6px 0 0 !important;
    text-align: right;
    vertical-align: middle !important;
    white-space: nowrap;
  }

  td {
    --size: 2.2rem;
    background: var(--surface);
    border: 1px solid var(--border) !important;
    border-radius: 3px;
    color: var(--text-primary);
    font-size: 0.88rem !important;
    font-weight: 500;
    height: var(--size);
    line-height: 1 !important;
    min-width: var(--size);
    padding: 0.1rem !important;
    text-align: center;
    vertical-align: middle !important;
    width: var(--size);
  }

  figcaption {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-top: 8px;
    text-align: center;
  }
</style>
