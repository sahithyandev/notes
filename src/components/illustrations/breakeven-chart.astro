---
// Static breakeven chart: fixed cost, total cost, and sales revenue lines
// against output, with the breakeven point, loss/profit regions, and the
// margin of safety between breakeven and budgeted sales.
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Breakeven Chart"
  desc="Fixed cost, total cost, and sales revenue plotted against output. The total cost and sales revenue lines cross at the breakeven point. Below breakeven output there is a loss, above it there is a profit. The margin of safety spans from breakeven output to budgeted sales."
  y={{ label: "Cost / Revenue", domain: [0, 10] }}
  x={{ label: "Output (Units)", domain: [0, 10] }}
  layout={{ x0: 70, y0: 360, top: 45, right: 490 }}
  yLabelOffset={15}
  xLabelOffset={32}
  maxWidth={560}
  areas={[
    {
      tone: "ct",
      points: [
        { x: 0, y: 1.9 },
        { x: 5, y: 4.9 },
        { x: 0, y: 0 },
      ],
    },
    {
      tone: "pt",
      points: [
        { x: 5, y: 4.9 },
        { x: 10, y: 9.8 },
        { x: 10, y: 7.9 },
      ],
    },
  ]}
  lines={[
    {
      tone: "ct",
      dashed: true,
      width: 2,
      from: { x: 0, y: 1.9 },
      to: { x: 10, y: 1.9 },
    },
    { tone: "pt", from: { x: 0, y: 1.9 }, to: { x: 10, y: 7.9 } },
    { tone: "s5", from: { x: 0, y: 0 }, to: { x: 10, y: 9.8 } },
    {
      tone: "key",
      width: 1.5,
      from: { x: 5, y: 0.5 },
      to: { x: 8.33, y: 0.5 },
    },
  ]}
  points={[
    {
      x: 5,
      y: 4.9,
      tone: "key",
      radius: 6,
      guides: true,
      label: "BEP",
      labelTone: "ink",
      labelDx: -20,
      labelDy: -13,
    },
    {
      x: 8.33,
      y: 8.2,
      tone: "key",
      radius: 6,
      guides: "x",
      label: "Budgeted Sales",
      labelTone: "ink",
      labelDx: 0,
      labelDy: 30,
    },
  ]}
  labels={[
    { text: "Fixed Cost", x: 6.9, y: 2.1, tone: "ct" },
    { text: "Total Cost", x: 10.2, y: 7.8, tone: "pt" },
    { text: "Sales Revenue", x: 10.2, y: 9.9, tone: "s5" },
    {
      text: "Margin of Safety",
      x: 6.66,
      y: 0.8,
      tone: "key",
      anchor: "middle",
      size: 11,
    },
  ]}
>
  <Fragment slot="caption">
    <span class="tone-ct">Loss</span> below the breakeven point, where total
    cost exceeds sales revenue. <span class="tone-pt">Profit</span> above it.
    The
    <span class="tone-key">margin of safety</span> is the output between the
    breakeven point and budgeted sales.
  </Fragment>
</CartesianGraph>
