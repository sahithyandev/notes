---
// Static demand curve diagram: downward-sloping curve on price/quantity
// axes, with a dashed curve shifted left (decrease) and right (increase)
// to illustrate a shift of the entire curve.
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  title="Demand Curve"
  yLabel="Price"
  xLabel="Quantity Demanded"
>
  <path
    class="curve dashed tone-ct"
    d="M 58 74 C 65 150, 166 230, 262 236"
  ></path>
  <path
    class="curve dashed tone-pt"
    d="M 178 74 C 185 150, 286 230, 382 236"
  ></path>
  <path class="curve tone-s5" d="M 118 74 C 125 150, 226 230, 322 236"></path>

  <text class="curve-label tone-s5" x="128" y="62">
    D
  </text>
  <text class="curve-label tone-ct" x="68" y="62">
    D&#8321;
  </text>
  <text class="curve-label tone-pt" x="188" y="62">
    D&#8322;
  </text>

  <Fragment slot="caption">
    <span class="tone-s5">D</span> the original demand curve.
    <span class="tone-ct">D&#8321;</span> a decrease in demand, curve shifts
    left.
    <span class="tone-pt">D&#8322;</span> an increase in demand, curve shifts
    right.
  </Fragment>
</AxesFigure>
