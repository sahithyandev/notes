---
// Static demand curve diagram: downward-sloping curve on price/quantity
// axes, with a dashed curve shifted left (decrease) and right (increase)
// to illustrate a shift of the entire curve.
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  title="Demand Curve"
  y={{ label: "Price", domain: [0, 10] }}
  x={{ label: "Quantity Demanded", domain: [0, 10] }}
  curves={[
    {
      equation: (quantity) => 10 - quantity,
      xShift: -1.75,
      domain: [0.25, 6.25],
      tone: "ct",
      dashed: true,
      label: "D₁",
      labelAt: 0.25,
      labelDx: 10,
      labelDy: -10,
    },
    {
      equation: (quantity) => 10 - quantity,
      xShift: 1.8,
      domain: [3.8, 9.8],
      tone: "pt",
      dashed: true,
      label: "D₂",
      labelAt: 3.8,
      labelDx: 10,
      labelDy: -10,
    },
    {
      equation: (quantity) => 10 - quantity,
      domain: [2, 8],
      tone: "s5",
      label: "D",
      labelAt: 2,
      labelDx: 10,
      labelDy: -10,
    },
  ]}
>
  <Fragment slot="caption">
    <span class="tone-s5">D</span> the original demand curve.
    <span class="tone-ct">D&#8321;</span> a decrease in demand, curve shifts
    left.
    <span class="tone-pt">D&#8322;</span> an increase in demand, curve shifts
    right.
  </Fragment>
</CartesianGraph>
