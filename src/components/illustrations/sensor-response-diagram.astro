---
// Static response curve of an image sensor: output signal against incident
// light, with the non-sensitive, optimum and saturated regions marked and the
// noise floor drawn as a dashed line.
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  title="Sensor Response Curve"
  yLabel="Output Signal"
  xLabel="Incident Light"
>
  <rect class="band tone-ct" x="50" y="20" width="80" height="270"></rect>
  <rect class="band tone-pt" x="130" y="20" width="170" height="270"></rect>
  <rect class="band tone-key" x="300" y="20" width="90" height="270"></rect>

  <line class="guide" x1="50" y1="255" x2="390" y2="255"></line>
  <path
    class="curve tone-s5"
    d="M 50 270 C 110 270, 130 255, 190 170 S 290 60, 390 52"
  ></path>

  <text class="region tone-ct" x="90" y="40" text-anchor="middle">
    1
  </text>
  <text class="region tone-pt" x="215" y="40" text-anchor="middle">
    2
  </text>
  <text class="region tone-key" x="345" y="40" text-anchor="middle">
    3
  </text>
  <text class="pt-label tone-ink" x="380" y="248" text-anchor="end">
    noise floor
  </text>

  <Fragment slot="caption">
    <span class="tone-ct">1</span> non-sensitive region, signal below the noise
    floor.
    <span class="tone-pt">2</span> optimum sensitivity, output tracks light.
    <span class="tone-key">3</span> saturated region, output stops responding.
  </Fragment>
</AxesFigure>

<style>
  .band {
    fill: var(--tone);
    fill-opacity: 0.08;
  }
  .region {
    fill: var(--tone);
    font-size: 15px;
    font-weight: 700;
  }
</style>
