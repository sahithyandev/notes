---
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  title="Total Product, Average Product and Marginal Product"
  y={{ label: "Product", domain: [0, 10] }}
  x={{ label: "Labour", domain: [0, 10] }}
  layout={{
    viewBox: "0 0 460 340",
    x0: 55,
    y0: 280,
    top: 25,
    right: 420,
    labelGap: 30,
  }}
  curves={[
    {
      equation: (labour) => 10 * (1 - Math.exp(-0.25 * labour)),
      domain: [0.4, 9.3],
      tone: "s5",
      round: true,
    },
    {
      equation: (labour) => 3.3 * labour * Math.exp(-0.18 * labour),
      domain: [0.4, 9.3],
      tone: "ct",
      round: true,
    },
    {
      equation: (labour) => 9 * Math.exp(-(((labour - 4.4) / 3) ** 2)),
      domain: [0.4, 9.3],
      tone: "pt",
      round: true,
    },
  ]}
>
  <Fragment slot="caption">
    <strong class="tone-s5">TP</strong> = Total Product,
    <strong class="tone-ct">AP</strong> = Average Product, and
    <strong class="tone-pt">MP</strong> = Marginal Product. The diagram shows
    their relationship as labour increases.
  </Fragment>
</CartesianGraph>
