---
import CartesianGraph from "./primitives/cartesian-graph.astro";

const stageOneEnd = 1.86;
const stageTwoEnd = 6.02;
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Total Product, Average Product and Marginal Product"
  desc="Total, average and marginal product curves divided into the three stages of production."
  y={{ label: "Product", domain: [0, 10] }}
  x={{ label: "Labour", domain: [0, 10] }}
  areas={[
    {
      points: [
        { x: 0, y: 0 },
        { x: stageOneEnd, y: 0 },
        { x: stageOneEnd, y: 10 },
        { x: 0, y: 10 },
      ],
      tone: "s5",
      opacity: 0.08,
    },
    {
      points: [
        { x: stageOneEnd, y: 0 },
        { x: stageTwoEnd, y: 0 },
        { x: stageTwoEnd, y: 10 },
        { x: stageOneEnd, y: 10 },
      ],
      tone: "pt",
      opacity: 0.08,
    },
    {
      points: [
        { x: stageTwoEnd, y: 0 },
        { x: 10, y: 0 },
        { x: 10, y: 10 },
        { x: stageTwoEnd, y: 10 },
      ],
      tone: "ct",
      opacity: 0.08,
    },
  ]}
  lines={[
    {
      from: { x: stageOneEnd, y: 0 },
      to: { x: stageOneEnd, y: 10 },
      tone: "ink",
      dashed: true,
      guide: true,
    },
    {
      from: { x: stageTwoEnd, y: 0 },
      to: { x: stageTwoEnd, y: 10 },
      tone: "ink",
      dashed: true,
      guide: true,
    },
  ]}
  labels={[
    {
      text: "Stage 1",
      x: stageOneEnd / 2,
      y: 9.3,
      tone: "s5",
      anchor: "middle",
    },
    {
      text: "Stage 2",
      x: (stageOneEnd + stageTwoEnd) / 2,
      y: 9.3,
      tone: "pt",
      anchor: "middle",
    },
    {
      text: "Stage 3",
      x: (stageTwoEnd + 10) / 2,
      y: 9.3,
      tone: "ct",
      anchor: "middle",
    },
  ]}
  curves={[
    {
      equation: (labour) => 10 * (1 - Math.exp(-0.25 * labour)),
      domain: [0.4, 9.3],
      tone: "s5",
      round: true,
    },
    {
      equation: (labour) => 3.3 * labour * Math.exp(-0.18 * labour),
      domain: [0.4, 9.3],
      tone: "ct",
      round: true,
    },
    {
      equation: (labour) => 9 * Math.exp(-(((labour - 4.4) / 3) ** 2)),
      domain: [0.4, 9.3],
      tone: "pt",
      round: true,
    },
  ]}
>
  <Fragment slot="caption">
    <span class="tp-ap-mp-caption">
      <strong class="tone-s5">TP = Total Product</strong>,
      <strong class="tone-ct">AP = Average Product</strong>, and
      <strong class="tone-pt">MP = Marginal Product</strong>. The diagram shows
      their relationship as labour increases.
    </span>
  </Fragment>
</CartesianGraph>

<style>
  .tp-ap-mp-caption :global(.tone-s5) {
    color: var(--s5);
  }

  .tp-ap-mp-caption :global(.tone-ct) {
    color: var(--dia-ct);
  }

  .tp-ap-mp-caption :global(.tone-pt) {
    color: var(--dia-pt);
  }
</style>
