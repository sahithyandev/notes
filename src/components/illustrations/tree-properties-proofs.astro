    fill: rgba(14, 122, 150, 0.08);
    stroke: rgba(14, 122, 150, 0.45);
  }
  #tree-props-proof .c-coral {
    --tpp-node-color: #b84030;
  }
  #tree-props-proof .c-coral rect {
