  }
  #tree-props-proof .c-amber rect {
    fill: rgba(138, 90, 24, 0.08);
    stroke: rgba(138, 90, 24, 0.45);
  }
  :root[data-theme="dark"] #tree-props-proof .c-purple {
    --tpp-node-color: #c090ee;
  }
  :root[data-theme="dark"] #tree-props-proof .c-purple rect {
    fill: rgba(168, 112, 224, 0.12);
    stroke: rgba(168, 112, 224, 0.55);
  }
  :root[data-theme="dark"] #tree-props-proof .c-teal {
    --tpp-node-color: #28b4d4;
  }
  :root[data-theme="dark"] #tree-props-proof .c-teal rect {
    fill: rgba(40, 180, 212, 0.12);
    stroke: rgba(40, 180, 212, 0.55);
  }
  :root[data-theme="dark"] #tree-props-proof .c-coral {
    --tpp-node-color: #f07868;
  }
  :root[data-theme="dark"] #tree-props-proof .c-coral rect {
    fill: rgba(240, 120, 104, 0.12);
