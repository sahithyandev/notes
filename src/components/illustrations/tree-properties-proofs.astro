  }
  :root[data-theme="dark"] #tree-props-proof .c-amber {
    --tpp-node-color: #d89040;
  }
  :root[data-theme="dark"] #tree-props-proof .c-amber rect {
    fill: rgba(216, 144, 64, 0.12);
