<figure id="perfect-complements-diagram">
  <svg viewBox="0 0 620 430" xmlns="http://www.w3.org/2000/svg" role="img">
    <title>Perfectly Complementary Inputs</title>

    <!-- Axes -->
    <line class="axis" x1="75" y1="35" x2="75" y2="355"></line>
    <line class="axis" x1="75" y1="355" x2="565" y2="355"></line>

    <!-- Axis labels -->
    <text class="axis-label" x="75" y="22" text-anchor="middle">
      Capital (K)
    </text>

    <text class="axis-label" x="565" y="385" text-anchor="end">
      Labour (L)
    </text>

    <!-- Right-angled isoquant -->
    <path
      class="isoquant"
      d="
        M 160 95
        L 160 260
        L 425 260
      "></path>

    <!-- Corner point -->
    <circle class="corner-point" cx="160" cy="260" r="6"></circle>

    <!-- Corner label -->
    <text class="corner-label" x="175" y="250"> Efficient combination </text>

    <!-- Isoquant label -->
    <text class="curve-label" x="280" y="245"> Q₁ </text>

    <!-- Right-angle marker -->
    <path class="right-angle" d="M 160 240 L 180 240 L 180 260"></path>

    <!-- Fixed ratio explanation -->
    <text class="ratio-label" x="310" y="110" text-anchor="middle">
      Inputs used in a specific ratio
    </text>

    <text class="ratio-label" x="310" y="130" text-anchor="middle">
      K : L = fixed
    </text>
  </svg>

  <figcaption>
    With perfectly complementary inputs, efficient production occurs only at the
    corner of the right-angled isoquant.
  </figcaption>
</figure>

