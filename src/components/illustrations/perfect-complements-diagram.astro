---
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  size="lg"
  title="Perfectly Complementary Inputs"
  yLabel="Capital (K)"
  xLabel="Labour (L)"
>
  <path
    class="curve tone-s5"
    d="
      M 160 95
      L 160 260
      L 425 260
    "
  ></path>

  <circle class="pt tone-ink" cx="160" cy="260" r="6"></circle>

  <text class="small-label" x="175" y="250">
    Efficient combination
  </text>

  <text class="curve-label tone-s5" x="280" y="245">
    Q₁
  </text>

  <path class="right-angle" d="M 160 240 L 180 240 L 180 260"></path>

  <text class="small-label" x="310" y="110" text-anchor="middle">
    Inputs used in a specific ratio
  </text>
  <text class="small-label" x="310" y="130" text-anchor="middle">
    K : L = fixed
  </text>

  <Fragment slot="caption">
    With perfectly complementary inputs, efficient production occurs only at the
    corner of the right-angled isoquant.
  </Fragment>
</AxesFigure>

<style>
  .small-label {
    fill: var(--text-secondary);
    font-size: 12px;
  }

  .right-angle {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }
</style>
