---
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Perfectly Complementary Inputs"
  desc="A right-angled isoquant. Its corner marks the only efficient input combination when inputs must be used in a fixed ratio."
  y={{ label: "Capital (K)", domain: [0, 10] }}
  x={{ label: "Labour (L)", domain: [0, 10] }}
  lines={[
    {
      from: { x: 1.6, y: 8.13 },
      to: { x: 1.6, y: 2.97 },
      tone: "s5",
      width: 3,
    },
    {
      from: { x: 1.6, y: 2.97 },
      to: { x: 6.6, y: 2.97 },
      tone: "s5",
      width: 3,
    },
    {
      from: { x: 1.6, y: 3.59 },
      to: { x: 1.98, y: 3.59 },
      tone: "ink",
      width: 1.5,
    },
    {
      from: { x: 1.98, y: 3.59 },
      to: { x: 1.98, y: 2.97 },
      tone: "ink",
      width: 1.5,
    },
  ]}
  points={[{ x: 1.6, y: 2.97, tone: "ink", radius: 6 }]}
  labels={[
    { text: "Efficient combination", x: 1.89, y: 3.28, tone: "ink" },
    { text: "Q₁", x: 3.87, y: 3.44, tone: "s5", size: 15, weight: 700 },
    {
      text: "Inputs used in a specific ratio",
      x: 4.43,
      y: 7.66,
      anchor: "middle",
      tone: "ink",
    },
    { text: "K : L = fixed", x: 4.43, y: 7.03, anchor: "middle", tone: "ink" },
  ]}
>
  <Fragment slot="caption">
    With perfectly complementary inputs, efficient production occurs only at the
    corner of the right-angled isoquant.
  </Fragment>
</CartesianGraph>
