---
// Static consumer surplus diagram: linear demand and supply curves meeting at
// the equilibrium point, with the consumer surplus triangle shaded between the
// demand curve and the equilibrium price.
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  title="Consumer Surplus"
  desc="Linear demand and supply curves meet at the equilibrium point. The triangle between the demand curve and the equilibrium price, from the choke price down to the equilibrium price, is the consumer surplus."
  yLabel="Price"
  xLabel="Quantity"
>
  <path class="region tone-s5" d="M 50 40 L 50 150 L 220 150 Z"></path>

  <path class="curve tone-s5" d="M 50 40 L 370 247"></path>
  <path class="curve tone-ct" d="M 50 230 L 370 79"></path>

  <line class="guide" x1="220" y1="150" x2="50" y2="150"></line>
  <line class="guide" x1="220" y1="150" x2="220" y2="290"></line>

  <circle class="pt tone-pt" cx="220" cy="150" r="5"></circle>

  <text class="axis-tick" x="42" y="44" text-anchor="end">
    P
    <tspan dy="4" font-size="9">
      max
    </tspan>
  </text>
  <text class="axis-tick" x="42" y="154" text-anchor="end">
    P
    <tspan dy="4" font-size="9">
      *
    </tspan>
  </text>
  <text class="axis-tick" x="220" y="305" text-anchor="middle">
    Q
    <tspan dy="4" font-size="9">
      *
    </tspan>
  </text>

  <text class="region-label tone-s5" x="100" y="118">
    CS
  </text>

  <text class="curve-label tone-s5" x="378" y="252">
    D
  </text>
  <text class="curve-label tone-ct" x="378" y="84">
    S
  </text>
  <text class="pt-label tone-pt" x="226" y="140">
    E
  </text>

  <Fragment slot="caption">
    <span class="tone-s5">Consumer surplus</span> is the shaded triangle between
    the demand curve <span class="tone-s5">D</span> and the equilibrium price,
    from the choke price down to <span class="tone-pt">E</span>.
  </Fragment>
</AxesFigure>

<style>
  .region {
    fill: var(--tone);
    opacity: 0.15;
  }

  .region-label {
    fill: var(--tone);
    font-size: 13px;
    font-weight: 600;
  }
</style>
