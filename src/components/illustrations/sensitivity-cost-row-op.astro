---
import "../../styles/tableau.css";
import { tex } from "../../utils/tex";
import Panel from "./primitives/panel.astro";
import SliderControl from "./primitives/slider-control.astro";
import StatusNote from "./primitives/status-note.astro";

interface Props {
  variable: string;
  baseC: number;
  deltaMin: number;
  deltaMax: number;
}

const { variable, baseC, deltaMin, deltaMax } = Astro.props;

const columns = ["x_1", "x_2", "s_1", "s_2", "s_3"];
const rows = [
  { basic: "z", cells: ["0", "0", "0", "3/2", "1"], rhs: 36 },
  { basic: "s_1", cells: ["0", "0", "1", "1/3", "-1/3"], rhs: 2 },
  { basic: "x_2", cells: ["0", "1", "0", "1/2", "0"], rhs: 6 },
  { basic: "x_1", cells: ["1", "0", "0", "-1/3", "1/3"], rhs: 2 },
];

const toNum = (s: string) => {
  const neg = s.startsWith("-");
  const body = neg ? s.slice(1) : s;
  const [n, d] = body.split("/");
  const val = d ? Number(n) / Number(d) : Number(n);
  return neg ? -val : val;
};

const zRow = rows.find((r) => r.basic === "z")!;
const sourceRow = rows.find((r) => r.basic === variable)!;
const nonBasicCols = columns.filter((c) => !rows.some((r) => r.basic === c));
---

<Panel class="row-op">
  <p class="formula">
    <span
      set:html={tex("z\\text{-row} \\leftarrow z\\text{-row} + \\Delta \\cdot")}
    />
    <span set:html={tex(`${variable}\\text{'s row}`)} />
  </p>

  <table class="tableau">
    <thead>
      <tr>
        <th class="basic">Basic</th>
        {columns.map((c) => <th class="num" set:html={tex(c)} />)}
        <th class="num rhs">RHS</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr class:list={{ "source-row": r.basic === variable }}>
            <td class="basic" set:html={tex(r.basic)} />
            {r.cells.map((cell, i) => {
              const col = columns[i];
              if (r.basic === "z" && nonBasicCols.includes(col)) {
                const mult = toNum(sourceRow.cells[i]);
                return (
                  <td
                    class="num target-cell"
                    data-cost-for={col}
                    data-base={toNum(cell)}
                    data-mult={mult}
                  >
                    {cell}
                  </td>
                );
              }
              return <td class="num" set:html={tex(cell)} />;
            })}
            {r.basic === "z" ? (
              <td
                class="num rhs target-cell"
                data-cost-for="z"
                data-base={zRow.rhs}
                data-mult={sourceRow.rhs}
              >
                {zRow.rhs}
              </td>
            ) : (
              <td class="num rhs" set:html={tex(String(r.rhs))} />
            )}
          </tr>
        ))
      }
    </tbody>
  </table>

  <SliderControl
    id={`row-op-delta-${variable}`}
    min={deltaMin}
    max={deltaMax}
    step={0.01}
    value={0}
  >
    &Delta;, change to <span set:html={tex(`c_{${variable}}`)} />, currently{
      " "
    }
    {baseC}
  </SliderControl>

  <StatusNote ok={true}>Optimal. Basis stays optimal.</StatusNote>
</Panel>

<script>
  import { fmt, label } from "./lib/format";

  document.querySelectorAll<HTMLDivElement>(".row-op").forEach((widget) => {
    const slider = widget.querySelector<HTMLInputElement>(
      'input[type="range"]',
    )!;
    const deltaOut = widget.querySelector<HTMLElement>("[data-delta]")!;
    const cells = Array.from(
      widget.querySelectorAll<HTMLElement>("[data-cost-for]"),
    );
    const status = widget.querySelector<HTMLElement>("[data-status]")!;

    const render = () => {
      const delta = Number(slider.value);
      deltaOut.textContent = fmt(delta);

      let violated: { name: string; value: number } | null = null;

      cells.forEach((cell) => {
        const name = cell.dataset.costFor!;
        const base = Number(cell.dataset.base);
        const mult = Number(cell.dataset.mult);
        const val = base + delta * mult;

        cell.textContent = fmt(val);
        cell.classList.toggle("changed", delta !== 0);

        if (name !== "z" && val < 0 && !violated) {
          violated = { name, value: val };
        }
      });

      const optimal = violated === null;
      status.dataset.state = optimal ? "ok" : "bad";
      status.textContent = optimal
        ? "Optimal. Basis stays optimal."
        : `Not optimal. ${label(
            violated!.name,
          )}'s reduced cost is ${fmt(violated!.value)}, negative, so it can enter the basis and improve z.`;
    };

    slider.addEventListener("input", render);
    render();
  });
</script>

<style>
  :global(.panel.row-op) {
    padding: 16px 18px 18px;
    border-radius: 10px;
  }

  .formula {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .tableau th,
  .tableau td {
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  /* Source row: the basic variable's row being scaled by Δ. */
  .tableau tr.source-row td {
    background: color-mix(in oklab, var(--s5) 14%, var(--surface));
  }
  .tableau tr.source-row td.basic {
    color: var(--s5);
    font-weight: 700;
  }

  /* Target cells: the objective row entries that row gets added into. */
  .tableau td.target-cell {
    background: var(--accent-subtle);
  }
  .tableau td.target-cell.changed {
    color: var(--accent);
    font-weight: 600;
  }
</style>
