---
// A fork is easiest to read as a split: both paths resume after one system call.
import ArrowMarker from "./primitives/arrow-marker.astro";
import { makeUid } from "./lib/uid";

const uid = makeUid("fork-exec");
---

<figure class="fork-flow" id={uid}>
  <svg
    viewBox="0 0 760 310"
    role="img"
    aria-labelledby={`${uid}-title ${uid}-desc`}
  >
    <title id={`${uid}-title`}>Fork, exec, and wait</title>
    <desc id={`${uid}-desc`}>
      A shell calls fork. The call splits execution into a parent path, where it
      returns the child PID and waits, and a child path, where it returns zero
      and exec replaces the shell with another program.
    </desc>
    <defs>
      <ArrowMarker id={`${uid}-arrow`} />
    </defs>

    <g class="start">
      <rect x="285" y="14" width="190" height="42" rx="8" />
      <text x="380" y="40" text-anchor="middle">
        Shell process
      </text>
    </g>
    <path
      class="arrow"
      d="M 380 58 L 380 87"
      marker-end={`url(#${uid}-arrow)`}
    />
    <g class="fork">
      <circle cx="380" cy="105" r="18" />
      <text x="380" y="109" text-anchor="middle">
        fork
      </text>
    </g>

    <path
      class="arrow"
      d="M 364 115 L 190 151"
      marker-end={`url(#${uid}-arrow)`}
    />
    <path
      class="arrow"
      d="M 396 115 L 570 151"
      marker-end={`url(#${uid}-arrow)`}
    />
    <text x="260" y="126" text-anchor="middle" class="return">
      returns child PID &gt; 0
    </text>
    <text x="500" y="126" text-anchor="middle" class="return">
      returns 0
    </text>

    <g class="lane parent">
      <rect x="80" y="154" width="220" height="74" rx="8" />
      <text x="190" y="181" text-anchor="middle" class="lane-title">
        Parent shell
      </text>
      <text x="190" y="205" text-anchor="middle" class="lane-body">
        waitpid(child)
      </text>
    </g>
    <g class="lane child">
      <rect x="460" y="154" width="220" height="74" rx="8" />
      <text x="570" y="181" text-anchor="middle" class="lane-title">
        Child copy
      </text>
      <text x="570" y="205" text-anchor="middle" class="lane-body">
        execvp(args)
      </text>
    </g>

    <path
      class="arrow"
      d="M 190 230 L 190 271"
      marker-end={`url(#${uid}-arrow)`}
    />
    <path
      class="arrow"
      d="M 570 230 L 570 271"
      marker-end={`url(#${uid}-arrow)`}
    />
    <text x="190" y="299" text-anchor="middle" class="outcome">
      collects exit status
    </text>
    <text x="570" y="299" text-anchor="middle" class="outcome">
      becomes someutil, then exits
    </text>
  </svg>
  <figcaption>
    One <code>fork()</code> call creates 2 continuations. The return value tells
    each continuation which path it is running.
  </figcaption>
</figure>

<style>
  .fork-flow {
    max-width: 760px;
    margin: 24px auto;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  rect,
  circle {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1.3;
  }
  .start rect,
  .fork circle {
    stroke: var(--dia-pt);
  }
  .parent rect {
    stroke: var(--dia-key);
  }
  .child rect {
    stroke: var(--s5);
  }
  text {
    fill: var(--text-primary);
    font-family: var(--font-ui);
  }
  .start text,
  .lane-title {
    font-size: 13px;
    font-weight: 700;
  }
  .fork text {
    font-size: 9px;
    font-weight: 700;
  }
  .lane-body,
  .return,
  .outcome {
    fill: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .return {
    font-size: 10px;
  }
  .outcome {
    font-family: var(--font-ui);
    font-size: 11px;
  }
  .arrow {
    fill: none;
    stroke: var(--text-secondary);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  figcaption {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.45;
    text-align: center;
  }
</style>
