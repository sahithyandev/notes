---
// Static box-and-arrow diagram of the generic 5-state process model (New,
// Ready, Running, Waiting, Terminated), replacing a hand-drawn PNG.
interface StateBox {
  id: string;
  label: string;
  x: number;
  y: number;
}

const boxes: StateBox[] = [
  { id: "new", label: "New", x: 90, y: 90 },
  { id: "ready", label: "Ready", x: 360, y: 90 },
  { id: "running", label: "Running", x: 640, y: 90 },
  { id: "terminated", label: "Terminated", x: 900, y: 90 },
  { id: "waiting", label: "Waiting", x: 640, y: 330 },
];

const BOX_W = 110;
const BOX_H = 50;
const HW = BOX_W / 2;
const HH = BOX_H / 2;

const byId = new Map(boxes.map((b) => [b.id, b]));

function rectClip(cx: number, cy: number, dx: number, dy: number) {
  const sx = dx !== 0 ? HW / Math.abs(dx) : Infinity;
  const sy = dy !== 0 ? HH / Math.abs(dy) : Infinity;
  const s = Math.min(sx, sy);
  return { x: cx + dx * s, y: cy + dy * s };
}

interface Point {
  x: number;
  y: number;
}

interface Edge {
  from: string;
  to: string;
  label: string;
  labelDx: number;
  labelDy: number;
  labelAnchor?: "start" | "middle" | "end";
  // Overrides the auto-clipped edge points, for the 2 parallel arrows
  // running between the same pair of boxes (Ready <-> Running).
  fromPoint?: Point;
  toPoint?: Point;
}

const ready = byId.get("ready")!;
const running = byId.get("running")!;

const edges: Edge[] = [
  { from: "new", to: "ready", label: "admit", labelDx: 0, labelDy: -14 },
  {
    from: "ready",
    to: "running",
    label: "scheduler dispatch",
    labelDx: 0,
    labelDy: 18,
    fromPoint: { x: ready.x + HW, y: ready.y + 12 },
    toPoint: { x: running.x - HW, y: running.y + 12 },
  },
  {
    from: "running",
    to: "ready",
    label: "interrupt",
    labelDx: 0,
    labelDy: -14,
    fromPoint: { x: running.x - HW, y: running.y - 12 },
    toPoint: { x: ready.x + HW, y: ready.y - 12 },
  },
  {
    from: "running",
    to: "terminated",
    label: "exit",
    labelDx: 0,
    labelDy: -14,
  },
  {
    from: "running",
    to: "waiting",
    label: "I/O or event wait",
    labelDx: 16,
    labelDy: -6,
    labelAnchor: "start",
  },
  {
    from: "waiting",
    to: "ready",
    label: "I/O or event completion",
    labelDx: -16,
    labelDy: -6,
    labelAnchor: "end",
  },
];

const uid = "proc-state-" + Math.random().toString(36).slice(2, 9);

const drawn = edges.map((edge) => {
  const from = byId.get(edge.from)!;
  const to = byId.get(edge.to)!;
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const p1 = edge.fromPoint ?? rectClip(from.x, from.y, dx, dy);
  const p2 = edge.toPoint ?? rectClip(to.x, to.y, -dx, -dy);
  const midX = (p1.x + p2.x) / 2;
  const midY = (p1.y + p2.y) / 2;
  return {
    label: edge.label,
    x1: p1.x,
    y1: p1.y,
    x2: p2.x,
    y2: p2.y,
    labelX: midX + edge.labelDx,
    labelY: midY + edge.labelDy,
    labelAnchor: edge.labelAnchor ?? "middle",
  };
});

const W = 1000;
const H = 400;
---

<figure class="process-state" id={uid}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    role="img"
    aria-label="Diagram of the 5-state process model: New, Ready, Running, Waiting, Terminated"
  >
    <defs>
      <marker
        id={`${uid}-arrow`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" class="arrowhead" />
      </marker>
    </defs>

    <g class="edges">
      {drawn.map((e) => (
        <g class="edge">
          <line
            x1={e.x1}
            y1={e.y1}
            x2={e.x2}
            y2={e.y2}
            class="shaft"
            marker-end={`url(#${uid}-arrow)`}
          />
          <text
            x={e.labelX}
            y={e.labelY}
            class="edge-label"
            text-anchor={e.labelAnchor}
          >
            {e.label}
          </text>
        </g>
      ))}
    </g>

    <g class="boxes">
      {boxes.map((b) => (
        <g
          class="box"
          style={`transform: translate(${b.x - HW}px, ${b.y - HH}px)`}
        >
          <rect width={BOX_W} height={BOX_H} rx="8" />
          <text x={HW} y={HH} text-anchor="middle" dominant-baseline="middle">
            {b.label}
          </text>
        </g>
      ))}
    </g>
  </svg>
</figure>

<style>
  .process-state {
    max-width: 850px;
    margin: 20px auto;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .shaft {
    stroke: var(--text-secondary);
    stroke-width: 1.5;
  }

  .arrowhead {
    fill: var(--text-secondary);
  }

  .edge-label {
    fill: var(--text-secondary);
    font-size: 12px;
    font-family: var(--font-mono);
  }

  .box rect {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .box text {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
    font-family: var(--font-body);
  }
</style>
