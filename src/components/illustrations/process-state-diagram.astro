---
// Box-and-arrow diagram of the generic 5-state process model (New, Ready,
// Running, Waiting, Terminated) plus the Unix-specific additions (Stopped,
// Zombie, Orphan), replacing a hand-drawn PNG. Unix states/edges are styled
// distinctly (dashed, accent-colored) so they read as an extension rather
// than part of the generic model. Running is the hub: every addition attaches
// to it at its own angle so the fan-out of edges stays legible.
import { makeUid } from "./lib/uid";
import ArrowMarker from "./primitives/arrow-marker.astro";

interface StateBox {
  id: string;
  label: string;
  x: number;
  y: number;
  unix?: boolean;
}

const boxes: StateBox[] = [
  { id: "new", label: "New", x: 90, y: 90 },
  { id: "ready", label: "Ready", x: 380, y: 90 },
  { id: "running", label: "Running", x: 680, y: 90 },
  { id: "terminated", label: "Terminated", x: 960, y: 90 },
  { id: "waiting", label: "Waiting", x: 380, y: 270 },
  { id: "zombie", label: "Zombie", x: 960, y: 270, unix: true },
  { id: "orphan", label: "Orphan", x: 500, y: 410, unix: true },
  { id: "stopped", label: "Stopped", x: 860, y: 410, unix: true },
];

const BOX_W = 110;
const BOX_H = 50;
const HW = BOX_W / 2;
const HH = BOX_H / 2;

const byId = new Map(boxes.map((b) => [b.id, b]));

function rectClip(cx: number, cy: number, dx: number, dy: number) {
  const sx = dx !== 0 ? HW / Math.abs(dx) : Infinity;
  const sy = dy !== 0 ? HH / Math.abs(dy) : Infinity;
  const s = Math.min(sx, sy);
  return { x: cx + dx * s, y: cy + dy * s };
}

interface Point {
  x: number;
  y: number;
}

interface Edge {
  from: string;
  to: string;
  label: string;
  labelDx: number;
  labelDy: number;
  labelAnchor?: "start" | "middle" | "end";
  // Overrides the auto-clipped edge points, for the 2 parallel arrows
  // running between the same pair of boxes (Ready <-> Running, Running <->
  // Stopped).
  fromPoint?: Point;
  toPoint?: Point;
  // Unix-specific addition, drawn/styled differently from the generic model.
  unix?: boolean;
}

const ready = byId.get("ready")!;
const running = byId.get("running")!;
const stopped = byId.get("stopped")!;

const edges: Edge[] = [
  { from: "new", to: "ready", label: "admit", labelDx: 0, labelDy: -14 },
  {
    from: "ready",
    to: "running",
    label: "scheduler dispatch",
    labelDx: 0,
    labelDy: 18,
    fromPoint: { x: ready.x + HW, y: ready.y + 12 },
    toPoint: { x: running.x - HW, y: running.y + 12 },
  },
  {
    from: "running",
    to: "ready",
    label: "interrupt",
    labelDx: 0,
    labelDy: -14,
    fromPoint: { x: running.x - HW, y: running.y - 12 },
    toPoint: { x: ready.x + HW, y: ready.y - 12 },
  },
  {
    from: "running",
    to: "waiting",
    label: "I/O or event wait",
    labelDx: -90,
    labelDy: 50,
    labelAnchor: "end",
  },
  {
    from: "waiting",
    to: "ready",
    label: "I/O or event completion",
    labelDx: 14,
    labelDy: -54,
    labelAnchor: "start",
  },
  {
    from: "running",
    to: "terminated",
    label: "exit",
    labelDx: 0,
    labelDy: -14,
  },
  {
    from: "running",
    to: "zombie",
    label: "exit",
    labelDx: 14,
    labelDy: -4,
    labelAnchor: "start",
    unix: true,
  },
  {
    from: "zombie",
    to: "terminated",
    label: "wait() reaps",
    labelDx: 14,
    labelDy: 0,
    labelAnchor: "start",
    unix: true,
  },
  {
    from: "running",
    to: "stopped",
    label: "SIGSTOP",
    labelDx: 14,
    labelDy: -4,
    labelAnchor: "start",
    fromPoint: { x: running.x + 12, y: running.y + HH },
    toPoint: { x: stopped.x + 12, y: stopped.y - HH },
    unix: true,
  },
  {
    from: "stopped",
    to: "running",
    label: "SIGCONT",
    labelDx: -14,
    labelDy: 4,
    labelAnchor: "end",
    fromPoint: { x: stopped.x - 12, y: stopped.y - HH },
    toPoint: { x: running.x - 12, y: running.y + HH },
    unix: true,
  },
  {
    from: "running",
    to: "orphan",
    label: "parent exits",
    labelDx: -14,
    labelDy: -4,
    labelAnchor: "end",
    unix: true,
  },
];

const uid = makeUid("proc-state");

const drawn = edges.map((edge) => {
  const from = byId.get(edge.from)!;
  const to = byId.get(edge.to)!;
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const p1 = edge.fromPoint ?? rectClip(from.x, from.y, dx, dy);
  const p2 = edge.toPoint ?? rectClip(to.x, to.y, -dx, -dy);
  const midX = (p1.x + p2.x) / 2;
  const midY = (p1.y + p2.y) / 2;
  return {
    label: edge.label,
    x1: p1.x,
    y1: p1.y,
    x2: p2.x,
    y2: p2.y,
    labelX: midX + edge.labelDx,
    labelY: midY + edge.labelDy,
    labelAnchor: edge.labelAnchor ?? "middle",
    unix: edge.unix ?? false,
  };
});

const W = 1080;
const H = 480;
---

<figure class="process-state" id={uid}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    role="img"
    aria-label="Diagram of the 5-state process model (New, Ready, Running, Waiting, Terminated) with the Unix-specific Stopped, Zombie, and Orphan additions shown dashed"
  >
    <defs>
      <ArrowMarker id={`${uid}-arrow`} />
      <ArrowMarker id={`${uid}-arrow-unix`} fill="var(--unix-accent)" />
    </defs>

    <g class="edges">
      {drawn.map((e) => (
        <g class={e.unix ? "edge unix" : "edge"}>
          <line
            x1={e.x1}
            y1={e.y1}
            x2={e.x2}
            y2={e.y2}
            class="shaft"
            marker-end={`url(#${uid}-${e.unix ? "arrow-unix" : "arrow"})`}
          />
          <text
            x={e.labelX}
            y={e.labelY}
            class="edge-label"
            text-anchor={e.labelAnchor}
          >
            {e.label}
          </text>
        </g>
      ))}
    </g>

    <g class="boxes">
      {boxes.map((b) => (
        <g
          class={b.unix ? "box unix" : "box"}
          style={`transform: translate(${b.x - HW}px, ${b.y - HH}px)`}
        >
          <rect width={BOX_W} height={BOX_H} rx="8" />
          <text x={HW} y={HH} text-anchor="middle" dominant-baseline="middle">
            {b.label}
          </text>
        </g>
      ))}
    </g>
  </svg>

  <figcaption>
    The generic 5-state model in solid gray, with Unix's dashed
    <strong>Stopped</strong>, <strong>Zombie</strong>, and{" "}
    <strong>Orphan</strong> additions in gold.
  </figcaption>
</figure>

<style>
  .process-state {
    max-width: 850px;
    margin: 20px auto;
    --unix-accent: #8a5a00;
  }

  :global([data-theme="dark"]) .process-state {
    --unix-accent: #f5c518;
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .shaft {
    stroke: var(--text-secondary);
    stroke-width: 1.5;
  }

  .edge-label {
    fill: var(--text-secondary);
    font-size: 12px;
    font-family: var(--font-mono);
  }

  .edge.unix .shaft {
    stroke: var(--unix-accent);
    stroke-dasharray: 4 3;
  }

  .edge.unix .edge-label {
    fill: var(--unix-accent);
    font-style: italic;
  }

  .box rect {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .box text {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 700;
    font-family: var(--font-body);
  }

  .box.unix rect {
    fill: var(--surface);
    stroke: var(--unix-accent);
    stroke-width: 1.5;
    stroke-dasharray: 5 3;
  }

  .box.unix text {
    fill: var(--unix-accent);
  }

  figcaption {
    margin-top: 10px;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--text-secondary);
    text-align: center;
  }

  figcaption strong {
    color: var(--text-primary);
  }
</style>
