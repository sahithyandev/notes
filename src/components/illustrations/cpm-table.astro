---
import { tex } from "../../utils/tex";

interface Props {
  activities: string[];
  es: string[];
  ef: string[];
  ls: string[];
  lf: string[];
  tf: string[];
  critical?: number[];
  dataSource?: boolean;
}

const {
  activities,
  es,
  ef,
  ls,
  lf,
  tf,
  critical = [],
  dataSource = false,
} = Astro.props;

const isCritical = (ai: number) => critical.includes(ai);
---

<table
  class="tableau"
  data-stage={dataSource ? "" : undefined}
  aria-hidden={dataSource ? "true" : undefined}
>
  <colgroup>
    <col class="c-label" />
    <col class="c-data" />
    <col class="c-data" />
    <col class="c-data" />
    <col class="c-data" />
    <col class="c-data" />
  </colgroup>
  <thead>
    <tr>
      <th>Activity</th>
      <th class="num" set:html={tex("\\text{ES}")} />
      <th class="num" set:html={tex("\\text{EF}")} />
      <th class="num" set:html={tex("\\text{LS}")} />
      <th class="num" set:html={tex("\\text{LF}")} />
      <th class="num" set:html={tex("\\text{TF}")} />
    </tr>
  </thead>
  <tbody>
    {activities.map((a, ai) => (
      <tr class:list={{ critical: isCritical(ai) }}>
        <th set:html={tex(a)} />
        <td class="num" set:html={es[ai] ? tex(es[ai]) : ""} />
        <td class="num" set:html={ef[ai] ? tex(ef[ai]) : ""} />
        <td class="num" set:html={ls[ai] ? tex(ls[ai]) : ""} />
        <td class="num" set:html={lf[ai] ? tex(lf[ai]) : ""} />
        <td class="num" set:html={tf[ai] ? tex(tf[ai]) : ""} />
      </tr>
    ))}
  </tbody>
</table>

<style>
  table.tableau {
    border-collapse: collapse;
    font-size: 0.9rem;
    max-width: 460px;
    margin: 0 auto;
  }

  col.c-label {
    width: 4.5rem;
  }
  col.c-data {
    width: 4.5rem;
  }

  th,
  td {
    padding: 6px 8px;
    text-align: center;
    border: 1px solid var(--border);
  }

  thead th {
    color: var(--text-secondary);
    font-weight: 600;
  }

  tbody th {
    color: var(--text-primary);
    font-weight: 600;
  }

  td.num {
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  td.num.changed {
    color: var(--accent);
    font-weight: 700;
  }

  tr.critical th,
  tr.critical td {
    background: var(--accent-subtle);
  }

  @media (prefers-reduced-motion: reduce) {
    td.num {
      transition: none;
    }
  }
</style>
