---
// Static supply curve diagram: upward-sloping curve on price/quantity
// axes, with a dashed curve shifted left (decrease) and right (increase)
// to illustrate a shift of the entire curve.
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  title="Supply Curve"
  y={{ label: "Price", domain: [0, 10] }}
  x={{ label: "Quantity Supplied", domain: [0, 10] }}
  curves={[
    {
      equation: (quantity) => 5 * quantity - 20.3,
      domain: [4.2, 5.9],
      tone: "ct",
      dashed: true,
      label: "S₁",
      labelAt: 5.9,
      labelDx: 7,
      labelDy: -5,
    },
    {
      equation: (quantity) => 5 * quantity - 0.75,
      domain: [0.3, 2],
      tone: "pt",
      dashed: true,
      label: "S₂",
      labelAt: 2,
      labelDx: 7,
      labelDy: -5,
    },
    {
      equation: (quantity) => 5 * quantity - 11,
      domain: [2.35, 4.1],
      tone: "s5",
      label: "S",
      labelAt: 4.1,
      labelDx: 7,
      labelDy: -5,
    },
  ]}
>
  <Fragment slot="caption">
    <span class="tone-s5">S</span> the original supply curve.
    <span class="tone-ct">S&#8321;</span> a decrease in supply, curve shifts
    left.
    <span class="tone-pt">S&#8322;</span> an increase in supply, curve shifts
    right.
  </Fragment>
</CartesianGraph>
