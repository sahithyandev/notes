---
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Marginal Rate of Technical Substitution"
  desc="A convex isoquant with two input combinations and a dashed tangent line, showing the changes in capital and labour used to calculate the marginal rate of technical substitution."
  y={{ label: "Capital (K)", domain: [0, 10] }}
  x={{ label: "Labour (L)", domain: [0, 10] }}
  curves={[
    {
      equation: (labour) =>
        -0.0114 * labour ** 3 +
        0.3106 * labour ** 2 -
        3.1283 * labour +
        11.5974,
      domain: [1.13, 8.96],
      tone: "s5",
    },
  ]}
  lines={[
    {
      from: { x: 2.45, y: 5.63 },
      to: { x: 2.45, y: 1.47 },
      guide: true,
    },
    {
      from: { x: 2.45, y: 1.47 },
      to: { x: 6.13, y: 1.47 },
      guide: true,
    },
    {
      from: { x: 1.13, y: 7.81 },
      to: { x: 3.87, y: 3.44 },
      tone: "ct",
      dashed: true,
      width: 2,
    },
  ]}
  points={[
    { x: 2.45, y: 5.63, tone: "ink", radius: 6 },
    { x: 6.13, y: 1.47, tone: "ink", radius: 6 },
  ]}
  labels={[
    { text: "A", x: 2.13, y: 5.94, tone: "ink", size: 14, weight: 700 },
    { text: "B", x: 6.32, y: 1.72, tone: "ink", size: 14, weight: 700 },
    { text: "Q₁", x: 4.72, y: 3.44, tone: "s5", size: 15, weight: 700 },
    { text: "ΔK", x: 1.98, y: 3.44, tone: "ink", size: 13, weight: 600 },
    { text: "ΔL", x: 4.25, y: 0.78, tone: "ink", size: 13, weight: 600 },
    {
      text: "MRTS = slope of isoquant",
      x: 4.81,
      y: 7.97,
      tone: "ink",
      weight: 600,
    },
    { text: "MRTS = −ΔK / ΔL", x: 4.81, y: 7.19, tone: "ink", size: 13 },
  ]}
>
  <Fragment slot="caption">
    MRTS shows how much capital can be reduced when labour is increased while
    keeping output constant.
  </Fragment>
</CartesianGraph>
