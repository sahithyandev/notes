---
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  size="lg"
  title="Marginal Rate of Technical Substitution"
  yLabel="Capital (K)"
  xLabel="Labour (L)"
>
  <path
    class="curve tone-s5"
    d="
      M 135 85
      C 165 125, 190 165, 230 205
      C 275 250, 335 285, 405 310
      C 455 328, 510 340, 550 345
    "
  ></path>

  <circle class="pt tone-ink" cx="205" cy="175" r="6"></circle>
  <circle class="pt tone-ink" cx="400" cy="308" r="6"></circle>

  <line class="change-line" x1="205" y1="175" x2="205" y2="308"></line>
  <line class="change-line" x1="205" y1="308" x2="400" y2="308"></line>

  <line class="tangent" x1="135" y1="105" x2="280" y2="245"></line>

  <text class="point-label" x="188" y="165">
    A
  </text>
  <text class="point-label" x="410" y="300">
    B
  </text>

  <text class="curve-label tone-s5" x="325" y="245">
    Q₁
  </text>

  <text class="delta-label" x="180" y="245">
    ΔK
  </text>
  <text class="delta-label" x="300" y="330">
    ΔL
  </text>

  <text class="mrts-label" x="330" y="100">
    MRTS = slope of isoquant
  </text>
  <text class="formula-label" x="330" y="125">
    MRTS = −ΔK / ΔL
  </text>

  <Fragment slot="caption">
    MRTS shows how much capital can be reduced when labour is increased while
    keeping output constant.
  </Fragment>
</AxesFigure>

<style>
  .tangent {
    stroke: var(--dia-ct);
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }

  .change-line {
    stroke: var(--text-muted);
    stroke-width: 1.3;
    stroke-dasharray: 5 5;
  }

  .point-label {
    fill: var(--text-primary);
    font-size: 14px;
    font-weight: 700;
  }

  .delta-label {
    fill: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
  }

  .mrts-label {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
  }

  .formula-label {
    fill: var(--text-secondary);
    font-size: 13px;
  }
</style>
