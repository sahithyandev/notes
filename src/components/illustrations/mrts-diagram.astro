<figure id="mrts-diagram">
  <svg viewBox="0 0 620 430" xmlns="http://www.w3.org/2000/svg" role="img">
    <title>Marginal Rate of Technical Substitution</title>

    <!-- Axes -->
    <line class="axis" x1="75" y1="35" x2="75" y2="355"></line>
    <line class="axis" x1="75" y1="355" x2="565" y2="355"></line>

    <!-- Axis labels -->
    <text class="axis-label" x="75" y="22" text-anchor="middle">
      Capital (K)
    </text>

    <text class="axis-label" x="565" y="385" text-anchor="end">
      Labour (L)
    </text>

    <!-- Convex isoquant -->
    <path
      class="isoquant"
      d="
        M 135 85
        C 165 125, 190 165, 230 205
        C 275 250, 335 285, 405 310
        C 455 328, 510 340, 550 345
      "
    ></path>

    <!-- Point A -->
    <circle class="point" cx="205" cy="175" r="6"></circle>

    <!-- Point B -->
    <circle class="point" cx="400" cy="308" r="6"></circle>

    <!-- Dashed change in capital -->
    <line class="change-line" x1="205" y1="175" x2="205" y2="308"></line>

    <!-- Dashed change in labour -->
    <line class="change-line" x1="205" y1="308" x2="400" y2="308"></line>

    <!-- Tangent at A -->
    <line class="tangent" x1="135" y1="105" x2="280" y2="245"></line>

    <!-- Labels -->
    <text class="point-label" x="188" y="165"> A </text>

    <text class="point-label" x="410" y="300"> B </text>

    <text class="curve-label" x="325" y="245"> Q₁ </text>

    <!-- Delta K -->
    <text class="delta-label" x="180" y="245"> ΔK </text>

    <!-- Delta L -->
    <text class="delta-label" x="300" y="330"> ΔL </text>

    <!-- MRTS explanation -->
    <text class="mrts-label" x="330" y="100"> MRTS = slope of isoquant </text>

    <text class="formula-label" x="330" y="125"> MRTS = −ΔK / ΔL </text>
  </svg>

  <figcaption>
    MRTS shows how much capital can be reduced when labour is increased while
    keeping output constant.
  </figcaption>
</figure>

<style>
  #mrts-diagram {
    max-width: 620px;
    margin: 28px auto;
  }

  #mrts-diagram svg {
    width: 100%;
    height: auto;
  }

  #mrts-diagram .axis {
    stroke: var(--text-muted);
    stroke-width: 1.8;
  }

  #mrts-diagram .axis-label {
    fill: var(--text-secondary);
    font-size: 14px;
    font-weight: 600;
  }

  #mrts-diagram .isoquant {
    fill: none;
    stroke: var(--s5);
    stroke-width: 3;
  }

  #mrts-diagram .tangent {
    stroke: var(--dia-ct);
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }

  #mrts-diagram .change-line {
    stroke: var(--text-muted);
    stroke-width: 1.3;
    stroke-dasharray: 5 5;
  }

  #mrts-diagram .point {
    fill: var(--text-primary);
  }

  #mrts-diagram .point-label {
    fill: var(--text-primary);
    font-size: 14px;
    font-weight: 700;
  }

  #mrts-diagram .curve-label {
    fill: var(--s5);
    font-size: 16px;
    font-weight: 700;
  }

  #mrts-diagram .delta-label {
    fill: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
  }

  #mrts-diagram .mrts-label {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
  }

  #mrts-diagram .formula-label {
    fill: var(--text-secondary);
    font-size: 13px;
  }

  #mrts-diagram figcaption {
    margin-top: 10px;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-secondary);
    text-align: center;
  }
</style>
