---
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Isoquant Map"
  desc="Three isoquants farther from the origin represent progressively higher output levels."
  y={{ label: "Capital (K)", domain: [0, 10] }}
  x={{ label: "Labour (L)", domain: [0, 10] }}
  curves={[
    {
      equation: (labour) => -0.1773 * labour ** 2 - 1.1125 * labour + 9.4555,
      domain: [1.13, 4.53],
      tone: "ct",
    },
    {
      equation: (labour) => -0.0672 * labour ** 2 - 1.2509 * labour + 12.6755,
      domain: [2.74, 7],
      tone: "s5",
    },
    {
      equation: (labour) => -0.1903 * labour ** 2 + 0.6288 * labour + 10.4293,
      domain: [4.53, 8.96],
      tone: "pt",
    },
  ]}
  lines={[
    {
      from: { x: 7.45, y: 8.75 },
      to: { x: 7.45, y: 8.13 },
      tone: "ink",
      arrow: "end",
    },
  ]}
  labels={[
    { text: "Q₁", x: 3.96, y: 1.25, tone: "ct", size: 15, weight: 700 },
    { text: "Q₂", x: 6.42, y: 1.88, tone: "s5", size: 15, weight: 700 },
    { text: "Q₃", x: 8.21, y: 2.66, tone: "pt", size: 15, weight: 700 },
    { text: "Higher output", x: 6.98, y: 8.75, tone: "ink", weight: 600 },
  ]}
>
  <Fragment slot="caption">
    Each isoquant represents a different level of output. Isoquants farther from
    the origin represent higher output levels.
  </Fragment>
</CartesianGraph>
