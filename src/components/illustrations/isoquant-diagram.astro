---
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  size="lg"
  title="Isoquant Map"
  yLabel="Capital (K)"
  xLabel="Labour (L)"
>
  <path
    class="curve tone-ct"
    d="M 135 100 C 185 125, 215 175, 245 225 C 270 265, 290 300, 315 330"
  ></path>
  <path
    class="curve tone-s5"
    d="M 220 75 C 275 105, 315 160, 350 215 C 380 260, 410 305, 445 335"
  ></path>
  <path
    class="curve tone-pt"
    d="M 315 55 C 370 85, 420 135, 455 190 C 490 245, 520 295, 550 330"
  ></path>

  <text class="curve-label tone-ct" x="285" y="315">
    Q₁
  </text>
  <text class="curve-label tone-s5" x="415" y="295">
    Q₂
  </text>
  <text class="curve-label tone-pt" x="510" y="270">
    Q₃
  </text>

  <text class="output-label" x="445" y="75">
    Higher output
  </text>
  <text class="output-arrow" x="470" y="95">
    ↑
  </text>

  <Fragment slot="caption">
    Each isoquant represents a different level of output. Isoquants farther from
    the origin represent higher output levels.
  </Fragment>
</AxesFigure>

<style>
  .output-label {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
  }

  .output-arrow {
    fill: var(--text-primary);
    font-size: 22px;
  }
</style>
