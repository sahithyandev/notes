<figure id="production-function-diagram">
  <svg
    viewBox="0 0 420 320"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="production-function-title"
  >
    <title id="production-function-title">Production Function</title>

    <!-- Axes -->
    <line class="axis" x1="55" y1="25" x2="55" y2="270"></line>

    <line class="axis" x1="55" y1="270" x2="390" y2="270"></line>

    <!-- Axis labels -->
    <text class="axis-label" x="55" y="18" text-anchor="middle"> Output </text>

    <text class="axis-label" x="390" y="300" text-anchor="end">
      Variable Input
    </text>

    <!-- Production function -->
    <path
      class="curve"
      d="M 70 250
         C 115 235, 155 195, 195 145
         C 235 95, 285 65, 335 52
         C 355 47, 370 45, 380 44"
    ></path>
  </svg>

  <figcaption>
    <strong>Q = f(L)</strong> — Production function showing the relationship between
    a variable input and the maximum output that can be produced.
  </figcaption>
</figure>

<style>
