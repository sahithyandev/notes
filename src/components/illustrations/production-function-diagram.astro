---
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  title="Production Function"
  yLabel="Output"
  xLabel="Variable Input"
  viewBox="0 0 420 320"
  x0={55}
  y0={270}
  top={25}
  yLabelOffset={7}
  xLabelOffset={30}
>
  <path
    class="curve round tone-s5"
    d="M 70 250
       C 115 235, 155 195, 195 145
       C 235 95, 285 65, 335 52
       C 355 47, 370 45, 380 44"
  ></path>

  <Fragment slot="caption">
    <strong class="tone-s5">Q = f(L)</strong> is the production function. It
    shows the relationship between a variable input and the maximum output that
    can be produced.
  </Fragment>
</AxesFigure>
