  }

  #production-function-diagram .axis {
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }

  #production-function-diagram .axis-label {
    fill: var(--text-secondary);
    font-size: 13px;
  }

  #production-function-diagram .curve {
    fill: none;
    stroke: var(--s5);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  #production-function-diagram figcaption {
    margin-top: 8px;
    font-size: 0.85rem;
