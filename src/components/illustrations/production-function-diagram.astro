---
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  title="Production Function"
  y={{ label: "Output", domain: [0, 10] }}
  x={{ label: "Variable Input", domain: [0, 10] }}
  layout={{ viewBox: "0 0 420 320", x0: 55, y0: 270, top: 25, labelGap: 30 }}
  curves={[
    {
      equation: (input) => 10 * (1 - Math.exp(-0.27 * input)),
      domain: [0.45, 9.55],
      tone: "s5",
      round: true,
    },
  ]}
>
  <Fragment slot="caption">
    <strong class="tone-s5">Q = f(L)</strong> is the production function. It
    shows the relationship between a variable input and the maximum output that
    can be produced.
  </Fragment>
</CartesianGraph>
