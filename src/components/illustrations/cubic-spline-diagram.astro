---
// Static illustration of the cubic spline conditions: the natural spline through
// (0, 0), (1, 1), (2, 0), (3, 1) from Example 2 of the cubic spline note. Three
// cubic pieces S0, S1, S2 meet at the interior knots x1 and x2 with matching
// value, slope (the dashed tangent, -1/3 on both sides) and curvature, and the
// natural end conditions give S'' = 0 at x0 and x3.
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Cubic Spline Conditions"
  desc="A natural cubic spline through the nodes (0, 0), (1, 1), (2, 0) and (3, 1), made of three cubic pieces. At the interior knots x1 and x2 the pieces share the same height, slope and curvature."
  y={{ label: "y", domain: [-0.3, 1.3] }}
  x={{ label: "x", domain: [0, 3.40625] }}
  layout={{ viewBox: "0 0 680 430", x0: 95, right: 640 }}
  curves={[
    {
      equation: (x) => (5 * x) / 3 - (2 * x ** 3) / 3,
      domain: [0, 1],
      tone: "s5",
      round: true,
    },
    {
      equation: (x) => {
        const t = x - 1;
        return (
          (-2 * (1 - t) ** 3) / 3 +
          (2 * t ** 3) / 3 +
          (5 * (1 - t)) / 3 -
          (2 * t) / 3
        );
      },
      domain: [1, 2],
      tone: "ct",
      round: true,
    },
    {
      equation: (x) => {
        const t = x - 2;
        return (2 * (1 - t) ** 3) / 3 - (2 * (1 - t)) / 3 + t;
      },
      domain: [2, 3],
      tone: "pt",
      round: true,
    },
  ]}
  lines={[
    { from: { x: 1, y: 1 }, to: { x: 1, y: -0.3 }, guide: true },
    { from: { x: 2, y: 0 }, to: { x: 2, y: -0.3 }, guide: true },
    {
      from: { x: 0.6, y: 1.13 },
      to: { x: 1.4, y: 0.87 },
      tone: "ink",
      dashed: true,
    },
  ]}
  points={[
    { x: 0, y: 0, tone: "ink", radius: 3.5 },
    { x: 1, y: 1, tone: "ink", radius: 3.5 },
    { x: 2, y: 0, tone: "ink", radius: 3.5 },
    { x: 3, y: 1, tone: "ink", radius: 3.5 },
  ]}
  labels={[
    { text: "x₀", x: 0, y: -0.3, anchor: "middle", dy: 19 },
    { text: "x₁", x: 1, y: -0.3, anchor: "middle", dy: 19 },
    { text: "x₂", x: 2, y: -0.3, anchor: "middle", dy: 19 },
    { text: "x₃", x: 3, y: -0.3, anchor: "middle", dy: 19 },
    { text: "same slope", x: 1.53, y: 1.19, anchor: "middle", tone: "ink" },
    { text: "S″ = 0", x: 0.09, y: -0.18, tone: "ink" },
    { text: "S″ = 0", x: 2.66, y: 1.08, anchor: "end", tone: "ink" },
    { text: "S₀", x: 0.34, y: 0.34, tone: "s5", size: 15, weight: 700 },
    { text: "S₁", x: 1.28, y: 0.89, tone: "ct", size: 15, weight: 700 },
    { text: "S₂", x: 2.34, y: 0.55, tone: "pt", size: 15, weight: 700 },
  ]}
>
  <Fragment slot="caption">
    <span class="tone-s5">S₀</span>, <span class="tone-ct">S₁</span> and
    <span class="tone-pt">S₂</span> are the three cubic pieces, one on each
    interval between nodes. At each interior knot x₁ and x₂ the two adjacent
    pieces meet at the same height, have the same slope (dashed line) and the
    same curvature. At the ends the natural condition sets S″ = 0.
  </Fragment>
</CartesianGraph>
