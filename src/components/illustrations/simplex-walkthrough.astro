---
// One persistent tableau. Stepping forward copies only the cells that
// actually change, so unchanged numbers stay put and the eye only tracks
// the pivot. Each <SimplexStep> child is a hidden data source + its note.
const uid = "simplex-" + Math.random().toString(36).slice(2, 9);
---

<figure class="simplex" id={uid} tabindex="0" aria-roledescription="carousel">
  <div class="bar">
    <span class="label" data-label></span>
    <span class="count"
      ><span data-current>1</span> / <span data-total></span></span
    >
  </div>

  <p class="legend">
    <span class="chip enter">entering column</span>
    <span class="chip leave">leaving row</span>
    <span class="chip pivot">pivot element</span>
    <span class="chip changed">updated this step</span>
  </p>

  <div class="scroll" data-live></div>

  <div class="stack"><slot /></div>

  <div class="foot">
    <div class="dots" role="tablist"></div>
    <div class="controls">
      <button type="button" data-prev disabled aria-label="Previous step">
        &#9664; Prev
      </button>
      <button type="button" data-next aria-label="Next step"
        >Next &#9654;</button
      >
    </div>
  </div>
  <p class="live" aria-live="polite"></p>
</figure>

<style>
  .simplex {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 14px 16px 16px;
    font-family: var(--font-ui);
  }
  .simplex:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .simplex:not(.ready) .bar,
  .simplex:not(.ready) .foot {
    visibility: hidden;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
    min-height: 1.2em;
  }
  .label {
    font-weight: 700;
    color: var(--text-primary);
  }
  .count {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 0 0 12px;
    font-size: 0.72rem;
    color: var(--text-secondary);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .chip::before {
    content: "";
    width: 11px;
    height: 11px;
    border-radius: 3px;
    flex: none;
  }
  .chip.enter::before {
    background: var(--accent-dim);
    border: 1px solid var(--accent);
  }
  .chip.leave::before {
    background: var(--accent-dim);
  }
  .chip.pivot::before {
    background: var(--accent-subtle);
  }
  .chip.changed::before {
    display: none;
  }
  .chip.changed {
    color: var(--accent);
    font-weight: 600;
  }

  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  /* The hidden data tables inside each step; only notes stay visible. */
  .stack :global(.step .tableau) {
    display: none;
  }

  /* Notes share one grid cell so the box does not resize between steps. */
  .stack {
    display: grid;
    margin-top: 2px;
  }
  .stack > :global(.step) {
    grid-area: 1 / 1;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
  }
  .stack > :global(.step.active) {
    opacity: 1;
    visibility: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .stack > :global(.step) {
      transition: none;
    }
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots :global(.dot) {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    cursor: pointer;
  }
  .dots :global(.dot[aria-selected="true"]) {
    background: var(--accent);
    border-color: var(--accent);
  }

  .controls {
    display: flex;
    gap: 8px;
  }
  .controls button {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-primary);
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<noscript>
  <style>
    .simplex [data-live] {
      display: none;
    }
    .simplex .stack {
      display: block;
    }
    .simplex .stack > .step {
      opacity: 1;
      visibility: visible;
      margin-top: 16px;
    }
    .simplex .stack .step > .tableau {
      display: table;
    }
    .simplex .foot {
      display: none;
    }
  </style>
</noscript>

<script>
  function initSimplex(root: HTMLElement) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>(".step"));
    if (!steps.length) return;

    const holder = root.querySelector<HTMLElement>("[data-live]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const label = root.querySelector<HTMLElement>("[data-label]")!;
    const current = root.querySelector<HTMLElement>("[data-current]")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;
    const dotWrap = root.querySelector<HTMLElement>(".dots")!;
    const live = root.querySelector<HTMLElement>(".live")!;

    // The persistent table: a clone of the first step's data table.
    const liveTable = steps[0]
      .querySelector<HTMLTableElement>(".tableau")!
      .cloneNode(true) as HTMLTableElement;
    liveTable.removeAttribute("aria-hidden");
    holder.appendChild(liveTable);

    total.textContent = String(steps.length);

    const dots = steps.map((s, idx) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "dot";
      b.setAttribute("aria-label", s.dataset.label ?? `Step ${idx + 1}`);
      b.addEventListener("click", () => show(idx));
      dotWrap.appendChild(b);
      return b;
    });

    let i = 0;

    function show(n: number) {
      i = Math.max(0, Math.min(steps.length - 1, n));
      const src = steps[i].querySelector<HTMLTableElement>(".tableau")!;

      const srcRows = src.querySelectorAll("tr");
      const dstRows = liveTable.querySelectorAll("tr");
      srcRows.forEach((sr, ri) => {
        const dr = dstRows[ri];
        if (!dr) return;
        dr.classList.toggle("leave", sr.classList.contains("leave"));
        const sCells = sr.querySelectorAll<HTMLElement>("th,td");
        const dCells = dr.querySelectorAll<HTMLElement>("th,td");
        sCells.forEach((sc, ci) => {
          const dc = dCells[ci];
          if (!dc) return;
          const changed = dc.innerHTML !== sc.innerHTML;
          if (changed) dc.innerHTML = sc.innerHTML;
          // Persist a marker on every cell touched by this step's pivot.
          dc.classList.toggle("changed", changed);
          dc.classList.toggle("enter", sc.classList.contains("enter"));
          dc.classList.toggle("pivot", sc.classList.contains("pivot"));
        });
      });

      steps.forEach((s, idx) => s.classList.toggle("active", idx === i));
      dots.forEach((d, idx) =>
        d.setAttribute("aria-selected", idx === i ? "true" : "false"),
      );
      prev.disabled = i === 0;
      next.disabled = i === steps.length - 1;
      label.textContent = steps[i].dataset.label ?? "";
      current.textContent = String(i + 1);
      const noteText =
        steps[i].querySelector(".step-note")?.textContent?.trim() ?? "";
      live.textContent = `${label.textContent}. ${noteText}`;
    }

    // Initial paint without flashing every cell.
    const first = steps[0].querySelector<HTMLTableElement>(".tableau")!;
    first.querySelectorAll("tr").forEach((sr, ri) => {
      const dr = liveTable.querySelectorAll("tr")[ri];
      if (dr) dr.classList.toggle("leave", sr.classList.contains("leave"));
    });
    steps[0].classList.add("active");
    label.textContent = steps[0].dataset.label ?? "";
    prev.disabled = true;
    next.disabled = steps.length === 1;
    dots[0]?.setAttribute("aria-selected", "true");

    prev.addEventListener("click", () => show(i - 1));
    next.addEventListener("click", () => show(i + 1));
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        show(i - 1);
        e.preventDefault();
      } else if (e.key === "ArrowRight") {
        show(i + 1);
        e.preventDefault();
      }
    });

    root.classList.add("ready");
  }

  document
    .querySelectorAll<HTMLElement>(".simplex")
    .forEach((el) => initSimplex(el));
</script>
