---
// Production Possibilities Frontier (PPF)
// A = efficient point on the frontier
// B = inefficient point inside the frontier
// C = unattainable point outside the frontier
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Production Possibilities Frontier"
  desc="A is on the production possibilities frontier and represents an efficient combination. B is inside the frontier and represents an inefficient combination. C is outside the frontier and is unattainable."
  y={{ label: "Good Y", domain: [0, 10] }}
  x={{ label: "Good X", domain: [0, 10] }}
  layout={{
    viewBox: "0 0 560 430",
    x0: 70,
    y0: 360,
    top: 45,
    right: 505,
    labelGap: 32,
  }}
  yLabelOffset={15}
  curves={[
    {
      equation: (goodX) => 9.05 * (1 - (goodX / 7.82) ** 1.8),
      domain: [0, 7.82],
      tone: "s5",
      round: true,
    },
  ]}
  areas={[
    {
      points: [
        { x: 0, y: 0 },
        { x: 0, y: 9.05 },
        { x: 1, y: 8.82 },
        { x: 2, y: 8.27 },
        { x: 3, y: 7.44 },
        { x: 4, y: 6.34 },
        { x: 5, y: 5.01 },
        { x: 6, y: 3.43 },
        { x: 7, y: 1.64 },
        { x: 7.82, y: 0 },
      ],
      tone: "s5",
      opacity: 0.07,
    },
  ]}
  points={[
    { x: 3.45, y: 6.98, tone: "pt", radius: 7, guides: true },
    { x: 2.3, y: 4.44, tone: "key", radius: 7, guides: true },
    { x: 6.55, y: 7.78, tone: "ct", radius: 7, guides: true },
  ]}
  labels={[
    { text: "0", x: 0, y: 0, tone: "ink", dx: -15, dy: 18 },
    {
      text: "A",
      x: 3.45,
      y: 6.98,
      tone: "ink",
      dx: 12,
      dy: -10,
      size: 15,
      weight: 600,
    },
    {
      text: "B",
      x: 2.3,
      y: 4.44,
      tone: "ink",
      dx: 12,
      dy: -10,
      size: 15,
      weight: 600,
    },
    {
      text: "C",
      x: 6.55,
      y: 7.78,
      tone: "ink",
      dx: 12,
      dy: -10,
      size: 15,
      weight: 600,
    },
  ]}
>
  <Fragment slot="caption">
    <p>
      <span class="tone-pt">A</span> on the frontier,{" "}
      <span class="tone-pt">efficient</span>. <span class="tone-key">B</span>{" "}
      inside the frontier, <span class="tone-key">inefficient</span>.
      <span class="tone-ct">C</span> outside the frontier,{" "}
      <span class="tone-ct">unattainable</span>.
    </p>
  </Fragment>
</CartesianGraph>
