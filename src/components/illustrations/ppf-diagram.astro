---
// Production Possibilities Frontier (PPF)
// A = efficient point on the frontier
// B = inefficient point inside the frontier
// C = unattainable point outside the frontier
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  size="lg"
  title="Production Possibilities Frontier"
  desc="A is on the production possibilities frontier and represents an efficient combination. B is inside the frontier and represents an inefficient combination. C is outside the frontier and is unattainable."
  viewBox="0 0 560 430"
  yLabel="Good Y"
  xLabel="Good X"
  x0={70}
  y0={360}
  top={45}
  right={505}
  yLabelOffset={15}
  xLabelOffset={32}
>
  <text class="origin" x="55" y="378">
    0
  </text>

  <path
    class="feasible-area tone-s5"
    d="
      M 70 75
      C 120 75, 165 95, 215 135
      C 285 190, 350 260, 410 360
      L 70 360
      Z
    "
  ></path>

  <path
    class="curve round tone-s5"
    d="
      M 70 75
      C 125 75, 175 100, 220 140
      C 285 195, 350 265, 410 360
    "
  ></path>

  <line class="guide" x1="220" y1="140" x2="220" y2="360"></line>
  <line class="guide" x1="70" y1="140" x2="220" y2="140"></line>
  <circle class="pt tone-pt" cx="220" cy="140" r="7"></circle>
  <text class="point-label" x="232" y="130">
    A
  </text>

  <line class="guide" x1="170" y1="220" x2="170" y2="360"></line>
  <line class="guide" x1="70" y1="220" x2="170" y2="220"></line>
  <circle class="pt tone-key" cx="170" cy="220" r="7"></circle>
  <text class="point-label" x="182" y="210">
    B
  </text>

  <line class="guide" x1="355" y1="115" x2="355" y2="360"></line>
  <line class="guide" x1="70" y1="115" x2="355" y2="115"></line>
  <circle class="pt tone-ct" cx="355" cy="115" r="7"></circle>
  <text class="point-label" x="367" y="105">
    C
  </text>

  <text class="description tone-pt" x="220" y="410" text-anchor="middle">
    A = Efficient
  </text>
  <text class="description tone-key" x="350" y="410" text-anchor="middle">
    B = Inefficient
  </text>
  <text class="description tone-ct" x="480" y="410" text-anchor="end">
    C = Unattainable
  </text>

  <Fragment slot="caption">
    <span class="tone-pt">A</span> on the frontier, efficient.
    <span class="tone-key">B</span> inside the frontier, inefficient.
    <span class="tone-ct">C</span> outside the frontier, unattainable.
  </Fragment>
</AxesFigure>

<style>
  .origin {
    fill: var(--text-muted);
    font-size: 13px;
  }

  .feasible-area {
    fill: var(--tone);
    opacity: 0.07;
  }

  .point-label {
    fill: var(--text-primary);
    font-size: 15px;
    font-weight: 600;
  }

  .description {
    fill: var(--tone);
    font-size: 12px;
    font-weight: 600;
  }
</style>
