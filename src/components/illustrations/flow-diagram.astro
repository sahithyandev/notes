---
// Interactive box-and-arrow flow diagram (DiffServ architecture, WFQ, token
// bucket, QoS principles, etc.). Boxes are laid out in rows; links are the
// steps. Prev / Next / dots step through the flow, highlighting the active
// arrow and its two boxes.

type Box = {
  label: string;
  sub?: string;
  spacer?: boolean;
};

interface Link {
  from: [number, number];
  to: [number, number];
  label?: string;
  note?: string;
  dash?: boolean;
  bend?: boolean;
  sbw?: number;
}

interface Props {
  rows: { title?: string; boxes: (string | Box)[] }[];
  links: Link[];
  sbw?: number;
}

const { rows, links, sbw } = Astro.props;

const uid = "flow-" + Math.random().toString(36).slice(2, 9);

const W = 900;
const M = 28;
const BOX_W = 150;
const BOX_H = 64;
const DEFAULT_SBW = 46;
const TOP = 12;

const commonSbw = sbw ?? DEFAULT_SBW;

type BoxOut = {
  label: string;
  sub?: string;
  spacer?: boolean;
  x: number;
  lines: string[];
  subLines: string[];
};

function wrap(text: string, max: number): string[] {
  if (!text) return [""];
  const words = text.split(/\s+/).filter(Boolean);
  const lines: string[] = [];
  let cur = "";
  for (const w of words) {
    const probe = cur ? cur + " " + w : w;
    if (probe.length > max && cur) {
      lines.push(cur);
      if (lines.length >= 2) return lines;
      cur = w;
    } else {
      cur = probe;
    }
  }
  if (cur) lines.push(cur);
  return lines.slice(0, 2);
}

const layout = rows.map((row, r) => {
  const nb = row.boxes.length;
  const gaps: number[] = [];
  for (let c = 0; c < nb - 1; c++) gaps[c] = commonSbw;
  for (const link of links) {
    const [sr, sc] = link.from;
    const [tr, tc] = link.to;
    if (
      link.sbw != null &&
      sr === tr &&
      tc === sc + 1 &&
      sc >= 0 &&
      sc < gaps.length
    ) {
      gaps[sc] = link.sbw;
    }
  }
  const used = nb * BOX_W + gaps.reduce((a, b) => a + b, 0);
  const avail = W - 2 * M;
  const scale = used > avail ? avail / used : 1;
  const left = (W - (nb * BOX_W + gaps.reduce((a, b) => a + b, 0)) * scale) / 2;
  let cursor = left + BOX_W / 2;
  const boxes: BoxOut[] = [];
  row.boxes.forEach((b, c) => {
    const box = typeof b === "string" ? { label: b } : b;
    boxes.push({
      label: box.label,
      sub: box.sub,
      spacer: box.spacer,
      x: cursor,
      lines: wrap(box.label, 20),
      subLines: box.sub ? wrap(box.sub, 18) : [],
    });
    cursor += BOX_W + gaps[c] * scale;
  });
  return { title: row.title, boxes, boxW: BOX_W };
});

let yCursor = TOP;
const rowY: number[] = [];
for (const row of layout) {
  const titleH = row.title ? 20 : 4;
  rowY.push(yCursor + titleH + BOX_H / 2);
  yCursor += titleH + BOX_H + 46;
}
const H = yCursor + 6;

type Pt = { x: number; y: number };

function center(r: number, c: number): Pt {
  return { x: layout[r].boxes[c].x, y: rowY[r] };
}
function boxEdge(
  r: number,
  c: number,
): {
  top: Pt;
  bottom: Pt;
  left: Pt;
  right: Pt;
} {
  const { x, y } = center(r, c);
  const half = layout[r].boxW / 2;
  return {
    top: { x, y: y - BOX_H / 2 },
    bottom: { x, y: y + BOX_H / 2 },
    left: { x: x - half, y },
    right: { x: x + half, y },
  };
}

const LINK_LEN = 10;
const HEAD_HALF = 4.5;

function chevron(ex: number, ey: number, ux: number, uy: number): string {
  const px = -uy * HEAD_HALF;
  const py = ux * HEAD_HALF;
  const bx = ex - ux * LINK_LEN;
  const by = ey - uy * LINK_LEN;
  return `M ${bx - px} ${by - py} L ${ex} ${ey} L ${bx + px} ${by + py}`;
}

type LinkDraw = {
  shaftD: string;
  headD: string;
  labelX: number;
  labelY: number;
  anchor: "middle" | "start";
  dash: boolean;
  label: string;
  note?: string;
  src: [number, number];
  dst: [number, number];
};

function drawLink(link: Link): LinkDraw {
  const [sr, sc] = link.from;
  const [tr, tc] = link.to;
  const s = boxEdge(sr, sc);
  const t = boxEdge(tr, tc);

  let p1: Pt;
  let p2: Pt;
  let shaftD: string;
  let headUx = 0;
  let headUy = 0;
  let labelX: number;
  let labelY: number;
  let anchor: "middle" | "start" = "middle";

  if (sr === tr && tc > sc) {
    p1 = s.right;
    p2 = t.left;
    headUx = 1;
    shaftD = `M ${p1.x} ${p1.y} L ${p2.x - LINK_LEN} ${p2.y}`;
    labelX = (p1.x + p2.x) / 2;
    labelY = p1.y - 12;
  } else if (sr === tr && tc < sc) {
    p1 = s.left;
    p2 = t.right;
    headUx = -1;
    shaftD = `M ${p1.x} ${p1.y} L ${p2.x + LINK_LEN} ${p2.y}`;
    labelX = (p1.x + p2.x) / 2;
    labelY = p1.y + 17;
  } else {
    const up = tr > sr;
    p1 = up ? s.bottom : s.top;
    p2 = up ? t.top : t.bottom;
    if (link.bend && Math.abs(p2.x - p1.x) > 8) {
      const bendY = p1.y + (up ? 14 : -14);
      const by = p2.y - (up ? LINK_LEN : -LINK_LEN);
      shaftD = `M ${p1.x} ${p1.y} L ${p1.x} ${bendY} L ${p2.x} ${bendY} L ${p2.x} ${by}`;
      headUy = up ? 1 : -1;
      labelX = (p1.x + p2.x) / 2;
      labelY = Math.min(p1.y, bendY) - 7;
    } else {
      const dx = p2.x - p1.x;
      const dy = p2.y - p1.y;
      const len = Math.hypot(dx, dy) || 1;
      headUx = dx / len;
      headUy = dy / len;
      const bx = p2.x - headUx * LINK_LEN;
      const by = p2.y - headUy * LINK_LEN;
      shaftD = `M ${p1.x} ${p1.y} L ${bx} ${by}`;
      labelX = (p1.x + p2.x) / 2 + 18;
      labelY = (p1.y + p2.y) / 2;
      anchor = "start";
    }
  }

  const headD = chevron(p2.x, p2.y, headUx, headUy);

  return {
    shaftD,
    headD,
    labelX,
    labelY,
    anchor,
    dash: link.dash ?? false,
    label: link.label ?? "",
    note: link.note,
    src: link.from,
    dst: link.to,
  };
}

const drawn = links.map(drawLink);
---

<figure
  class="flow"
  id={uid}
  tabindex="0"
  aria-roledescription="carousel"
  aria-label="Interactive flow diagram"
>
  <div class="bar">
    <span class="label" data-label></span>
    <span class="count"
      ><span data-current>1</span> / <span data-total>{drawn.length}</span
      ></span
    >
  </div>

  <div class="scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      width="100%"
      aria-hidden="true"
      style={`max-height: ${H}px; aspect-ratio: ${W} / ${H}`}
    >
      <g class="row-titles">
        {
          layout.map((row, r) =>
            row.title ? (
              <text x={M} y={rowY[r] - BOX_H / 2 - 8} class="row-title">
                {row.title}
              </text>
            ) : null,
          )
        }
      </g>

      <g class="boxes">
        {
          layout.map((row, r) =>
            row.boxes.map((b, c) =>
              b.spacer ? null : (
                <g
                  class="box"
                  id={`box-${uid}-${r}-${c}`}
                  style={`transform: translate(${b.x}px, ${rowY[r]}px)`}
                >
                  <rect
                    width={row.boxW}
                    height={BOX_H}
                    rx="10"
                    style={`transform: translate(${-row.boxW / 2}px, ${-BOX_H / 2}px)`}
                  />
                  <text
                    x="0"
                    text-anchor="middle"
                    dominant-baseline="middle"
                    class="box-label"
                  >
                    {b.lines.map((l, i) => (
                      <tspan
                        x="0"
                        y={
                          b.lines.length === 1
                            ? b.sub
                              ? -8
                              : 3
                            : (b.sub ? -16 : -10) + i * 20
                        }
                      >
                        {l}
                      </tspan>
                    ))}
                  </text>
                  {b.subLines.length > 0 && (
                    <text
                      x="0"
                      text-anchor="middle"
                      dominant-baseline="middle"
                      class="box-sub"
                    >
                      {b.subLines.map((l, i) => (
                        <tspan
                          x="0"
                          y={b.subLines.length === 1 ? 16 : 9 + i * 13}
                        >
                          {l}
                        </tspan>
                      ))}
                    </text>
                  )}
                </g>
              ),
            ),
          )
        }
      </g>

      <g class="links">
        {
          drawn.map((l, i) => (
            <g
              class="link"
              data-title={l.note ?? l.label ?? ""}
              data-src={`box-${uid}-${l.src[0]}-${l.src[1]}`}
              data-dst={`box-${uid}-${l.dst[0]}-${l.dst[1]}`}
            >
              <path d={l.shaftD} class={`shaft${l.dash ? " dash" : ""}`} />
              <path d={l.headD} class="head" />
              {l.label && (
                <text
                  x={l.labelX}
                  y={l.labelY}
                  text-anchor={l.anchor}
                  class="link-label"
                >
                  {l.label}
                </text>
              )}
            </g>
          ))
        }
      </g>
    </svg>
  </div>

  <div class="foot">
    <div class="dots" role="tablist"></div>
    <div class="controls">
      <button type="button" data-prev disabled aria-label="Previous step">
        &#9664; Prev
      </button>
      <button type="button" data-next aria-label="Next step"
        >Next &#9654;</button
      >
    </div>
  </div>
  <p class="live" aria-live="polite"></p>
</figure>

<style>
  .flow {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 14px 16px 16px;
    font-family: var(--font-ui);
  }
  .flow:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 10px;
    min-height: 2.5em;
  }
  .label {
    font-weight: 700;
    color: var(--text-primary);
    min-width: 0;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .count {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    flex: none;
    padding-top: 2px;
  }

  .scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  svg {
    display: block;
    min-width: 640px;
  }

  .row-title {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    fill: var(--text-muted);
  }

  .box {
    text-align: center;
  }
  .box rect {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .box-label {
    font-size: 0.68rem;
    font-weight: 700;
    fill: var(--text-primary);
    font-family: var(--font-body);
  }
  .box-sub {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    fill: var(--text-muted);
  }

  .box.current rect {
    stroke: var(--sem);
    stroke-width: 1.6;
    fill: var(--sem-bg);
  }
  .box.current .box-label {
    fill: var(--sem);
  }

  .link {
    transition: opacity 0.25s ease;
  }
  .link path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .link path.dash {
    stroke-dasharray: 5 4;
  }
  .link-label {
    font-size: 0.6rem;
    font-family: var(--font-mono);
    fill: var(--text-secondary);
  }
  .link.current path {
    stroke: var(--sem);
    stroke-width: 2.2;
  }
  .link.current .link-label {
    fill: var(--sem);
    font-weight: 700;
  }
  .link.done {
    opacity: 0.32;
  }
  .link.future {
    opacity: 0.5;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots :global(.dot) {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    cursor: pointer;
  }
  .dots :global(.dot[aria-selected="true"]) {
    background: var(--sem);
    border-color: var(--sem);
  }

  .controls {
    display: flex;
    gap: 8px;
  }
  .controls button {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-primary);
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    border-color: var(--sem);
    color: var(--sem);
  }
  .controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<noscript>
  <style>
    .flow .foot {
      display: none;
    }
  </style>
</noscript>

<script>
  function initFlow(root: HTMLElement) {
    const links = Array.from(root.querySelectorAll<HTMLElement>(".link"));
    if (!links.length) return;
    const boxes = Array.from(root.querySelectorAll<HTMLElement>(".box"));

    const prev = root.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-next]")!;
    const label = root.querySelector<HTMLElement>("[data-label]")!;
    const current = root.querySelector<HTMLElement>("[data-current]")!;
    const total = root.querySelector<HTMLElement>("[data-total]")!;
    const dotWrap = root.querySelector<HTMLElement>(".dots")!;
    const live = root.querySelector<HTMLElement>(".live")!;

    const linkBox = links.map((l) => {
      const src = l.dataset.src ?? "";
      const dst = l.dataset.dst ?? "";
      return { src, dst, label: (l.dataset.title ?? "").trim() };
    });

    const dots = links.map((l, idx) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "dot";
      b.setAttribute("aria-label", `Step ${idx + 1}`);
      b.addEventListener("click", () => show(idx));
      dotWrap.appendChild(b);
      return b;
    });

    let i = 0;

    function show(n: number) {
      i = Math.max(0, Math.min(links.length - 1, n));
      links.forEach((l, idx) => {
        l.classList.toggle("current", idx === i);
        l.classList.toggle("done", idx < i);
        l.classList.toggle("future", idx > i);
      });
      boxes.forEach((b) => b.classList.remove("current"));
      const s = linkBox[i];
      boxes.forEach((b) => {
        if (b.id === s.src || b.id === s.dst) b.classList.add("current");
      });
      dots.forEach((d, idx) =>
        d.setAttribute("aria-selected", idx === i ? "true" : "false"),
      );
      prev.disabled = i === 0;
      next.disabled = i === links.length - 1;
      label.textContent = s.label || `Step ${i + 1}`;
      current.textContent = String(i + 1);
      live.textContent = s.label;
    }

    show(0);

    prev.addEventListener("click", () => show(i - 1));
    next.addEventListener("click", () => show(i + 1));
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        show(i - 1);
        e.preventDefault();
      } else if (e.key === "ArrowRight") {
        show(i + 1);
        e.preventDefault();
      }
    });
  }

  document.querySelectorAll<HTMLElement>(".flow").forEach((el) => initFlow(el));
</script>
