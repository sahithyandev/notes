---
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  size="lg"
  title="Cost Minimization"
  desc="An isoquant and two parallel isocost lines. The equilibrium point is marked separately from the lowest isocost line."
  y={{ label: "Capital (K)", domain: [0, 10] }}
  x={{ label: "Labour (L)", domain: [0, 10] }}
  layout={{ viewBox: "0 0 650 450", y0: 370, right: 590 }}
  curves={[
    {
      equation: (labour) =>
        -0.011 * labour ** 3 + 0.2952 * labour ** 2 - 3.0282 * labour + 11.8051,
      domain: [1.36, 9.06],
      tone: "s5",
    },
  ]}
  lines={[
    {
      from: { x: 1.13, y: 1.34 },
      to: { x: 6.89, y: 8.06 },
      tone: "pt",
      width: 2.8,
    },
    {
      from: { x: 2.55, y: 0.3 },
      to: { x: 9.91, y: 8.51 },
      tone: "ink",
      dashed: true,
      width: 1.8,
    },
  ]}
  points={[{ x: 5.09, y: 3.58, tone: "ink", radius: 7, guides: true }]}
  labels={[
    { text: "Q₁", x: 6.32, y: 1.79, tone: "s5", size: 15, weight: 700 },
    { text: "Isocost", x: 3.02, y: 2.54, tone: "pt", weight: 600 },
    { text: "Higher cost", x: 7.17, y: 6.12, tone: "ink" },
    { text: "E", x: 5.28, y: 3.88, tone: "ink", size: 15, weight: 700 },
    {
      text: "Cost-minimizing combination",
      x: 5.38,
      y: 2.84,
      tone: "ink",
    },
    { text: "Tangency", x: 5.47, y: 9.1, tone: "ink", weight: 600 },
    { text: "MRTS = Pₗ / Pₖ", x: 5.47, y: 8.51, tone: "ink", size: 13 },
  ]}
>
  <Fragment slot="caption">
    The firm minimizes the cost of producing Q₁ where the isoquant is tangent to
    the lowest attainable isocost line.
  </Fragment>
</CartesianGraph>
