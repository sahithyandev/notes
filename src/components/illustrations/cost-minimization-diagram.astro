<figure id="cost-minimization-diagram">
  <svg viewBox="0 0 650 450" xmlns="http://www.w3.org/2000/svg" role="img">
    <title>Cost Minimization</title>

    <!-- Axes -->
    <line class="axis" x1="75" y1="35" x2="75" y2="370"></line>
    <line class="axis" x1="75" y1="370" x2="590" y2="370"></line>

    <!-- Axis labels -->
    <text class="axis-label" x="75" y="22" text-anchor="middle">
      Capital (K)
    </text>

    <text class="axis-label" x="590" y="400" text-anchor="end">
      Labour (L)
    </text>

    <!-- Isoquant -->
    <path
      class="isoquant"
      d="
        M 145 95
        C 175 135, 205 175, 250 215
        C 300 260, 365 300, 440 325
        C 490 342, 540 352, 575 357
      "
    ></path>

    <!-- Lower-cost isocost -->
    <line class="isocost-min" x1="135" y1="325" x2="440" y2="100"></line>

    <!-- Higher-cost isocost -->
    <line class="isocost-high" x1="210" y1="360" x2="585" y2="85"></line>

    <!-- Tangency point -->
    <circle class="tangency-point" cx="335" cy="250" r="7"></circle>

    <!-- Dashed guides -->
    <line class="guide" x1="335" y1="250" x2="335" y2="370"></line>

    <line class="guide" x1="75" y1="250" x2="335" y2="250"></line>

    <!-- Labels -->
    <text class="isoquant-label" x="410" y="310"> Q₁ </text>

    <text class="isocost-label" x="235" y="285"> Isocost </text>

    <text class="high-cost-label" x="455" y="165"> Higher cost </text>

    <text class="point-label" x="345" y="240"> E </text>

    <text class="minimum-label" x="350" y="275">
      Cost-minimizing combination
    </text>

    <!-- Tangency condition -->
    <text class="condition-label" x="355" y="65"> Tangency </text>

    <text class="formula-label" x="355" y="85"> MRTS = Pₗ / Pₖ </text>
  </svg>

  <figcaption>
    The firm minimizes the cost of producing Q₁ where the isoquant is tangent to
    the lowest attainable isocost line.
  </figcaption>
</figure>

