---
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  size="lg"
  title="Cost Minimization"
  yLabel="Capital (K)"
  xLabel="Labour (L)"
  viewBox="0 0 650 450"
  y0={370}
  right={590}
>
  <path
    class="curve tone-s5"
    d="
      M 145 95
      C 175 135, 205 175, 250 215
      C 300 260, 365 300, 440 325
      C 490 342, 540 352, 575 357
    "
  ></path>

  <line class="isocost-min" x1="135" y1="325" x2="440" y2="100"></line>
  <line class="isocost-high" x1="210" y1="360" x2="585" y2="85"></line>

  <circle class="pt tone-ink" cx="335" cy="250" r="7"></circle>

  <line class="guide" x1="335" y1="250" x2="335" y2="370"></line>
  <line class="guide" x1="75" y1="250" x2="335" y2="250"></line>

  <text class="curve-label tone-s5" x="410" y="310">
    Q₁
  </text>
  <text class="isocost-label" x="235" y="285">
    Isocost
  </text>
  <text class="small-label" x="455" y="165">
    Higher cost
  </text>
  <text class="point-label" x="345" y="240">
    E
  </text>
  <text class="small-label" x="350" y="275">
    Cost-minimizing combination
  </text>

  <text class="condition-label" x="355" y="65">
    Tangency
  </text>
  <text class="formula-label" x="355" y="85">
    MRTS = Pₗ / Pₖ
  </text>

  <Fragment slot="caption">
    The firm minimizes the cost of producing Q₁ where the isoquant is tangent to
    the lowest attainable isocost line.
  </Fragment>
</AxesFigure>

<style>
  .isocost-min {
    stroke: var(--dia-pt);
    stroke-width: 2.8;
  }

  .isocost-high {
    stroke: var(--text-muted);
    stroke-width: 1.8;
    stroke-dasharray: 7 5;
  }

  .isocost-label {
    fill: var(--dia-pt);
    font-size: 13px;
    font-weight: 600;
  }

  .small-label {
    fill: var(--text-secondary);
    font-size: 12px;
  }

  .point-label {
    fill: var(--text-primary);
    font-size: 15px;
    font-weight: 700;
  }

  .condition-label {
    fill: var(--text-primary);
    font-size: 13px;
    font-weight: 600;
  }

  .formula-label {
    fill: var(--text-secondary);
    font-size: 13px;
  }
</style>
