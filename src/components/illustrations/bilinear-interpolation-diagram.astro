---
import FigureCaption from "./primitives/figure-caption.astro";
import { makeUid } from "./lib/uid";

const uid = makeUid("bilinear-interpolation");
const cell = 62;
const gridX = 24;
const gridY = 42;
const sample = {
  x: gridX + cell / 2 + cell * 0.75,
  y: gridY + cell / 2 + cell * 0.25,
};
const pixels = [
  { x: 0, y: 0, value: "10" },
  { x: 1, y: 0, value: "30" },
  { x: 0, y: 1, value: "50" },
  { x: 1, y: 1, value: "90" },
];
---

<figure class="bilinear-interpolation-diagram">
  <svg
    viewBox="0 0 360 205"
    role="img"
    aria-labelledby={`${uid}-title ${uid}-desc`}
  >
    <title
      id={`${uid}-title`}
    >Bilinear interpolation from 4 source pixels</title>
    <desc id={`${uid}-desc`}>
      A mapped target position lies between 4 source-pixel centres. Dashed lines
      show that bilinear interpolation uses all 4 source values.
    </desc>
    <text class="label" x="24" y="16">
      Source neighbourhood
    </text>
    {pixels.map((pixel) => (
      <g>
        <rect
          class="cell"
          x={gridX + pixel.x * cell}
          y={gridY + pixel.y * cell}
          width={cell}
          height={cell}
        />
        <line
          class="guide"
          x1={sample.x}
          y1={sample.y}
          x2={gridX + pixel.x * cell + cell / 2}
          y2={gridY + pixel.y * cell + cell / 2}
        />
        <text
          class="value"
          x={gridX + pixel.x * cell + cell / 2}
          y={gridY + pixel.y * cell + 29}
          text-anchor="middle"
        >
          {pixel.value}
        </text>
      </g>
    ))}
    <circle class="sample" cx={sample.x} cy={sample.y} r="3.5" />
    <text class="sample-text" x={gridX} y="188">
      mapped target at (0.75, 0.25)
    </text>
    <path class="connector" d="M 168 104 H 236" />
    <path class="arrow" d="M 236 104 l -8 -5 M 236 104 l -8 5" />
    <text class="label" x="284" y="80" text-anchor="middle">
      Output
    </text>
    <rect class="output" x="253" y="92" width="62" height="62" rx="6" />
    <text class="output-value" x="284" y="130" text-anchor="middle">
      39
    </text>
    <text class="explanation" x="284" y="188" text-anchor="middle">
      weighted sum
    </text>
  </svg>
  <FigureCaption>
    Bilinear interpolation from a 2 by 2 source neighbourhood.
  </FigureCaption>
</figure>

<style>
  .bilinear-interpolation-diagram {
    max-width: 440px;
    margin: 14px auto;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  text {
    font-family: var(--font-ui);
  }
  .label,
  .value,
  .output-value {
    fill: var(--text-primary);
    font-weight: 650;
  }
  .label {
    font-size: 12px;
  }
  .value,
  .output-value {
    font-size: 15px;
  }
  .cell {
    fill: var(--surface);
    stroke: var(--border-strong);
  }
  .guide {
    stroke: var(--dia-ct);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
  }
  .sample {
    fill: var(--dia-pt);
    stroke: var(--surface);
    stroke-width: 1.5;
  }
  .sample-text,
  .explanation {
    fill: var(--text-secondary);
    font-size: 11px;
  }
  .connector,
  .arrow {
    fill: none;
    stroke: var(--text-secondary);
    stroke-width: 1.5;
  }
  .output {
    fill: var(--accent-soft);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
</style>
