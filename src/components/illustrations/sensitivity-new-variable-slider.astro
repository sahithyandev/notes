---
import { tex } from "../../utils/tex";
import Panel from "./primitives/panel.astro";
import SliderControl from "./primitives/slider-control.astro";
import StatusNote from "./primitives/status-note.astro";

interface Props {
  zTerm: number;
  deltaMin: number;
  deltaMax: number;
}

const { zTerm, deltaMin, deltaMax } = Astro.props;
---

<Panel class="new-var-slider">
  <div class="row">
    <span class="label">
      <span set:html={tex("z_{\\text{new}} - c_{\\text{new}}")} /> ={" "}
      {zTerm} - <span set:html={tex("c_{\\text{new}}")} />
    </span>
    <span class="value" data-reduced-cost data-base={zTerm}>
      {zTerm}
    </span>
  </div>

  <SliderControl
    id="new-var-cost"
    min={deltaMin}
    max={deltaMax}
    step={0.01}
    value={0}
  >
    <span set:html={tex("c_{\\text{new}}")} />
  </SliderControl>

  <StatusNote ok={true}>
    Reduced cost &ge; 0. The new variable stays non-basic at value 0.
  </StatusNote>
</Panel>

<script>
  import { fmt } from "./lib/format";

  document
    .querySelectorAll<HTMLDivElement>(".new-var-slider")
    .forEach((widget) => {
      const slider = widget.querySelector<HTMLInputElement>(
        'input[type="range"]',
      )!;
      const cOut = widget.querySelector<HTMLElement>("[data-delta]")!;
      const reducedCostEl = widget.querySelector<HTMLElement>(
        "[data-reduced-cost]",
      )!;
      const base = Number(reducedCostEl.dataset.base);
      const status = widget.querySelector<HTMLElement>("[data-status]")!;

      const render = () => {
        const cNew = Number(slider.value);
        const reducedCost = base - cNew;

        cOut.textContent = fmt(cNew);
        reducedCostEl.textContent = fmt(reducedCost);
        reducedCostEl.classList.toggle("changed", cNew !== 0);

        const optimal = reducedCost >= 0;
        status.dataset.state = optimal ? "ok" : "bad";
        status.textContent = optimal
          ? "Reduced cost ≥ 0. The new variable stays non-basic at value 0."
          : `Reduced cost ${fmt(reducedCost)} < 0. The new variable can enter the basis and improve z.`;
      };

      slider.addEventListener("input", render);
      render();
    });
</script>

<style>
  :global(.panel.new-var-slider) {
    padding: 16px 18px 18px;
    border-radius: 10px;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.9rem;
    font-family: var(--font-ui);
  }

  .row .label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
  }

  .row .value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
  }

  .row .value.changed {
    color: var(--accent);
    font-weight: 600;
    transition: color 0.15s ease;
  }
</style>
