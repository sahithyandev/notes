---
// Static market equilibrium diagram: demand and supply curves
// intersecting at the equilibrium point, with dashed guides to the
// price and quantity axes.
import CartesianGraph from "./primitives/cartesian-graph.astro";
---

<CartesianGraph
  captionSlot
  title="Market Equilibrium"
  desc="Demand and supply curves intersect at the equilibrium point, with dashed projections to the price and quantity axes."
  y={{ label: "Price", domain: [0, 10] }}
  x={{ label: "Quantity", domain: [0, 10] }}
  curves={[
    {
      equation: (quantity) => 10.19 - quantity,
      domain: [1.47, 9.41],
      tone: "s5",
    },
    {
      equation: (quantity) => 0.19 + quantity,
      domain: [1.18, 8.82],
      tone: "ct",
    },
  ]}
  points={[
    {
      x: 5,
      y: 5.19,
      tone: "pt",
      label: "E",
      labelDx: 2,
      labelDy: -10,
      guides: true,
    },
  ]}
  labels={[
    { text: "Pₑ", x: 0, y: 5.19, anchor: "end", dx: -8, dy: 4 },
    { text: "Qₑ", x: 5, y: 0, anchor: "middle", dy: 16 },
    { text: "D", x: 1.62, y: 9.63, tone: "s5", weight: 600 },
    { text: "S", x: 8.97, y: 9.26, tone: "ct", weight: 600 },
  ]}
>
  <Fragment slot="caption">
    <span class="tone-pt">E</span> the equilibrium point, where
    <span class="tone-s5">D</span> and <span class="tone-ct">S</span> intersect,
    at price <span class="tone-pt">P&#8337;</span> and quantity
    <span class="tone-pt">Q&#8337;</span>.
  </Fragment>
</CartesianGraph>
