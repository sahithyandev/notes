---
// Static market equilibrium diagram: demand and supply curves
// intersecting at the equilibrium point, with dashed guides to the
// price and quantity axes.
import AxesFigure from "./primitives/axes-figure.astro";
---

<AxesFigure
  captionSlot
  title="Market Equilibrium"
  yLabel="Price"
  xLabel="Quantity"
>
  <path
    class="curve tone-s5"
    d="M 100 40 C 150 90, 190 130, 220 150 C 260 180, 320 220, 370 260"
  ></path>
  <path
    class="curve tone-ct"
    d="M 90 270 C 140 220, 180 180, 220 150 C 260 120, 310 80, 350 40"
  ></path>

  <line class="guide" x1="220" y1="150" x2="50" y2="150"></line>
  <line class="guide" x1="220" y1="150" x2="220" y2="290"></line>

  <circle class="pt tone-pt" cx="220" cy="150" r="5"></circle>

  <text class="axis-tick" x="42" y="154" text-anchor="end">
    P&#8337;
  </text>
  <text class="axis-tick" x="220" y="305" text-anchor="middle">
    Q&#8337;
  </text>

  <text class="curve-label tone-s5" x="105" y="30">
    D
  </text>
  <text class="curve-label tone-ct" x="355" y="40">
    S
  </text>
  <text class="pt-label tone-pt" x="222" y="140">
    E
  </text>

  <Fragment slot="caption">
    <span class="tone-pt">E</span> the equilibrium point, where
    <span class="tone-s5">D</span> and <span class="tone-ct">S</span> intersect,
    at price <span class="tone-pt">P&#8337;</span> and quantity
    <span class="tone-pt">Q&#8337;</span>.
  </Fragment>
</AxesFigure>
