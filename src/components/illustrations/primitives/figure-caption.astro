---
// The <figcaption> shared by Panel and by illustrations that render their own
// <figure>. `hidden` keeps it available to assistive tech while removing it
// from the layout, for interactive widgets whose chrome already labels them.
interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;
---

<figcaption class:list={{ hidden }}>
  <slot />
</figcaption>

<style>
  figcaption {
    margin-top: 10px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-secondary);
    text-align: center;
  }

  figcaption.hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
