---
// The label + range input + live output row shared by the sensitivity
// sliders. Label content varies per slider (it often embeds inline KaTeX),
// so it's a slot rather than a prop.
import RangeInput from "./range-input.astro";

interface Props {
  id: string;
  min: number;
  max: number;
  step?: number;
  value?: number;
}

const { id, min, max, step = 0.01, value = 0 } = Astro.props;
---

<div class="control">
  <label for={id}>
    <slot />
  </label>
  <RangeInput id={id} min={min} max={max} step={step} value={value} />
  <output for={id} data-delta>
    {value}
  </output>
</div>

<style>
  .control {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .control label {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .control {
    --range-accent: var(--s5);
  }

  .control :global(.sn-range) {
    flex: 1 1 160px;
    width: auto;
  }

  .control output {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--s5);
    min-width: 4ch;
    text-align: right;
  }
</style>
