---
// The bordered surface box shared by the walkthrough carousel, the
// sensitivity sliders and the other interactive widgets. Attributes beyond
// `class` (tabindex, aria-roledescription, id, ...) are passed through to the
// root element so carousel-specific semantics stay in the component that needs
// them. The caption is required by type (see lib/caption.ts); `hideCaption`
// makes it screen-reader-only.
import type { HTMLAttributes } from "astro/types";
import { assertCaption, type CaptionProps } from "../lib/caption";
import FigureCaption from "./figure-caption.astro";

type Props = HTMLAttributes<"figure"> &
  CaptionProps & {
    hideCaption?: boolean;
  };

const {
  class: className,
  caption,
  captionSlot: _captionSlot,
  hideCaption = false,
  ...rest
} = Astro.props;

assertCaption("Panel", caption, Astro.slots.has("caption"));
---

<figure class:list={["panel", className]} {...rest}>
  <slot />
  <FigureCaption hidden={hideCaption}>
    {caption}
    <slot name="caption" />
  </FigureCaption>
</figure>

<style>
  .panel {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 14px 16px 16px;
    font-family: var(--font-ui);
  }
  .panel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
