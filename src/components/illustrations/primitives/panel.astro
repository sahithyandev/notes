---
// The bordered surface box shared by the walkthrough carousel and (later)
// the sensitivity sliders. Attributes beyond `class` (tabindex,
// aria-roledescription, id, ...) are passed through to the root element so
// carousel-specific semantics stay in the component that needs them.
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"figure"> {}

const { class: className, ...rest } = Astro.props;
---

<figure class:list={["panel", className]} {...rest}>
  <slot />
</figure>

<style>
  .panel {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    padding: 14px 16px 16px;
    font-family: var(--font-ui);
  }
  .panel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
