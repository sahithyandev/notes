---
// The prose note under a walkthrough step's hidden data table.
---

<div class="step-note"><slot /></div>

<style>
  .step-note {
    margin: 12px 0 0;
    min-height: 2.8em;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }
  .step-note :global(p) {
    margin: 0;
  }
  .step-note :global(.katex) {
    font-size: 1em;
  }
</style>
