---
// Dots + prev/next + the visually-hidden aria-live announcer, filled in by
// the shared controller (lib/walkthrough.ts). The dot template lets the
// controller clone a real element that carries this component's own
// scoped-CSS id, so ".dots .dot" styles normally with no :global() escape.
---

<div class="foot">
  <div class="dots" role="tablist">
    <template data-dot-template
      ><button type="button" class="dot"></button></template
    >
  </div>
  <div class="controls">
    <button type="button" data-prev disabled aria-label="Previous step">
      &#9664; Prev
    </button>
    <button type="button" data-next aria-label="Next step">Next &#9654;</button>
  </div>
</div>
<p class="live" aria-live="polite"></p>

<style>
  /* See step-bar.astro for why the ancestor compound needs :global(). */
  :global(.walkthrough:not(.ready)) .foot {
    visibility: hidden;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .dots {
    display: flex;
    gap: 7px;
  }
  .dots .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: transparent;
    cursor: pointer;
  }
  .dots .dot[aria-selected="true"] {
    background: var(--accent);
    border-color: var(--accent);
  }

  .controls {
    display: flex;
    gap: 8px;
  }
  .controls button {
    font: inherit;
    font-size: 0.85rem;
    padding: 5px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-primary);
    cursor: pointer;
  }
  .controls button:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .controls button:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
