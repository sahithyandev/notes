---
interface Props {
  slug: string;
  initialUp?: number;
  initialDown?: number;
}
const { slug, initialUp = 0, initialDown = 0 } = Astro.props;
---

<div class="note-feedback" data-slug={slug} aria-label="Was this note helpful?">
  <span class="note-feedback-label">Was this helpful?</span>
  <div class="note-feedback-btns">
    <button
      class="note-feedback-btn"
      data-vote="1"
      aria-label="Yes, this note was helpful"
      aria-pressed="false"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"
        ></path>
        <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
      </svg>
    </button>

    <span class="note-feedback-score">{initialUp - initialDown}</span>

    <button
      class="note-feedback-btn"
      data-vote="-1"
      aria-label="No, this note was not helpful"
      aria-pressed="false"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3H10z"
        ></path>
        <path
          d="M17 2h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"
        ></path>
      </svg>
    </button>
  </div>
</div>

<script>
  (() => {
    const container = document.querySelector<HTMLElement>(".note-feedback");
    if (!container) return;

    const slug = container.dataset.slug ?? "";
    const storageKey = `sn-vote-${slug}`;
    const btns =
      container.querySelectorAll<HTMLButtonElement>(".note-feedback-btn");
    const scoreEl =
      container.querySelector<HTMLElement>(".note-feedback-score")!;

    let inflight = false;

    function markActive(vote: number | null) {
      btns.forEach((btn) => {
        const v = Number(btn.dataset.vote);
        const active = vote !== null && v === vote;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-pressed", String(active));
      });
    }

    // Restore prior vote highlight from localStorage (counts are server-rendered)
    const stored = localStorage.getItem(storageKey);
    if (stored === "1" || stored === "-1") {
      markActive(Number(stored));
    }

    btns.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (inflight) return;
        const vote = Number(btn.dataset.vote) as 1 | -1;

        // Optimistic UI: undo previous vote effect on score, apply new
        const prevVote = localStorage.getItem(storageKey);
        let score = Number(scoreEl.textContent) || 0;
        if (prevVote === "1") score -= 1;
        if (prevVote === "-1") score += 1;
        score += vote;
        scoreEl.textContent = String(score);
        markActive(vote);
        localStorage.setItem(storageKey, String(vote));

        inflight = true;
        fetch("/api/votes", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ slug, vote }),
        })
          .then((r) => (r.ok ? r.json() : null))
          .then((data) => {
            if (data && typeof data.up === "number") {
              scoreEl.textContent = String(data.up - data.down);
              window.stonks?.event("vote", "/" + slug, { vote });
            }
          })
          .catch(() => {})
          .finally(() => {
            inflight = false;
          });
      });
    });
  })();
</script>

<style>
  .note-feedback {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-family: var(--font-ui);
  }

  .note-feedback-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .note-feedback-btns {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .note-feedback-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--text-secondary);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition:
      background 0.12s ease,
      border-color 0.12s ease,
      color 0.12s ease,
      transform 0.1s ease;
  }

  .note-feedback-btn:hover {
    color: var(--sem);
    background: var(--sem-bg);
    border-color: var(--sem-border);
  }

  .note-feedback-btn:active {
    transform: scale(0.93);
  }

  .note-feedback-btn.is-active {
    color: var(--sem);
    background: var(--sem-bg);
    border-color: var(--sem-border);
  }

  .note-feedback-btn.is-active svg {
    fill: currentColor;
    opacity: 1;
  }

  .note-feedback-btn svg {
    flex-shrink: 0;
    opacity: 0.75;
  }

  .note-feedback-score {
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    min-width: 2ch;
    text-align: center;
    padding: 0 4px;
  }
</style>
