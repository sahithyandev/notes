(* CreatedBy='Wolfram 14.3' *)

Notebook[{
Cell["Program Evaluation and Review Technique", "Title",ExpressionUUID->"B2A5E55B-7D1B-41B6-A7E8-8E2C2D0E0A11"],

Cell["Companion to docs/s5/operational-research/21-program-evaluation-and-review-technique.mdx. Computes PERT expected activity times, variances, critical-path duration, project standard deviation, and completion probability. Each activity is {name, predecessors, optimistic time, most likely time, pessimistic time}.", "Text",ExpressionUUID->"7D1C8C6E-2D8A-4FA3-9A1B-C4C5E4D5A1D2"],

Cell["Parameters: edit these and re-evaluate the notebook", "Subsection",ExpressionUUID->"E8B4A8C7-1B3E-4E6F-9D2B-0F6D0A5D2B32"],

Cell["activities = {{\"A\", {}, 2, 4, 6}, {\"B\", {\"A\"}, 1, 2, 3}, {\"C\", {\"A\"}, 2, 5, 8}, {\"D\", {\"B\", \"C\"}, 1, 3, 5}, {\"E\", {\"C\"}, 1, 2, 3}};", "Input",ExpressionUUID->"A4C5F6D7-8E9B-40A1-B2C3-D4E5F6A7B8C9"],

Cell["order = {\"A\", \"B\", \"C\", \"D\", \"E\"}; target = 14; paths = {{\"A\", \"B\", \"D\"}, {\"A\", \"C\", \"D\"}, {\"A\", \"C\", \"E\"}};", "Input",ExpressionUUID->"C9B8A7F6-E5D4-43C2-B1A0-9F8E7D6C5B4A"],

Cell["PERT estimates", "Subsection",ExpressionUUID->"D3E4F5A6-B7C8-49D0-E1F2-A3B4C5D6E7F8"],

Cell["activity[name_] := Select[activities, First[#] == name &][[1]]; optimistic[name_] := activity[name][[3]]; likely[name_] := activity[name][[4]]; pessimistic[name_] := activity[name][[5]]; expected[name_] := (optimistic[name] + 4 likely[name] + pessimistic[name])/6; standardDeviation[name_] := (pessimistic[name] - optimistic[name])/6; variance[name_] := standardDeviation[name]^2;", "Input",ExpressionUUID->"F1E2D3C4-B5A6-4789-90A1-B2C3D4E5F6A7"],

Cell["Grid[Prepend[Table[{name, optimistic[name], likely[name], pessimistic[name], expected[name], variance[name]}, {name, order}], {\"activity\", \"a\", \"m\", \"b\", \"expected time\", \"variance\"}], Frame -> All]", "Input",ExpressionUUID->"A1B2C3D4-E5F6-4789-90AB-C1D2E3F4A5B6"],

Cell["Path durations", "Subsection",ExpressionUUID->"B6A5F4E3-D2C1-40BA-9876-5F4E3D2C1B0A"],

Cell["pathDuration[path_] := Total[expected /@ path]; pathTable = ({#, pathDuration[#]} & /@ paths); Grid[Prepend[pathTable, {\"path\", \"expected duration\"}], Frame -> All]", "Input",ExpressionUUID->"C1D2E3F4-A5B6-4789-0ABC-D1E2F3A4B5C6"],

Cell["criticalPath = First@SortBy[paths, -pathDuration[#] &]; projectDuration = pathDuration[criticalPath]; criticalPath", "Input",ExpressionUUID->"D6E5F4A3-B2C1-4098-7654-3F2E1D0C9B8A"],

Cell["Project uncertainty", "Subsection",ExpressionUUID->"E7F8A9B0-C1D2-43E4-F5A6-B7C8D9E0F1A2"],

Cell["projectVariance = Total[variance /@ criticalPath]; projectStandardDeviation = Sqrt[projectVariance]; {projectDuration, projectVariance, projectStandardDeviation}", "Input",ExpressionUUID->"F2A3B4C5-D6E7-4890-A1B2-C3D4E5F6A7B8"],

Cell["Completion probability", "Subsection",ExpressionUUID->"A8B9C0D1-E2F3-4567-89A0-B1C2D3E4F5A6"],

Cell["z = (target - projectDuration)/projectStandardDeviation; probability = CDF[NormalDistribution[projectDuration, projectStandardDeviation], target]; {z, probability}", "Input",ExpressionUUID->"B7C6D5E4-F3A2-4190-8B7C-6D5E4F3A2B1C"],

Cell["The first result is the standard normal score for the target deadline. The second result is the approximate probability of completing the project by that deadline. Change the activity estimates, path list, or target above to explore other PERT scenarios.", "Text",ExpressionUUID->"C4D5E6F7-A8B9-4012-C3D4-E5F6A7B8C9D0"]
},
WindowSize->{Full, Full},
WindowMargins->{{0, Automatic}, {Automatic, 0}},
FrontEndVersion->"14.3 for Mac OS X ARM (64-bit) (July 8, 2025)",
