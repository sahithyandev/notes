Notebook[{
Cell["Gaussian Elimination \[LongDash] Scaled Partial Pivoting", "Title",ExpressionUUID->"733e61dc-0fd6-4754-a44a-950ff75da606"],

Cell["\<\
Companion to docs/s5/numerical-methods/04-gaussian-elimination.mdx. Edit the \
parameters cell below (the augmented system), then Kernel \[Rule] Evaluate \
Notebook.\
\>", "Text",ExpressionUUID->"fa33eb3c-b5b0-4245-a8eb-689752a551a1"],

Cell["Parameters \[LongDash] edit these and re-evaluate the notebook", \
"Subsection",ExpressionUUID->"446f2a27-6ad7-44fe-bb74-93df4a55cbee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eqs", "=",
   RowBox[{"{",
    RowBox[{
     RowBox[{"{",
      RowBox[{"30.`", ",", "591400"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"5.291`", ",",
       RowBox[{"-", "6.13`"}]}], "}"}]}], "}"}]}], ";",
  RowBox[{"b", "=",
   RowBox[{"{",
    RowBox[{"591700", ",", "46.78`"}], "}"}]}]}]], "Input",ExpressionUUID->\
"3a6e8819-ca47-4e7e-b2c6-31d821e49ba9"],

Cell["Scale factors and scaled ratios", "Subsection",ExpressionUUID->"5a5932f0-c02e-4d75-9e9a-78425da2e805"],

Cell[BoxData[
 RowBox[{"s", "=",
  RowBox[{
   RowBox[{"(",
    RowBox[{
     RowBox[{"Max", "[",
      RowBox[{"Abs", "[", "#1", "]"}], "]"}], "&"}], ")"}], "/@",
   "eqs"}]}]], "Input",ExpressionUUID->"d85af50f-3f2d-499b-ab2e-9ae29f3d95bf"],

Cell[BoxData[
 RowBox[{"ratios", "=",
  FractionBox[
   RowBox[{"Abs", "[",
    RowBox[{"eqs", "\[LeftDoubleBracket]",
     RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "]"}],
   "s"]}]], "Input",ExpressionUUID->"5726812e-5db9-47d0-bd3a-f48dbbd9ea1f"],

Cell["Pivot on the larger ratio, then solve", "Subsection",ExpressionUUID->"c764087d-1d73-4539-bb2c-b7d93c1a6934"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pivotRow", "=",
   RowBox[{"First", "[",
    RowBox[{"Ordering", "[",
     RowBox[{"ratios", ",",
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";",
  RowBox[{"order", "=",
   RowBox[{"If", "[",
    RowBox[{
     RowBox[{"pivotRow", "\[Equal]", "1"}], ",",
     RowBox[{"{",
      RowBox[{"1", ",", "2"}], "}"}], ",",
     RowBox[{"{",
      RowBox[{"2", ",", "1"}], "}"}]}], "]"}]}], ";",
  RowBox[{"sol", "=",
   RowBox[{"LinearSolve", "[",
    RowBox[{
     RowBox[{
     "eqs", "\[LeftDoubleBracket]", "order", "\[RightDoubleBracket]"}], ",",
     RowBox[{
     "b", "\[LeftDoubleBracket]", "order", "\[RightDoubleBracket]"}]}],
    "]"}]}]}]], "Input",ExpressionUUID->"b6c54aed-706c-4e71-b602-\
ce36486cf20b"]
},
WindowSize->{Full, Full},
