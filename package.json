{
  "name": "notes",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun build:astro && bun build:pagefind",
    "build:astro": "astro build",
    "build:pagefind": "pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "sync-note-metadata": "bun scripts/sync-note-metadata.ts",
    "check-notes-style": "bun scripts/check-notes-style.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "generate-db-types": "supabase gen types typescript --project-id qrpfxrgemtvxmkuhmpcg > src/lib/database.types.ts",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "lint-staged": {
    "docs/**/*.{md,mdx}": [
      "bun run sync-note-metadata -- --staged-only"
    ],
    "**/*.{js,ts,astro,css,json,xml,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@astrojs/vercel": "11.0.17",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^8.0.7",
    "@lucide/astro": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "astro": "7.4.4",
    "d3-force": "^3.0.0",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "pdf-lib": "^1.17.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/babel__generator": "^7.6.8",
    "@types/bun": "^1.4.4",
    "@types/d3-force": "^3.0.10",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pagefind": "^1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-xml": "^0.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
