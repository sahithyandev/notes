{
  "name": "notes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun build:astro && bun build:pagefind",
    "build:astro": "astro build",
    "build:pagefind": "pagefind --site .vercel/output/static",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "sync-note-metadata": "bun scripts/sync-note-metadata.ts",
    "check-notes-style": "bun scripts/check-notes-style.ts",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "generate-db-types": "supabase gen types typescript --project-id qrpfxrgemtvxmkuhmpcg > src/lib/database.types.ts",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "lint-staged": {
    "docs/**/*.{md,mdx}": [
      "bun run sync-note-metadata"
    ],
    "**/*.{js,ts,astro,css,json,xml,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/vercel": "11.0.11",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^8.0.6",
    "@lucide/astro": "^1.47.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.2",
    "astro": "7.3.4",
    "astro-og-canvas": "^0.13.2",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.9",
    "pdf-lib": "^1.17.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pagefind": "^1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1",
    "prettier-plugin-xml": "^0.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
